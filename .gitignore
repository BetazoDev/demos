# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Impeccable: capturas de revisión y comps (pesados, se regeneran)
.impeccable/review/
.impeccable/mocks/
.impeccable/build/

# generados por astro/scripts/install.mjs (lista 2)
/public/_a/
/public/_l2/
