---
// Cifras reales del despacho (cuentan al entrar en pantalla). Solo las que el despacho publica.
interface Props {
  stats: { value: string; label: string }[];
  class?: string;
}
const { stats, class: cls = "" } = Astro.props;
---

<dl data-stagger data-gap="90" class:list={["grid gap-x-10 gap-y-10", stats.length >= 4 ? "grid-cols-2 lg:grid-cols-4" : stats.length === 3 ? "sm:grid-cols-3" : "sm:grid-cols-2", cls]}>
  {
    stats.map((s) => (
      <div>
        <dt class="sr-only">{s.label}</dt>
        <dd>
          <span data-count={s.value} class="block font-(family-name:--f-display) text-[clamp(2.8rem,6vw,5.2rem)] font-medium leading-none tracking-[-0.04em] tabular-nums">{s.value}</span>
          <span class="mt-3 block max-w-[22ch] text-[15px] opacity-70">{s.label}</span>
        </dd>
      </div>
    ))
  }
</dl>
