---
// Calificación de Google y reseñas reales (cita literal, máx. 3 líneas). Atribuir tal como aparecen en Google.
interface Props {
  rating: number;
  count: number;
  quotes: { text: string; author: string; when?: string }[];
  class?: string;
}
const { rating, count, quotes, class: cls = "" } = Astro.props;
---

<div class={cls}>
  <p class="flex items-baseline gap-4">
    <span data-count={rating.toFixed(1)} class="font-(family-name:--f-display) text-[clamp(3.5rem,8vw,6.5rem)] font-medium leading-none tracking-[-0.04em] tabular-nums">{rating.toFixed(1)}</span>
    <span class="text-lg opacity-75">en Google, {count} {count === 1 ? "reseña" : "reseñas"}</span>
  </p>
  <ul data-stagger data-gap="90" class="mt-10 grid gap-5 md:grid-cols-3">
    {
      quotes.slice(0, 3).map((q) => (
        <li class="flex flex-col justify-between gap-6 rounded-(--c-radius-card,1.25rem) bg-current/[0.05] p-7">
          <blockquote class="line-clamp-6 text-lg leading-snug">“{q.text}”</blockquote>
          <p class="text-sm opacity-65">{q.author}{q.when ? `, ${q.when}` : ""}</p>
        </li>
      ))
    }
  </ul>
</div>
