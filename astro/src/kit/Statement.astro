---
// Frase grande que se llena palabra por palabra con el scroll. Solo para una frase REAL del despacho (lema, descripción).
interface Props { text: string; class?: string }
const { text, class: cls = "" } = Astro.props;
---

<p data-statement class:list={["max-w-[24ch] text-[clamp(1.9rem,4.4vw,4rem)] font-medium leading-[1.12] tracking-[-0.03em] sm:max-w-[28ch]", cls]}>{text}</p>
