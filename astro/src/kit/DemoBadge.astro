---
// Botón flotante «Sitio demo · Hablemos» y su modal: identifica cada propuesta como demo de Hemeron.
// Mismo comportamiento que el de la lista 1 (Next.js), en HTML nativo (<dialog>) y sin framework.
import HemeronLogo from "./HemeronLogo.astro";

interface Props {
  name: string;
  lang?: "es" | "en";
  /** Ruta de la página actual, para el mensaje de WhatsApp */
  path?: string;
}
const { name, lang = "es", path = Astro.url.pathname } = Astro.props;
const WHATSAPP = "524491254443";
const url = new URL(path, Astro.site).href;

const COPY = {
  es: {
    pill: "Sitio demo",
    talk: "Hablemos",
    eyebrow: "Propuesta de rediseño",
    title: `Así podría verse el sitio de ${name}`,
    body: "Este es un sitio demo que preparamos en Hemeron con su logo, sus colores y la información que ya tienen publicada. Todavía no es su sitio oficial: los formularios no envían datos.",
    points: ["Diseño actual que se adapta a celular, tablet y computadora", "Carga rápida y estructura lista para aparecer en Google", "Contacto directo por WhatsApp, llamada o correo en un toque"],
    audit: "También le hacemos sin costo una auditoría de su sitio actual.",
    whatsapp: "Hablemos por WhatsApp",
    visit: "Conocer Hemeron",
    close: "Cerrar",
    message: `Hola, vi la propuesta de sitio web para ${name} (${url}) y me gustaría platicar.`,
  },
  en: {
    pill: "Demo site",
    talk: "Let's talk",
    eyebrow: "Website redesign proposal",
    title: `This is how the ${name} website could look`,
    body: "This is a demo site Hemeron prepared with your logo, your colors and the information you already publish. It is not your official website yet: forms don't send any data.",
    points: ["Modern design that adapts to phone, tablet and desktop", "Fast loading and a structure ready to show up on Google", "Direct contact by WhatsApp, phone or email in one tap"],
    audit: "We can also audit your current website for free.",
    whatsapp: "Let's talk on WhatsApp",
    visit: "Visit Hemeron",
    close: "Close",
    message: `Hi, I saw the website proposal for ${name} (${url}) and I'd like to talk.`,
  },
};
const t = COPY[lang];
const wa = `https://wa.me/${WHATSAPP}?text=${encodeURIComponent(t.message)}`;
---

<style>
  [data-demo-pill] {
    transition: opacity 0.5s var(--ease-out), translate 0.5s var(--ease-out);
    animation: pill-in 0.6s var(--ease-out) 1.2s both;
  }
  [data-demo-pill][data-hidden] {
    opacity: 0;
    translate: 0 10px;
    pointer-events: none;
    transition-duration: 0.2s;
  }
  @keyframes pill-in {
    from { opacity: 0; translate: 0 14px; }
  }
  @media (prefers-reduced-motion: reduce) {
    [data-demo-pill] { animation: none; }
  }
</style>

<div transition:persist="demo-badge" transition:name="demo-badge">
  <button
    type="button"
    data-demo-pill
    aria-haspopup="dialog"
    class="press fixed bottom-4 left-4 z-40 inline-flex h-11 items-center gap-2.5 rounded-full bg-[#0E0E0E] pl-3.5 pr-4 font-sans text-[13.5px] font-medium tracking-[-0.005em] text-white shadow-[0_10px_30px_-8px_rgba(0,0,0,0.45)] ring-1 ring-white/12 hover:bg-[#1c1c1c] sm:bottom-6 sm:left-6"
  >
    <span aria-hidden="true" class="size-2 rounded-full bg-[#3DDC84] shadow-[0_0_0_3px_rgba(61,220,132,0.18)]"></span>
    {t.pill}
    <span aria-hidden="true" class="h-3.5 w-px bg-white/20"></span>
    <span class="text-white/70">{t.talk}</span>
  </button>

  <dialog data-demo-dialog aria-labelledby="demo-dialog-title" class="demo-dialog">
    <div class="relative rounded-t-[28px] bg-white px-6 pb-[max(24px,env(safe-area-inset-bottom))] pt-6 text-[#141414] shadow-2xl sm:rounded-[24px] sm:p-8">
      <div aria-hidden="true" class="mx-auto -mt-2 mb-5 h-1 w-10 rounded-full bg-black/12 sm:hidden"></div>
      <div class="flex items-center justify-between">
        <HemeronLogo class="h-[18px] w-auto text-[#0E0E0E]" />
        <button type="button" data-demo-close aria-label={t.close} class="press -mr-2 grid size-9 place-items-center rounded-full text-black/50 hover:bg-black/5 hover:text-black">
          <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M2 2l10 10M12 2 2 12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path></svg>
        </button>
      </div>

      <p class="mt-7 font-mono text-[11.5px] uppercase tracking-[0.08em] text-black/45">{t.eyebrow}</p>
      <h2 id="demo-dialog-title" class="mt-2 text-balance font-sans text-[26px] font-semibold leading-[1.1] tracking-[-0.025em]">{t.title}</h2>
      <p class="mt-3 text-pretty text-[15px] leading-relaxed text-black/62">{t.body}</p>

      <ul class="mt-6 grid gap-3">
        {
          t.points.map((point) => (
            <li class="flex gap-3 text-[14.5px] leading-snug">
              <svg class="mt-0.5 size-[18px] shrink-0 text-[#1F9D5C]" viewBox="0 0 18 18" aria-hidden="true">
                <circle cx="9" cy="9" r="9" fill="currentColor" opacity="0.12"></circle>
                <path d="m5.5 9.2 2.3 2.3 4.7-4.9" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
              {point}
            </li>
          ))
        }
      </ul>

      <p class="mt-6 rounded-2xl bg-[#F4F4F1] px-4 py-3 text-[14px] leading-snug text-black/70">{t.audit}</p>

      <div class="mt-6 grid gap-2.5">
        <a href={wa} target="_blank" rel="noopener" class="press inline-flex h-12 items-center justify-center gap-2 rounded-full bg-[#0E0E0E] px-5 text-[15px] font-medium text-white hover:bg-[#262626]">
          <svg width="17" height="17" viewBox="0 0 16 16" aria-hidden="true">
            <path d="M2.5 13.5l.8-2.6A5.5 5.5 0 1 1 5.6 13l-3.1.5Z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"></path>
            <path d="M6 5.8c.1 1.6 1.6 3.4 3.4 3.9l.8-.8 1.2.6-.3 1c-2.6.2-5.3-2.4-5.3-5l1-.3.5 1.2-.8.8" fill="currentColor"></path>
          </svg>
          {t.whatsapp}
        </a>
        <a href="https://hemeron.com/" target="_blank" rel="noopener" class="press inline-flex h-12 items-center justify-center gap-1.5 rounded-full border border-black/15 px-5 text-[15px] font-medium hover:border-black/40">
          {t.visit}
          <svg width="13" height="13" viewBox="0 0 16 16" aria-hidden="true"><path d="M5 11 11 5M6 5h5v5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg>
        </a>
      </div>
    </div>
  </dialog>
</div>
