---
import "@/sites/ulvyn/theme.css";
import SiteLayout from "@/kit/SiteLayout.astro";
import PageHero from "@/kit/PageHero.astro";
import Section from "@/kit/Section.astro";
import ContactBlock from "@/kit/ContactBlock.astro";
import Composer from "@/kit/Composer.astro";
import { site } from "@/sites/ulvyn/site";
import { areas } from "@/sites/ulvyn/data";

const base = "/ulvyn";
---

<SiteLayout
  site={site}
  title="Contacto | ULVYN Abogados Digitales en IA"
  description="Ignacio L. Vallarta 1, 3er piso, colonia Tabacalera, Ciudad de México. WhatsApp 55 2177 8948 y correo contacto@ulvyn.com. Atención presencial o en línea."
  nav={{ variant: "bar", tone: "light", logoHeight: 38 }}
  footer={{ variant: "dark", blurb: "Human-AI Interaction Law" }}
  breadcrumbs={[{ name: "Contacto", href: `${base}/contacto` }]}
>
  <PageHero title="Contacto" lede="Agende su sesión estratégica, presencial o en línea." />
  <Section size="sm" class="pt-4">
    <div class="wrap grid gap-14 lg:grid-cols-2 lg:gap-24">
      <div data-reveal><ContactBlock site={site} /></div>
      <div data-reveal data-delay="120" class="rounded-(--c-radius-card) border border-(--c-line) bg-(--c-surface) p-6 sm:p-9">
        <Composer site={site} areas={areas.map((a) => a.title)} />
      </div>
    </div>
  </Section>
</SiteLayout>
