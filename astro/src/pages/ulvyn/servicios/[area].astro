---
import "@/sites/ulvyn/theme.css";
import SiteLayout from "@/kit/SiteLayout.astro";
import PageHero from "@/kit/PageHero.astro";
import Section from "@/kit/Section.astro";
import Icon from "@/kit/Icon.astro";
import CtaBand from "@/kit/CtaBand.astro";
import { site, waLink } from "@/sites/ulvyn/site";
import { areas, serviceSchema } from "@/sites/ulvyn/data";

export function getStaticPaths() {
  return areas.map((a) => ({ params: { area: a.key }, props: { area: a } }));
}
const { area } = Astro.props;
const base = "/ulvyn";
const others = areas.filter((a) => a.key !== area.key);
const wa = waLink(`${site.whatsapp.intro} sobre ${area.title}.`);
const h2 = "text-[clamp(1.6rem,2.8vw,2.3rem)] font-semibold leading-tight tracking-[-0.035em]";
---

<SiteLayout
  site={site}
  title={`${area.title}: consultoría preventiva y litigio estratégico | ULVYN`}
  description={area.lead}
  nav={{ variant: "bar", tone: "light", logoHeight: 38 }}
  footer={{ variant: "dark", blurb: "Human-AI Interaction Law" }}
  breadcrumbs={[{ name: "Servicios", href: `${base}/servicios` }, { name: area.title, href: `${base}/servicios/${area.key}` }]}
  schema={[serviceSchema(area, Astro.site)]}
>
  <PageHero title={area.title} lede={area.lead} transitionName={`area-${area.key}`} />
  {area.extra && <p class="wrap -mt-6 text-(--c-muted)">{area.extra}</p>}

  <Section size="sm" class="pt-10 sm:pt-14">
    <div class="wrap grid gap-4 lg:grid-cols-[1.15fr_0.85fr]">
      <div data-reveal class="rounded-(--c-radius-card) bg-(--c-brand) p-8 text-(--c-on-brand) sm:p-12">
        <div class="flex items-center gap-3"><Icon name="shield-check" class="size-6 text-(--c-spark)" /><h2 class={h2}>Consultoría preventiva</h2></div>
        <ul data-stagger data-gap="45" class="mt-9 grid gap-4 text-[17px]">
          {area.consult.map((t) => <li class="flex gap-3"><Icon name="check" weight="bold" class="mt-1.5 size-4 shrink-0 text-(--c-spark)" /><span>{t}</span></li>)}
        </ul>
      </div>
      <div data-reveal data-delay="100" class="rounded-(--c-radius-card) border border-(--c-line) bg-(--c-surface) p-8 sm:p-12">
        <div class="flex items-center gap-3"><Icon name="gavel" class="size-6 text-(--c-brand)" /><h2 class={h2}>Litigio estratégico</h2></div>
        <ul data-stagger data-gap="45" class="mt-9 grid gap-4 text-[17px]">
          {area.litigate.map((t) => <li class="flex gap-3"><Icon name="check" weight="bold" class="mt-1.5 size-4 shrink-0 text-(--c-brand)" /><span>{t}</span></li>)}
        </ul>
      </div>
    </div>
  </Section>

  <Section size="sm">
    <div class="wrap">
      <h2 data-reveal class={`${h2} mb-8`}>Otras áreas</h2>
      <ul data-stagger data-gap="60" class="grid gap-3 sm:grid-cols-3">
        {others.map((o) => (
          <li>
            <a href={`${base}/servicios/${o.key}`} class="group press flex h-full items-center justify-between gap-4 rounded-(--c-radius-card) border border-(--c-line) bg-(--c-bg) p-6 hover:border-(--c-brand)">
              <span class="flex items-center gap-4 font-medium"><Icon name={o.icon} class="size-6 text-(--c-brand)" />{o.title}</span>
              <Icon name="arrow-up-right" weight="bold" class="size-5 opacity-40 transition-opacity group-hover:opacity-100" />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </Section>

  <CtaBand title="Agende la consultoría" href={wa} label="Escribir por WhatsApp" tone="dark" external />
</SiteLayout>
