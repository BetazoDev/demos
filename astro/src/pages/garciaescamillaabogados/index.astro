---
import SiteLayout from "@/kit/SiteLayout.astro";
import Button from "@/kit/Button.astro";
import Section from "@/kit/Section.astro";
import Statement from "@/kit/Statement.astro";
import AreasIndex from "@/kit/AreasIndex.astro";
import ContactBlock from "@/kit/ContactBlock.astro";
import Composer from "@/kit/Composer.astro";
import Hero from "@/sites/garciaescamillaabogados/Hero.astro";
import Skin from "@/sites/garciaescamillaabogados/Skin.astro";
import { site } from "@/sites/garciaescamillaabogados/site";
import { areas, experience, experienceMore, consult } from "@/sites/garciaescamillaabogados/data";
import sillas from "@/sites/garciaescamillaabogados/assets/dos-sillas.jpg";

const base = "/garciaescamillaabogados";
const rows = areas.map((a) => ({ key: a.key, title: a.title, text: a.short, href: `${base}/servicios#${a.key}` }));
const wa = `https://wa.me/${site.whatsapp.number}?text=${encodeURIComponent(site.whatsapp.intro)}`;
---

<SiteLayout
  site={site}
  title="García & Escamilla Abogados | Abogados civiles, mercantiles, familiares y laborales en la Roma Norte, CDMX"
  nav={{ variant: "bar", tone: "light", logoHeight: 56 }}
  footer={{ variant: "dark", blurb: "Abogados especialistas y comprometidos con nuestros clientes." }}
>
  <Skin />
  <Hero title="Abogados especialistas y comprometidos con nuestros clientes" lede="Desde 2014, derecho civil, mercantil, familiar, laboral y penal." image={sillas} imageAlt="">
    <Fragment slot="actions">
      <Button href={wa} size="lg" external>Escribir por WhatsApp</Button>
      <Button href={`${base}/servicios`} variant="outline" size="lg">Ver servicios</Button>
    </Fragment>
  </Hero>

  <Section>
    <div class="wrap">
      <Statement text={experience} />
      <p data-reveal class="mt-12 max-w-[52ch] text-lg text-(--c-muted)">{experienceMore}</p>
    </div>
  </Section>

  <Section tone="surface" id="servicios">
    <div class="wrap">
      <h2 data-reveal class="mb-12 text-[clamp(2.2rem,4.8vw,4.2rem)] font-medium leading-[1.02] tracking-[-0.03em]">Servicios</h2>
      <AreasIndex areas={rows} />
    </div>
  </Section>

  <Section tone="brand">
    <div class="wrap grid items-end gap-10 lg:grid-cols-[auto_1fr] lg:gap-24">
      <p data-reveal class="text-[clamp(4.5rem,14vw,12rem)] font-medium leading-[0.9] tracking-[-0.05em] [font-family:var(--f-display)]">{consult.price}</p>
      <div data-reveal data-delay="100">
        <h2 class="text-[clamp(1.8rem,3.4vw,2.8rem)] font-medium leading-[1.05] tracking-[-0.02em]">{consult.title}</h2>
        <p class="mt-4 max-w-[40ch] text-lg text-white/85">{consult.detail}</p>
        <div class="mt-8"><Button href={wa} variant="light" size="lg" external>Escribir por WhatsApp</Button></div>
      </div>
    </div>
  </Section>

  <Section id="contacto">
    <div class="wrap grid gap-14 lg:grid-cols-2 lg:gap-24">
      <div data-reveal>
        <h2 class="mb-10 text-[clamp(2.2rem,4.8vw,4.2rem)] font-medium leading-[1.02] tracking-[-0.03em]">Contacto</h2>
        <ContactBlock site={site} showCta={false} />
      </div>
      <div data-reveal data-delay="120" class="border border-(--c-line) bg-(--c-surface) p-6 sm:p-9">
        <Composer site={site} areas={areas.map((a) => a.title)} />
      </div>
    </div>
  </Section>
</SiteLayout>
