---
import SiteLayout from "@/kit/SiteLayout.astro";
import PageHero from "@/kit/PageHero.astro";
import Section from "@/kit/Section.astro";
import Icon from "@/kit/Icon.astro";
import CtaBand from "@/kit/CtaBand.astro";
import Skin from "@/sites/gjarillo/Skin.astro";
import { site } from "@/sites/gjarillo/site";
import { areas } from "@/sites/gjarillo/data";

const base = "/gjarillo";
const wa = `https://wa.me/${site.whatsapp.number}?text=${encodeURIComponent(site.whatsapp.intro)}`;
const provider = { "@id": new URL(`/${site.slug}#organizacion`, Astro.site).href };
const schema = areas.map((a) => ({
  "@context": "https://schema.org",
  "@type": "Service",
  name: a.title,
  description: `${a.lead} ${a.groups.map((g) => g.items.join(", ")).join(". ")}.`,
  provider,
  areaServed: { "@type": "City", name: "Ciudad de México" },
}));
---

<SiteLayout
  site={site}
  title="Servicios | Gerardo Jarillo y Abogados, derecho laboral, civil y familiar en la CDMX"
  description="Derecho laboral para trabajadores y empresas, derecho civil y derecho familiar: despidos injustificados, contratos, divorcio, pensión alimenticia y sucesiones."
  nav={{ variant: "bar", tone: "light", logoHeight: 50 }}
  breadcrumbs={[{ name: "Servicios", href: `${base}/servicios` }]}
  schema={schema}
>
  <Skin />
  <PageHero title="Servicios" lede="Derecho laboral, civil y familiar para personas físicas y jurídicas." />

  {
    areas.map((a) => (
      <Section size="sm" id={a.key} class="scroll-mt-24 border-t border-(--c-line)">
        <div class="wrap grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:gap-20">
          <div data-reveal>
            <h2 transition:name={`area-${a.key}`} class="text-[clamp(2.2rem,4.8vw,4.2rem)] leading-[1.02] tracking-[-0.03em]">{a.title}</h2>
            <p class="mt-6 max-w-[40ch] text-lg text-(--c-muted)">{a.lead}</p>
          </div>
          <div data-stagger data-gap="70" class="grid content-start gap-x-10 gap-y-9 sm:grid-cols-2">
            {a.groups.map((g) => (
              <div class:list={[a.groups.length === 1 && "sm:col-span-2"]}>
                <h3 class="text-lg font-semibold tracking-[-0.01em] [font-family:var(--f-body)]">{g.title}</h3>
                <ul class:list={["mt-3 grid gap-2 text-[17px] text-(--c-muted)", a.groups.length === 1 && "sm:grid-cols-2 sm:gap-x-10"]}>
                  {g.items.map((i) => (
                    <li class="flex gap-3">
                      <Icon name="check" weight="bold" class="mt-1.5 size-4 shrink-0 text-(--c-brand)" />
                      <span>{i}</span>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </div>
      </Section>
    ))
  }

  <CtaBand title="Cuéntenos su caso" href={wa} label="Escribir por WhatsApp" tone="brand" external />
</SiteLayout>
