---
import SiteLayout from "@/kit/SiteLayout.astro";
import PageHero from "@/kit/PageHero.astro";
import Section from "@/kit/Section.astro";
import Icon from "@/kit/Icon.astro";
import CtaBand from "@/kit/CtaBand.astro";
import { site } from "@/sites/litemabogados/site";
import { areas, photos } from "@/sites/litemabogados/data";

export function getStaticPaths() {
  return areas.map((a) => ({ params: { area: a.key }, props: { area: a } }));
}
const { area } = Astro.props;
const base = "/litemabogados";
const others = areas.filter((a) => a.key !== area.key);
const wa = `https://wa.me/${site.whatsapp.number}?text=${encodeURIComponent(`${site.whatsapp.intro} sobre ${area.title.toLowerCase()}.`)}`;
const h2 = "text-[clamp(1.6rem,3vw,2.4rem)] font-semibold leading-tight tracking-[-0.025em]";
const image = area.key === "inmobiliarias" ? photos.maqueta : undefined;
const schema = [{ "@context": "https://schema.org", "@type": "Service", name: area.title, description: area.seo, provider: { "@id": `https://demos.diabolicalservices.tech/${site.slug}#organizacion` }, areaServed: { "@type": "City", name: "Ciudad de México" } }];
---

<SiteLayout site={site} bodyClass="[--c-radius-img:12px] [--c-radius-card:12px] [--c-radius-field:12px]" title={`${area.title} en la Ciudad de México | Lítem Abogados`} description={area.seo} schema={schema} nav={{ variant: "bar", tone: "light", logoHeight: 48 }} breadcrumbs={[{ name: "Servicios", href: `${base}/servicios` }, { name: area.title, href: `${base}/servicios/${area.key}` }]}>
  <PageHero title={area.title} lede={area.lead} transitionName={`area-${area.key}`} image={image} imageAlt="Maqueta de un edificio residencial sobre un escritorio" />
  <Section size="sm" class="pt-8 sm:pt-12">
    <div class="wrap grid gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:gap-20">
      <div data-reveal class="grid content-start gap-6 text-lg leading-relaxed text-(--c-muted)">
        {area.body?.map((p) => <p>{p}</p>)}
        {area.note && <p class="border-l-2 border-(--c-accent) pl-5 text-[16px]">{area.note}</p>}
      </div>
      <div>
        <h2 data-reveal class={`mb-8 ${h2}`}>{area.itemsTitle}</h2>
        <ul data-stagger data-gap="45" class:list={["grid gap-x-10 gap-y-5", area.items.length > 5 && "sm:grid-cols-2"]}>
          {area.items.map((i) => (
            <li class="flex gap-3 text-[17px] leading-snug">
              <Icon name="check" weight="bold" class="mt-1 size-4 shrink-0 text-(--c-accent)" />
              <span>{i}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </Section>
  <Section tone="surface" size="sm">
    <div class="wrap">
      <h2 data-reveal class={`mb-8 ${h2}`}>Otros servicios</h2>
      <ul data-stagger data-gap="45" class="flex flex-wrap gap-3">
        {others.map((o) => <li><a href={`${base}/servicios/${o.key}`} class="press inline-flex rounded-(--c-radius) border border-(--c-line) px-5 py-2.5 text-[15px] hover:border-(--c-accent) hover:text-(--c-accent)">{o.title}</a></li>)}
      </ul>
    </div>
  </Section>
  <CtaBand title="Cuéntenos su caso" href={wa} label="Escribir por WhatsApp" tone="brand" external />
</SiteLayout>
