---
import SiteLayout from "@/kit/SiteLayout.astro";
import PageHero from "@/kit/PageHero.astro";
import Section from "@/kit/Section.astro";
import AreasIndex from "@/kit/AreasIndex.astro";
import CtaBand from "@/kit/CtaBand.astro";
import { site } from "@/sites/litemabogados/site";
import { areas, otros } from "@/sites/litemabogados/data";

const base = "/litemabogados";
const rows = areas.map((a) => ({ key: a.key, title: a.title, text: a.lead, href: `${base}/servicios/${a.key}` }));
const wa = `https://wa.me/${site.whatsapp.number}?text=${encodeURIComponent(site.whatsapp.intro)}.`;
---

<SiteLayout site={site} bodyClass="[--c-radius-img:12px] [--c-radius-card:12px] [--c-radius-field:12px]" title="Servicios | Lítem Abogados, abogados en Polanco CDMX" description="Asuntos civiles, mercantiles y familiares, inversiones inmobiliarias, juicio de amparo y derecho penal. Abogados en Polanco, Ciudad de México." nav={{ variant: "bar", tone: "light", logoHeight: 48 }} breadcrumbs={[{ name: "Servicios", href: `${base}/servicios` }]}>
  <PageHero title="Servicios" lede="Servicios legales dirigidos a cualquier ciudadano o empresa, para prevenir y corregir situaciones legales adversas." />
  <Section size="sm" class="pt-4">
    <div class="wrap">
      <AreasIndex areas={rows} />
      <p data-reveal class="mt-8 text-[15px] text-(--c-muted)">También: {otros.join(", ").toLowerCase()}.</p>
    </div>
  </Section>
  <CtaBand title="Luchamos por nuestros clientes" href={wa} label="Escribir por WhatsApp" tone="brand" external />
</SiteLayout>
