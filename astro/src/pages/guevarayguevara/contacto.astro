---
import SiteLayout from "@/kit/SiteLayout.astro";
import Section from "@/kit/Section.astro";
import Composer from "@/kit/Composer.astro";
import GNav from "@/sites/guevarayguevara/GNav.astro";
import GPageHero from "@/sites/guevarayguevara/GPageHero.astro";
import GFooter from "@/sites/guevarayguevara/GFooter.astro";
import ContactInfo from "@/sites/guevarayguevara/ContactInfo.astro";
import { site } from "@/sites/guevarayguevara/site";
import { areas, photos } from "@/sites/guevarayguevara/data";

const base = "/guevarayguevara";
---

<SiteLayout
  site={site}
  title="Contacto | Guevara & Guevara Abogados, Zempoala 217, Narvarte, Ciudad de México"
  description="Zempoala 217, colonia Narvarte, Benito Juárez, Ciudad de México. Tels. 55 5211 0229 y 55 5286 5073. Sedes en León, Guadalajara, Colima y Celaya."
  nav={false}
  footer={false}
  breadcrumbs={[{ name: "Contacto", href: `${base}/contacto` }]}
>
  <GNav slot="nav" site={site} />

  <GPageHero title="Contacto" lede="Escríbanos por WhatsApp o llámenos. Con presencia en la Ciudad de México y casi todos los estados de la República." image={photos.fachada} imageAlt="Frontón y cornisa de una fachada neoclásica de piedra" position="28% 30%" />

  <Section size="sm" class="pt-10 sm:pt-14">
    <div class="wrap grid gap-14 lg:grid-cols-[1.05fr_0.95fr] lg:gap-24">
      <div data-reveal class="lg:order-first"><ContactInfo site={site} full /></div>
      <div data-reveal data-delay="120" class="order-first self-start border border-(--c-line) bg-(--c-surface) p-6 sm:p-9">
        <Composer site={site} areas={areas.map((a) => a.title)} />
      </div>
    </div>
  </Section>

  <GFooter slot="footer" site={site} />
</SiteLayout>
