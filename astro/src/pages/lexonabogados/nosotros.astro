---
import SiteLayout from "@/kit/SiteLayout.astro";
import PageHero from "@/kit/PageHero.astro";
import Section from "@/kit/Section.astro";
import CtaBand from "@/kit/CtaBand.astro";
import Icon from "@/kit/Icon.astro";
import Pic from "@/kit/Pic.astro";
import Skin from "@/sites/lexonabogados/Skin.astro";
import { site } from "@/sites/lexonabogados/site";
import { team, quienes, especialidadesDespacho, mision, vision } from "@/sites/lexonabogados/data";

const base = "/lexonabogados";
const wa = `https://wa.me/${site.whatsapp.number}?text=${encodeURIComponent(site.whatsapp.intro)}`;
---

<SiteLayout
  site={site}
  title="Nuestro despacho | Lexon Abogados, fundado en 2019 en Ciudad de México"
  description="Lexon Abogados, despacho jurídico fundado en 2019 en Ciudad de México, orientado a médicos privados, clínicas y consultorios. Conozca su misión, visión y a sus socios."
  nav={{ variant: "pill", tone: "light", logoHeight: 44 }}
  footer={{ variant: "light", blurb: "Abogados para la nueva realidad jurídica" }}
  breadcrumbs={[{ name: "Nuestro despacho", href: `${base}/nosotros` }]}
>
  <Skin />
  <PageHero title="Nuestro despacho" lede="Somos un despacho jurídico fundado en 2019 en la Ciudad de México." />

  <Section size="sm" class="pt-6">
    <div class="wrap grid gap-10 lg:grid-cols-[0.78fr_1.22fr] lg:gap-16">
      <h2 data-reveal class="text-[clamp(1.6rem,3vw,2.5rem)] leading-tight">Quién es Lexon Abogados</h2>
      <p data-reveal data-delay="80" class="max-w-[60ch] text-[clamp(1.15rem,1.7vw,1.5rem)] leading-snug">{quienes}</p>
    </div>
  </Section>

  <Section tone="surface" size="sm">
    <div class="wrap">
      <h2 data-reveal class="mb-10 text-[clamp(1.6rem,3vw,2.5rem)] leading-tight">Nuestras áreas de especialidad</h2>
      <ul data-stagger data-gap="90" class="grid gap-px border border-(--c-line) bg-(--c-line) md:grid-cols-3">
        {
          especialidadesDespacho.map((e) => (
            <li class="bg-(--c-surface) p-7 sm:p-9">
              <h3 class="text-[clamp(1.3rem,2vw,1.7rem)] leading-tight">{e.title}</h3>
              <p class="mt-4 max-w-[34ch] text-lg text-(--c-muted)">{e.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </Section>

  <Section>
    <div class="wrap grid gap-14 lg:grid-cols-2 lg:gap-24">
      <div data-reveal>
        <h2 class="text-[clamp(1.6rem,3vw,2.5rem)] leading-tight text-(--c-accent)">Misión</h2>
        <p class="mt-6 max-w-[56ch] text-lg leading-relaxed">{mision}</p>
      </div>
      <div data-reveal data-delay="120">
        <h2 class="text-[clamp(1.6rem,3vw,2.5rem)] leading-tight text-(--c-accent)">Visión</h2>
        <p class="mt-6 max-w-[56ch] text-lg leading-relaxed">{vision}</p>
      </div>
    </div>
  </Section>

  <Section tone="surface" id="equipo">
    <div class="wrap">
      <h2 data-reveal class="mb-16 text-[clamp(2rem,4.2vw,3.6rem)] leading-[1.04]">Nuestro equipo de abogados</h2>
      <ul class="grid gap-24">
        {
          team.map((p, i) => (
            <li class:list={["grid items-start gap-8 md:gap-16", i % 2 === 0 ? "md:grid-cols-[0.8fr_1.2fr]" : "md:grid-cols-[1.2fr_0.8fr]"]}>
              <div data-reveal="clip" class:list={["aspect-[4/5] overflow-hidden bg-(--c-bg)", i % 2 === 1 && "md:order-2"]}><Pic src={p.photo} alt={p.name} class="size-full object-cover" position="50% 20%" /></div>
              <div data-reveal class="md:py-6">
                <h3 class="text-[clamp(1.7rem,3vw,2.5rem)] leading-tight">{p.name}</h3>
                <p class="mt-2 font-medium text-(--c-accent)">{p.role}</p>
                {p.bio.map((b) => <p class="mt-5 max-w-[56ch] text-lg leading-relaxed text-(--c-muted)">{b}</p>)}
                {
                  p.studies && (
                    <div class="mt-8">
                      <h4 class="text-lg font-medium">Estudios</h4>
                      <ul class="mt-4 grid gap-3">
                        {p.studies.map((s) => <li class="flex gap-3 text-[17px]"><Icon name="check" weight="bold" class="mt-[0.4em] size-4 shrink-0 text-(--c-accent)" />{s}</li>)}
                      </ul>
                    </div>
                  )
                }
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </Section>
  <CtaBand title="Contamos con planes de protección jurídica para su clínica o consultorio." href={wa} label="Escribir por WhatsApp" tone="brand" external />
</SiteLayout>
