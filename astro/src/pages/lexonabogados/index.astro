---
import SiteLayout from "@/kit/SiteLayout.astro";
import Button from "@/kit/Button.astro";
import Section from "@/kit/Section.astro";
import ImageBand from "@/kit/ImageBand.astro";
import ContactBlock from "@/kit/ContactBlock.astro";
import Composer from "@/kit/Composer.astro";
import CtaBand from "@/kit/CtaBand.astro";
import Icon from "@/kit/Icon.astro";
import Pic from "@/kit/Pic.astro";
import Hero from "@/sites/lexonabogados/Hero.astro";
import Skin from "@/sites/lexonabogados/Skin.astro";
import { site } from "@/sites/lexonabogados/site";
import { areas, byKey, especialidades, photos, team, comparacion } from "@/sites/lexonabogados/data";

const base = "/lexonabogados";
const wa = `https://wa.me/${site.whatsapp.number}?text=${encodeURIComponent(site.whatsapp.intro)}`;
const cols = [comparacion.sanitario, comparacion.medico];
---

<SiteLayout
  site={site}
  title="Lexon Abogados | Derecho sanitario y defensa penal del médico en Ciudad de México"
  nav={{ variant: "pill", tone: "light", logoHeight: 44 }}
  footer={{ variant: "light", blurb: "Abogados para la nueva realidad jurídica" }}
>
  <Skin />
  <Hero title="Derecho sanitario y defensa penal del médico" lede="Bufete de abogados en Ciudad de México. Asesoría legal contra denuncias, demandas y multas de COFEPRIS." image={photos.hero} imageAlt="Pasillo luminoso de una clínica con una pared azul marino y una lámpara de bronce" position="50% 55%">
    <Fragment slot="actions">
      <Button href={wa} variant="solid" size="lg" external>Escribir por WhatsApp</Button>
      <Button href={`${base}/servicios`} variant="outline" size="lg">Ver servicios</Button>
    </Fragment>
  </Hero>

  <Section>
    <div class="wrap">
      <p data-statement class="max-w-[24ch] font-(family-name:--f-display) text-[clamp(1.9rem,4.3vw,3.9rem)] font-medium leading-[1.12] tracking-[-0.02em] sm:max-w-[26ch]">Deje que los abogados de Lexon garanticen su tranquilidad en la práctica de la medicina.</p>
      <div data-reveal class="mt-10 grid gap-8 md:grid-cols-[1fr_auto] md:items-end">
        <p class="max-w-[52ch] text-lg text-(--c-muted) sm:text-xl">Somos un despacho jurídico fundado en 2019 en la Ciudad de México. Nuestros servicios están orientados hacia médicos privados, clínicas y consultorios.</p>
        <Button href={`${base}/nosotros`} variant="outline">Conocer el despacho</Button>
      </div>
    </div>
  </Section>

  <Section tone="surface" id="especialidades">
    <div class="wrap">
      <h2 data-reveal transition:name="servicios-title" class="mb-12 max-w-[20ch] text-[clamp(2rem,4.2vw,3.6rem)] leading-[1.04]">Lexon Abogados, somos especialistas en</h2>
      <ul data-stagger data-gap="60" class="grid grid-cols-2 gap-px border border-(--c-line) bg-(--c-line) lg:grid-cols-4">
        {
          especialidades.map((e) => {
            const a = byKey(e.key);
            return (
              <li class="bg-(--c-surface)">
                <a href={`${base}/servicios/${a.key}`} class="lx-tile flex h-full min-h-[11.5rem] flex-col justify-between gap-8 p-4 sm:min-h-[14rem] sm:gap-10 sm:p-7">
                  <Icon name={a.icon} class="lx-ic size-9" />
                  <span class="flex items-end justify-between gap-2 sm:gap-4">
                    <h3 transition:name={`area-${a.key}`} class="text-[clamp(1rem,1.5vw,1.3rem)] font-medium leading-[1.2] tracking-[-0.02em]">{e.label}</h3>
                    <Icon name="arrow-up-right" weight="bold" class="lx-go size-5 shrink-0" />
                  </span>
                </a>
              </li>
            );
          })
        }
      </ul>
      <div data-reveal class="mt-10"><Button href={`${base}/servicios`} variant="outline">Ver los {areas.length} servicios</Button></div>
    </div>
  </Section>

  <Section tone="dark" id="derecho-sanitario-y-medico">
    <div class="wrap">
      <h2 data-reveal class="max-w-[24ch] text-[clamp(1.9rem,3.8vw,3.3rem)] leading-[1.08]">Derecho sanitario y derecho médico</h2>
      <p data-reveal data-delay="80" class="mt-6 max-w-[60ch] text-lg text-(--c-on-dark)/75 sm:text-xl">En nuestro despacho nos especializamos en dos áreas clave del derecho que, aunque relacionadas, tienen enfoques y aplicaciones distintas.</p>
      <div class="mt-16 grid gap-16 lg:grid-cols-2 lg:gap-0">
        {
          cols.map((c, i) => (
            <div data-reveal data-delay={i * 120} class:list={[i === 0 ? "lg:pr-14" : "lg:border-l lg:border-(--c-on-dark)/20 lg:pl-14"]}>
              <h3 class="text-[clamp(1.5rem,2.4vw,2.1rem)] leading-tight text-(--lx-bronze-light)">{c.title}</h3>
              <p class="mt-4 max-w-[52ch] text-lg text-(--c-on-dark)/75">{c.intro}</p>
              <ul class="mt-10 grid gap-7">
                {c.items.map((it) => (
                  <li>
                    <p class="text-lg font-medium">{it.h}</p>
                    <p class="mt-1.5 max-w-[56ch] text-[16px] leading-relaxed text-(--c-on-dark)/70">{it.d}</p>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
      <div data-reveal class="mt-20 grid gap-6 border-t border-(--c-on-dark)/20 pt-10 md:grid-cols-2 md:gap-14">
        {comparacion.diferencia.map((d) => <p class="max-w-[52ch] text-lg leading-relaxed">{d}</p>)}
      </div>
    </div>
  </Section>

  <ImageBand image={photos.banda} alt="Mazo de juez y estetoscopio sobre un escritorio de nogal, junto a una carpeta azul marino y una pluma" position="50% 55%" height="clamp(17rem,40vw,30rem)" />

  <Section id="equipo">
    <div class="wrap">
      <h2 data-reveal class="mb-16 text-[clamp(2rem,4.2vw,3.6rem)] leading-[1.04]">Nuestro equipo de abogados</h2>
      <ul class="grid gap-14 md:grid-cols-2 md:gap-10 lg:gap-20">
        {
          team.map((p, i) => (
            <li class:list={[i === 1 && "md:mt-24"]}>
              <div data-reveal="clip" class="aspect-[4/5] overflow-hidden bg-(--c-surface)"><Pic src={p.photo} alt={p.name} class="size-full object-cover" position="50% 20%" /></div>
              <div data-reveal data-delay="80" class="mt-6">
                <h3 class="text-[clamp(1.4rem,2.2vw,1.9rem)] leading-tight">{p.name}</h3>
                <p class="mt-1 text-(--c-accent) font-medium">{p.role}</p>
                <p class="mt-4 max-w-[46ch] text-lg text-(--c-muted)">{p.short}</p>
              </div>
            </li>
          ))
        }
      </ul>
      <div data-reveal class="mt-14"><Button href={`${base}/nosotros#equipo`} variant="outline">Conocer su trayectoria</Button></div>
    </div>
  </Section>

  <Section tone="surface" id="contacto">
    <div class="wrap grid gap-14 lg:grid-cols-[1fr_1fr] lg:gap-24">
      <div data-reveal>
        <h2 class="mb-10 text-[clamp(2rem,4.2vw,3.6rem)] leading-[1.04]">Contacto</h2>
        <ContactBlock site={site} showCta={false} />
      </div>
      <div data-reveal data-delay="120" class="border border-(--c-line) bg-(--c-bg) p-6 sm:p-9">
        <Composer site={site} areas={areas.map((a) => a.title)} />
      </div>
    </div>
  </Section>

  <CtaBand title="Contamos con planes de protección jurídica para su clínica o consultorio." href={wa} label="Escribir por WhatsApp" tone="brand" external />
</SiteLayout>
