---
import "@/sites/lexcivitasabogados/theme.css";
import SiteLayout from "@/kit/SiteLayout.astro";
import PageHero from "@/kit/PageHero.astro";
import Section from "@/kit/Section.astro";
import Pic from "@/kit/Pic.astro";
import CtaBand from "@/kit/CtaBand.astro";
import Timeline from "@/sites/lexcivitasabogados/Timeline.astro";
import Footer from "@/sites/lexcivitasabogados/Footer.astro";
import { site, waLink } from "@/sites/lexcivitasabogados/site";
import { quienes, mision, vision, historia, fundadores, valores } from "@/sites/lexcivitasabogados/data";
import libros from "@/sites/lexcivitasabogados/assets/libros.jpg";
import escudo from "@/sites/lexcivitasabogados/assets/escudo-claro.png";

const base = "/lexcivitasabogados";
const h2 = "font-medium leading-[1.04] tracking-[-0.025em] text-[clamp(1.9rem,3.6vw,3rem)]";
---

<SiteLayout
  site={site}
  title="Nosotros | Lex Civitas Abogados"
  description="Sociedad constituida en abril de 2021 que desde el 1 de enero de 2022 es Lex Civitas Abogados, bufete integral con medios alternativos de solución."
  nav={{ variant: "pill", tone: "dark", logoHeight: 50 }}
  footer={false}
  breadcrumbs={[{ name: "Nosotros", href: `${base}/nosotros` }]}
>
  <PageHero title="Nosotros" tone="dark" />

  <Section size="sm" class="pt-4">
    <div class="wrap grid items-start gap-12 lg:grid-cols-[0.55fr_1.45fr] lg:gap-24">
      <div data-reveal class="mx-auto w-full max-w-[16rem] lg:mx-0 lg:sticky lg:top-28">
        <Pic src={escudo} alt="Escudo de Lex Civitas Abogados con búho, balanza, mazo, libro y la leyenda Iustitia in lege est" fill={false} class="h-auto w-full" />
      </div>
      <p data-reveal data-delay="100" class="max-w-[34ch] font-(family-name:--f-display) text-[clamp(1.6rem,3vw,2.6rem)] leading-[1.18] tracking-[-0.015em]">{quienes}</p>
    </div>
  </Section>

  <Section tone="surface">
    <div class="wrap grid gap-14 lg:grid-cols-[0.7fr_1.3fr] lg:gap-24">
      <h2 data-reveal class={`${h2} lg:sticky lg:top-28 lg:self-start`}>Historia</h2>
      <Timeline items={historia} />
    </div>
  </Section>

  <Section>
    <div class="wrap grid gap-14 md:grid-cols-2 md:gap-20">
      <div data-reveal>
        <h2 class={h2}>Misión</h2>
        <p class="mt-6 max-w-[44ch] text-lg text-(--c-muted)">{mision}</p>
      </div>
      <div data-reveal data-delay="100">
        <h2 class={h2}>Visión</h2>
        <p class="mt-6 max-w-[44ch] text-lg text-(--c-muted)">{vision}</p>
      </div>
    </div>
  </Section>

  <div class="relative isolate h-[clamp(14rem,34vw,28rem)] overflow-hidden bg-(--c-dark)">
    <div class="absolute inset-0 -z-10" data-parallax="50"><Pic src={libros} alt="Lomos de libros antiguos de derecho encuadernados en piel, en blanco y negro" position="50% 50%" class="size-full object-cover" /></div>
  </div>

  <Section>
    <div class="wrap grid gap-14 lg:grid-cols-[0.7fr_1.3fr] lg:gap-24">
      <h2 data-reveal class={h2}>Fundadores de la sociedad original</h2>
      <ul data-stagger data-gap="80" class="grid gap-x-10 gap-y-10 sm:grid-cols-2">
        {fundadores.map((p) => (
          <li>
            <h3 class="font-(family-name:--f-display) text-[clamp(1.5rem,2.4vw,2rem)] leading-tight tracking-[-0.015em]">{p.name}</h3>
            <p class="mt-2 text-(--c-muted)">{p.role}</p>
          </li>
        ))}
      </ul>
    </div>
  </Section>

  <Section tone="surface" size="sm">
    <div class="wrap">
      <h2 data-reveal class="mb-8 text-2xl font-medium tracking-[-0.01em]">Valores</h2>
      <ul data-stagger data-gap="50" class="flex flex-wrap gap-3">
        {valores.map((v) => <li class="rounded-(--c-radius) border border-(--c-line) px-5 py-2.5 text-lg">{v}</li>)}
      </ul>
    </div>
  </Section>

  <CtaBand title="Hablemos de su caso" href={waLink()} label="Escribir por WhatsApp" tone="brand" external />
  <Footer slot="footer" site={site} variant="dark" blurb="Iustitia in lege est. En el derecho está la justicia." />
</SiteLayout>
