---
import Layout from "@/sites/garciaasociadoslaw/Layout.astro";
import Hero from "@/sites/garciaasociadoslaw/Hero.astro";
import GoldFrame from "@/sites/garciaasociadoslaw/GoldFrame.astro";
import Button from "@/kit/Button.astro";
import Section from "@/kit/Section.astro";
import Statement from "@/kit/Statement.astro";
import Icon from "@/kit/Icon.astro";
import ImageBand from "@/kit/ImageBand.astro";
import ContactBlock from "@/kit/ContactBlock.astro";
import Composer from "@/kit/Composer.astro";
import CtaBand from "@/kit/CtaBand.astro";
import { site } from "@/sites/garciaasociadoslaw/site";
import { areas, principios, photos } from "@/sites/garciaasociadoslaw/data";

const base = "/garciaasociadoslaw";
const wa = `https://wa.me/${site.whatsapp.number}?text=${encodeURIComponent(site.whatsapp.intro)}`;
---

<Layout site={site} title="García & Asociados | Abogados en Ciudad de México y Quintana Roo" description="Despacho jurídico con presencia en Ciudad de México y Quintana Roo, especializado en derecho penal, laboral, civil, mercantil y familiar. Soluciones legales, resultados reales.">
  <Hero title="Soluciones legales. Resultados reales" lede="Despacho jurídico con presencia en Ciudad de México y Quintana Roo, especializado en derecho penal, laboral, civil, mercantil y familiar." image={photos.columnas} imageAlt="Una sala de columnas altas con un haz de luz dorada sobre el piso" position="50% 55%">
    <Fragment slot="actions">
      <Button href={wa} variant="solid" size="lg" external>Escribir por WhatsApp</Button>
      <Button href={`${base}/servicios`} variant="outline" size="lg">Ver servicios</Button>
    </Fragment>
  </Hero>

  <Section>
    <div class="wrap"><Statement class="max-w-[30ch] text-[clamp(1.7rem,3.6vw,3.2rem)] sm:max-w-[36ch]" text="Brindamos representación legal estratégica a personas físicas, empresas y organizaciones con un enfoque profesional, ético y orientado a resultados." /></div>
  </Section>

  <Section tone="surface" id="servicios">
    <div class="wrap">
      <h2 data-reveal class="mb-10 text-[clamp(2rem,4.4vw,3.6rem)] leading-none">Servicios</h2>
      <ul data-stagger data-gap="70" class="grid gap-1">
        {areas.map((a) => (
          <li>
            <a href={`${base}/servicios#${a.key}`} class="group grid items-center gap-3 py-6 sm:grid-cols-[minmax(0,1fr)_minmax(0,1fr)_auto] sm:gap-10 sm:py-7">
              <h3 transition:name={`area-${a.key}`} class="text-[clamp(1.8rem,3.4vw,3rem)] leading-[1.1] transition-transform duration-500 ease-(--ease-out) group-hover:translate-x-2">{a.title}</h3>
              <p class="max-w-[46ch] text-[15px] leading-relaxed text-(--c-muted) sm:text-base">{a.text}</p>
              <span class="arr hidden size-12 place-items-center rounded-full border border-current/25 transition-[background-color,color,border-color] duration-300 group-hover:border-transparent group-hover:bg-(--c-accent) group-hover:text-(--c-on-accent) sm:grid">
                <Icon name="arrow-up-right" weight="bold" class="size-5" />
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </Section>

  <ImageBand image={photos.ciudad} alt="Rascacielos iluminados al caer la tarde sobre una avenida" position="50% 60%">
    <div class="relative">
      <div aria-hidden="true" class="pointer-events-none absolute -bottom-10 -left-[50vw] -top-40 -z-10 w-[calc(50vw+120%)] bg-[linear-gradient(to_right,rgb(1_8_32/0.82),rgb(1_8_32/0.5)_60%,transparent)]"></div>
      <p data-reveal class="max-w-[22ch] text-[clamp(1.7rem,3.8vw,3.4rem)] leading-[1.1] [font-family:var(--f-display)]">Presencia en Ciudad de México y Quintana Roo</p>
    </div>
  </ImageBand>

  <Section>
    <div class="wrap grid items-center gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:gap-24">
      <div data-reveal>
        <h2 class="text-[clamp(2rem,4.4vw,3.6rem)] leading-none">Principios</h2>
        <p class="mt-6 max-w-[44ch] text-lg leading-relaxed text-(--c-muted)">García &amp; Asociados nace con el compromiso de brindar servicios jurídicos de alto nivel, combinando experiencia, preparación y atención personalizada para cada uno de nuestros clientes.</p>
      </div>
      <GoldFrame class="p-8 sm:p-12">
        <ul class="grid gap-y-5">
          {principios.map((p) => <li class="text-[clamp(1.5rem,2.8vw,2.4rem)] leading-tight [font-family:var(--f-display)]">{p}</li>)}
        </ul>
      </GoldFrame>
    </div>
  </Section>

  <Section tone="surface" id="contacto">
    <div class="wrap grid gap-14 lg:grid-cols-2 lg:gap-24">
      <div data-reveal>
        <h2 class="mb-10 text-[clamp(2rem,4.4vw,3.6rem)] leading-none">Contacto</h2>
        <ContactBlock site={site} showCta={false} />
      </div>
      <div data-reveal data-delay="120" class="border border-(--c-line) bg-(--c-bg) p-6 sm:p-9">
        <Composer site={site} areas={areas.map((a) => `Derecho ${a.title.toLowerCase()}`)} />
      </div>
    </div>
  </Section>

  <CtaBand title="Soluciones legales para su caso" href={wa} label="Escribir por WhatsApp" tone="brand" external />
</Layout>
