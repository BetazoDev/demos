---
import SiteLayout from "@/kit/SiteLayout.astro";
import PageHero from "@/kit/PageHero.astro";
import Section from "@/kit/Section.astro";
import Icon from "@/kit/Icon.astro";
import CtaBand from "@/kit/CtaBand.astro";
import Skin from "@/sites/hidalgoabogados/Skin.astro";
import { site } from "@/sites/hidalgoabogados/site";
import { firm, method, lawyer } from "@/sites/hidalgoabogados/data";

const base = "/hidalgoabogados";
const wa = `https://wa.me/${site.whatsapp.number}?text=${encodeURIComponent(site.whatsapp.intro)}`;
---

<SiteLayout
  site={site}
  title="La firma | Hidalgo Abogados, firma penalista fundada en 1999"
  description="Firma fundada en 1999 con más de 20 años de experiencia, trayectoria académica y trato personal. Conozca al Mtro. Gabriel Hidalgo Pastor, especialista en materia penal."
  nav={{ variant: "pill", tone: "light" }}
  breadcrumbs={[{ name: "La firma", href: `${base}/nosotros` }]}
>
  <Skin />
  <PageHero title="La firma" lede="Más de 20 años de experiencia, trayectoria académica y trato personal." />
  <Section size="sm" class="pt-4">
    <div class="wrap grid gap-10 lg:grid-cols-[1fr_1fr] lg:gap-24">
      <div data-reveal class="space-y-6 text-lg text-(--c-muted)">
        {firm.map((p) => <p>{p}</p>)}
      </div>
      <p data-reveal data-delay="100" class="max-w-[30ch] text-[clamp(1.6rem,2.8vw,2.4rem)] leading-snug [font-family:var(--f-display)]">{method}</p>
    </div>
  </Section>
  <Section tone="surface">
    <div class="wrap grid gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:gap-24">
      <div data-reveal class="lg:sticky lg:top-28 lg:self-start">
        <h2 class="text-[clamp(2.2rem,4.4vw,3.8rem)] leading-[1.04] tracking-[-0.02em]">{lawyer.name}</h2>
        <p class="mt-5 max-w-[44ch] text-lg text-(--c-muted)">{lawyer.role}</p>
      </div>
      <ul data-stagger data-gap="70" class="grid content-start gap-4 text-lg">
        {lawyer.education.map((e) => (
          <li class="flex gap-3">
            <Icon name="check" weight="bold" class="mt-2 size-4 shrink-0 text-(--c-brand)" />
            <span>{e}</span>
          </li>
        ))}
      </ul>
    </div>
  </Section>
  <CtaBand title="Hablemos de su caso" href={wa} label="Escribir por WhatsApp" tone="brand" external />
</SiteLayout>
