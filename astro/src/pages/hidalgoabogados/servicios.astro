---
import SiteLayout from "@/kit/SiteLayout.astro";
import PageHero from "@/kit/PageHero.astro";
import Section from "@/kit/Section.astro";
import CtaBand from "@/kit/CtaBand.astro";
import Skin from "@/sites/hidalgoabogados/Skin.astro";
import { site } from "@/sites/hidalgoabogados/site";
import { areas, precedents } from "@/sites/hidalgoabogados/data";

const base = "/hidalgoabogados";
const wa = `https://wa.me/${site.whatsapp.number}?text=${encodeURIComponent(site.whatsapp.intro)}`;
const provider = { "@id": new URL(`/${site.slug}#organizacion`, Astro.site).href };
const schema = areas.map((a) => ({
  "@context": "https://schema.org",
  "@type": "Service",
  name: a.title,
  description: a.text,
  provider,
  areaServed: { "@type": "City", name: "Ciudad de México" },
}));
---

<SiteLayout
  site={site}
  title="Servicios | Hidalgo Abogados, defensa penal, asesoría a víctimas y criminal compliance"
  description="Defensa de personas investigadas, asesoría jurídica de víctimas, criminal compliance, ejecución de sanciones penales y consultoría en la Ciudad de México."
  nav={{ variant: "pill", tone: "light" }}
  breadcrumbs={[{ name: "Servicios", href: `${base}/servicios` }]}
  schema={schema}
>
  <Skin />
  <PageHero title="Servicios" lede="Defensa y asesoría jurídica en las distintas etapas del procedimiento penal, y construcción de acuerdos." />
  <Section size="sm" class="pt-4">
    <div class="wrap">
      <ul data-stagger data-gap="80" class="grid gap-5 md:grid-cols-2">
        {
          areas.map((a, i) => (
            <li id={a.key} class:list={["scroll-mt-28", (i === 0 || i === areas.length - 1) && "md:col-span-2"]}>
              <article class:list={["h-full rounded-(--c-radius-card,6px) p-7 sm:p-10", i === 0 ? "bg-(--c-brand) text-(--c-on-brand)" : i === areas.length - 1 ? "bg-(--c-accent) text-(--c-on-accent)" : "bg-(--c-surface)"]}>
                <h2 transition:name={`area-${a.key}`} class:list={["text-[clamp(1.7rem,3vw,2.6rem)] leading-[1.08] tracking-[-0.015em]", i === 0 && "max-w-[22ch] md:text-[clamp(2.2rem,4vw,3.4rem)]", i === areas.length - 1 && "max-w-[24ch]"]}>{a.title}</h2>
                <p class:list={["mt-5 max-w-[52ch] text-lg leading-relaxed", i === 0 ? "text-white/85" : i === areas.length - 1 ? "text-(--c-on-accent)" : "text-(--c-muted)"]}>{a.text}</p>
              </article>
            </li>
          ))
        }
      </ul>
    </div>
  </Section>
  <Section tone="surface" size="sm">
    <div class="wrap">
      <p data-reveal class="max-w-[34ch] text-[clamp(1.5rem,2.6vw,2.3rem)] leading-snug [font-family:var(--f-display)]">{precedents}</p>
    </div>
  </Section>
  <CtaBand title="Cuéntenos su caso" href={wa} label="Escribir por WhatsApp" tone="brand" external />
</SiteLayout>
