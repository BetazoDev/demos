---
import Layout from "@/sites/gardunomonterde/Layout.astro";
import PageHero from "@/kit/PageHero.astro";
import Section from "@/kit/Section.astro";
import ContactBlock from "@/kit/ContactBlock.astro";
import Composer from "@/kit/Composer.astro";
import { site } from "@/sites/gardunomonterde/site";
import { areas } from "@/sites/gardunomonterde/data";

const base = "/gardunomonterde";
---

<Layout
  title="Contacto | Garduño Monterde Asociados"
  description="Avenida Insurgentes Centro 132, Despacho 305, colonia Tabacalera, Ciudad de México. WhatsApp 55 2201 7493."
  breadcrumbs={[{ name: "Contacto", href: `${base}/contacto` }]}
>
  <PageHero title="Contacto" lede="Escríbanos por WhatsApp o visítenos en la colonia Tabacalera, Alcaldía Cuauhtémoc." />
  <Section size="sm" class="pt-4">
    <div class="wrap grid gap-14 lg:grid-cols-2 lg:gap-24">
      <div data-reveal><ContactBlock site={site} /></div>
      <div data-reveal data-delay="120" class="rounded-[1.5rem] border border-(--c-line) bg-(--c-surface) p-6 sm:p-9">
        <Composer site={site} areas={areas.map((a) => a.title)} />
      </div>
    </div>
  </Section>
</Layout>
