---
import Layout from "@/sites/gardunomonterde/Layout.astro";
import PageHero from "@/kit/PageHero.astro";
import Section from "@/kit/Section.astro";
import CtaBand from "@/kit/CtaBand.astro";
import AreaAccordion from "@/sites/gardunomonterde/AreaAccordion.astro";
import { site } from "@/sites/gardunomonterde/site";
import { areas } from "@/sites/gardunomonterde/data";

const base = "/gardunomonterde";
const wa = `https://wa.me/${site.whatsapp.number}?text=${encodeURIComponent(site.whatsapp.intro + ".")}`;
const waArea = (a: { title: string }) => `https://wa.me/${site.whatsapp.number}?text=${encodeURIComponent(`${site.whatsapp.intro} sobre ${a.title.toLowerCase()}.`)}`;
const service = areas.map((a) => ({
  "@context": "https://schema.org",
  "@type": "Service",
  name: a.title,
  description: a.lead,
  provider: { "@id": new URL(`${base}#organizacion`, Astro.site!).href },
  areaServed: { "@type": "City", name: "Ciudad de México" },
}));
---

<Layout
  title="Servicios penales en la Ciudad de México | Garduño Monterde Asociados"
  description="Amparo penal, proceso penal, representación jurídica, atención a víctimas del delito, procedimientos administrativos y consultoría. Abogados penalistas en la Ciudad de México."
  breadcrumbs={[{ name: "Servicios", href: `${base}/servicios` }]}
  schema={service}
>
  <PageHero title="Servicios" lede="Asesoría legal y representación jurídica integral, informándole de todos y cada uno de sus derechos humanos reconocidos en la Constitución, Leyes y Tratados Internacionales." />
  <Section size="sm" class="pt-4">
    <div class="wrap"><AreaAccordion areas={areas} waHref={waArea} first /></div>
  </Section>
  <CtaBand title="Cuéntenos su caso" href={wa} label="Escribir por WhatsApp" tone="surface" external />
</Layout>
