---
import Layout from "@/sites/gardunomonterde/Layout.astro";
import PageHero from "@/kit/PageHero.astro";
import Section from "@/kit/Section.astro";
import CtaBand from "@/kit/CtaBand.astro";
import { site } from "@/sites/gardunomonterde/site";
import { partners, photos } from "@/sites/gardunomonterde/data";

const base = "/gardunomonterde";
const wa = `https://wa.me/${site.whatsapp.number}?text=${encodeURIComponent(site.whatsapp.intro + ".")}`;
const slug = (s: string) => s.normalize("NFD").replace(/[̀-ͯ]/g, "").toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, "");
---

<Layout
  title="Socios fundadores | Garduño Monterde Asociados"
  description="Roberto Carlos Garduño Mejía y Euquenee Aimme Monterde Valero, socios fundadores de Garduño Monterde Asociados, abogados penalistas en la Ciudad de México."
  breadcrumbs={[{ name: "Socios fundadores", href: `${base}/nosotros` }]}
>
  <PageHero title="Socios fundadores" lede="Nuestra experiencia y conocimiento nos permite plantear y aplicar estrategias legales de litigación idóneas a casos particulares." image={photos.sala} imageAlt="Sala de audiencias vacía con bancas de madera" />
  <Section>
    <div class="wrap grid gap-20 sm:gap-28">
      {
        partners.map((p) => (
          <article id={slug(p.name)} class="grid scroll-mt-28 gap-8 lg:grid-cols-[0.9fr_1.1fr] lg:gap-20">
            <header data-reveal class="lg:sticky lg:top-28 lg:self-start">
              <h2 class="text-[clamp(1.9rem,3.6vw,3.2rem)] leading-[1.08]">{p.name}</h2>
              <p class="mt-3 text-lg text-(--c-muted)">{p.role}</p>
            </header>
            <div data-stagger data-gap="70" class="grid gap-5 text-lg leading-relaxed">
              {p.bio.map((line) => <p>{line}</p>)}
            </div>
          </article>
        ))
      }
    </div>
  </Section>
  <CtaBand title="Cuéntenos su caso" href={wa} label="Escribir por WhatsApp" tone="surface" external />
</Layout>
