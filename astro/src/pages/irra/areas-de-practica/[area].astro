---
import Layout from "@/sites/irra/Layout.astro";
import PageHero from "@/kit/PageHero.astro";
import Section from "@/kit/Section.astro";
import Icon from "@/kit/Icon.astro";
import CtaBand from "@/kit/CtaBand.astro";
import { site } from "@/sites/irra/site";
import { areas } from "@/sites/irra/areas";

export function getStaticPaths() {
  return areas.map((a) => ({ params: { area: a.key }, props: { area: a } }));
}
const { area } = Astro.props;
const base = "/irra";
const others = areas.filter((a) => a.key !== area.key);
const wa = `https://wa.me/${site.whatsapp.number}?text=${encodeURIComponent(`${site.whatsapp.intro} sobre ${area.title.toLowerCase()}.`)}`;
const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    name: area.title,
    description: area.lead,
    provider: { "@id": new URL(`${base}#organizacion`, Astro.site).href },
    areaServed: { "@type": "Country", name: "México" },
  },
];
---

<Layout site={site} title={`${area.title} | Irra Ibarra, firma de abogados en la Ciudad de México`} description={area.lead} schema={schema} breadcrumbs={[{ name: "Áreas de práctica", href: `${base}/areas-de-practica` }, { name: area.title, href: `${base}/areas-de-practica/${area.key}` }]}>
  <PageHero title={area.title} lede={area.lead} transitionName={`area-${area.key}`} />
  {
    area.items && (
      <Section size="sm" class="pt-4">
        <div class="wrap grid gap-10 lg:grid-cols-[0.7fr_1.3fr] lg:gap-20">
          <h2 data-reveal class="text-[clamp(1.5rem,2.6vw,2.2rem)] font-bold leading-tight tracking-[-0.025em]">{area.itemsTitle}</h2>
          <div>
            <ul data-stagger data-gap="45" class="grid gap-x-12 gap-y-4 sm:grid-cols-2">
              {area.items.map((i) => (
                <li class="flex gap-3 text-lg leading-snug">
                  <Icon name="check" weight="bold" class="mt-1.5 size-4 shrink-0 text-(--c-accent)" />
                  <span>{i}</span>
                </li>
              ))}
            </ul>
            {area.note && <p data-reveal class="mt-10 max-w-[52ch] text-(--c-muted)">{area.note}</p>}
          </div>
        </div>
      </Section>
    )
  }
  <Section tone="surface" size="sm">
    <div class="wrap">
      <h2 data-reveal class="mb-8 text-[clamp(1.5rem,2.6vw,2.2rem)] font-bold leading-tight tracking-[-0.025em]">Otras áreas de práctica</h2>
      <ul data-stagger data-gap="30" class="flex flex-wrap gap-2.5">
        {others.map((o) => <li><a href={`${base}/areas-de-practica/${o.key}`} class="press inline-flex border border-(--c-line) bg-(--c-bg) px-4 py-2.5 text-[15px] hover:border-(--c-accent) hover:text-(--c-accent)">{o.title}</a></li>)}
      </ul>
    </div>
  </Section>
  <CtaBand title="Soluciones jurídicas prácticas para los complejos retos de los negocios actuales" href={wa} label="Escribir por WhatsApp" tone="brand" external />
</Layout>
