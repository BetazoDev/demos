---
import Layout from "@/sites/irra/Layout.astro";
import Hero from "@/sites/irra/Hero.astro";
import Muro from "@/sites/irra/Muro.astro";
import Band from "@/sites/irra/Band.astro";
import Tira from "@/sites/irra/Tira.astro";
import Button from "@/kit/Button.astro";
import Section from "@/kit/Section.astro";
import Statement from "@/kit/Statement.astro";
import Stats from "@/kit/Stats.astro";
import ContactBlock from "@/kit/ContactBlock.astro";
import Composer from "@/kit/Composer.astro";
import { site } from "@/sites/irra/site";
import { areas, sectores } from "@/sites/irra/areas";
import { photos, lema, promesa, soporte, prevenir, nosotros } from "@/sites/irra/data";

const base = "/irra";
const wa = `https://wa.me/${site.whatsapp.number}?text=${encodeURIComponent(site.whatsapp.intro)}`;
const items = areas.map((a) => ({ key: a.key, title: a.title, text: a.lead, href: `${base}/areas-de-practica/${a.key}` }));
const h2 = "text-[clamp(2rem,4.2vw,3.6rem)] font-bold leading-[1.04] tracking-[-0.035em]";
---

<Layout site={site} title="Irra Ibarra | Firma de abogados en la Ciudad de México: arbitraje, litigio, corporativo y más">
  <Hero title={lema} lede={promesa} image={photos.edificios} imageAlt="Rascacielos fotografiados en contrapicado, en blanco y negro" position="50% 35%">
    <Fragment slot="actions">
      <Button href={wa} variant="light" size="lg" external>Escribir por WhatsApp</Button>
      <Button href={`${base}/areas-de-practica`} variant="outline" size="lg">Ver áreas de práctica</Button>
    </Fragment>
  </Hero>

  <Section size="sm">
    <div class="wrap">
      <Stats stats={[{ value: "+40", label: "años brindando asesoría legal" }, { value: "15", label: "áreas de práctica" }, { value: "16", label: "sectores en los que asesoran" }]} />
    </div>
  </Section>

  <Section class="pt-0">
    <div class="wrap">
      <Statement class="font-semibold tracking-[-0.04em]" text={prevenir} />
    </div>
  </Section>

  <Section tone="surface" id="areas">
    <div class="wrap">
      <h2 data-reveal class={`mb-12 ${h2}`}>Áreas de práctica</h2>
      <Muro items={items} idle="Asesoría jurídica integral reconocida a nivel nacional e internacional." />
    </div>
  </Section>

  <Band image={photos.fachada} alt="Fachada de cristal y acero con cielo nublado, en blanco y negro" position="50% 40%">
    <p data-reveal class="max-w-[24ch] text-[clamp(1.7rem,3.4vw,3rem)] font-semibold leading-[1.1] tracking-[-0.03em]">{soporte}</p>
  </Band>

  <Section size="sm">
    <div class="wrap"><h2 data-reveal class={`mb-10 ${h2}`}>Sectores</h2></div>
    <Tira items={sectores} speed={90} />
  </Section>

  <Section tone="surface">
    <div class="wrap">
      <h2 data-reveal class={`mb-8 ${h2}`}>Nosotros</h2>
      <p data-reveal class="max-w-[34ch] text-[clamp(1.5rem,2.6vw,2.3rem)] leading-[1.25] tracking-[-0.02em]">{nosotros[0]}</p>
      <p data-reveal data-delay="100" class="mt-8 max-w-[60ch] text-lg text-(--c-muted)">{nosotros[1]}</p>
      <div data-reveal class="mt-10"><Button href={`${base}/nosotros`} variant="outline">Conocer a la firma</Button></div>
    </div>
  </Section>

  <Section id="contacto">
    <div class="wrap grid gap-14 lg:grid-cols-[1fr_1fr] lg:gap-24">
      <div data-reveal>
        <h2 class={`mb-10 ${h2}`}>Contacto</h2>
        <ContactBlock site={site} showCta={false} />
      </div>
      <div data-reveal data-delay="120" class="border border-(--c-line) bg-(--c-surface) p-6 sm:p-9">
        <Composer site={site} areas={areas.map((a) => a.title)} />
      </div>
    </div>
  </Section>
</Layout>
