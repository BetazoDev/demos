---
import Layout from "@/sites/abogadosdravi/Layout.astro";
import PageHero from "@/kit/PageHero.astro";
import Section from "@/kit/Section.astro";
import Button from "@/kit/Button.astro";
import CtaBand from "@/kit/CtaBand.astro";
import { site } from "@/sites/abogadosdravi/site";
import { areas, poliza } from "@/sites/abogadosdravi/data";

export function getStaticPaths() {
  return areas.map((a) => ({ params: { area: a.key }, props: { area: a } }));
}
const { area } = Astro.props;
const base = "/abogadosdravi";
const others = areas.filter((a) => a.key !== area.key);
const wa = `https://wa.me/${site.whatsapp.number}?text=${encodeURIComponent(`${site.whatsapp.intro} sobre ${area.title.toLowerCase()}.`)}`;
const h2 = "text-[clamp(1.6rem,3vw,2.4rem)] font-normal leading-tight tracking-[-0.02em]";
const schema = [{ "@context": "https://schema.org", "@type": "Service", name: area.title, description: area.lead, provider: { "@id": new URL(`/${site.slug}#organizacion`, Astro.site).href }, areaServed: [{ "@type": "City", name: "Ciudad de México" }, { "@type": "State", name: "Estado de México" }] }];
---

<Layout
  site={site}
  title={`${area.title} en CDMX y Estado de México | Abogados DRAVI`}
  description={area.lead}
  nav={{ variant: "pill", tone: "light", logoHeight: 44 }}
  breadcrumbs={[{ name: "Servicios", href: `${base}/servicios` }, { name: area.title, href: `${base}/servicios/${area.key}` }]}
  schema={schema}
>
  <PageHero title={area.title} lede={area.lead} transitionName={`area-${area.key}`} image={area.image} imageAlt={area.alt} />

  <Section>
    <div class="wrap grid gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:gap-24">
      <div class="lg:sticky lg:top-28 lg:self-start">
        <p data-reveal class="text-[clamp(1.2rem,1.9vw,1.5rem)] leading-snug">{area.intro}</p>
        <div data-reveal data-delay="100" class="mt-8"><Button href={wa} external>Escribir por WhatsApp</Button></div>
      </div>
      <div>
        <h2 data-reveal class:list={["mb-8", h2]}>{area.itemsTitle}</h2>
        <ul data-stagger data-gap="50" class="grid gap-x-10 gap-y-8 sm:grid-cols-2">
          {area.items.map((i) => (
            <li>
              <h3 class="text-[1.15rem] font-medium leading-snug">{i.t}</h3>
              {i.d && <p class="mt-2 text-base leading-relaxed text-(--c-muted)">{i.d}</p>}
            </li>
          ))}
        </ul>
        {area.closing && <p data-reveal class="mt-10 text-lg text-(--c-muted)">{area.closing}</p>}
      </div>
    </div>
  </Section>

  <Section tone="surface" size="sm">
    <div class="wrap">
      <h2 data-reveal class:list={["mb-8", h2]}>Otros servicios</h2>
      <ul data-stagger data-gap="45" class="flex flex-wrap gap-3">
        {others.map((o) => <li><a href={`${base}/servicios/${o.key}`} class="press inline-flex rounded-full border border-(--c-line) px-5 py-3 text-[15px] hover:border-(--c-accent) hover:text-(--c-accent)">{o.title}</a></li>)}
        <li><a href={`${base}/servicios/poliza-de-arrendamiento`} class="press inline-flex rounded-full border border-(--c-line) px-5 py-3 text-[15px] hover:border-(--c-accent) hover:text-(--c-accent)">{poliza.title}</a></li>
      </ul>
    </div>
  </Section>

  <CtaBand title="Hablemos de tu caso" href={wa} label="Escribir por WhatsApp" tone="brand" external />
</Layout>
