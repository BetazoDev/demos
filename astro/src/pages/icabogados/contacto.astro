---
import SiteLayout from "@/kit/SiteLayout.astro";
import PageHero from "@/kit/PageHero.astro";
import Section from "@/kit/Section.astro";
import ContactBlock from "@/kit/ContactBlock.astro";
import Composer from "@/kit/Composer.astro";
import "@/sites/icabogados/theme.css";
import { site } from "@/sites/icabogados/site";
import { areas } from "@/sites/icabogados/areas";

const base = "/icabogados";
---

<SiteLayout site={site} title="Contacto | IC Abogados, Taine 249, Polanco, Ciudad de México y Querétaro" description="Oficinas de IC Abogados en Taine 249, Polanco, Ciudad de México, y en Ejército Republicano 199, Querétaro. Teléfonos 55 5254 8270 y 44 2213 8844, correo info@icabogados.com." nav={{ variant: "bar", tone: "dark", logoHeight: 52 }} breadcrumbs={[{ name: "Contacto", href: `${base}/contacto` }]} footer={{ variant: "dark" }}>
  <PageHero title="Contacto" lede="Escríbanos por WhatsApp o por correo y agende una conferencia telefónica gratuita de 30 minutos." />
  <Section size="sm" class="pt-4">
    <div class="wrap grid gap-14 lg:grid-cols-2 lg:gap-24">
      <div data-reveal><ContactBlock site={site} /></div>
      <div data-reveal data-delay="120" class="rounded-(--c-radius-card) border border-(--c-line) bg-(--c-surface) p-6 sm:p-9">
        <Composer site={site} areas={areas.map((a) => a.title)} />
      </div>
    </div>
  </Section>
</SiteLayout>
