---
import SiteLayout from "@/kit/SiteLayout.astro";
import Button from "@/kit/Button.astro";
import Section from "@/kit/Section.astro";
import Statement from "@/kit/Statement.astro";
import Stats from "@/kit/Stats.astro";
import ContactBlock from "@/kit/ContactBlock.astro";
import Composer from "@/kit/Composer.astro";
import CtaBand from "@/kit/CtaBand.astro";
import Hero from "@/sites/icabogados/Hero.astro";
import AreaAccordion from "@/sites/icabogados/AreaAccordion.astro";
import TeamGrid from "@/sites/icabogados/TeamGrid.astro";
import Quotes from "@/sites/icabogados/Quotes.astro";
import "@/sites/icabogados/theme.css";
import grupo from "@/sites/icabogados/assets/grupo.jpg";
import { site } from "@/sites/icabogados/site";
import { areas } from "@/sites/icabogados/areas";
import { home, values, stats, team, quotes } from "@/sites/icabogados/data";

const base = "/icabogados";
const wa = `https://wa.me/${site.whatsapp.number}?text=${encodeURIComponent(site.whatsapp.intro)}`;
const h2 = "text-[clamp(1.9rem,4vw,3.4rem)] font-semibold leading-[1.06]";
---

<SiteLayout site={site} title="IC Abogados | Litigio y asesoría de empresa e inversión extranjera en CDMX y Querétaro" nav={{ variant: "bar", tone: "dark", logoHeight: 52 }} footer={{ variant: "dark" }}>
  <Hero title={home.headline} lede={home.lede} image={grupo} imageAlt="El equipo de IC Abogados sobre fondo negro">
    <Fragment slot="actions">
      <Button href={wa} variant="light" size="lg" external>Escribir por WhatsApp</Button>
      <Button href={`${base}/servicios`} variant="outline" size="lg">Ver servicios</Button>
    </Fragment>
  </Hero>

  <Section>
    <div class="wrap"><Statement text={home.statement} class="font-(family-name:--f-display) font-medium" /></div>
  </Section>

  <Section tone="surface">
    <div class="wrap grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:gap-24">
      <h2 data-reveal class={h2}>¿Qué hacemos y cómo lo hacemos diferente?</h2>
      <div data-reveal data-delay="100" class="grid max-w-[58ch] gap-5 text-lg text-(--c-muted)">
        {home.intro.map((p) => <p class="text-(--c-ink)">{p}</p>)}
        <p>{home.introMore}</p>
      </div>
    </div>
  </Section>

  <Section>
    <div class="wrap">
      <h2 data-reveal class:list={["mb-14", h2]}>¿Por qué nosotros?</h2>
      <dl data-stagger data-gap="90" class="grid gap-x-16 gap-y-12 sm:grid-cols-2">
        {values.map((v) => (
          <div class="border-t border-(--c-line) pt-7">
            <dt class="font-(family-name:--f-display) text-[clamp(1.6rem,2.6vw,2.2rem)] font-medium leading-tight">{v.title}</dt>
            <dd class="mt-3 max-w-[38ch] text-lg text-(--c-muted)">{v.text}</dd>
          </div>
        ))}
      </dl>
    </div>
  </Section>

  <Section tone="surface" id="servicios">
    <div class="wrap grid gap-10 lg:grid-cols-[0.7fr_1.3fr] lg:gap-20">
      <div>
        <h2 data-reveal class={h2}>¿En qué áreas podemos ayudarle?</h2>
        <div data-reveal data-delay="100" class="mt-8"><Button href={`${base}/servicios`} variant="outline">Ver todos los servicios</Button></div>
      </div>
      <AreaAccordion areas={areas} base={base} />
    </div>
  </Section>

  <Section>
    <div class="wrap"><Stats stats={stats} /></div>
  </Section>

  <Section tone="surface">
    <div class="wrap">
      <div class="mb-12 flex flex-wrap items-end justify-between gap-6">
        <h2 data-reveal class={h2}>Equipo</h2>
        <div data-reveal data-delay="100"><Button href={`${base}/equipo`} variant="outline">Conocer al equipo</Button></div>
      </div>
      <TeamGrid people={team.slice(0, 5)} bios={false} />
    </div>
  </Section>

  <Section>
    <div class="wrap"><Quotes rating={site.google!.rating} count={site.google!.reviews} quotes={quotes} /></div>
  </Section>

  <Section tone="surface" id="contacto">
    <div class="wrap grid gap-14 lg:grid-cols-2 lg:gap-24">
      <div data-reveal>
        <h2 class:list={["mb-10", h2]}>Contacto</h2>
        <ContactBlock site={site} showCta={false} />
      </div>
      <div data-reveal data-delay="120" class="rounded-(--c-radius-card) border border-(--c-line) bg-(--c-bg) p-6 sm:p-9">
        <Composer site={site} areas={areas.map((a) => a.title)} />
      </div>
    </div>
  </Section>

  <CtaBand title="Conferencia telefónica gratuita de 30 minutos" text="Cuéntenos su pretensión, el problema que se dio y el estado actual. Le confirmaremos si su situación es parte de nuestra rama." href={wa} label="Escribir por WhatsApp" tone="brand" external />
</SiteLayout>
