---
import SiteLayout from "@/kit/SiteLayout.astro";
import PageHero from "@/kit/PageHero.astro";
import Section from "@/kit/Section.astro";
import CtaBand from "@/kit/CtaBand.astro";
import Pic from "@/kit/Pic.astro";
import Skin from "@/sites/guerrerogonzalezabogados/Skin.astro";
import { site } from "@/sites/guerrerogonzalezabogados/site";
import { about, values, commitment } from "@/sites/guerrerogonzalezabogados/data";
import fachada from "@/sites/guerrerogonzalezabogados/assets/fachada.jpg";

const base = "/guerrerogonzalezabogados";
---

<SiteLayout
  site={site}
  title="El despacho | Guerrero González Abogados, servicios legales integrales en la Roma Norte"
  description="Despacho de servicios legales integrales con sólidas relaciones con firmas legales de todo el mundo y una amplia red de despachos en el país."
  nav={{ variant: "pill", tone: "dark", logoHeight: 46 }}
  breadcrumbs={[{ name: "Despacho", href: `${base}/despacho` }]}
>
  <Skin />
  <PageHero title="Despacho" lede="Un despacho de servicios legales integrales conformado por abogados en el ejercicio profesional." />

  <Section size="sm" class="pt-4">
    <div class="wrap grid gap-12 lg:grid-cols-[1.15fr_0.85fr] lg:gap-20">
      <div data-reveal class="space-y-6 text-lg leading-relaxed text-(--c-muted)">
        {about.map((p) => <p>{p}</p>)}
      </div>
      <div data-reveal="clip" class="aspect-[4/5] self-start overflow-hidden lg:sticky lg:top-28">
        <Pic src={fachada} alt="Fachada con balcones y reja de hierro en la colonia Roma Norte" position="30% 50%" class="size-full object-cover" />
      </div>
    </div>
  </Section>

  <Section tone="surface">
    <div class="wrap">
      <ul data-stagger data-gap="90" class="divide-y divide-(--c-line) border-y border-(--c-line)">
        {values.map((v) => <li class="py-5 text-[clamp(3rem,9vw,7.5rem)] font-semibold uppercase leading-[0.95] [font-family:var(--f-display)]">{v}</li>)}
      </ul>
    </div>
  </Section>

  <Section>
    <div class="wrap">
      <h2 data-reveal class="mb-8 text-[clamp(2.4rem,5vw,4.4rem)] font-semibold leading-[0.98]">Nuestro compromiso</h2>
      <p data-reveal class="max-w-[34ch] text-[clamp(1.5rem,2.6vw,2.2rem)] leading-snug">{commitment.lead}</p>
      <p data-reveal data-delay="100" class="mt-6 max-w-[48ch] text-lg text-(--c-muted)">{commitment.rest}</p>
    </div>
  </Section>

  <CtaBand title="Hablemos de su caso" href={`tel:${site.phones[0].tel}`} label="Llamar al 55 5564 5950" tone="brand" />
</SiteLayout>
