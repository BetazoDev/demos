---
import SiteLayout from "@/kit/SiteLayout.astro";
import PageHero from "@/kit/PageHero.astro";
import Section from "@/kit/Section.astro";
import ContactBlock from "@/kit/ContactBlock.astro";
import Composer from "@/kit/Composer.astro";
import Pic from "@/kit/Pic.astro";
import Nav from "@/sites/solucionesjuridicas/Nav.astro";
import { site } from "@/sites/solucionesjuridicas/site";
import { areas, photos } from "@/sites/solucionesjuridicas/data";

const base = "/solucionesjuridicas";
---

<SiteLayout site={site} title="Contacto | Soluciones Jurídicas, abogados en la Roma Sur" description="Ario 5, Col. Roma Sur, Ciudad de México. Oficina 55 2454 8118 y WhatsApp 55 1798 4108, todos los días las 24 horas." breadcrumbs={[{ name: "Contacto", href: `${base}/contacto` }]} footer={{ variant: "dark", blurb: "Despacho de abogados en Ciudad de México. Asesoría legal gratuita." }}>
  <Nav slot="nav" site={site} variant="bar" tone="light" logoHeight={46} />
  <PageHero title="Contacto" lede="Escríbanos por WhatsApp, todos los días y a cualquier hora, o visítenos en la Roma Sur." />
  <Section size="sm" class="pt-4">
    <div class="wrap grid gap-14 lg:grid-cols-2 lg:gap-24">
      <div data-reveal>
        <ContactBlock site={site} />
        <p class="mt-8 max-w-[44ch] text-[15px] text-(--c-muted)">A la vuelta del Bancomer de Eje 3 Sur (Baja California) y Eje 3 Pte (Medellín), a 4 calles de Av. Insurgentes Sur, a la altura del Metro Chilpancingo.</p>
      </div>
      <div data-reveal data-delay="120" class="rounded-[0.75rem] border border-(--c-line) bg-(--c-surface) p-6 sm:p-9">
        <Composer site={site} areas={areas.map((a) => a.title)} />
      </div>
    </div>
  </Section>
  <div data-reveal="clip" class="overflow-hidden bg-(--c-dark)">
    <div class="aspect-[2048/611] min-h-[13rem] w-full"><Pic src={photos.porton} alt="Portón negro, entrada y ventana con herrería de la oficina en Ario 5" position="50% 50%" class="size-full object-cover" /></div>
  </div>
</SiteLayout>
