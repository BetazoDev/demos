---
import SiteLayout from "@/kit/SiteLayout.astro";
import PageHero from "@/kit/PageHero.astro";
import Section from "@/kit/Section.astro";
import Icon from "@/kit/Icon.astro";
import CtaBand from "@/kit/CtaBand.astro";
import Nav from "@/sites/solucionesjuridicas/Nav.astro";
import { site } from "@/sites/solucionesjuridicas/site";
import { areas, waLink } from "@/sites/solucionesjuridicas/data";

export function getStaticPaths() {
  return areas.map((a) => ({ params: { area: a.key }, props: { area: a } }));
}
const { area } = Astro.props;
const base = "/solucionesjuridicas";
const others = areas.filter((a) => a.key !== area.key);
const wa = waLink(`${site.whatsapp.intro} sobre ${area.title.toLowerCase()}.`);
const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    name: area.title,
    description: area.lead,
    provider: { "@id": new URL(`/${site.slug}#organizacion`, Astro.site).href },
    areaServed: { "@type": "City", name: "Ciudad de México" },
  },
];
---

<SiteLayout site={site} title={`${area.title} | Soluciones Jurídicas`} description={`${area.lead} Despacho de ${area.seo}.`.slice(0, 300)} breadcrumbs={[{ name: "Servicios", href: `${base}/servicios` }, { name: area.title, href: `${base}/servicios/${area.key}` }]} schema={schema} footer={{ variant: "dark", blurb: "Despacho de abogados en Ciudad de México. Asesoría legal gratuita." }}>
  <Nav slot="nav" site={site} variant="bar" tone="light" logoHeight={46} />
  <PageHero title={area.title} lede={area.lead} transitionName={`area-${area.key}`} />
  <Section size="sm" class="pt-6">
    <div class="wrap grid gap-14 lg:grid-cols-[1fr_1fr] lg:gap-24">
      {
        area.intro && (
          <div class="grid content-start gap-10">
            {area.intro.map((b) => (
              <article data-reveal>
                <h2 class="text-[clamp(1.4rem,2.4vw,2rem)] font-bold leading-tight tracking-[-0.02em]">{b.title}</h2>
                <p class="mt-3 max-w-[56ch] text-lg leading-relaxed text-(--c-muted)">{b.text}</p>
              </article>
            ))}
          </div>
        )
      }
      <div class:list={["grid content-start gap-12", !area.intro && "lg:col-span-2 lg:grid-cols-2 lg:gap-x-24"]}>
        {
          area.groups.map((g) => (
            <section>
              <h2 data-reveal class="mb-5 text-[clamp(1.4rem,2.4vw,2rem)] font-bold leading-tight tracking-[-0.02em]">{g.title}</h2>
              <ul data-stagger data-gap="45" class="grid gap-3.5">
                {g.items.map((i) => (
                  <li class="flex gap-3 text-[17px] leading-snug">
                    <Icon name="check" weight="bold" class="mt-1 size-4 shrink-0 text-(--c-accent)" />
                    <span>{i}</span>
                  </li>
                ))}
              </ul>
            </section>
          ))
        }
      </div>
    </div>
  </Section>
  <Section tone="surface" size="sm">
    <div class="wrap">
      <h2 data-reveal class="mb-8 text-[clamp(1.4rem,2.4vw,2rem)] font-bold leading-tight tracking-[-0.02em]">Otros servicios</h2>
      <ul data-stagger data-gap="45" class="flex flex-wrap gap-3">
        {others.map((o) => <li><a href={`${base}/servicios/${o.key}`} class="press inline-flex rounded-(--c-radius) border border-(--c-line) bg-(--c-bg) px-5 py-2.5 text-[15px] hover:border-(--c-accent)">{o.title}</a></li>)}
      </ul>
    </div>
  </Section>
  <CtaBand title="Hablemos de su caso" href={wa} label="Escribir por WhatsApp" tone="dark" external />
</SiteLayout>
