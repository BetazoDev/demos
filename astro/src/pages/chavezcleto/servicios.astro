---
import SiteLayout from "@/kit/SiteLayout.astro";
import PageHero from "@/kit/PageHero.astro";
import Section from "@/kit/Section.astro";
import Button from "@/kit/Button.astro";
import Icon from "@/kit/Icon.astro";
import Footer from "@/sites/chavezcleto/Footer.astro";
import Skin from "@/sites/chavezcleto/Skin.astro";
import { site } from "@/sites/chavezcleto/site";
import { areas } from "@/sites/chavezcleto/data";

const base = "/chavezcleto";
const wa = `https://wa.me/${site.whatsapp.number}?text=${encodeURIComponent(site.whatsapp.intro)}`;
const lede = "Nuestra firma brinda asesoría, representación y defensa jurídica en las principales áreas del Derecho, atendiendo cada asunto de manera profesional, estratégica y personalizada.";
const services = areas.map((a) => ({
  "@context": "https://schema.org",
  "@type": "Service",
  name: a.title,
  description: a.text,
  provider: { "@id": `https://demos.diabolicalservices.tech/${site.slug}#organizacion` },
  areaServed: ["Ciudad de México", "Estado de México", "México"],
}));
---

<SiteLayout
  site={site}
  title="Servicios jurídicos | Chávez Cleto & Asociados, Tabacalera, CDMX"
  description="Abogados en Tabacalera, CDMX: derecho civil, familiar, mercantil, penal, laboral, administrativo, amparo y trámites notariales para personas y empresas."
  nav={{ variant: "pill", tone: "dark", logoHeight: 54 }}
  footer={false}
  schema={services}
  breadcrumbs={[{ name: "Servicios", href: `${base}/servicios` }]}
>
  <Skin />
  <PageHero title="Servicios" lede={lede} transitionName="servicios-title" />
  <Section size="sm" class="pt-6">
    <div class="wrap">
      <ul data-stagger data-gap="60" class="grid gap-x-16 gap-y-14 md:grid-cols-2">
        {
          areas.map((a) => (
            <li id={a.key} class="border-t border-(--c-line) pt-8">
              <Icon name={a.icon} class="size-8 text-(--c-accent)" />
              <h2 class="mt-6 text-[clamp(1.9rem,3vw,2.7rem)] leading-[1.05] tracking-[-0.015em]">{a.title}</h2>
              <p class="mt-4 max-w-[46ch] text-lg text-(--c-muted)">{a.text}</p>
              <a href={`${base}/contacto?area=${encodeURIComponent(a.title)}#consulta`} class="cc-more group mt-6 flex w-fit items-center gap-2 whitespace-nowrap text-[15px] font-semibold text-(--c-accent)">
                Consultar sobre este servicio
                <Icon name="arrow-right" weight="bold" class="size-4 transition-transform duration-300 ease-(--ease-out) group-hover:translate-x-1" />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </Section>
  <section class="section-y overflow-hidden bg-(--c-brand) text-(--c-on-brand)">
    <div class="wrap grid items-end gap-10 lg:grid-cols-[1fr_auto]">
      <h2 data-reveal class="max-w-[22ch] text-[clamp(2rem,4.4vw,3.8rem)] leading-[1.05] tracking-[-0.02em]">Tu problema legal tiene solución. Estamos para ayudarte.</h2>
      <div data-reveal data-delay="120"><Button href={wa} variant="light" size="lg" external>Escribir por WhatsApp</Button></div>
    </div>
  </section>
  <Footer slot="footer" site={site} variant="dark" blurb="Estrategia jurídica. Defensa firme. Resultados que importan." />
</SiteLayout>
