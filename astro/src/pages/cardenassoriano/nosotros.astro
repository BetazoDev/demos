---
import "@/sites/cardenassoriano/theme.css";
import SiteLayout from "@/kit/SiteLayout.astro";
import PageHero from "@/kit/PageHero.astro";
import Section from "@/kit/Section.astro";
import Statement from "@/kit/Statement.astro";
import Stats from "@/kit/Stats.astro";
import Pic from "@/kit/Pic.astro";
import Icon from "@/kit/Icon.astro";
import CtaBand from "@/kit/CtaBand.astro";
import { site } from "@/sites/cardenassoriano/site";
import { founder, stats, contribution, publications, photos } from "@/sites/cardenassoriano/data";

const base = "/cardenassoriano";
const wa = `https://wa.me/${site.whatsapp.number}?text=${encodeURIComponent(site.whatsapp.intro)}.`;
---

<SiteLayout
  site={site}
  title="Nosotros | Cárdenas Soriano Abogados"
  description="Cárdenas Soriano Abogados: litigio y mediación en Polanco, CDMX. Conoce a Gustavo Cárdenas Soriano, socio fundador, que participó en los grupos redactores del CNPCF y de la LGMASC."
  nav={{ variant: "pill", tone: "light" }}
  breadcrumbs={[{ name: "Nosotros", href: `${base}/nosotros` }]}
>
  <PageHero title="Cada caso merece una estrategia propia." lede="Cárdenas Soriano Abogados reúne a un equipo que analiza cada asunto con cuidado y construye estrategias acordes con las necesidades de cada cliente." image={photos.libro} imageAlt="Libro abierto con las páginas en abanico" />

  <Section>
    <div class="wrap"><Statement text="Litigamos cuando es necesario. Mediamos cuando existe una mejor salida." /></div>
  </Section>

  <Section tone="surface">
    <div class="wrap grid items-start gap-12 lg:grid-cols-[0.78fr_1.22fr] lg:gap-24">
      <div data-reveal="clip" class="aspect-[4/5] overflow-hidden rounded-(--c-radius-img) bg-(--c-bg)">
        <Pic src={photos.gustavo} alt={`${founder.name}, ${founder.role.toLowerCase()}`} class="size-full object-cover" />
      </div>
      <div>
        <h2 data-reveal class="text-[clamp(2rem,4.4vw,3.8rem)] leading-[1.02] tracking-[-0.035em]">{founder.name}</h2>
        <p data-reveal data-delay="60" class="mt-3 text-lg text-(--c-muted)">{founder.role}</p>
        <p data-reveal data-delay="120" class="mt-8 max-w-[56ch] text-lg leading-relaxed">{founder.bio}</p>
        <ul data-stagger data-gap="70" class="mt-10 grid max-w-[56ch] gap-4">
          {founder.credentials.map((c) => (
            <li class="flex gap-4">
              <span class="mt-1 grid size-6 shrink-0 place-items-center rounded-full bg-(--c-accent) text-(--c-on-accent)"><Icon name="check" weight="bold" class="size-3.5" /></span>
              <span class="text-lg">{c}.</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </Section>

  <Section>
    <div class="wrap"><Stats stats={stats} /></div>
  </Section>

  <Section tone="dark">
    <div class="wrap grid gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:gap-20">
      <h2 data-reveal class="max-w-[12ch] text-[clamp(2rem,4.4vw,3.8rem)] leading-[1.02] tracking-[-0.035em]">Nuestro aporte a la legislación</h2>
      <p data-reveal data-delay="100" class="max-w-[46ch] text-[clamp(1.3rem,2.2vw,1.8rem)] leading-snug opacity-90">{contribution}</p>
    </div>
  </Section>

  <Section>
    <div class="wrap grid items-start gap-12 lg:grid-cols-[0.6fr_1.4fr] lg:gap-24">
      <div data-reveal="clip" class="aspect-[3/4] max-w-[22rem] overflow-hidden rounded-(--c-radius-img) bg-(--c-surface)">
        <Pic src={photos.brochure} alt="Portada del brochure Litigio y mediación familiar, con el Palacio de Bellas Artes" class="size-full object-cover" />
      </div>
      <div>
        <h2 data-reveal class="mb-8 text-[clamp(2rem,4.4vw,3.8rem)] leading-[1.02] tracking-[-0.035em]">Lecturas y publicaciones</h2>
        <ul data-stagger data-gap="70" class="grid gap-x-10 gap-y-7 sm:grid-cols-2">
          {publications.map((p) => (
            <li>
              <h3 class="text-lg font-medium leading-snug">{p.t}</h3>
              {p.by && <p class="mt-1.5 text-[15px] text-(--c-muted)">{p.by}</p>}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </Section>

  <CtaBand title="Empecemos por una llamada." href={wa} label="Escribir por WhatsApp" tone="surface" external />
</SiteLayout>
