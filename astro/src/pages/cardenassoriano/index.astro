---
import "@/sites/cardenassoriano/theme.css";
import SiteLayout from "@/kit/SiteLayout.astro";
import Button from "@/kit/Button.astro";
import Section from "@/kit/Section.astro";
import Statement from "@/kit/Statement.astro";
import AreasIndex from "@/kit/AreasIndex.astro";
import Stats from "@/kit/Stats.astro";
import Pic from "@/kit/Pic.astro";
import ContactBlock from "@/kit/ContactBlock.astro";
import Hero from "@/sites/cardenassoriano/Hero.astro";
import Process from "@/sites/cardenassoriano/Process.astro";
import BandQuote from "@/sites/cardenassoriano/BandQuote.astro";
import Composer from "@/sites/cardenassoriano/Composer.astro";
import { site } from "@/sites/cardenassoriano/site";
import { areas, founder, stats, reviews, photos } from "@/sites/cardenassoriano/data";

const base = "/cardenassoriano";
const rows = areas.map((a) => ({ key: a.key, title: a.title, text: a.lead, href: `${base}/servicios/${a.key}` }));
const wa = `https://wa.me/${site.whatsapp.number}?text=${encodeURIComponent(site.whatsapp.intro)}.`;
const mint = "bg-(--c-accent)! text-(--c-on-accent)!";
const [lead, ...rest] = reviews.quotes;
---

<SiteLayout
  site={site}
  title="Cárdenas Soriano Abogados | Abogados en Polanco, CDMX: litigio, mediación y consultoría jurídica"
  description="Cárdenas Soriano, abogados en Polanco, CDMX. Litigio, mediación y consultoría jurídica para personas, empresas y gobiernos."
  nav={{ variant: "pill", tone: "dark" }}
  footer={{ variant: "dark", blurb: "Litigio y mediación para resolver las controversias de personas, empresas y gobiernos." }}
>
  <Hero title="Conocemos la ley porque ayudamos a escribirla e implementarla." lede="Litigio y mediación para resolver las controversias de personas, empresas y gobiernos." image={photos.vidrio} imageAlt="Cristales esmeralda y menta sobre fondo verde petróleo">
    <Fragment slot="actions">
      <Button href={wa} variant="light" size="lg" external class={mint}>Escribir por WhatsApp</Button>
      <Button href={`${base}/servicios`} variant="outline" size="lg">Ver servicios</Button>
    </Fragment>
  </Hero>

  <Section>
    <div class="wrap">
      <Statement text={founder.quote} />
      <p data-reveal class="mt-8 text-lg text-(--c-muted)">{founder.name}, {founder.role.toLowerCase()}.</p>
    </div>
  </Section>

  <Section tone="surface">
    <div class="wrap">
      <Process>
        <Fragment slot="action"><Button href={wa} external>Escribir por WhatsApp</Button></Fragment>
      </Process>
    </div>
  </Section>

  <Section id="servicios">
    <div class="wrap">
      <h2 data-reveal class="mb-12 max-w-[14ch] text-[clamp(2rem,4.4vw,3.8rem)] leading-[1.02] tracking-[-0.035em]">Acompañamos cada etapa de tu caso.</h2>
      <AreasIndex areas={rows} />
      <div data-reveal class="mt-10"><Button href={`${base}/servicios`} variant="outline">Ver los 22 servicios</Button></div>
    </div>
  </Section>

  <BandQuote image={photos.sala} alt="Sala de juntas con madera cálida" position="50% 55%">
    <p data-reveal class="max-w-[24ch] text-[clamp(1.8rem,4vw,3.4rem)] font-medium leading-[1.08] tracking-[-0.03em]">Litigamos cuando es necesario. Mediamos cuando existe una mejor salida.</p>
  </BandQuote>

  <Section>
    <div class="wrap grid items-start gap-12 lg:grid-cols-[0.78fr_1.22fr] lg:gap-24">
      <div data-reveal="clip" class="aspect-[4/5] overflow-hidden rounded-(--c-radius-img) bg-(--c-surface)">
        <Pic src={photos.gustavo} alt={`${founder.name}, ${founder.role.toLowerCase()} de Cárdenas Soriano Abogados`} class="size-full object-cover" />
      </div>
      <div>
        <h2 data-reveal class="text-[clamp(2rem,4.4vw,3.8rem)] leading-[1.02] tracking-[-0.035em]">{founder.name}</h2>
        <p data-reveal data-delay="60" class="mt-3 text-lg text-(--c-muted)">{founder.role}</p>
        <p data-reveal data-delay="120" class="mt-8 max-w-[56ch] text-lg leading-relaxed">{founder.bio}</p>
        <div class="mt-14"><Stats stats={stats} /></div>
        <div data-reveal class="mt-12"><Button href={`${base}/nosotros`} variant="outline">Conocer al despacho</Button></div>
      </div>
    </div>
  </Section>

  <Section tone="surface">
    <div class="wrap grid gap-12 lg:grid-cols-[0.6fr_1.4fr] lg:gap-24">
      <p data-reveal class="flex flex-col gap-3">
        <span data-count={reviews.rating.toFixed(1)} class="font-(family-name:--f-display) text-[clamp(4.5rem,10vw,8rem)] font-medium leading-none tracking-[-0.05em] tabular-nums">{reviews.rating.toFixed(1)}</span>
        <span class="text-lg text-(--c-muted)">en Google, {reviews.count} reseñas</span>
      </p>
      <div>
        <figure data-reveal>
          <blockquote class="max-w-[36ch] text-[clamp(1.4rem,2.5vw,2.1rem)] leading-[1.25] tracking-[-0.015em]">“{lead.text}”</blockquote>
          <figcaption class="mt-5 text-(--c-muted)">{lead.author}</figcaption>
        </figure>
        <ul data-stagger data-gap="90" class="mt-12 grid gap-10 border-t border-(--c-line) pt-10 sm:grid-cols-2">
          {rest.map((q) => (
            <li>
              <blockquote class="text-xl leading-snug">“{q.text}”</blockquote>
              <p class="mt-4 text-(--c-muted)">{q.author}</p>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </Section>

  <Section id="contacto">
    <div class="wrap grid gap-14 lg:grid-cols-[1fr_1fr] lg:gap-24">
      <div data-reveal>
        <h2 class="mb-10 max-w-[12ch] text-[clamp(2rem,4.4vw,3.8rem)] leading-[1.02] tracking-[-0.035em]">Empecemos por una llamada.</h2>
        <ContactBlock site={site} showCta={false} />
      </div>
      <div data-reveal data-delay="120" class="rounded-(--c-radius-card) border border-(--c-line) bg-(--c-surface) p-6 sm:p-9">
        <Composer site={site} areas={areas.map((a) => a.title)} />
      </div>
    </div>
  </Section>
</SiteLayout>
