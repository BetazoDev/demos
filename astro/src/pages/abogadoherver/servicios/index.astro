---
import SiteLayout from "@/kit/SiteLayout.astro";
import PageHero from "@/kit/PageHero.astro";
import Section from "@/kit/Section.astro";
import Button from "@/kit/Button.astro";
import Icon from "@/kit/Icon.astro";
import CtaBand from "@/kit/CtaBand.astro";
import Nav from "@/sites/abogadoherver/Nav.astro";
import Footer from "@/sites/abogadoherver/Footer.astro";
import { site } from "@/sites/abogadoherver/site";
import { areas, asesoria } from "@/sites/abogadoherver/data";
import "@/sites/abogadoherver/theme.css";

const base = "/abogadoherver";
const wa = `https://wa.me/${site.whatsapp.number}?text=${encodeURIComponent(site.whatsapp.intro)}`;
---

<SiteLayout
  site={site}
  title="Servicios: derecho civil, familiar y penal en CDMX | Herver Abogados de México"
  description="Juicios civiles, divorcio, pensión alimenticia, guarda y custodia, defensa penal, denuncias y querellas, amparos en materia penal, en la colonia Narvarte, Ciudad de México."
  breadcrumbs={[{ name: "Servicios", href: `${base}/servicios` }]}
>
  <Nav slot="nav" site={site} variant="bar" tone="light" logoHeight={38} />
  <PageHero title="Servicios" lede={asesoria} />

  <Section size="sm" class="pt-10 sm:pt-16">
    <div class="wrap grid gap-16 sm:gap-24">
      {areas.map((a) => (
        <article class="grid gap-8 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16">
          <div>
            <h2 transition:name={`area-${a.key}`} class="text-[clamp(2rem,3.6vw,3.2rem)] font-normal leading-[1.05] tracking-[-0.01em]">{a.title}</h2>
            <p class="mt-5 max-w-[40ch] text-lg text-(--c-muted)">{a.lead}</p>
            <div class="mt-8"><Button href={`${base}/servicios/${a.key}`} variant="outline">Ver {a.title}</Button></div>
          </div>
          <ul data-stagger data-gap="45" class="grid content-start gap-x-10 gap-y-3 sm:grid-cols-2">
            {a.items.map((i) => (
              <li class="flex gap-3 text-[17px] leading-relaxed"><Icon name="check" weight="bold" class="mt-1.5 size-4 shrink-0 text-(--c-accent)" /><span>{i}</span></li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </Section>

  <CtaBand title="Cuéntanos tu caso" href={wa} label="Escribir por WhatsApp" tone="brand" external />
  <Footer slot="footer" site={site} variant="dark" blurb="Más que abogados, somos aliados estratégicos en la protección de tus derechos." />
</SiteLayout>
