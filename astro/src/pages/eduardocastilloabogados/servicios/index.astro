---
import SiteLayout from "@/sites/eduardocastilloabogados/Page.astro";
import PageHero from "@/kit/PageHero.astro";
import Section from "@/kit/Section.astro";
import AreasIndex from "@/kit/AreasIndex.astro";
import CtaBand from "@/kit/CtaBand.astro";
import { site } from "@/sites/eduardocastilloabogados/site";
import { withPage, others, enfoque, alcance, prioridades, cobro } from "@/sites/eduardocastilloabogados/data";
import pluma from "@/sites/eduardocastilloabogados/assets/pluma-contratos-escritorio.jpg";

const base = "/eduardocastilloabogados";
const rows = withPage.map((a) => ({ key: a.key, title: a.title, text: a.lead, href: `${base}/servicios/${a.key}` }));
const wa = `https://wa.me/${site.whatsapp.number}?text=${encodeURIComponent(site.whatsapp.intro)}`;
const modo = [
  { t: "Enfoque", items: enfoque },
  { t: "Alcance", items: [alcance] },
  { t: "Prioridades", items: prioridades },
  { t: "Formas de cobro", items: cobro },
  { t: "Idioma", items: ["En el despacho se habla el idioma inglés."] },
];
---

<SiteLayout site={site} title="Servicios y soluciones | Eduardo Castillo Abogados" description="Litigio mercantil, bancario y bursátil, concursal, fiduciario, corporativo, amparo, mediación y más. Atención personal y directa del titular en la Ciudad de México." nav={{ variant: "bar", tone: "light", logoHeight: 50 }} breadcrumbs={[{ name: "Servicios", href: `${base}/servicios` }]}>
  <PageHero title="Servicios y soluciones" lede="Un servicio personalizado y directo en cada asunto, sin delegarlo en terceros que muchas veces carecen de la experiencia y los conocimientos suficientes." image={pluma} imageAlt="Pluma dorada sobre una pila de hojas en blanco, sobre un escritorio con carpeta azul marino" />
  <Section size="sm" class="pt-16 sm:pt-24">
    <div class="wrap">
      <AreasIndex areas={rows} />
      <div data-reveal class="mt-14">
        <h2 class="text-xl font-semibold tracking-[-0.01em]">Otras especialidades</h2>
        <ul class="mt-6 grid gap-x-10 gap-y-3 text-lg text-(--c-muted) sm:grid-cols-2 lg:grid-cols-3">
          {others.map((o) => <li>{o.title}</li>)}
        </ul>
      </div>
    </div>
  </Section>
  <Section tone="surface">
    <div class="wrap">
      <h2 data-reveal class="mb-12 text-[clamp(2rem,4vw,3.4rem)] font-semibold leading-[1.02] tracking-[-0.03em]">Cómo se atiende cada asunto</h2>
      <dl class="divide-y divide-(--c-line) border-y border-(--c-line)">
        {modo.map((m) => (
          <div data-reveal class="grid gap-4 py-8 md:grid-cols-[0.45fr_1.55fr] md:gap-16">
            <dt class="text-lg font-semibold">{m.t}</dt>
            <dd>
              <ul class="grid max-w-[62ch] gap-3 text-lg leading-relaxed text-(--c-muted)">{m.items.map((i) => <li>{i}</li>)}</ul>
            </dd>
          </div>
        ))}
      </dl>
    </div>
  </Section>
  <CtaBand title="Contacto directo con el titular del despacho" href={wa} label="Escribir por WhatsApp" tone="brand" external />
</SiteLayout>
