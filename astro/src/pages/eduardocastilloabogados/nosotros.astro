---
import SiteLayout from "@/sites/eduardocastilloabogados/Page.astro";
import PageHero from "@/kit/PageHero.astro";
import Section from "@/kit/Section.astro";
import Stats from "@/kit/Stats.astro";
import CtaBand from "@/kit/CtaBand.astro";
import { site } from "@/sites/eduardocastilloabogados/site";
import { titular, filosofia, publicaciones, clientes } from "@/sites/eduardocastilloabogados/data";
import torres from "@/sites/eduardocastilloabogados/assets/torres-financieras-hora-azul.jpg";

const base = "/eduardocastilloabogados";
const wa = `https://wa.me/${site.whatsapp.number}?text=${encodeURIComponent(site.whatsapp.intro)}`;
const stats = [
  { value: "29+", label: "años de experiencia en el mercado mexicano" },
  { value: "4", label: "obras de derecho mercantil publicadas por el titular" },
  { value: "1984", label: "titulación en la UNAM y comienzo de la docencia universitaria" },
];
---

<SiteLayout site={site} title="Nosotros | Eduardo Castillo Abogados" description="Despacho de profesionales en derecho altamente especializado, con más de 29 años de experiencia en el mercado mexicano. Conozca al titular, el Lic. Eduardo Castillo." nav={{ variant: "bar", tone: "light", logoHeight: 50 }} breadcrumbs={[{ name: "Nosotros", href: `${base}/nosotros` }]}>
  <PageHero title="Nosotros" lede="Despacho de profesionales en derecho altamente especializado, con una experiencia de más de 29 años en el mercado mexicano." image={torres} imageAlt="Fachadas de torres de oficinas al anochecer, con algunas ventanas iluminadas" />

  <Section>
    <div class="wrap">
      <p data-reveal class="max-w-[30ch] text-[clamp(1.6rem,3.2vw,2.8rem)] font-medium leading-[1.15] tracking-[-0.025em]">{filosofia}</p>
      <Stats stats={stats} class="mt-20" />
    </div>
  </Section>

  <Section tone="surface">
    <div class="wrap grid gap-12 lg:grid-cols-[0.55fr_1.45fr] lg:gap-20">
      <div class="lg:sticky lg:top-32 lg:self-start">
        <h2 data-reveal class="text-[clamp(2rem,4vw,3.4rem)] font-semibold leading-[1.02] tracking-[-0.03em]">{titular.name}</h2>
        <p data-reveal data-delay="60" class="mt-3 text-lg text-(--c-muted)">{titular.role}</p>
      </div>
      <div class="grid gap-12">
        <p data-reveal class="max-w-[58ch] text-xl leading-relaxed">{titular.bio}</p>
        <div data-reveal>
          <h3 class="text-lg font-semibold">Antes de constituir la firma</h3>
          <ul class="mt-5 grid max-w-[62ch] gap-x-8 gap-y-2.5 text-lg text-(--c-muted) sm:grid-cols-2">
            {titular.trayectoria.map((t) => <li>{t}</li>)}
          </ul>
        </div>
        <div data-reveal>
          <h3 class="text-lg font-semibold">Docencia</h3>
          <p class="mt-4 max-w-[58ch] text-lg leading-relaxed text-(--c-muted)">{titular.docencia}</p>
        </div>
        <div data-reveal>
          <h3 class="text-lg font-semibold">Capacitación impartida</h3>
          <p class="mt-4 max-w-[58ch] text-lg leading-relaxed text-(--c-muted)">{titular.capacitacion}</p>
        </div>
        <div data-reveal>
          <h3 class="text-lg font-semibold">Obras</h3>
          <ul class="mt-5 grid gap-3 text-lg">{publicaciones.map((p) => <li>{p.title}</li>)}</ul>
        </div>
      </div>
    </div>
  </Section>

  <Section>
    <div class="wrap">
      <h2 data-reveal class="max-w-[22ch] text-[clamp(1.8rem,3.6vw,3rem)] font-semibold leading-[1.05] tracking-[-0.03em]">Algunos clientes que se atienden o se les han prestado servicios</h2>
      <ul data-stagger data-gap="30" class="mt-12 grid gap-x-12 gap-y-3.5 text-[17px] text-(--c-muted) md:grid-cols-2">
        {clientes.map((c) => <li>{c}</li>)}
        <li>Y múltiples personas físicas.</li>
      </ul>
      <p data-reveal class="mt-12 max-w-[60ch] text-lg leading-relaxed">{titular.sinCorresponsales} {titular.idioma}</p>
    </div>
  </Section>
  <CtaBand title="Contacto directo con el titular del despacho" href={wa} label="Escribir por WhatsApp" tone="brand" external />
</SiteLayout>
