---
import "@/sites/herreraabogados/site.css";
import SiteLayout from "@/kit/SiteLayout.astro";
import Button from "@/kit/Button.astro";
import Section from "@/kit/Section.astro";
import Icon from "@/kit/Icon.astro";
import ImageBand from "@/kit/ImageBand.astro";
import ContactBlock from "@/kit/ContactBlock.astro";
import Composer from "@/kit/Composer.astro";
import Hero from "@/sites/herreraabogados/Hero.astro";
import Footer from "@/sites/herreraabogados/Footer.astro";
import { site } from "@/sites/herreraabogados/site";
import { areas, partners, clients, manifesto } from "@/sites/herreraabogados/data";
import fachada from "@/sites/herreraabogados/assets/fachada.jpg";
import ciudad from "@/sites/herreraabogados/assets/ciudad.jpg";

const base = "/herreraabogados";
const wa = `https://wa.me/${site.whatsapp.number}?text=${encodeURIComponent(site.whatsapp.intro)}.`;
const h2 = "hh-light text-[clamp(2.2rem,4.8vw,4.4rem)] leading-[1] tracking-[-0.035em]";
---

<SiteLayout site={site} title="Herrera Abogados | Asesoría y representación en negocios, energía y regulatorio, Ciudad de México" nav={{ variant: "bar", tone: "dark", logoHeight: 36 }} footer={false}>
  <Hero lines={["Negocios dentro", "y fuera de México"]} lede="Somos un despacho que asesora y representa a sus clientes, con un enfoque fresco, dinámico y profundo." image={fachada} imageAlt="Fachada de cristal de una torre de oficinas al anochecer con una línea de luz dorada" position="60% 40%">
    <Fragment slot="actions">
      <Button href={wa} size="lg" external>Escribir por WhatsApp</Button>
      <Button href={`${base}/practica`} variant="outline" size="lg">Ver práctica</Button>
    </Fragment>
  </Hero>

  <Section>
    <div class="wrap">
      <p data-statement class="hh-light max-w-[32ch] font-(family-name:--f-display) text-[clamp(1.75rem,3.5vw,3.2rem)] leading-[1.14] tracking-[-0.025em]">{manifesto}</p>
    </div>
  </Section>

  <Section tone="surface" id="practica">
    <div class="wrap grid gap-12 lg:grid-cols-[0.6fr_1.4fr] lg:gap-24">
      <div class="lg:sticky lg:top-28 lg:self-start">
        <h2 data-reveal class={h2}>Práctica</h2>
        <div data-reveal data-delay="100" class="mt-9"><Button href={`${base}/practica`} variant="outline">Ver práctica</Button></div>
      </div>
      <ul data-stagger data-gap="60" class="hh-list grid gap-1">
        {
          areas.map((a) => (
            <li>
              <a href={`${base}/practica#${a.key}`} class="hh-row group flex items-center justify-between gap-6 py-3 sm:py-4">
                <span class="hh-light text-[clamp(1.6rem,3.4vw,3rem)] leading-[1.1] tracking-[-0.025em]" style="font-family:var(--f-display)">{a.title}</span>
                <Icon name="arrow-up-right" weight="light" class="hh-arrow size-7 shrink-0 text-(--c-accent) sm:size-9" />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </Section>

  <ImageBand image={ciudad} alt="Vista nocturna del centro de la Ciudad de México desde una ventana, con la Torre Latinoamericana al fondo" position="50% 50%" height="clamp(20rem,56vw,38rem)" />

  <Section>
    <div class="wrap">
      <h2 data-reveal class={`mb-14 ${h2}`}>Socios</h2>
      <ul data-stagger data-gap="110" class="grid gap-10 md:grid-cols-3 md:gap-0">
        {
          partners.map((p) => (
            <li class="border-t border-(--c-line) pt-7 md:px-8 md:first:pl-0 md:last:pr-0 md:[&:not(:first-child)]:border-l">
              <p class="text-[15px] font-medium text-(--c-accent)">{p.role}</p>
              <h3 class="hh-light mt-3 text-[clamp(1.7rem,2.6vw,2.4rem)] leading-[1.1] tracking-[-0.02em]">{p.name}</h3>
              <p class="mt-4 max-w-[30ch] text-base leading-relaxed text-(--c-muted)">{p.focus}</p>
            </li>
          ))
        }
      </ul>
      <div data-reveal class="mt-12"><Button href={`${base}/nosotros`} variant="outline">Conocer a los socios</Button></div>
    </div>
  </Section>

  <Section tone="surface">
    <div class="wrap grid gap-10 lg:grid-cols-[0.6fr_1.4fr] lg:gap-24">
      <h2 data-reveal class={h2}>Clientes</h2>
      <ul data-stagger data-gap="70" class="flex flex-wrap content-start gap-3">
        {clients.map((c) => <li class="rounded-full border border-(--c-line) px-6 py-3.5 text-lg">{c}</li>)}
      </ul>
    </div>
  </Section>

  <Section id="contacto">
    <div class="wrap grid gap-14 lg:grid-cols-2 lg:gap-24">
      <div data-reveal>
        <h2 class={`mb-10 ${h2}`}>Contacto</h2>
        <ContactBlock site={site} showCta={false} />
      </div>
      <div data-reveal data-delay="120" class="rounded-[1.5rem] border border-(--c-line) bg-(--c-surface) p-6 sm:p-9">
        <Composer site={site} areas={areas.map((a) => a.title)} />
      </div>
    </div>
  </Section>

  <Footer slot="footer" site={site} variant="dark" />
</SiteLayout>
