---
import "@/sites/herreraabogados/site.css";
import SiteLayout from "@/kit/SiteLayout.astro";
import PageHero from "@/kit/PageHero.astro";
import Section from "@/kit/Section.astro";
import CtaBand from "@/kit/CtaBand.astro";
import Footer from "@/sites/herreraabogados/Footer.astro";
import { site } from "@/sites/herreraabogados/site";
import { partners, clients, manifesto, honorarios } from "@/sites/herreraabogados/data";
import sala from "@/sites/herreraabogados/assets/sala.jpg";

const base = "/herreraabogados";
const wa = `https://wa.me/${site.whatsapp.number}?text=${encodeURIComponent(site.whatsapp.intro)}.`;
const h2 = "hh-light text-[clamp(1.9rem,3.6vw,3.2rem)] leading-[1.05] tracking-[-0.03em]";
---

<SiteLayout
  site={site}
  title="Nosotros | Herrera Abogados, socios y clientes"
  description="Despacho que asesora y representa a sus clientes en sus negocios dentro y fuera de México. Conozca a sus socios: José Luis Herrera Vaca, Juan Antonio Ramírez y José Sifuentes."
  nav={{ variant: "bar", tone: "dark", logoHeight: 36 }}
  footer={false}
  breadcrumbs={[{ name: "Nosotros", href: `${base}/nosotros` }]}
>
  <PageHero title="Nosotros" lede="Somos un despacho que asesora y representa a sus clientes en sus negocios dentro y fuera de México." image={sala} imageAlt="Sala de juntas con una larga mesa de madera, sillas de piel azul y lámparas doradas junto a ventanales con vista nocturna de la ciudad" />
  <Section>
    <div class="wrap">
      <p data-statement class="hh-light max-w-[32ch] font-(family-name:--f-display) text-[clamp(1.75rem,3.5vw,3.2rem)] leading-[1.14] tracking-[-0.025em]">{manifesto}</p>
      <p data-reveal class="mt-12 max-w-[40ch] text-xl leading-relaxed text-(--c-muted) sm:text-2xl">{honorarios}</p>
    </div>
  </Section>

  <Section tone="surface">
    <div class="wrap">
      <h2 data-reveal class={`mb-14 ${h2}`}>Socios</h2>
      <ul class="grid">
        {
          partners.map((p) => (
            <li data-reveal class="grid gap-5 border-t border-(--c-line) py-12 md:grid-cols-[0.6fr_1.4fr] md:gap-16 lg:py-14">
              <div>
                <h3 class="hh-light text-[clamp(1.7rem,2.6vw,2.4rem)] leading-[1.1] tracking-[-0.02em]">{p.name}</h3>
                <p class="mt-3 text-[15px] font-medium text-(--c-accent)">{p.role}</p>
              </div>
              <p class="max-w-[62ch] text-lg leading-relaxed text-(--c-muted)">{p.bio}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </Section>

  <Section>
    <div class="wrap grid gap-10 lg:grid-cols-[0.6fr_1.4fr] lg:gap-24">
      <h2 data-reveal class={h2}>Clientes</h2>
      <ul data-stagger data-gap="70" class="flex flex-wrap content-start gap-3">
        {clients.map((c) => <li class="rounded-full border border-(--c-line) px-6 py-3.5 text-lg">{c}</li>)}
      </ul>
    </div>
  </Section>
  <CtaBand title="Cuéntenos su caso" href={wa} label="Escribir por WhatsApp" tone="brand" external />
  <Footer slot="footer" site={site} variant="dark" />
</SiteLayout>
