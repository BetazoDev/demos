---
import Layout from "@/sites/abogadosemprendedores/Layout.astro";
import PageHero from "@/kit/PageHero.astro";
import Section from "@/kit/Section.astro";
import Statement from "@/kit/Statement.astro";
import Pic from "@/kit/Pic.astro";
import CtaBand from "@/kit/CtaBand.astro";
import { site } from "@/sites/abogadosemprendedores/site";
import { equipo } from "@/sites/abogadosemprendedores/data";

const base = "/abogadosemprendedores";
const wa = `https://wa.me/${site.whatsapp.number}?text=${encodeURIComponent(site.whatsapp.intro)}`;
---

<Layout site={site} title="Nosotros | Abogados para Emprendedores MX, despacho para emprendedores" description="Despacho de abogados especializado en atender las necesidades de los emprendedores. Conoce nuestra misión, nuestra visión y a la abogada titular, María Elena Cortés Zárate." breadcrumbs={[{ name: "Nosotros", href: `${base}/nosotros` }]}>
  <PageHero title="Nosotros" lede="Somos un despacho de abogados especializados en atender las necesidades de los emprendedores." />

  <Section size="sm" class="pt-4">
    <div class="wrap grid gap-14 lg:grid-cols-2 lg:gap-24">
      <div data-reveal>
        <h2 class="text-[clamp(1.8rem,3.4vw,2.8rem)] font-semibold leading-tight tracking-[-0.03em]">Misión</h2>
        <p class="mt-5 max-w-[48ch] text-lg leading-relaxed text-(--c-muted)">Apoyar a los emprendedores mexicanos a elaborar los documentos legales esenciales para el funcionamiento de su negocio de manera rápida, sencilla y económica. Nuestro principal objetivo es formar más empresas legalmente constituidas en nuestro país.</p>
      </div>
      <div data-reveal data-delay="100">
        <h2 class="text-[clamp(1.8rem,3.4vw,2.8rem)] font-semibold leading-tight tracking-[-0.03em]">Visión</h2>
        <p class="mt-5 max-w-[48ch] text-lg leading-relaxed text-(--c-muted)">Promover la legalidad entre los pequeños empresarios en México. Queremos que nuestra empresa sea una herramienta básica y de referencia en términos de legalidad para todos aquellos que quieran emprender.</p>
      </div>
    </div>
  </Section>

  <Section tone="surface">
    <div class="wrap"><Statement class="max-w-[30ch] text-[clamp(1.7rem,3.8vw,3.4rem)] sm:max-w-[34ch]" text="Estamos capacitados para manejar un lenguaje sencillo y comprensible que nos permite generar una cultura legal." /></div>
  </Section>

  <Section>
    <div class="wrap">
      <h2 data-reveal class="mb-14 text-[clamp(2.2rem,4.8vw,4.2rem)] font-semibold leading-none tracking-[-0.04em]">Equipo</h2>
      <ul class="grid gap-16 sm:gap-24">
        {equipo.map((p, i) => (
          <li class:list={["grid items-center gap-8 md:gap-16", i === 0 ? "md:grid-cols-[0.8fr_1.2fr]" : "md:grid-cols-[0.5fr_1.5fr]"]}>
            <div data-reveal="clip" class:list={["overflow-hidden bg-(--c-surface)", i === 0 ? "aspect-[4/5] [clip-path:polygon(0_0,84%_0,100%_14%,100%_100%,0_100%)]" : "aspect-square max-w-[16rem] rounded-full bg-(--c-bg)"]}>
              <Pic src={p.photo} alt={p.name} position={i === 0 ? "50% 25%" : undefined} />
            </div>
            <div data-reveal data-delay="100">
              <h3 class="text-[clamp(1.6rem,2.8vw,2.4rem)] font-semibold leading-tight tracking-[-0.025em]">{p.name}</h3>
              {p.role && <p class="mt-1 text-(--c-muted)">{p.role}</p>}
              <blockquote class="mt-6 max-w-[56ch] text-lg leading-relaxed text-(--c-muted)">“{p.quote}”</blockquote>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </Section>

  <CtaBand title="Cuéntanos tu proyecto" href={wa} label="Escribir por WhatsApp" tone="brand" external />
</Layout>
