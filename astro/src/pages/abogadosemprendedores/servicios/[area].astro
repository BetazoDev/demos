---
import Layout from "@/sites/abogadosemprendedores/Layout.astro";
import PageHero from "@/kit/PageHero.astro";
import Section from "@/kit/Section.astro";
import Icon from "@/kit/Icon.astro";
import CtaBand from "@/kit/CtaBand.astro";
import { site } from "@/sites/abogadosemprendedores/site";
import { areas, planes, serviciosIncluibles } from "@/sites/abogadosemprendedores/data";

export function getStaticPaths() {
  return areas.map((a) => ({ params: { area: a.key }, props: { area: a } }));
}
const { area } = Astro.props;
const base = "/abogadosemprendedores";
const others = areas.filter((a) => a.key !== area.key);
const isPoliza = area.key === "poliza-empresarial";
const wa = `https://wa.me/${site.whatsapp.number}?text=${encodeURIComponent(`${site.whatsapp.intro} sobre ${area.cta}.`)}`;
const org = new URL(`/${site.slug}#organizacion`, Astro.site).href;
---

<Layout
  site={site}
  title={`${area.title} | Abogados para Emprendedores MX`}
  description={`${area.lead} Abogados para emprendedores en la Ciudad de México.`}
  breadcrumbs={[{ name: "Servicios", href: `${base}/servicios` }, { name: area.title, href: `${base}/servicios/${area.key}` }]}
  schema={[{ "@context": "https://schema.org", "@type": "Service", name: area.title, description: area.lead, provider: { "@id": org }, areaServed: { "@type": "City", name: "Ciudad de México" } }]}
>
  <PageHero title={area.title} lede={area.lead} transitionName={`area-${area.key}`} />
  <Section size="sm" class="pt-4">
    <div class="wrap grid gap-10 lg:grid-cols-[0.8fr_1.4fr] lg:gap-20">
      <h2 data-reveal class="text-[clamp(1.6rem,3vw,2.4rem)] font-semibold leading-tight tracking-[-0.025em]">{area.itemsTitle}</h2>
      <ul data-stagger data-gap="45" class="grid gap-x-10 gap-y-5 sm:grid-cols-2">
        {area.items.map((i) => (
          <li class="flex gap-3 text-lg leading-snug">
            <Icon name="check" weight="bold" class="mt-1.5 size-4 shrink-0 text-(--c-accent)" />
            <span>{i}</span>
          </li>
        ))}
      </ul>
    </div>
  </Section>
  {
    isPoliza && (
      <Section tone="surface" size="sm">
        <div class="wrap grid gap-10 lg:grid-cols-[0.8fr_1.4fr] lg:gap-20">
          <h2 data-reveal class="text-[clamp(1.6rem,3vw,2.4rem)] font-semibold leading-tight tracking-[-0.025em]">Planes</h2>
          <ul data-stagger data-gap="80" class="grid gap-6">
            {planes.map((p) => (
              <li class="grid gap-1 bg-(--c-bg) p-6 sm:grid-cols-[1fr_auto] sm:items-baseline sm:gap-8 sm:p-7">
                <div>
                  <p class="text-xl font-semibold">{p.name}</p>
                  <p class="mt-1 max-w-[46ch] text-(--c-muted)">{p.text}</p>
                </div>
                <p class="font-(family-name:--f-display) text-3xl font-semibold tracking-[-0.03em]">{p.big}</p>
              </li>
            ))}
          </ul>
        </div>
      </Section>
      <Section size="sm">
        <div class="wrap grid gap-10 lg:grid-cols-[0.8fr_1.4fr] lg:gap-20">
          <h2 data-reveal class="text-[clamp(1.6rem,3vw,2.4rem)] font-semibold leading-tight tracking-[-0.025em]">Servicios que puedes incluir</h2>
          <ul data-stagger data-gap="40" class="grid gap-x-10 gap-y-4 sm:grid-cols-2">
            {serviciosIncluibles.map((i) => (
              <li class="flex gap-3 text-lg leading-snug">
                <Icon name="check" weight="bold" class="mt-1.5 size-4 shrink-0 text-(--c-accent)" />
                <span>{i}</span>
              </li>
            ))}
          </ul>
        </div>
      </Section>
    )
  }
  <Section tone={isPoliza ? "paper" : "surface"} size="sm">
    <div class="wrap">
      <h2 data-reveal class="mb-8 text-[clamp(1.6rem,3vw,2.4rem)] font-semibold leading-tight tracking-[-0.025em]">Otros servicios</h2>
      <ul data-stagger data-gap="45" class="flex flex-wrap gap-3">
        {others.map((o) => <li><a href={`${base}/servicios/${o.key}`} class="press inline-flex border border-(--c-line) bg-(--c-bg) px-5 py-2.5 text-[15px] hover:border-(--c-ink)">{o.title}</a></li>)}
      </ul>
    </div>
  </Section>
  <CtaBand title="Cuéntanos tu proyecto" href={wa} label="Escribir por WhatsApp" tone="brand" external />
</Layout>
