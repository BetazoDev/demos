---
import SiteLayout from "@/kit/SiteLayout.astro";
import PageHero from "@/kit/PageHero.astro";
import Section from "@/kit/Section.astro";
import CtaBand from "@/kit/CtaBand.astro";
import Icon from "@/kit/Icon.astro";
import { site } from "@/sites/riosabogados/site";
import { areas } from "@/sites/riosabogados/data";

const base = "/riosabogados";
const wa = `https://wa.me/${site.whatsapp.number}?text=${encodeURIComponent(site.whatsapp.intro)}`;
---

<SiteLayout site={site} title="Servicios legales en la Ciudad de México | R1OS Abogados" description="Derecho informático, propiedad industrial e intelectual, derecho corporativo, civil y mercantil, administrativo, litigio y derecho migratorio en la Ciudad de México." nav={{ variant: "pill", tone: "light", logoHeight: 44 }} breadcrumbs={[{ name: "Servicios", href: `${base}/servicios` }]}>
  <PageHero title="Servicios" lede="Derecho informático, propiedad industrial e intelectual, corporativo, civil y mercantil, administrativo, litigio y migratorio." />
  <Section size="sm" class="pt-4">
    <div class="wrap">
      <ul data-stagger data-gap="70" class="grid gap-4 md:grid-cols-2">
        {
          areas.map((a) => (
            <li>
              <a href={`${base}/servicios/${a.key}`} class="svc-card group relative flex h-full min-h-[15rem] flex-col justify-between gap-10 rounded-[1.75rem] bg-(--c-surface) p-7 sm:p-9">
                <div>
                  <h2 transition:name={`area-${a.key}`} class="text-[clamp(1.7rem,2.8vw,2.4rem)] font-semibold leading-[1.08] tracking-[-0.03em]">{a.title}</h2>
                  <p class="svc-text mt-4 max-w-[44ch] text-[17px] text-(--c-muted)">{a.lead}</p>
                </div>
                <span class="svc-arr grid size-12 place-items-center self-end rounded-full border border-current/25">
                  <Icon name="arrow-up-right" weight="bold" class="size-5" />
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </Section>
  <CtaBand title="Cuéntenos su caso" href={wa} label="Escribir por WhatsApp" tone="brand" external />
</SiteLayout>

<style is:global>
  .svc-card { transition: background-color 280ms ease, color 280ms ease; }
  .svc-card .svc-arr { transition: background-color 280ms ease, color 280ms ease, border-color 280ms ease, transform 360ms var(--ease-out); }
  @media (hover: hover) and (pointer: fine) {
    .svc-card:hover { background: var(--c-brand); color: var(--c-on-brand); }
    .svc-card:hover .svc-text { color: color-mix(in oklab, var(--c-on-brand) 82%, transparent); }
    .svc-card:hover .svc-arr { background: var(--c-on-brand); color: var(--c-brand); border-color: transparent; transform: translate(2px, -2px); }
  }
</style>
