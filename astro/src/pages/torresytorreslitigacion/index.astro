---
import Layout from "@/sites/torresytorreslitigacion/Layout.astro";
import Hero from "@/sites/torresytorreslitigacion/Hero.astro";
import Button from "@/kit/Button.astro";
import Section from "@/kit/Section.astro";
import Statement from "@/kit/Statement.astro";
import AreasIndex from "@/kit/AreasIndex.astro";
import ImageBand from "@/kit/ImageBand.astro";
import Pic from "@/kit/Pic.astro";
import Accordion from "@/kit/Accordion.astro";
import ContactBlock from "@/kit/ContactBlock.astro";
import Composer from "@/kit/Composer.astro";
import CtaBand from "@/kit/CtaBand.astro";
import { site } from "@/sites/torresytorreslitigacion/site";
import { areas, lineas, team, photos, faqHome, firma } from "@/sites/torresytorreslitigacion/data";

const base = "/torresytorreslitigacion";
const rows = (g: string) => areas.filter((a) => a.group === g).map((a) => ({ key: a.key, title: a.title, text: a.lead, href: `${base}/servicios/${a.key}` }));
const wa = `https://wa.me/${site.whatsapp.number}?text=${encodeURIComponent(site.whatsapp.intro)}`;
const h2 = "text-[clamp(2rem,4.2vw,3.6rem)] leading-[1.06] tracking-[-0.025em]";
---

<Layout
  site={site}
  title="Abogados penalistas en CDMX | Grupo Roberto Torres & Torres, litigación estratégica"
  description="Despacho de abogados penalistas en Verónica Anzures, Ciudad de México: defensa penal, carpetas de investigación, juicios orales, amparo penal, penal financiero y compliance."
  nav={{ variant: "bar", tone: "light", logoHeight: 40 }}
  footer={{ variant: "dark" }}
>
  <Hero title="Litigación penal estratégica" lede="Defensa, representación y consultoría penal con análisis técnico, atención directa y absoluta confidencialidad para personas, empresas e instituciones." image={photos.hero} imageAlt="Lámpara de latón sobre un escritorio de piedra negra con una carpeta de cuero y una pluma dorada" position="50% 40%">
    <Fragment slot="actions">
      <Button href={wa} size="lg" external>Escribir por WhatsApp</Button>
      <Button href={`${base}/servicios`} variant="outline" size="lg">Ver servicios</Button>
    </Fragment>
  </Hero>

  <Section>
    <div class="wrap"><Statement text="Para proteger tus decisiones, tu libertad y tu patrimonio." class="!max-w-[20ch] !font-normal font-(family-name:--f-display)" /></div>
  </Section>

  <Section size="sm" class="!pt-0" id="servicios">
    <div class="wrap">
      <h2 data-reveal class:list={["mb-5 max-w-[22ch]", h2]}>Defensa para personas y prevención para organizaciones</h2>
      <p data-reveal class="mb-14 max-w-[56ch] text-lg text-(--c-muted)">El despacho separa la atención penal urgente de la consultoría corporativa para responder con claridad a necesidades distintas.</p>
      <div class="tt-stack" data-stack>
        {lineas.map((l) => (
          <article class="tt-panel p-6 sm:p-10 lg:p-14">
            <h3 class="mb-8 text-[clamp(1.7rem,3vw,2.6rem)] leading-tight tracking-[-0.02em]">{l.title}</h3>
            <AreasIndex areas={rows(l.key)} />
          </article>
        ))}
      </div>
    </div>
  </Section>

  <ImageBand image={photos.pasillo} alt="Pasillo de un edificio de justicia con arcos de piedra y piso de mármol" position="50% 55%">
    <p class="max-w-[30ch] text-[clamp(1.4rem,2.6vw,2.2rem)] leading-snug">Defensa penal estratégica y prevención de riesgos para personas y organizaciones en Ciudad de México.</p>
  </ImageBand>

  <Section>
    <div class="wrap grid gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:gap-24">
      <div class="lg:sticky lg:top-28 lg:self-start">
        <h2 data-reveal class={h2}>El equipo</h2>
        <p data-reveal data-delay="100" class="mt-6 max-w-[34ch] text-lg text-(--c-muted)">{firma.equipoLead}</p>
        <div data-reveal data-delay="160" class="mt-8"><Button href={`${base}/nosotros`} variant="outline">Conocer a la firma</Button></div>
      </div>
      <ul data-stagger data-gap="90" class="grid gap-10">
        {team.map((p) => (
          <li class="grid grid-cols-[6.5rem_1fr] items-center gap-6 sm:grid-cols-[8.5rem_1fr] sm:gap-10">
            <div class="tt-medal"><Pic src={p.photo} alt={p.name} class="size-full object-cover" /></div>
            <div>
              <h3 class="text-[clamp(1.25rem,2vw,1.7rem)] leading-tight">{p.name}</h3>
              <p class="mt-1 text-(--c-muted)">{p.role}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </Section>

  <Section tone="surface" size="sm">
    <div class="wrap grid gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:gap-24">
      <h2 data-reveal class={h2}>Preguntas frecuentes</h2>
      <div data-reveal data-delay="100"><Accordion items={faqHome} /></div>
    </div>
  </Section>

  <Section id="contacto">
    <div class="wrap grid gap-14 lg:grid-cols-[1fr_1fr] lg:gap-24">
      <div data-reveal>
        <h2 class:list={["mb-10", h2]}>Contacto</h2>
        <ContactBlock site={site} showCta={false} />
      </div>
      <div data-reveal data-delay="120" class="rounded-md border border-(--c-line) bg-(--c-surface) p-6 sm:p-9">
        <Composer site={site} areas={areas.map((a) => a.title)} />
      </div>
    </div>
  </Section>

  <CtaBand title="Hablemos de tu caso" href={wa} label="Escribir por WhatsApp" tone="brand" external />
</Layout>
