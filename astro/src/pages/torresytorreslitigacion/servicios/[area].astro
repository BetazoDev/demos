---
import Layout from "@/sites/torresytorreslitigacion/Layout.astro";
import PageHero from "@/kit/PageHero.astro";
import Section from "@/kit/Section.astro";
import Button from "@/kit/Button.astro";
import Icon from "@/kit/Icon.astro";
import Accordion from "@/kit/Accordion.astro";
import CtaBand from "@/kit/CtaBand.astro";
import { site } from "@/sites/torresytorreslitigacion/site";
import { areas, centinela, photos } from "@/sites/torresytorreslitigacion/data";

export function getStaticPaths() {
  return areas.map((a) => ({ params: { area: a.key }, props: { area: a } }));
}
const { area } = Astro.props;
const base = "/torresytorreslitigacion";
const isCen = area.key === "programa-centinela";
const others = areas.filter((a) => a.key !== area.key);
const wa = `https://wa.me/${site.whatsapp.number}?text=${encodeURIComponent(`${site.whatsapp.intro} sobre ${area.title.toLowerCase()}.`)}`;
const waInc = `https://wa.me/${site.whatsapp.number}?text=${encodeURIComponent("Hola, quiero un diagnóstico inicial del Programa Centinela. Descripción breve del incidente:")}`;
const h2 = "text-[clamp(1.6rem,3vw,2.5rem)] leading-tight tracking-[-0.02em]";
const schema = [
  { "@context": "https://schema.org", "@type": "Service", name: area.title, description: area.lead, provider: { "@id": new URL(`/${site.slug}#organizacion`, Astro.site).href }, areaServed: { "@type": "City", name: "Ciudad de México" } },
  { "@context": "https://schema.org", "@type": "FAQPage", mainEntity: area.faq.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })) },
];
---

<Layout
  site={site}
  title={`${area.title} en CDMX | Grupo Roberto Torres & Torres`}
  description={area.lead}
  nav={{ variant: "bar", tone: "light", logoHeight: 40 }}
  breadcrumbs={[{ name: "Servicios", href: `${base}/servicios` }, { name: area.title, href: `${base}/servicios/${area.key}` }]}
  schema={schema}
>
  <PageHero title={area.title} lede={area.lead} transitionName={`area-${area.key}`} image={isCen ? photos.ciudad : undefined} imageAlt="Vista nocturna de una gran ciudad desde la ventana de una oficina" />

  <Section>
    <div class="wrap grid gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:gap-24">
      <h2 data-reveal class:list={["lg:sticky lg:top-28 lg:self-start", h2]}>{area.kicker}</h2>
      <div data-reveal data-delay="100" class="grid gap-7 text-lg leading-relaxed text-(--c-muted)">
        {area.paragraphs.map((p, i) => <p class:list={[i === 0 && "text-[clamp(1.2rem,1.9vw,1.5rem)] leading-snug text-(--c-ink)"]}>{p}</p>)}
        {
          area.why && (
            <div class="tt-note mt-3">
              <h3 class="text-xl text-(--c-ink)">Por qué conviene actuar a tiempo</h3>
              <p class="mt-3">{area.why}</p>
            </div>
          )
        }
        {isCen && <div class="mt-2 flex flex-wrap gap-3"><Button href={waInc} external>Enviar descripción del incidente</Button></div>}
        {isCen && <ul class="flex flex-wrap gap-2 text-base">{centinela.tags.map((t) => <li class="rounded-md border border-(--c-line) px-4 py-2">{t}</li>)}</ul>}
      </div>
    </div>
  </Section>

  {
    isCen && (
      <Section tone="surface">
        <div class="wrap grid gap-16">
          <div class="grid gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:gap-24">
            <div>
              <h2 data-reveal class={h2}>{centinela.diagTitle}</h2>
              <p data-reveal data-delay="80" class="mt-3 text-lg text-(--c-muted)">{centinela.diagLead}</p>
            </div>
            <div class="grid gap-10">
              <ul data-stagger data-gap="60" class="grid gap-4 text-lg">
                {centinela.diag.map((d) => <li class="flex gap-3"><Icon name="check" weight="bold" class="mt-1.5 size-4 shrink-0 text-(--c-accent)" /><span>{d}</span></li>)}
              </ul>
              <dl data-stagger data-gap="70" class="grid gap-x-10 gap-y-8 sm:grid-cols-2">
                {centinela.incident.map((x) => <div><dt class="text-xl">{x.t}</dt><dd class="mt-2 text-(--c-muted)">{x.d}</dd></div>)}
              </dl>
            </div>
          </div>
        </div>
      </Section>
    )
  }

  <Section tone={isCen ? "paper" : "surface"}>
    <div class="wrap grid gap-14 lg:grid-cols-2 lg:gap-24">
      <div>
        <h2 data-reveal class:list={["mb-8", h2]}>{area.casesTitle}</h2>
        {isCen && <p data-reveal class="-mt-4 mb-8 text-lg text-(--c-muted)">Actúa rápido si detectaste alguno de estos escenarios.</p>}
        <ul data-stagger data-gap="55" class="grid gap-4 text-lg">
          {area.cases.map((c) => <li class="flex gap-3"><Icon name="check" weight="bold" class="mt-1.5 size-4 shrink-0 text-(--c-accent)" /><span>{c}</span></li>)}
        </ul>
      </div>
      {
        area.scope.length > 0 && (
          <div>
            <h2 data-reveal class:list={["mb-8", h2]}>¿Qué puede incluir el servicio?</h2>
            <ul data-stagger data-gap="55" class="grid gap-4 text-lg">
              {area.scope.map((c) => <li class="flex gap-3"><Icon name="check" weight="bold" class="mt-1.5 size-4 shrink-0 text-(--c-accent)" /><span>{c}</span></li>)}
            </ul>
          </div>
        )
      }
      {
        isCen && (
          <div>
            <h2 data-reveal class:list={["mb-8", h2]}>{centinela.systemTitle}</h2>
            <ol data-stagger data-gap="70" class="grid gap-6">
              {centinela.system.map((s) => <li><h3 class="text-xl">{s.t}</h3><p class="mt-1 text-(--c-muted)">{s.d}</p></li>)}
            </ol>
          </div>
        )
      }
    </div>
  </Section>

  <Section tone={isCen ? "surface" : "paper"} size="sm">
    <div class="wrap grid gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:gap-24">
      <h2 data-reveal class={h2}>{area.faqTitle}</h2>
      <div data-reveal data-delay="100"><Accordion items={area.faq} /></div>
    </div>
  </Section>

  <Section tone={isCen ? "paper" : "surface"} size="sm">
    <div class="wrap">
      <h2 data-reveal class:list={["mb-8", h2]}>Otros servicios</h2>
      <ul data-stagger data-gap="45" class="flex flex-wrap gap-3">
        {others.map((o) => <li><a href={`${base}/servicios/${o.key}`} class="press inline-flex rounded-md border border-(--c-line) px-5 py-3 text-[15px] hover:border-(--c-accent) hover:text-(--c-accent)">{o.title}</a></li>)}
      </ul>
    </div>
  </Section>

  <CtaBand title={isCen ? "Diagnóstico por WhatsApp" : "Hablemos de tu caso"} text={isCen ? "Envía una descripción breve del incidente y te decimos el siguiente paso." : undefined} href={isCen ? waInc : wa} label="Escribir por WhatsApp" tone="brand" external />
</Layout>
