---
import Layout from "@/sites/divorcioexpres/Layout.astro";
import PageHero from "@/kit/PageHero.astro";
import Section from "@/kit/Section.astro";
import CtaBand from "@/kit/CtaBand.astro";
import Icon from "@/kit/Icon.astro";
import AreasList from "@/sites/divorcioexpres/AreasList.astro";
import { site } from "@/sites/divorcioexpres/site";
import { areas, otros } from "@/sites/divorcioexpres/data";

const base = "/divorcioexpres";
const wa = `https://wa.me/${site.whatsapp.number}?text=${encodeURIComponent(site.whatsapp.intro + ".")}`;
---

<Layout
  title="Servicios de derecho familiar en CDMX | Divorcio Exprés, Abogados de lo Familiar"
  description="Divorcio exprés, pensión alimenticia, guarda y custodia, patria potestad, visitas y convivencias, adopción, designación de apoyo y sucesiones. Asesoría gratuita en materia familiar en la Ciudad de México."
  breadcrumbs={[{ name: "Servicios", href: `${base}/servicios` }]}
>
  <PageHero title="Servicios" lede="Toda la asesoría que brinda nuestro equipo de abogados expertos y especialistas en materia familiar es totalmente gratuita." />
  <Section size="sm" class="pt-4">
    <div class="wrap">
      <AreasList areas={areas} base={base} />
    </div>
  </Section>
  <Section tone="surface" size="sm">
    <div class="wrap grid gap-8 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16">
      <h2 data-reveal class="text-[clamp(1.6rem,3vw,2.4rem)] leading-tight">Resolvemos todas sus dudas respecto a otros procesos</h2>
      <ul data-stagger data-gap="50" class="grid gap-3 sm:grid-cols-2">
        {
          otros.map((o) => (
            <li class="flex gap-3 text-lg">
              <Icon name="check" weight="bold" class="mt-1.5 size-4 shrink-0 text-(--c-accent)" />
              <span>{o}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </Section>
  <CtaBand title="Decídase de una vez a cambiar su vida" href={wa} label="Escribir por WhatsApp" tone="dark" external />
</Layout>
