---
import Layout from "@/sites/divorcioexpres/Layout.astro";
import HeroTriptych from "@/sites/divorcioexpres/HeroTriptych.astro";
import AreasList from "@/sites/divorcioexpres/AreasList.astro";
import Requisitos from "@/sites/divorcioexpres/Requisitos.astro";
import Button from "@/kit/Button.astro";
import Section from "@/kit/Section.astro";
import Statement from "@/kit/Statement.astro";
import ContactBlock from "@/kit/ContactBlock.astro";
import Composer from "@/kit/Composer.astro";
import CtaBand from "@/kit/CtaBand.astro";
import { site } from "@/sites/divorcioexpres/site";
import { areas, requisitos, photos } from "@/sites/divorcioexpres/data";
import patio from "@/sites/divorcioexpres/assets/patio-colonial.jpg";
import mesa from "@/sites/divorcioexpres/assets/mesa-carpeta.jpg";

const base = "/divorcioexpres";
const wa = `https://wa.me/${site.whatsapp.number}?text=${encodeURIComponent(site.whatsapp.intro + ".")}`;
---

<Layout title="Divorcio exprés en la Ciudad de México: asesoría gratuita | Divorcio Exprés, Abogados de lo Familiar" footer={{ blurb: "Asesoría y representación jurídica de calidad en procesos de carácter familiar." }}>
  <HeroTriptych
    title="Asesoría gratuita para su divorcio exprés"
    lede="En la Ciudad de México, Estado de México y en cualquier proceso de carácter familiar."
    center={{ src: photos.fachada, alt: "Fachada de piedra con grandes puertas de madera en el Centro Histórico de la Ciudad de México", position: "40% 50%" }}
    left={{ src: patio, alt: "Patio colonial con arcos, columnas de piedra y macetas", position: "34% 50%" }}
    right={{ src: mesa, alt: "Mesa junto a una ventana con una carpeta cerrada, una pluma y un vaso de agua", position: "70% 60%" }}
  >
    <Fragment slot="actions">
      <Button href={wa} size="lg" external>Escribir por WhatsApp</Button>
      <Button href={`${base}/servicios`} variant="outline" size="lg">Ver servicios</Button>
    </Fragment>
  </HeroTriptych>

  <Section>
    <div class="wrap"><Statement text="Brindamos asesoría y representación jurídica de calidad a nuestros clientes, en un proceso judicial de carácter familiar." /></div>
  </Section>

  <Section id="servicios" class="pt-0">
    <div class="wrap">
      <h2 data-reveal class="mb-10 text-[clamp(2rem,4.4vw,3.8rem)] leading-[1.05]">Áreas especializadas</h2>
      <AreasList areas={areas} base={base} />
    </div>
  </Section>

  <Section tone="brand" style="--c-step-ink: var(--c-brand)">
    <div class="wrap grid gap-14 lg:grid-cols-[0.8fr_1.2fr] lg:gap-24">
      <div>
        <h2 data-reveal class="text-[clamp(2rem,4.4vw,3.8rem)] leading-[1.05] lg:sticky lg:top-32">Requisitos para su divorcio exprés</h2>
        <div data-reveal data-delay="120" class="mt-10"><Button href={`${base}/servicios/divorcio-expres`} variant="light">Ver el trámite completo</Button></div>
      </div>
      <Requisitos items={requisitos.map((r) => ({ title: r.title }))} />
    </div>
  </Section>

  <Section tone="surface" id="contacto">
    <div class="wrap grid gap-14 lg:grid-cols-2 lg:gap-24">
      <div data-reveal>
        <h2 class="mb-10 text-[clamp(2rem,4.4vw,3.8rem)] leading-[1.05]">Contacto</h2>
        <ContactBlock site={site} showCta={false} />
      </div>
      <div data-reveal data-delay="120" class="rounded-(--c-radius-card) border border-(--c-line) bg-(--c-bg) p-6 sm:p-9">
        <Composer site={site} areas={areas.map((a) => a.title)} />
      </div>
    </div>
  </Section>

  <CtaBand title="Decídase de una vez a cambiar su vida" href={wa} label="Escribir por WhatsApp" tone="dark" external />
</Layout>
