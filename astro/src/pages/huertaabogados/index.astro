---
import SiteLayout from "@/kit/SiteLayout.astro";
import Hero from "@/kit/Hero.astro";
import Button from "@/kit/Button.astro";
import Section from "@/kit/Section.astro";
import Statement from "@/kit/Statement.astro";
import Split from "@/kit/Split.astro";
import Pic from "@/kit/Pic.astro";
import ContactBlock from "@/kit/ContactBlock.astro";
import Composer from "@/kit/Composer.astro";
import Footer from "@/sites/huertaabogados/Footer.astro";
import Materias from "@/sites/huertaabogados/Materias.astro";
import { site } from "@/sites/huertaabogados/site";
import { materias, arrendamiento, abogado, photos } from "@/sites/huertaabogados/data";

const base = "/huertaabogados";
const wa = `https://wa.me/${site.whatsapp.number}?text=${encodeURIComponent(site.whatsapp.intro)}.`;
const h2 = "text-[clamp(2rem,4.4vw,3.8rem)] leading-[1.04] tracking-[-0.025em]";
---

<SiteLayout site={site} title="Huerta Abogados | Asesoría y representación jurídica integral, CDMX" nav={{ variant: "bar", tone: "dark", logoHeight: 66 }} footer={false} bodyClass="[--c-radius-img:6px] [--c-radius-card:6px] [--c-radius-field:6px]">
  <Hero layout="photo" title="Asesoría y Representación Jurídica Integral" lede="Asistimos a nuestros clientes de manera objetiva y profesional en la Ciudad de México y el Estado de México." image={photos.estudio} imageAlt="Estudio con librero de nogal iluminado por una lámpara de latón y un sillón de piel vacío" position="70% 50%">
    <Fragment slot="actions">
      <Button href={wa} variant="light" size="lg" external>Escribir por WhatsApp</Button>
      <Button href={`${base}/servicios`} variant="outline" size="lg">Ver servicios</Button>
    </Fragment>
  </Hero>

  <Section>
    <div class="wrap"><Statement text="Estamos comprometidos con ofrecer un servicio jurídico de alta calidad." class="max-w-[24ch] font-(family-name:--f-display) font-normal! sm:max-w-[26ch]" /></div>
  </Section>

  <Section tone="surface" id="servicios">
    <div class="wrap">
      <h2 data-reveal class={`mb-12 ${h2}`}>Servicios</h2>
      <Materias items={materias} href={`${base}/servicios`} />
    </div>
  </Section>

  <Section>
    <div class="wrap">
      <Split image={photos.llaves} alt="Una llave de latón sobre un documento en blanco, en un escritorio de nogal" ratio="5/4" reverse>
        <h2 class={h2}>Arrendamiento inmobiliario</h2>
        <p class="mt-6 max-w-[46ch] text-lg text-(--c-muted)">{arrendamiento}</p>
        <div class="mt-9"><Button href={`${base}/servicios`} variant="outline">Ver servicios</Button></div>
      </Split>
    </div>
  </Section>

  <div class="relative isolate overflow-hidden bg-(--c-dark) text-(--c-on-dark)" style="min-height:clamp(24rem,50vw,34rem)">
    <div class="absolute inset-0 -z-10" data-parallax="60"><Pic src={photos.escalera} alt="Escalera de piedra con pasamanos de latón en un edificio histórico" class="size-full object-cover" position="50% 50%" /></div>
    <div class="absolute inset-0 -z-10 bg-[linear-gradient(to_right,color-mix(in_oklab,var(--c-dark)_90%,transparent),color-mix(in_oklab,var(--c-dark)_35%,transparent)_75%)]"></div>
    <div class="wrap flex min-h-[inherit] items-end pb-12 sm:pb-16">
      <p data-reveal class="max-w-[26ch] font-(family-name:--f-display) text-[clamp(1.7rem,3.6vw,3rem)] leading-[1.12] tracking-[-0.02em]">No importa cuál sea su problema legal, nuestro equipo de abogados está aquí para ayudarle a encontrar una solución justa y eficaz.</p>
    </div>
  </div>

  <Section id="contacto">
    <div class="wrap grid gap-14 lg:grid-cols-[1fr_1fr] lg:gap-24">
      <div data-reveal>
        <h2 class={`mb-4 ${h2}`}>Contacto</h2>
        <p class="mb-10 text-lg text-(--c-muted)">{abogado.name}, {abogado.role.toLowerCase()}</p>
        <ContactBlock site={site} showCta={false} />
      </div>
      <div data-reveal data-delay="120" class="rounded-(--c-radius) border border-(--c-line) bg-(--c-surface) p-6 sm:p-9">
        <Composer site={site} areas={[...materias, "Arrendamiento inmobiliario"]} />
      </div>
    </div>
  </Section>
  <Footer slot="footer" site={site} variant="dark" />
</SiteLayout>
