---
import SiteLayout from "@/kit/SiteLayout.astro";
import PageHero from "@/kit/PageHero.astro";
import Section from "@/kit/Section.astro";
import Icon from "@/kit/Icon.astro";
import CtaBand from "@/kit/CtaBand.astro";
import { site } from "@/sites/omcabogados/site";
import { areas, areasIntro } from "@/sites/omcabogados/data";

const base = "/omcabogados";
const wa = `https://wa.me/${site.whatsapp.number}?text=${encodeURIComponent(site.whatsapp.intro)}`;
const waArea = (t: string) => `https://wa.me/${site.whatsapp.number}?text=${encodeURIComponent(`${site.whatsapp.intro} sobre ${t.toLowerCase()}.`)}`;
const orgId = new URL(`${base}#organizacion`, Astro.site).href;
const schema = areas.map((a) => ({
  "@context": "https://schema.org",
  "@type": "Service",
  name: a.title,
  description: a.items.join("; "),
  provider: { "@id": orgId },
  areaServed: { "@type": "Country", name: "México" },
  url: new URL(`${base}/servicios#${a.key}`, Astro.site).href,
}));
---

<SiteLayout
  site={site}
  title="Áreas de práctica | Responsabilidades de servidores públicos y derecho administrativo | OMC abogados"
  description="Sistema de responsabilidades de los servidores públicos, asesoría y litigio administrativo, contratación pública, transparencia y datos personales, protección al consumidor y juegos y sorteos."
  nav={{ variant: "pill", tone: "dark", logoHeight: 42 }}
  breadcrumbs={[{ name: "Áreas de práctica", href: `${base}/servicios` }]}
  schema={schema}
>
  <PageHero tone="brand" title="Áreas de práctica" lede={areasIntro} />

  <Section size="sm" class="pt-14 sm:pt-20">
    <div class="wrap grid gap-10 lg:grid-cols-[0.62fr_1.38fr] lg:gap-20">
      <nav aria-label="Áreas de práctica" class="lg:sticky lg:top-28 lg:self-start">
        <ul class="flex flex-wrap gap-2 lg:grid lg:gap-1">
          {areas.map((a) => (
            <li>
              <a href={`#${a.key}`} data-index-link={a.key} class="index-link press block rounded-full border border-(--c-line) px-4 py-2 text-[15px] leading-snug lg:rounded-(--c-radius) lg:border-0 lg:px-4 lg:py-2.5">{a.title}</a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="grid gap-20 sm:gap-24">
        {areas.map((a) => (
          <article id={a.key} data-area-block class="scroll-mt-28">
            <div data-reveal>
              <span class="grid size-12 place-items-center rounded-full bg-(--c-brand) text-(--c-on-brand)"><Icon name={a.icon} class="size-6" /></span>
              <h2 class="mt-6 max-w-[24ch] text-[clamp(1.9rem,3.6vw,3rem)] leading-[1.06] tracking-[-0.025em]">{a.title}</h2>
            </div>
            <ul data-stagger data-gap="60" class="mt-8 grid gap-5">
              {a.items.map((i) => (
                <li class="flex gap-4 text-[17px] leading-relaxed">
                  <Icon name="check" weight="bold" class="mt-1.5 size-4 shrink-0 text-(--c-accent)" />
                  <span>{i}</span>
                </li>
              ))}
            </ul>
            <p data-reveal class="mt-8"><a href={waArea(a.title)} target="_blank" rel="noopener" class="link-u font-medium">Escribir por WhatsApp</a></p>
          </article>
        ))}
      </div>
    </div>
  </Section>

  <CtaBand title="Cuéntenos su caso" href={wa} label="Escribir por WhatsApp" tone="brand" external />
</SiteLayout>

<style is:global>
  .index-link { opacity: 0.6; transition: opacity 200ms ease, background-color 200ms ease; }
  .index-link[aria-current="true"] { opacity: 1; background: var(--c-surface); }
  @media (hover: hover) { .index-link:hover { opacity: 1; } }
</style>

<script>
  let off: Array<() => void> = [];
  let live = false;
  function init() {
    if (live) return;
    live = true;
    const blocks = document.querySelectorAll<HTMLElement>("[data-area-block]");
    const links = new Map<string, HTMLElement>();
    document.querySelectorAll<HTMLElement>("[data-index-link]").forEach((l) => links.set(l.dataset.indexLink!, l));
    if (!blocks.length) return;
    const set = (key: string) => links.forEach((l, k) => (k === key ? l.setAttribute("aria-current", "true") : l.removeAttribute("aria-current")));
    const io = new IntersectionObserver(
      (entries) => {
        const hit = entries.filter((e) => e.isIntersecting).sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)[0];
        if (hit) set((hit.target as HTMLElement).id);
      },
      { rootMargin: "-20% 0px -60% 0px", threshold: 0 },
    );
    blocks.forEach((b) => io.observe(b));
    off.push(() => io.disconnect());
  }
  document.addEventListener("astro:page-load", init);
  document.addEventListener("astro:before-swap", () => { off.forEach((f) => f()); off = []; live = false; });
  init();
</script>
