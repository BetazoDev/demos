---
import Layout from "@/sites/lozanoguzman/Layout.astro";
import PageHero from "@/sites/lozanoguzman/PageHero.astro";
import Section from "@/kit/Section.astro";
import Icon from "@/kit/Icon.astro";
import CtaBand from "@/kit/CtaBand.astro";
import { site } from "@/sites/lozanoguzman/site";
import { areas } from "@/sites/lozanoguzman/areas";

export function getStaticPaths() {
  return areas.map((a) => ({ params: { area: a.key }, props: { area: a } }));
}
const { area } = Astro.props;
const base = "/lozanoguzman";
const others = areas.filter((a) => a.key !== area.key);
const wa = `https://wa.me/${site.whatsapp.number}?text=${encodeURIComponent(`${site.whatsapp.intro} sobre ${area.short.toLowerCase()}.`)}`;
const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    name: area.title,
    description: `${area.lead}${area.body ? " " + area.body : ""}`,
    provider: { "@id": new URL(`${base}#organizacion`, Astro.site).href },
    areaServed: { "@type": "City", name: "Ciudad de México" },
  },
];
const cols = area.items.length > 6 ? "sm:grid-cols-2" : "";
---

<Layout site={site} title={`${area.title} | Lozano Guzmán Abogados, CDMX y Ecatepec`} description={area.lead} schema={schema} breadcrumbs={[{ name: "Servicios", href: `${base}/servicios` }, { name: area.short, href: `${base}/servicios/${area.key}` }]}>
  <PageHero title={area.title} transitionName={`area-${area.key}`} />
  <Section size="sm" class="pt-6">
    <div class="wrap grid gap-12 lg:grid-cols-[0.95fr_1.05fr] lg:gap-24">
      <div>
        <p data-reveal class="max-w-[46ch] font-(family-name:--f-display) text-[clamp(1.35rem,2.1vw,1.8rem)] leading-[1.4]">{area.lead}</p>
        {area.body && <p data-reveal data-delay="100" class="mt-8 max-w-[56ch] text-lg text-(--c-muted)">{area.body}</p>}
      </div>
      <div>
        <h2 data-reveal class="mb-7 font-(family-name:--f-display) text-[clamp(1.4rem,2.2vw,1.9rem)] font-bold leading-tight">{area.itemsTitle}</h2>
        <ul data-stagger data-gap="40" class={`grid gap-x-10 gap-y-4 ${cols}`}>
          {area.items.map((i) => (
            <li class="flex gap-3 text-[17px] leading-snug">
              <Icon name="check" weight="bold" class="mt-1 size-4 shrink-0 text-(--c-accent)" />
              <span>{i}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </Section>
  <Section size="sm" class="pt-4">
    <div class="wrap">
      <h2 data-reveal class="mb-8 font-(family-name:--f-display) text-[clamp(1.4rem,2.2vw,1.9rem)] font-bold leading-tight">Otros servicios</h2>
      <ul data-stagger data-gap="30" class="flex flex-wrap gap-2.5">
        {others.map((o) => <li><a href={`${base}/servicios/${o.key}`} class="press inline-flex border border-(--c-line) bg-(--c-surface) px-4 py-2.5 text-[15px] hover:border-(--c-accent) hover:text-(--c-accent)">{o.short}</a></li>)}
      </ul>
    </div>
  </Section>
  <CtaBand title="La defensa como derecho humano, al alcance de todos" href={wa} label="Escribir por WhatsApp" tone="surface" external />
</Layout>
