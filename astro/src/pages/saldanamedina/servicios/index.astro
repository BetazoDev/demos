---
import SiteLayout from "@/kit/SiteLayout.astro";
import PageHero from "@/kit/PageHero.astro";
import Section from "@/kit/Section.astro";
import CtaBand from "@/sites/saldanamedina/Cta.astro";
import Icon from "@/kit/Icon.astro";
import "@/sites/saldanamedina/theme.css";
import { site } from "@/sites/saldanamedina/site";
import { areas, facilidades, photos } from "@/sites/saldanamedina/data";

const base = "/saldanamedina";
const wa = `https://wa.me/${site.whatsapp.number}?text=${encodeURIComponent(site.whatsapp.intro)}`;
const schema = areas.map((a) => ({
  "@context": "https://schema.org",
  "@type": "Service",
  name: a.title,
  ...(a.lead ? { description: a.lead } : {}),
  provider: { "@id": new URL(`/${site.slug}#organizacion`, Astro.site).href },
  areaServed: { "@type": "City", name: "Ciudad de México" },
}));
---

<SiteLayout site={site} title="Servicios | Saldaña Medina & Abogados, abogados en Ciudad de México" description="Representación jurídica en juicios mercantiles, familiares y administrativos, juicios penales y civiles, y responsabilidades administrativas de servidores públicos en Ciudad de México." nav={{ variant: "pill", tone: "light", logoHeight: 42 }} breadcrumbs={[{ name: "Servicios", href: `${base}/servicios` }]} schema={schema}>
  <PageHero title="Servicios" lede="Representación especializada en asuntos jurídicos, con base en Ciudad de México." image={photos.columnata} imageAlt="Columnata de piedra de un edificio público al anochecer, en blanco y negro" />
  <Section>
    <div class="wrap">
      <ul data-stagger data-gap="90" class="divide-y divide-(--c-line) border-y border-(--c-line)">
        {areas.map((a) => (
          <li id={a.key} class="grid gap-4 py-10 sm:grid-cols-[1.1fr_1fr] sm:gap-12 sm:py-14">
            <h2 transition:name={`area-${a.key}`} class="text-[clamp(1.7rem,3.4vw,2.9rem)] font-light leading-[1.05] tracking-[-0.025em]">{a.title}</h2>
            {a.lead && <p class="max-w-[46ch] text-lg text-(--c-muted)">{a.lead}</p>}
          </li>
        ))}
      </ul>
    </div>
  </Section>
  <Section tone="surface" size="sm">
    <div class="wrap">
      <h2 data-reveal class="mb-8 text-[clamp(1.6rem,3vw,2.4rem)] font-light leading-tight tracking-[-0.02em]">Facilidades</h2>
      <ul data-stagger data-gap="60" class="grid gap-4 sm:grid-cols-2">
        {facilidades.map((f) => (
          <li class="flex items-center gap-4 rounded-(--c-radius) border border-(--c-line) px-6 py-5 text-lg">
            <Icon name="check" weight="bold" class="size-4 shrink-0 text-(--c-accent)" />
            {f}
          </li>
        ))}
      </ul>
    </div>
  </Section>
  <CtaBand title="Cuéntenos su caso" href={wa} label="Escribir por WhatsApp" external />
</SiteLayout>
