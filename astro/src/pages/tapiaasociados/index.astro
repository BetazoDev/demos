---
import Layout from "@/sites/tapiaasociados/Layout.astro";
import Button from "@/kit/Button.astro";
import Hero from "@/kit/Hero.astro";
import Section from "@/kit/Section.astro";
import Statement from "@/kit/Statement.astro";
import Split from "@/kit/Split.astro";
import ContactBlock from "@/kit/ContactBlock.astro";
import Composer from "@/kit/Composer.astro";
import CtaBand from "@/kit/CtaBand.astro";
import StackCards from "@/sites/tapiaasociados/StackCards.astro";
import { site } from "@/sites/tapiaasociados/site";
import { areas, photos } from "@/sites/tapiaasociados/data";

const base = "/tapiaasociados";
const wa = `https://wa.me/${site.whatsapp.number}?text=${encodeURIComponent(site.whatsapp.intro + ".")}`;
---

<Layout title="Abogados especialistas en materia civil y familiar en CDMX | Abogados Tapia & Asociados" nav={{ tone: "dark" }} footer={{ blurb: "Especialistas en materia civil y familiar." }}>
  <Hero layout="photo" title="Especialistas en materia civil y familiar" lede="Damos soluciones a sus problemas legales de una forma ágil, eficaz y atendiendo sus necesidades." image={photos.sala} imageAlt="Sala de consulta con mesa de madera, dos sillones y una ventana con luz cálida" position="50% 60%">
    <Fragment slot="actions">
      <Button href={wa} variant="light" size="lg" external>Escribir por WhatsApp</Button>
      <Button href={`${base}/servicios`} variant="outline" size="lg">Ver servicios</Button>
    </Fragment>
  </Hero>

  <Section>
    <div class="wrap"><Statement text="Cuando se toma la decisión de disolver el vínculo matrimonial, muchas dudas llegan. Permítanos apoyarle en dicho proceso." /></div>
  </Section>

  <Section size="sm" id="servicios" class="pt-0">
    <div class="wrap">
      <h2 data-reveal class="mb-10 text-[clamp(2rem,4.4vw,3.8rem)] leading-[1.05]">Nuestras especialidades</h2>
      <StackCards areas={areas} base={base} />
    </div>
  </Section>

  <Section>
    <div class="wrap">
      <Split image={photos.mazo} alt="Mazo de juez sobre su base de madera frente a tomos de leyes" position="28% 50%" ratio="4/5">
        <h2 class="text-[clamp(2rem,4.4vw,3.6rem)] leading-[1.05]">Venga a visitarnos</h2>
        <p class="mt-6 max-w-[40ch] text-lg leading-relaxed text-(--c-muted)">Nos encanta recibir a nuestros clientes. Agende su cita para brindarle la adecuada asesoría jurídica.</p>
        <div class="mt-9 flex flex-wrap gap-3">
          <Button href={wa} external>Escribir por WhatsApp</Button>
          {site.mapsUrl && <Button href={site.mapsUrl} variant="outline" external>Ver en el mapa</Button>}
        </div>
        <p class="mt-8 text-[15px] text-(--c-muted)">Aceptamos tarjetas de crédito y débito.</p>
      </Split>
    </div>
  </Section>

  <Section tone="surface" id="contacto">
    <div class="wrap grid gap-14 lg:grid-cols-2 lg:gap-24">
      <div data-reveal>
        <h2 class="mb-10 text-[clamp(2rem,4.4vw,3.8rem)] leading-[1.05]">Contacto</h2>
        <ContactBlock site={site} showCta={false} />
      </div>
      <div data-reveal data-delay="120" class="rounded-(--c-radius-card) border border-(--c-line) bg-(--c-bg) p-6 sm:p-9">
        <Composer site={site} areas={areas.map((a) => a.title)} />
      </div>
    </div>
  </Section>

  <CtaBand title="Agende su cita" href={wa} label="Escribir por WhatsApp" tone="brand" external />
</Layout>
