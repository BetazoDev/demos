---
import SiteLayout from "@/kit/SiteLayout.astro";
import PageHero from "@/kit/PageHero.astro";
import Section from "@/kit/Section.astro";
import Button from "@/kit/Button.astro";
import Icon from "@/kit/Icon.astro";
import CtaBand from "@/kit/CtaBand.astro";
import Tiers from "@/sites/enley/Tiers.astro";
import Steps from "@/sites/enley/Steps.astro";
import Faq from "@/sites/enley/Faq.astro";
import "@/sites/enley/theme.css";
import { site } from "@/sites/enley/site";
import { services } from "@/sites/enley/services";

export function getStaticPaths() {
  return services.map((s) => ({ params: { area: s.key }, props: { s } }));
}
const { s } = Astro.props;
const base = "/enley";
const others = services.filter((o) => o.key !== s.key);
const wa = `https://wa.me/${site.whatsapp.number}?text=${encodeURIComponent(`${site.whatsapp.intro} sobre ${s.title.toLowerCase()}.`)}`;
const h2 = "text-[clamp(1.8rem,3.4vw,2.8rem)] font-semibold leading-[1.05]";
const seo: Record<string, { title: string; description: string }> = {
  "creacion-empresa": { title: "Constitución de empresa en línea desde $1,500 | Enley", description: "Constituye tu SAS o tu empresa tradicional en línea, acompañado por un abogado experto. SAS desde $1,500, empresa tradicional $18,000. Primera consulta gratuita." },
  "registro-marca": { title: "Registro de marca en México desde $5,900 | Enley", description: "Búsqueda de marca $750, registro de marca $5,900 y registro con estudio $6,500. Registra, renueva y declara el uso de tu marca con abogados en línea." },
  repse: { title: "REPSE: consigue o renueva tu registro en línea | Enley", description: "Tramitamos tu REPSE ante la STPS para personas físicas y morales, con un abogado experto y trámite en línea. Primera consulta gratuita." },
  contaduria: { title: "Contaduría online para personas y empresas desde $750 al mes | Enley", description: "Declaraciones de impuestos, reporte de ingresos y gastos, asesoría fiscal y contable y facturación. Contaduría online desde $750 + IVA al mes." },
  "constancia-empleador": { title: "Constancia del Empleador ante el INM por $5,000 | Enley", description: "Obtén tu Constancia del Empleador ante el Instituto Nacional de Migración en aproximadamente 20 días, con trámite en línea y abogados expertos." },
  divorcio: { title: "Divorcio en línea en 8 días hábiles desde $4,000 | Enley", description: "Divorcio voluntario, administrativo o unilateral con abogados especialistas. Proceso ágil y discreto, desde $4,000 + IVA, en la Ciudad de México." },
};
const faqSchema = s.faq
  ? [{ "@context": "https://schema.org", "@type": "FAQPage", mainEntity: s.faq.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a.join(" ") } })) }]
  : [];
const schema = [
  { "@context": "https://schema.org", "@type": "Service", name: s.title, description: s.lede, provider: { "@id": new URL(`/${site.slug}#organizacion`, Astro.site).href }, areaServed: { "@type": "Country", name: "México" } },
  ...faqSchema,
];
---

<SiteLayout site={site} title={seo[s.key].title} description={seo[s.key].description} nav={{ variant: "pill", tone: "dark" }} breadcrumbs={[{ name: "Servicios", href: `${base}/servicios` }, { name: s.title, href: `${base}/servicios/${s.key}` }]} schema={schema}>
  <PageHero title={s.title} lede={`${s.headline}. ${s.lede}`} transitionName={`area-${s.key}`}>
    <div data-hero style="--i:2" class="mt-9 flex flex-wrap items-center gap-4">
      <Button href={wa} size="lg" external>Escribir por WhatsApp</Button>
      <span class="rounded-full border border-(--c-line) px-5 py-2.5 text-lg font-medium tabular-nums">{s.price}</span>
    </div>
  </PageHero>

  {s.intro && (
    <Section size="sm">
      <div class="wrap grid gap-8 lg:grid-cols-[0.8fr_1.2fr] lg:gap-20">
        <h2 data-reveal class={h2}>{s.introTitle}</h2>
        <div data-reveal data-delay="100" class="grid max-w-[60ch] gap-5 text-lg text-(--c-muted)">
          {s.intro.map((p) => <p>{p}</p>)}
        </div>
      </div>
    </Section>
  )}

  {s.tiers && (
    <Section size="sm" tone="surface">
      <div class="wrap">
        <h2 data-reveal class:list={["mb-10", h2]}>{s.tiersTitle}</h2>
        <Tiers tiers={s.tiers} />
        {s.tiersNote && <p data-reveal class="mt-6 text-(--c-muted)">{s.tiersNote}</p>}
      </div>
    </Section>
  )}

  {s.tiers2 && (
    <Section size="sm">
      <div class="wrap">
        <h2 data-reveal class:list={["mb-10", h2]}>{s.tiers2Title}</h2>
        <Tiers tiers={s.tiers2} />
      </div>
    </Section>
  )}

  {s.list && (
    <Section size="sm">
      <div class="wrap grid gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:gap-20">
        <h2 data-reveal class={h2}>{s.listTitle}</h2>
        <div class="grid gap-14">
          <ul data-stagger data-gap="45" class="grid gap-x-10 gap-y-4 sm:grid-cols-2">
            {s.list.map((i) => (
              <li class="flex gap-3.5 border-b border-(--c-line) pb-4 text-lg leading-snug">
                <Icon name="check" weight="bold" class="mt-1.5 size-4 shrink-0 text-(--c-accent)" />
                <span>{i}</span>
              </li>
            ))}
          </ul>
          {s.list2 && (
            <div>
              <h3 data-reveal class="mb-6 text-[clamp(1.4rem,2.2vw,1.9rem)] font-medium tracking-[-0.02em]">{s.list2Title}</h3>
              <ul data-stagger data-gap="45" class="grid gap-x-10 gap-y-4 sm:grid-cols-2">
                {s.list2.map((i) => (
                  <li class="flex gap-3.5 border-b border-(--c-line) pb-4 text-lg leading-snug">
                    <Icon name="check" weight="bold" class="mt-1.5 size-4 shrink-0 text-(--c-accent)" />
                    <span>{i}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>
      </div>
    </Section>
  )}

  {s.steps && (
    <Section tone="surface">
      <div class="wrap">
        <h2 data-reveal class:list={["mb-16 max-w-[24ch]", h2]}>{s.stepsTitle}</h2>
        <Steps steps={s.steps} />
      </div>
    </Section>
  )}

  {s.faq && (
    <Section>
      <div class="wrap grid gap-10 lg:grid-cols-[0.7fr_1.3fr] lg:gap-20">
        <h2 data-reveal class={h2}>Preguntas frecuentes</h2>
        <Faq items={s.faq} />
      </div>
    </Section>
  )}

  <Section tone="surface" size="sm">
    <div class="wrap">
      <h2 data-reveal class="mb-8 text-[clamp(1.6rem,3vw,2.4rem)] font-semibold leading-tight">Otros servicios</h2>
      <ul data-stagger data-gap="45" class="flex flex-wrap gap-3">
        {others.map((o) => <li><a href={`${base}/servicios/${o.key}`} class="press inline-flex rounded-full border border-(--c-line) bg-(--c-bg) px-5 py-2.5 text-[15px] hover:border-(--c-ink)">{o.title}</a></li>)}
      </ul>
    </div>
  </Section>

  <CtaBand title="Primera consulta gratuita" text="Cuéntanos tu caso y un abogado se pondrá en contacto contigo." href={wa} label="Escribir por WhatsApp" tone="brand" external />
</SiteLayout>
