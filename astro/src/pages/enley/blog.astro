---
import SiteLayout from "@/kit/SiteLayout.astro";
import PageHero from "@/kit/PageHero.astro";
import Section from "@/kit/Section.astro";
import Icon from "@/kit/Icon.astro";
import CtaBand from "@/kit/CtaBand.astro";
import "@/sites/enley/theme.css";
import { site } from "@/sites/enley/site";
import { posts } from "@/sites/enley/data";

const base = "/enley";
const wa = `https://wa.me/${site.whatsapp.number}?text=${encodeURIComponent(site.whatsapp.intro)}`;
const fmt = new Intl.DateTimeFormat("es-MX", { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" });
---

<SiteLayout site={site} title="Blog | Enley, todo lo que debes saber sobre el mundo legal" description="Artículos de Enley sobre registro de marca, divorcio exprés y constitución de empresas en México, incluidos los publicados para extranjeros." nav={{ variant: "pill", tone: "dark" }} breadcrumbs={[{ name: "Blog", href: `${base}/blog` }]}>
  <PageHero title="Blog" lede="Todo lo que debes saber sobre el mundo legal." />
  <Section size="sm" class="pt-4">
    <div class="wrap">
      <ul data-stagger data-gap="80" class="divide-y divide-(--c-line) border-y border-(--c-line)">
        {posts.map((p) => (
          <li>
            <a href={`https://www.enley.mx/blog/${p.slug}`} target="_blank" rel="noopener" class="group grid gap-3 py-8 md:grid-cols-[11rem_1fr_auto] md:items-start md:gap-10 md:py-10">
              <time datetime={p.date} class="text-[15px] text-(--c-muted) md:pt-2">{fmt.format(new Date(p.date))}</time>
              <div>
                <h2 class="text-[clamp(1.5rem,2.6vw,2.2rem)] font-medium leading-[1.12] tracking-[-0.025em]">{p.title}</h2>
                <p class="mt-3 max-w-[60ch] text-lg text-(--c-muted)">{p.text}</p>
                {p.lang === "en" && <p class="mt-3 text-[15px] text-(--c-muted)">Artículo en inglés</p>}
              </div>
              <Icon name="arrow-up-right" weight="bold" class="hidden size-6 opacity-50 transition-[opacity,translate] duration-300 ease-(--ease-out) group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-hover:opacity-100 md:block md:mt-2" />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </Section>
  <CtaBand title="Te ayudamos a resolver cualquier duda" href={wa} label="Escribir por WhatsApp" tone="brand" external />
</SiteLayout>
