---
import SiteLayout from "@/kit/SiteLayout.astro";
import Button from "@/kit/Button.astro";
import Section from "@/kit/Section.astro";
import Statement from "@/kit/Statement.astro";
import Stats from "@/sites/enley/Stats.astro";
import Icon from "@/kit/Icon.astro";
import ContactBlock from "@/kit/ContactBlock.astro";
import CtaBand from "@/kit/CtaBand.astro";
import Hero from "@/sites/enley/Hero.astro";
import ServiceRows from "@/sites/enley/ServiceRows.astro";
import Steps from "@/sites/enley/Steps.astro";
import Reviews from "@/sites/enley/Reviews.astro";
import Composer from "@/sites/enley/Composer.astro";
import "@/sites/enley/theme.css";
import mark from "@/sites/enley/assets/mark.svg";
import { site } from "@/sites/enley/site";
import { home, reviews } from "@/sites/enley/data";
import { services } from "@/sites/enley/services";

const base = "/enley";
const wa = `https://wa.me/${site.whatsapp.number}?text=${encodeURIComponent(site.whatsapp.intro)}`;
const rows = services.map((s) => ({ key: s.key, title: s.title, text: s.blurb, price: s.price, href: `${base}/servicios/${s.key}` }));
const h2 = "text-[clamp(2rem,4.4vw,3.8rem)] font-semibold leading-[1.02]";
---

<SiteLayout site={site} title="Enley | Abogados en línea: constitución de empresa, registro de marca y divorcio" nav={{ variant: "pill", tone: "dark" }} footer={{ variant: "dark" }}>
  <Hero title={home.tagline} lede={home.lede} mark={mark.src}>
    <Fragment slot="actions">
      <Button href={wa} size="lg" external>Escribir por WhatsApp</Button>
      <Button href={`${base}/servicios`} variant="outline" size="lg">Ver servicios</Button>
    </Fragment>
  </Hero>

  <Section>
    <div class="wrap"><Statement text={home.statement} /></div>
  </Section>

  <Section tone="surface" id="servicios">
    <div class="wrap">
      <h2 data-reveal class:list={["mb-6", h2]}>Servicios</h2>
      <p data-reveal class="mb-12 text-(--c-muted)">Precios en pesos mexicanos, sin IVA.</p>
      <ServiceRows rows={rows} />
    </div>
  </Section>

  <Section>
    <div class="wrap">
      <div data-reveal class="mb-16 grid gap-5 lg:grid-cols-[1fr_1fr] lg:gap-24">
        <h2 class={h2}>{home.stepsTitle}</h2>
        <p class="max-w-[44ch] text-lg text-(--c-muted) lg:pt-3">{home.stepsLead}</p>
      </div>
      <Steps steps={home.steps} />
    </div>
  </Section>

  <Section tone="surface">
    <div class="wrap">
      <Stats stats={home.stats} />
    </div>
  </Section>

  <Section>
    <div class="wrap">
      <Reviews rating={site.google!.rating} count={site.google!.reviews} quotes={reviews} />
    </div>
  </Section>

  <Section tone="surface">
    <div class="wrap">
      <h2 data-reveal class:list={["mb-14", h2]}>{home.whyTitle}</h2>
      <dl data-stagger data-gap="90" class="grid gap-x-16 gap-y-12 sm:grid-cols-2">
        {home.why.map((w) => (
          <div class="border-t border-(--c-line) pt-7">
            <dt class="font-(family-name:--f-display) text-[clamp(1.5rem,2.4vw,2rem)] font-medium leading-tight tracking-[-0.02em]">{w.title}</dt>
            <dd class="mt-3 max-w-[40ch] text-lg text-(--c-muted)">{w.text}</dd>
          </div>
        ))}
      </dl>
    </div>
  </Section>

  <Section id="contacto">
    <div class="wrap grid gap-14 lg:grid-cols-2 lg:gap-24">
      <div data-reveal>
        <h2 class:list={["mb-10", h2]}>Consulta gratis con un abogado</h2>
        <ContactBlock site={site} showCta={false} />
      </div>
      <div data-reveal data-delay="120" class="rounded-(--c-radius-card) border border-(--c-line) bg-(--c-surface) p-6 sm:p-9">
        <Composer site={site} areas={services.map((s) => s.title)} />
      </div>
    </div>
  </Section>

  <CtaBand title="Te ayudamos a resolver cualquier duda" href={wa} label="Escribir por WhatsApp" tone="brand" external />
</SiteLayout>
