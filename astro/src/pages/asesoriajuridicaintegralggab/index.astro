---
import SiteLayout from "@/sites/asesoriajuridicaintegralggab/Page.astro";
import Button from "@/kit/Button.astro";
import Section from "@/kit/Section.astro";
import Statement from "@/kit/Statement.astro";
import ContactBlock from "@/kit/ContactBlock.astro";
import CtaBand from "@/kit/CtaBand.astro";
import Icon from "@/kit/Icon.astro";
import Hero from "@/sites/asesoriajuridicaintegralggab/Hero.astro";
import Composer from "@/sites/asesoriajuridicaintegralggab/Composer.astro";
import { site } from "@/sites/asesoriajuridicaintegralggab/site";
import { titulo, lede, alcance, servicios } from "@/sites/asesoriajuridicaintegralggab/data";
import logoLight from "@/sites/asesoriajuridicaintegralggab/assets/logo-light.png";

const base = "/asesoriajuridicaintegralggab";
const wa = `https://wa.me/${site.whatsapp.number}?text=${encodeURIComponent(site.whatsapp.intro)}`;
---

<SiteLayout site={site} title="G&G Asesoría Jurídica Integral | Despacho jurídico de consultoría y litigio en CDMX y Estado de México" nav={{ variant: "pill", tone: "dark", logoHeight: 52 }} footer={{ variant: "dark", blurb: "Firma Legal" }}>
  <Hero title={titulo} lede={lede} logo={logoLight} logoAlt="G&G Asesoría Jurídica Integral, Firma Legal: un búho sobre una balanza">
    <Fragment slot="actions">
      <Button href={wa} variant="light" size="lg" external>Escribir por WhatsApp</Button>
      <Button href="#servicios" variant="outline" size="lg">Ver servicios</Button>
    </Fragment>
  </Hero>

  <Section>
    <div class="wrap"><Statement text={alcance} /></div>
  </Section>

  <Section tone="surface" id="servicios">
    <div class="wrap">
      <h2 data-reveal class="mb-10 text-[clamp(2rem,4.2vw,3.6rem)] font-bold leading-[1.02] tracking-[-0.03em]">Servicios</h2>
      <ul data-reveal data-delay="80" class="gg-cloud text-[clamp(1.55rem,3.3vw,3rem)] font-medium leading-[1.22] tracking-[-0.02em]">
        {servicios.map((s) => <li><a href="#contacto" data-area={s} class="gg-link">{s}</a></li>)}
      </ul>
      <p data-reveal class="mt-10 max-w-[48ch] text-[15px] text-(--c-muted)">Elige un servicio y el redactor de abajo lo prepara para WhatsApp.</p>
    </div>
  </Section>

  <Section id="contacto">
    <div class="wrap grid gap-14 lg:grid-cols-2 lg:gap-24">
      <div data-reveal>
        <h2 class="mb-10 text-[clamp(2rem,4.2vw,3.6rem)] font-bold leading-[1.02] tracking-[-0.03em]">Contacto</h2>
        <ContactBlock site={site} showCta={false} />
        <a href={site.social.facebook!} target="_blank" rel="noopener" class="mt-8 flex gap-4 text-[17px]"><Icon name="facebook-logo" class="mt-1 size-5 shrink-0 opacity-55" /><span class="link-u">Facebook G&amp;GJURIDICO15</span></a>
      </div>
      <div data-reveal data-delay="120" class="rounded-(--c-radius-card) border border-(--c-line) bg-(--c-surface) p-6 sm:p-9">
        <Composer site={site} areas={servicios} />
      </div>
    </div>
  </Section>

  <CtaBand title="Problemas legales ¡Contáctanos!" href={wa} label="Escribir por WhatsApp" tone="brand" external />
</SiteLayout>

<style is:global>
  .gg-cloud li { display: inline; }
  .gg-cloud li:not(:last-child)::after { content: "/"; margin: 0 0.4em; color: var(--c-accent); font-weight: 400; }
  .gg-link { background: linear-gradient(var(--c-accent), var(--c-accent)) 0 100% / 0 0.08em no-repeat; transition: background-size 350ms var(--ease-out), color 250ms var(--ease-out); }
  @media (hover: hover) { .gg-link:hover { background-size: 100% 0.08em; color: var(--c-accent); } }
  .gg-link:focus-visible { background-size: 100% 0.08em; }
</style>
