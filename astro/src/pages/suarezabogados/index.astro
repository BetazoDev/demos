---
import Layout from "@/sites/suarezabogados/Layout.astro";
import Hero from "@/sites/suarezabogados/Hero.astro";
import Button from "@/kit/Button.astro";
import Section from "@/kit/Section.astro";
import Statement from "@/kit/Statement.astro";
import Icon from "@/kit/Icon.astro";
import ContactBlock from "@/kit/ContactBlock.astro";
import Composer from "@/kit/Composer.astro";
import { site } from "@/sites/suarezabogados/site";
import { pensiones, laboral, petrolero, imss, areasComposer, photos } from "@/sites/suarezabogados/data";

const base = "/suarezabogados";
const wa = `https://wa.me/${site.whatsapp.number}?text=${encodeURIComponent(site.whatsapp.intro)}`;
const socials = [
  { name: "Facebook", icon: "facebook-logo", href: site.social.facebook! },
  { name: "YouTube", icon: "youtube-logo", href: site.social.youtube! },
  { name: "TikTok", icon: "tiktok-logo", href: site.social.tiktok! },
];
---

<Layout site={site} title="Abogados en pensiones y derecho laboral en la Ciudad de México | Suárez Abogados" description="Abogados en pensiones IMSS, ISSSTE, ISSFAM e ISSEMYM y en derecho laboral para trabajadores IMSS y petroleros. Oficina en Av. Insurgentes Centro, colonia San Rafael, Ciudad de México.">
  <Hero title="Abogados en pensiones y derecho laboral" lede="Pensiones IMSS, ISSSTE, ISSFAM e ISSEMYM, y representación jurídica especializada en derecho laboral." image={photos.escritorio} imageAlt="Una carpeta, unos lentes de lectura y una taza sobre un escritorio de madera junto a la ventana" position="50% 60%">
    <Fragment slot="actions">
      <Button href={wa} variant="light" size="lg" external>Escribir por WhatsApp</Button>
      <Button href="#servicios" variant="outline" size="lg">Ver servicios</Button>
    </Fragment>
  </Hero>

  <Section class="pt-28 lg:pt-52">
    <div class="wrap"><Statement text="El Corporativo Suárez Abogados fue fundado en 1996." /></div>
  </Section>

  <Section tone="surface" id="servicios">
    <div class="wrap">
      <h2 data-reveal class="mb-12 text-[clamp(2.2rem,4.8vw,4rem)] font-semibold leading-none tracking-[-0.03em]">Servicios</h2>
      <ul data-stagger data-gap="120" class="grid gap-4 lg:grid-cols-3">
        <li class="panel panel-dark bg-(--c-dark) p-8 text-(--c-on-dark) sm:p-12 lg:col-span-2" style="--i:0">
          <h3 class="max-w-[22ch] text-[clamp(1.8rem,3vw,2.6rem)] font-semibold leading-tight tracking-[-0.02em]">{pensiones.title}</h3>
          <ul class="mt-7 flex flex-wrap gap-2.5">
            {pensiones.tipos.map((t) => <li class="rounded-(--c-radius) border border-current/30 px-4 py-2 text-[15px]">{t}</li>)}
          </ul>
          <dl class="mt-9 grid gap-x-10 gap-y-6 sm:grid-cols-2">
            {pensiones.casos.map((c) => (
              <div>
                <dt class="text-lg font-semibold leading-snug">{c.q}</dt>
                <dd class="mt-1 text-lg opacity-85">{c.a}</dd>
              </div>
            ))}
          </dl>
        </li>
        <li class="panel bg-(--c-bg) p-8 sm:p-10" style="--i:1">
          <h3 class="text-[clamp(1.6rem,2.4vw,2.1rem)] font-semibold leading-tight tracking-[-0.02em]">{laboral.title}</h3>
          <p class="mt-5 text-lg leading-relaxed text-(--c-muted)">{laboral.lead}</p>
          <p class="mt-6 inline-flex items-center gap-2 text-lg font-bold text-(--c-accent)"><Icon name="check-circle" weight="fill" class="size-5" />{laboral.nota}</p>
        </li>
        <li class="panel bg-(--c-bg) p-8 sm:p-10" style="--i:2">
          <h3 class="text-[clamp(1.6rem,2.4vw,2.1rem)] font-semibold leading-tight tracking-[-0.02em]">{petrolero.title}</h3>
          <ul class="mt-5 grid gap-3 text-lg leading-snug text-(--c-muted)">
            {petrolero.items.map((i) => <li class="flex gap-3"><Icon name="check" weight="bold" class="mt-1.5 size-4 shrink-0 text-(--c-accent)" /><span>{i}</span></li>)}
          </ul>
        </li>
        <li class="panel bg-(--c-bg) p-8 sm:p-10 lg:col-span-2" style="--i:3">
          <h3 class="text-[clamp(1.6rem,2.4vw,2.1rem)] font-semibold leading-tight tracking-[-0.02em]">{imss.title}</h3>
          <p class="mt-3 text-lg text-(--c-muted)">{imss.lead}</p>
          <ul class="mt-6 grid gap-x-10 gap-y-3 text-lg leading-snug sm:grid-cols-2">
            {imss.items.map((i) => <li class="flex gap-3"><Icon name="check" weight="bold" class="mt-1.5 size-4 shrink-0 text-(--c-accent)" /><span>{i}</span></li>)}
          </ul>
        </li>
      </ul>
    </div>
  </Section>

  <Section>
    <div class="wrap">
      <h2 data-reveal class="max-w-[16ch] text-[clamp(2rem,4.2vw,3.6rem)] font-semibold leading-[1.05] tracking-[-0.03em]">Síguenos en nuestras redes sociales</h2>
      <ul data-stagger data-gap="90" class="mt-10 flex flex-wrap gap-3">
        {socials.map((s) => (
          <li>
            <a href={s.href} target="_blank" rel="noopener" class="press inline-flex h-14 items-center gap-3 rounded-(--c-radius) border border-(--c-line) bg-(--c-surface) px-6 text-lg font-medium hover:border-(--c-ink)">
              <Icon name={s.icon} class="size-6" />{s.name}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </Section>

  <Section tone="surface" id="contacto">
    <div class="wrap grid gap-14 lg:grid-cols-2 lg:gap-24">
      <div data-reveal>
        <h2 class="mb-10 text-[clamp(2.2rem,4.8vw,4rem)] font-semibold leading-none tracking-[-0.03em]">Contacto</h2>
        <ContactBlock site={site} showCta={false} />
      </div>
      <div data-reveal data-delay="120" class="rounded-[12px] border border-(--c-line) bg-(--c-bg) p-6 sm:p-9">
        <Composer site={site} areas={areasComposer} />
      </div>
    </div>
  </Section>

</Layout>
