---
import Layout from "@/sites/hernanpizarro/Layout.astro";
import PageHero from "@/kit/PageHero.astro";
import Section from "@/kit/Section.astro";
import Icon from "@/kit/Icon.astro";
import CtaBand from "@/kit/CtaBand.astro";
import { site } from "@/sites/hernanpizarro/site";
import { areas } from "@/sites/hernanpizarro/data";

export function getStaticPaths() {
  return areas.map((a) => ({ params: { area: a.key }, props: { area: a } }));
}
const { area } = Astro.props;
const base = "/hernanpizarro";
const others = areas.filter((a) => a.key !== area.key);
const wa = `https://wa.me/${site.whatsapp.number}?text=${encodeURIComponent(`${site.whatsapp.intro} sobre ${area.cta}.`)}`;
const org = new URL(`/${site.slug}#organizacion`, Astro.site).href;
---

<Layout
  site={site}
  title={`${area.title} | Hernán Pizarro y Asociados, abogados en la Ciudad de México`}
  description={area.lead}
 
  breadcrumbs={[{ name: "Servicios", href: `${base}/servicios` }, { name: area.title, href: `${base}/servicios/${area.key}` }]}
  schema={[{ "@context": "https://schema.org", "@type": "Service", name: area.title, description: area.lead, provider: { "@id": org }, areaServed: { "@type": "City", name: "Ciudad de México" } }]}
>
  <PageHero title={area.title} lede={area.lead} transitionName={`area-${area.key}`} />
  <Section size="sm" class="pt-4">
    <div class="wrap grid gap-10 lg:grid-cols-[0.8fr_1.4fr] lg:gap-20">
      <h2 data-reveal class="text-[clamp(1.6rem,3vw,2.4rem)] leading-tight tracking-[-0.02em]">{area.itemsTitle}</h2>
      <ul data-stagger data-gap="40" class="grid gap-x-10 gap-y-5 sm:grid-cols-2">
        {area.items.map((i) => (
          <li class="flex gap-3 text-lg leading-snug">
            <Icon name="check" weight="bold" class="mt-1.5 size-4 shrink-0 text-(--c-accent)" />
            <span>{i}</span>
          </li>
        ))}
      </ul>
    </div>
  </Section>
  <Section tone="surface" size="sm">
    <div class="wrap">
      <h2 data-reveal class="mb-8 text-[clamp(1.6rem,3vw,2.4rem)] leading-tight tracking-[-0.02em]">Otros servicios</h2>
      <ul data-stagger data-gap="45" class="flex flex-wrap gap-3">
        {others.map((o) => <li><a href={`${base}/servicios/${o.key}`} class="press inline-flex rounded-full border border-(--c-line) px-5 py-2.5 text-[15px] hover:border-(--c-accent) hover:text-(--c-accent)">{o.title}</a></li>)}
      </ul>
    </div>
  </Section>
  <CtaBand title="Cuéntenos su caso" href={wa} label="Escribir por WhatsApp" tone="brand" external />
</Layout>
