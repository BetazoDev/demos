---
import Layout from "@/sites/sanchezsoto/Layout.astro";
import PageHead from "@/sites/sanchezsoto/PageHead.astro";
import Section from "@/kit/Section.astro";
import ContactBlock from "@/kit/ContactBlock.astro";
import Composer from "@/kit/Composer.astro";
import { site } from "@/sites/sanchezsoto/site";
import { areas } from "@/sites/sanchezsoto/data";

const base = "/sanchezsoto";
---

<Layout
  site={site}
  title="Contacto | Sánchez Soto Abogados, Río Rhin 22, Col. Cuauhtémoc, CDMX"
  description="Río Rhin 22, oficina 302, Colonia Cuauhtémoc, Ciudad de México. Lunes a viernes de 9:00 a 20:00 h. WhatsApp 55 5408 4560."
  nav={{ variant: "bar", tone: "light", logoHeight: 46 }}
  breadcrumbs={[{ name: "Contacto", href: `${base}/contacto` }]}
>
  <PageHead title="Contacto" lede="Contáctanos para recibir una asesoría legal personalizada y resolver tu caso con expertos." />
  <Section size="sm" class="pt-4">
    <div class="wrap grid gap-14 lg:grid-cols-2 lg:gap-24">
      <div data-reveal><ContactBlock site={site} /></div>
      <div data-reveal data-delay="120" class="rounded-[2rem] border border-(--c-line) bg-(--c-surface) p-6 sm:p-9">
        <Composer site={site} areas={areas.map((a) => a.title)} />
      </div>
    </div>
  </Section>
</Layout>
