---
import Layout from "@/sites/sanchezsoto/Layout.astro";
import PageHead from "@/sites/sanchezsoto/PageHead.astro";
import Section from "@/kit/Section.astro";
import ImageBand from "@/kit/ImageBand.astro";
import Button from "@/kit/Button.astro";
import Icon from "@/kit/Icon.astro";
import CtaBand from "@/sites/sanchezsoto/CtaBand.astro";
import { site } from "@/sites/sanchezsoto/site";
import { areas } from "@/sites/sanchezsoto/data";

export function getStaticPaths() {
  return areas.map((a) => ({ params: { area: a.key }, props: { area: a } }));
}
const { area } = Astro.props;
const base = "/sanchezsoto";
const others = areas.filter((a) => a.key !== area.key);
const wa = `https://wa.me/${site.whatsapp.number}?text=${encodeURIComponent(`${site.whatsapp.intro} sobre ${area.title.toLowerCase()}.`)}`;
const h2 = "text-[clamp(1.7rem,3.2vw,2.8rem)] font-light leading-tight tracking-[-0.03em]";
const schema = [{ "@context": "https://schema.org", "@type": "Service", name: area.title, description: area.lead, provider: { "@id": new URL(`/${site.slug}#organizacion`, Astro.site).href }, areaServed: { "@type": "City", name: "Ciudad de México" } }];
---

<Layout
  site={site}
  title={`${area.title} en CDMX | Sánchez Soto Abogados`}
  description={area.lead}
  nav={{ variant: "bar", tone: "light", logoHeight: 46 }}
  breadcrumbs={[{ name: "Servicios", href: `${base}/servicios` }, { name: area.title, href: `${base}/servicios/${area.key}` }]}
  schema={schema}
>
  <PageHead title={area.title} lede={area.lead} transitionName={`area-${area.key}`} />

  <Section size="sm" class="pt-4">
    <div class="wrap grid gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:gap-24">
      <div class="lg:sticky lg:top-28 lg:self-start">
        <h2 data-reveal class={h2}>{area.itemsTitle}</h2>
        <div data-reveal data-delay="100" class="mt-8"><Button href={wa} external>Escribir por WhatsApp</Button></div>
      </div>
      <ul data-stagger data-gap="80" class="grid gap-9">
        {area.items.map((i) => (
          <li class="ss-item">
            <Icon name="check" weight="bold" class="mt-2 size-5 text-(--c-accent)" />
            <p class="text-[clamp(1.2rem,1.9vw,1.55rem)] leading-snug">{i}</p>
          </li>
        ))}
      </ul>
    </div>
  </Section>

  <ImageBand image={area.image} alt={area.alt} position="50% 50%" />

  <Section tone="surface" size="sm">
    <div class="wrap">
      <h2 data-reveal class:list={["mb-8", h2]}>Otros servicios</h2>
      <ul data-stagger data-gap="45" class="flex flex-wrap gap-3">
        {others.map((o) => <li><a href={`${base}/servicios/${o.key}`} class="press inline-flex rounded-full border border-(--c-line) px-5 py-3 text-[15px] hover:border-(--c-ink)">{o.title}</a></li>)}
      </ul>
    </div>
  </Section>

  <CtaBand title="Protege tus derechos y asegura tu tranquilidad" href={wa} label="Escribir por WhatsApp" external />
</Layout>
