---
import Layout from "@/sites/valenciarangel/Layout.astro";
import Faq from "@/sites/valenciarangel/Faq.astro";
import PageHero from "@/kit/PageHero.astro";
import Section from "@/kit/Section.astro";
import CtaBand from "@/kit/CtaBand.astro";
import { site } from "@/sites/valenciarangel/site";
import { areas, faqs } from "@/sites/valenciarangel/data";

const base = "/valenciarangel";
const wa = `https://wa.me/${site.whatsapp.number}?text=${encodeURIComponent(site.whatsapp.intro + ".")}`;
const groups = ["familiar", "migratorios", "propiedad-intelectual"].map((k) => ({ area: areas.find((a) => a.key === k)!, items: faqs.filter((f) => f.area === k) }));
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: [...(f.p ?? []), ...(f.ul ?? [])].join(" ") } })),
};
---

<Layout title="Preguntas frecuentes: divorcio, sucesiones, visa de trabajo y derechos de autor | Valencia Rangel" description="Respuestas del despacho sobre tipos de divorcio, patria potestad, pensión alimenticia, sucesiones, concubinato, visa para trabajar en México, naturalización y derechos de autor." schema={[faqSchema]} breadcrumbs={[{ name: "Preguntas frecuentes", href: `${base}/preguntas-frecuentes` }]}>
  <PageHero title="Preguntas frecuentes" lede="Te compartimos las preguntas frecuentes que surgen comúnmente en un contexto determinado y sobre un tema específico." />
  <Section size="sm" class="pt-4">
    <div class="wrap grid gap-16 sm:gap-24">
      {
        groups.map((g) => (
          <div class="grid gap-8 lg:grid-cols-[0.55fr_1.45fr] lg:gap-16">
            <div data-reveal>
              <h2 class="text-[clamp(1.7rem,3vw,2.5rem)] leading-tight">{g.area.title}</h2>
              <a href={`${base}/servicios/${g.area.key}`} class="link-u mt-4 inline-block text-[15px] text-(--c-accent)">Ver el servicio</a>
            </div>
            <div data-reveal data-delay="80"><Faq items={g.items} /></div>
          </div>
        ))
      }
    </div>
  </Section>
  <CtaBand title="¿Necesitas asesoría legal?" text="Solucionamos tus problemas legales de manera eficaz, con la mejor estrategia de defensa." href={wa} label="Escribir por WhatsApp" tone="brand" external />
</Layout>
