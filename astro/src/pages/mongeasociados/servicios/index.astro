---
import Layout from "@/sites/mongeasociados/Layout.astro";
import PageHero from "@/kit/PageHero.astro";
import Section from "@/kit/Section.astro";
import CtaBand from "@/kit/CtaBand.astro";
import Icon from "@/kit/Icon.astro";
import { site } from "@/sites/mongeasociados/site";
import { areas, photos } from "@/sites/mongeasociados/data";

const base = "/mongeasociados";
const wa = `https://wa.me/${site.whatsapp.number}?text=${encodeURIComponent(site.whatsapp.intro + ".")}`;
const waArea = (t: string) => `https://wa.me/${site.whatsapp.number}?text=${encodeURIComponent(`${site.whatsapp.intro} sobre ${t.toLowerCase()}.`)}`;
const service = areas.map((a) => ({
  "@context": "https://schema.org",
  "@type": "Service",
  name: a.title,
  description: a.lead,
  provider: { "@id": new URL(`${base}#organizacion`, Astro.site!).href },
  areaServed: [{ "@type": "City", name: "Ciudad de México" }, { "@type": "State", name: "Estado de México" }],
}));
---

<Layout
  title="Servicios: materia penal, familiar y civil en CDMX | Monge & Asociados"
  description="Materia penal, asistencia ante el Ministerio Público las 24 horas, pensión alimenticia, intestados y materia familiar y civil en Buenavista, Ciudad de México."
  breadcrumbs={[{ name: "Servicios", href: `${base}/servicios` }]}
  schema={service}
>
  <PageHero title="Servicios" lede="Materia penal, asistencia ante el Ministerio Público las 24 horas, pensión alimenticia, sucesiones y materia familiar y civil." image={photos.aldaba} imageAlt="Aldaba de bronce con cabeza de león sobre una puerta de mármol negro" />
  <Section>
    <div class="wrap">
      <ul data-stagger data-gap="70" class="divide-y divide-current/12 border-y border-current/12">
        {
          areas.map((a) => (
            <li id={a.key} class="scroll-mt-28 py-9 sm:py-12">
              <div class="grid items-start gap-5 md:grid-cols-[1.1fr_1fr] md:gap-16">
                <h2 transition:name={`area-${a.key}`} class="text-[clamp(1.7rem,3.4vw,2.9rem)] leading-[1.05]">{a.title}</h2>
                <div>
                  <p class="max-w-[46ch] text-lg leading-relaxed text-(--c-muted)">{a.lead}</p>
                  <a href={waArea(a.title)} target="_blank" rel="noopener" class="mt-6 inline-flex items-center gap-2 font-medium" aria-label={`Escribir por WhatsApp sobre ${a.title.toLowerCase()}`}>
                    <Icon name="whatsapp-logo" weight="fill" class="size-5 text-(--c-accent)" />
                    <span class="link-u">Escribir por WhatsApp</span>
                  </a>
                </div>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </Section>
  <CtaBand title="Cuéntenos su caso" href={wa} label="Escribir por WhatsApp" tone="brand" external />
</Layout>
