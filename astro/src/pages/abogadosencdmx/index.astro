---
import Layout from "@/sites/abogadosencdmx/Layout.astro";
import Hero from "@/sites/abogadosencdmx/Hero.astro";
import Button from "@/kit/Button.astro";
import Section from "@/kit/Section.astro";
import Statement from "@/kit/Statement.astro";
import AreasIndex from "@/kit/AreasIndex.astro";
import ImageBand from "@/kit/ImageBand.astro";
import ContactBlock from "@/kit/ContactBlock.astro";
import Composer from "@/kit/Composer.astro";
import CtaBand from "@/kit/CtaBand.astro";
import { site } from "@/sites/abogadosencdmx/site";
import { areas, photos } from "@/sites/abogadosencdmx/data";

const base = "/abogadosencdmx";
const rows = areas.map((a) => ({ key: a.key, title: a.title, text: a.lead, href: `${base}/servicios#${a.key}` }));
const wa = `https://wa.me/${site.whatsapp.number}?text=${encodeURIComponent(site.whatsapp.intro + ".")}`;
---

<Layout title="Abogados en CDMX | Despacho jurídico en la colonia Roma Norte" nav={{ tone: "dark" }} footer={{ blurb: "Despacho jurídico en la colonia Roma Norte, Ciudad de México." }}>
  <Hero
    title="Protegemos sus derechos con estrategia legal"
    lede="Despacho jurídico en la colonia Roma Norte, especializado en derecho familiar, penal, civil, corporativo, inmobiliario, migratorio y laboral."
    image={photos.estatua}
    imageAlt="Estatua de bronce de la Justicia con los ojos vendados y una balanza"
    position="62% 40%"
  >
    <Fragment slot="actions">
      <Button href={wa} variant="light" size="lg" external>Escribir por WhatsApp</Button>
      <Button href={`${base}/servicios`} variant="outline" size="lg">Ver servicios</Button>
    </Fragment>
  </Hero>

  <Section>
    <div class="wrap"><Statement text="Brindamos representación legal integral a personas y empresas en la Ciudad de México." /></div>
  </Section>

  <Section tone="surface" id="servicios">
    <div class="wrap">
      <h2 data-reveal class="mb-12 text-[clamp(2rem,4.4vw,3.8rem)] leading-[1.05]">Áreas de especialidad</h2>
      <AreasIndex areas={rows} />
    </div>
  </Section>

  <ImageBand image={photos.calle} alt="Calle arbolada de la colonia Roma Norte con edificios de principios del siglo XX y jacarandas en flor" position="50% 55%" />

  <Section id="contacto">
    <div class="wrap grid gap-14 lg:grid-cols-2 lg:gap-24">
      <div data-reveal>
        <h2 class="mb-10 text-[clamp(2rem,4.4vw,3.8rem)] leading-[1.05]">Contacto</h2>
        <ContactBlock site={site} showCta={false} />
      </div>
      <div data-reveal data-delay="120" class="rounded-(--c-radius-card) border border-(--c-line) bg-(--c-surface) p-6 sm:p-9">
        <Composer site={site} areas={areas.map((a) => a.title)} />
      </div>
    </div>
  </Section>

  <CtaBand title="Cuéntenos su caso" href={wa} label="Escribir por WhatsApp" tone="brand" external />
</Layout>
