---
import Layout from "@/sites/abogadosencdmx/Layout.astro";
import PageHero from "@/kit/PageHero.astro";
import Section from "@/kit/Section.astro";
import CtaBand from "@/kit/CtaBand.astro";
import Icon from "@/kit/Icon.astro";
import AreaAccordion from "@/sites/abogadosencdmx/AreaAccordion.astro";
import { site } from "@/sites/abogadosencdmx/site";
import { areas, servicios } from "@/sites/abogadosencdmx/data";

const base = "/abogadosencdmx";
const wa = `https://wa.me/${site.whatsapp.number}?text=${encodeURIComponent(site.whatsapp.intro + ".")}`;
const waArea = (a: { title: string }) => `https://wa.me/${site.whatsapp.number}?text=${encodeURIComponent(`${site.whatsapp.intro} sobre ${a.title.toLowerCase()}.`)}`;
const service = areas.map((a) => ({
  "@context": "https://schema.org",
  "@type": "Service",
  name: a.title,
  description: a.lead,
  provider: { "@id": new URL(`${base}#organizacion`, Astro.site!).href },
  areaServed: { "@type": "City", name: "Ciudad de México" },
}));
---

<Layout
  title="Servicios jurídicos en la Ciudad de México | Abogados en CDMX"
  description="Derecho familiar, penal, civil, corporativo, inmobiliario, migratorio y laboral en la colonia Roma Norte, Ciudad de México. Representación legal integral a personas y empresas."
  breadcrumbs={[{ name: "Servicios", href: `${base}/servicios` }]}
  schema={service}
>
  <PageHero title="Servicios" lede="Abogados en CDMX es un despacho jurídico ubicado en la Colonia Roma Norte, especializado en derecho familiar, penal, civil, corporativo, inmobiliario, migratorio y laboral." />
  <Section size="sm" class="pt-4">
    <div class="wrap"><AreaAccordion areas={areas} waHref={waArea} first /></div>
  </Section>
  <Section tone="surface" size="sm">
    <div class="wrap grid gap-8 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16">
      <h2 data-reveal class="text-[clamp(1.8rem,3.4vw,2.8rem)] leading-tight">Qué ofrecemos</h2>
      <ul data-stagger data-gap="60" class="grid gap-x-10 gap-y-4 sm:grid-cols-2">
        {
          servicios.map((s) => (
            <li class="flex gap-3 text-lg">
              <Icon name="check" weight="bold" class="mt-1.5 size-4 shrink-0 text-(--c-accent)" />
              <span>{s}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </Section>
  <CtaBand title="Cuéntenos su caso" href={wa} label="Escribir por WhatsApp" tone="brand" external />
</Layout>
