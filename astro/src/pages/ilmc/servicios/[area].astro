---
import SiteLayout from "@/kit/SiteLayout.astro";
import PageHero from "@/kit/PageHero.astro";
import Section from "@/kit/Section.astro";
import Icon from "@/kit/Icon.astro";
import CtaBand from "@/kit/CtaBand.astro";
import { site } from "@/sites/ilmc/site";
import { areas, waLink } from "@/sites/ilmc/data";

export function getStaticPaths() {
  return areas.map((a) => ({ params: { area: a.key }, props: { area: a } }));
}
const { area } = Astro.props;
const base = "/ilmc";
const others = areas.filter((a) => a.key !== area.key);
const wa = waLink(`${site.whatsapp.intro} sobre ${area.title.toLowerCase()}.`);
const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    name: area.title,
    description: area.lead,
    provider: { "@id": new URL(`/${site.slug}#organizacion`, Astro.site).href },
    areaServed: { "@type": "Country", name: "México" },
  },
];
---

<SiteLayout site={site} title={`${area.title} | ILMC Abogados, derecho migratorio`} description={`${area.lead} ILMC Abogados, expertos en derecho migratorio.`.slice(0, 300)} nav={{ variant: "bar", tone: "light", logoHeight: 52 }} breadcrumbs={[{ name: "Servicios", href: `${base}/servicios` }, { name: area.title, href: `${base}/servicios/${area.key}` }]} schema={schema} footer={{ variant: "dark", blurb: "Expertos en derecho migratorio." }}>
  <PageHero title={area.title} lede={area.lead} transitionName={`area-${area.key}`} />
  <Section size="sm" class="pt-6">
    <div class="wrap grid gap-16 sm:gap-20">
      {
        area.blocks.map((b) => (
          <article class="grid gap-6 lg:grid-cols-[0.8fr_1.2fr] lg:gap-24">
            <h2 data-reveal class="text-[clamp(1.6rem,3vw,2.5rem)] font-medium leading-tight tracking-[-0.03em]">{b.title}</h2>
            <div data-reveal data-delay="100">
              {b.text && <p class="max-w-[60ch] text-lg leading-relaxed text-(--c-muted)">{b.text}</p>}
              {b.items && (
                <ul class:list={["grid gap-3.5", b.text && "mt-7"]}>
                  {b.items.map((i) => (
                    <li class="flex gap-3 text-[17px] leading-snug">
                      <Icon name="check" weight="bold" class="mt-1 size-4 shrink-0 text-(--c-brand)" />
                      <span>{i}</span>
                    </li>
                  ))}
                </ul>
              )}
            </div>
          </article>
        ))
      }
    </div>
  </Section>
  <Section tone="surface" size="sm">
    <div class="wrap">
      <h2 data-reveal class="mb-8 text-[clamp(1.5rem,2.6vw,2.1rem)] font-medium leading-tight tracking-[-0.03em]">Otros servicios</h2>
      <ul data-stagger data-gap="45" class="flex flex-wrap gap-3">
        {others.map((o) => <li><a href={`${base}/servicios/${o.key}`} class="press inline-flex rounded-full border border-(--c-line) bg-(--c-bg) px-5 py-2.5 text-[15px] hover:border-(--c-brand)">{o.title}</a></li>)}
      </ul>
    </div>
  </Section>
  <CtaBand title="Hablemos de su caso" href={wa} label="Escribir por WhatsApp" tone="brand" external />
</SiteLayout>
