---
import SiteLayout from "@/kit/SiteLayout.astro";
import PageHero from "@/kit/PageHero.astro";
import Section from "@/kit/Section.astro";
import ContactBlock from "@/kit/ContactBlock.astro";
import Composer from "@/kit/Composer.astro";
import Skin from "@/sites/cyca/Skin.astro";
import { site } from "@/sites/cyca/site";
import { areas } from "@/sites/cyca/data";

const base = "/cyca";
---

<SiteLayout
  site={site}
  title="Contacto | CYCA Abogados, Obrero Mundial 903, colonia Álamos, CDMX"
  description="Obrero Mundial 903, Int. 101, colonia Álamos, Benito Juárez, Ciudad de México. Lunes a viernes de 9:00 a 20:00 h. WhatsApp 55 4346 1693."
  nav={{ variant: "pill", tone: "light" }}
  breadcrumbs={[{ name: "Contacto", href: `${base}/contacto` }]}
>
  <Skin />
  <PageHero title="Contacto" lede="Escríbanos por WhatsApp, llámenos o visítenos en la colonia Álamos." />
  <Section size="sm" class="pt-4">
    <div class="wrap grid gap-14 lg:grid-cols-2 lg:gap-24">
      <div data-reveal><ContactBlock site={site} /></div>
      <div data-reveal data-delay="120" class="border border-(--c-line) bg-(--c-surface) p-6 sm:p-9">
        <Composer site={site} areas={areas.map((a) => a.title)} />
      </div>
    </div>
  </Section>
</SiteLayout>
