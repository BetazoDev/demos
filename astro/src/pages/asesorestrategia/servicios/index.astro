---
import SiteLayout from "@/kit/SiteLayout.astro";
import PageHero from "@/kit/PageHero.astro";
import Section from "@/kit/Section.astro";
import AreasIndex from "@/kit/AreasIndex.astro";
import CtaBand from "@/kit/CtaBand.astro";
import Nav from "@/sites/asesorestrategia/Nav.astro";
import Footer from "@/sites/asesorestrategia/Footer.astro";
import { site } from "@/sites/asesorestrategia/site";
import { areas } from "@/sites/asesorestrategia/data";

const base = "/asesorestrategia";
const rows = areas.map((a) => ({ key: a.key, title: a.title, text: a.short, href: `${base}/servicios/${a.key}` }));
const wa = `https://wa.me/${site.whatsapp.number}?text=${encodeURIComponent(site.whatsapp.intro)}`;
---

<SiteLayout site={site} title="Servicios | Strategia Asesores, abogados civil y familiar en la Roma Sur, CDMX" description="Derecho familiar y divorcios, herencias y juicios sucesorios, derecho inmobiliario y arrendamiento, contratos y blindaje legal en la Ciudad de México." nav={false} footer={false} breadcrumbs={[{ name: "Servicios", href: `${base}/servicios` }]}>
  <Nav slot="nav" site={site} variant="bar" tone="light" />
  <PageHero title="Servicios" lede="Estrategia jurídica y económica para personas con patrimonio que buscan protección, discreción y decisiones legales bien fundamentadas." />
  <Section size="sm" class="pt-4">
    <div class="wrap"><AreasIndex areas={rows} /></div>
  </Section>
  <CtaBand title="Hablemos de su legado" text="La tranquilidad patrimonial comienza con una conversación honesta." href={wa} label="Escribir por WhatsApp" tone="brand" external />
  <Footer slot="footer" site={site} variant="dark" blurb="Firma legal y consultoría patrimonial" />
</SiteLayout>
