---
import SiteLayout from "@/kit/SiteLayout.astro";
import PageHero from "@/kit/PageHero.astro";
import Section from "@/kit/Section.astro";
import Icon from "@/kit/Icon.astro";
import CtaBand from "@/kit/CtaBand.astro";
import Nav from "@/sites/asesorestrategia/Nav.astro";
import Footer from "@/sites/asesorestrategia/Footer.astro";
import Filete from "@/sites/asesorestrategia/Filete.astro";
import { site } from "@/sites/asesorestrategia/site";
import { areas } from "@/sites/asesorestrategia/data";

export function getStaticPaths() {
  return areas.map((a) => ({ params: { area: a.key }, props: { area: a } }));
}
const { area } = Astro.props;
const base = "/asesorestrategia";
const related = area.related.map((k) => areas.find((a) => a.key === k)!);
const wa = `https://wa.me/${site.whatsapp.number}?text=${encodeURIComponent(`${site.whatsapp.intro} sobre ${area.title.toLowerCase()}.`)}`;
const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    name: area.title,
    description: `${area.lead} ${area.body}`,
    provider: { "@id": new URL(`${base}#organizacion`, Astro.site).href },
    areaServed: { "@type": "City", name: "Ciudad de México" },
  },
];
---

<SiteLayout site={site} title={`${area.title} en la Ciudad de México | Strategia Asesores`} description={area.lead} nav={false} footer={false} schema={schema} breadcrumbs={[{ name: "Servicios", href: `${base}/servicios` }, { name: area.title, href: `${base}/servicios/${area.key}` }]}>
  <Nav slot="nav" site={site} variant="bar" tone="light" />
  <PageHero title={area.title} lede={area.lead} transitionName={`area-${area.key}`} />
  <Section size="sm" class="pt-6">
    <div class="wrap">
      <Filete class="mb-12 sm:mb-16" />
      <div class="grid gap-12 lg:grid-cols-[1.1fr_0.9fr] lg:gap-24">
        <p data-reveal class="max-w-[52ch] text-[clamp(1.15rem,1.6vw,1.35rem)] leading-[1.6]">{area.body}</p>
        <div>
          <h2 data-reveal class="mb-6 text-[clamp(1.5rem,2.6vw,2.1rem)] leading-tight tracking-[-0.01em]">{area.itemsTitle}</h2>
          <ul data-stagger data-gap="45" class="grid gap-3">
            {area.items.map((i) => (
              <li class="flex gap-3 text-lg">
                <Icon name="check" weight="bold" class="mt-1.5 size-4 shrink-0 text-(--c-accent)" />
                <span>{i}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </Section>
  <Section tone="surface" size="sm">
    <div class="wrap">
      <h2 data-reveal class="mb-8 text-[clamp(1.5rem,2.6vw,2.1rem)] leading-tight tracking-[-0.01em]">Otros servicios</h2>
      <ul data-stagger data-gap="45" class="flex flex-wrap gap-3">
        {related.map((o) => <li><a href={`${base}/servicios/${o.key}`} class="press inline-flex rounded-(--c-radius) border border-(--c-line) bg-(--c-bg) px-5 py-3 text-[15px] hover:border-(--c-accent) hover:text-(--c-accent)">{o.title}</a></li>)}
        <li><a href={`${base}/servicios`} class="press inline-flex rounded-(--c-radius) border border-(--c-line) px-5 py-3 text-[15px] hover:border-(--c-accent) hover:text-(--c-accent)">Todos los servicios</a></li>
      </ul>
    </div>
  </Section>
  <CtaBand title="Hablemos de su legado" text="La tranquilidad patrimonial comienza con una conversación honesta." href={wa} label="Escribir por WhatsApp" tone="brand" external />
  <Footer slot="footer" site={site} variant="dark" blurb="Firma legal y consultoría patrimonial" />
</SiteLayout>
