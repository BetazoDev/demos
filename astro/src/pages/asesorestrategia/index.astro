---
import SiteLayout from "@/kit/SiteLayout.astro";
import Button from "@/kit/Button.astro";
import Section from "@/kit/Section.astro";
import Statement from "@/kit/Statement.astro";
import AreasIndex from "@/kit/AreasIndex.astro";
import Band from "@/sites/asesorestrategia/Band.astro";
import Split from "@/kit/Split.astro";
import Accordion from "@/kit/Accordion.astro";
import ContactBlock from "@/kit/ContactBlock.astro";
import Composer from "@/kit/Composer.astro";
import Nav from "@/sites/asesorestrategia/Nav.astro";
import Footer from "@/sites/asesorestrategia/Footer.astro";
import Hero from "@/sites/asesorestrategia/Hero.astro";
import Filete from "@/sites/asesorestrategia/Filete.astro";
import { site } from "@/sites/asesorestrategia/site";
import { areas, photos, socio, principios } from "@/sites/asesorestrategia/data";

const base = "/asesorestrategia";
const rows = areas.map((a) => ({ key: a.key, title: a.title, text: a.short, href: `${base}/servicios/${a.key}` }));
const wa = `https://wa.me/${site.whatsapp.number}?text=${encodeURIComponent(site.whatsapp.intro)}`;
const h2 = "text-[clamp(2rem,4.4vw,3.8rem)] leading-[1.04] tracking-[-0.015em]";
---

<SiteLayout site={site} title="Strategia Asesores | Firma legal y consultoría patrimonial en la Ciudad de México" nav={false} footer={false}>
  <Nav slot="nav" site={site} variant="bar" tone="light" />
  <Hero title="Firma legal y consultoría patrimonial" lede="Protegemos el patrimonio y el legado de su familia, combinando un despacho litigante con planeación estratégica preventiva." image={photos.retrato} imageAlt="Lic. José Ruiz, socio fundador de Strategia Asesores, sentado en un banco de madera">
    <Fragment slot="actions">
      <Button href={wa} size="lg" external>Escribir por WhatsApp</Button>
      <Button href={`${base}/servicios`} variant="outline" size="lg">Ver servicios</Button>
    </Fragment>
  </Hero>

  <Section>
    <div class="wrap">
      <Filete class="mb-14 sm:mb-20" />
      <Statement class="font-(family-name:--f-display) font-normal tracking-[-0.01em]" text="Protección, discreción y decisiones legales bien fundamentadas, no soluciones genéricas." />
      <p data-reveal class="mt-10 max-w-[44ch] text-lg text-(--c-muted)">Firma boutique de asesoría legal y patrimonial en la Ciudad de México. Atención directa por el socio fundador y confidencialidad absoluta.</p>
    </div>
  </Section>

  <Section tone="surface" id="servicios">
    <div class="wrap">
      <h2 data-reveal class={`mb-12 ${h2}`}>Áreas de especialidad</h2>
      <AreasIndex areas={rows} />
    </div>
  </Section>

  <Band image={photos.fachada} alt="Casona de cantera con balcones de herrería y una jacaranda en flor en una calle de la Ciudad de México" position="50% 45%" />

  <Section>
    <div class="wrap">
      <figure data-reveal class="mx-auto max-w-[62rem]">
        <blockquote class="font-(family-name:--f-display) text-[clamp(1.9rem,3.9vw,3.3rem)] leading-[1.14] tracking-[-0.01em] text-(--c-brand)">“{socio.quote}”</blockquote>
        <figcaption class="mt-10 flex flex-wrap items-baseline gap-x-5 gap-y-1">
          <span class="text-lg font-medium">{socio.name}</span>
          <span class="text-(--c-muted)">{socio.role}</span>
          <span class="text-(--c-muted)">{socio.studies}</span>
        </figcaption>
      </figure>
    </div>
  </Section>

  <Section tone="surface">
    <div class="wrap">
      <Split image={photos.llaves} alt="Llaves antiguas de latón, una libreta de piel azul marino y una pluma sobre una mesa de roble" ratio="5/4" position="35% 50%">
        <h2 class="mb-5 text-[clamp(1.8rem,3.2vw,2.8rem)] leading-[1.08] tracking-[-0.015em]">¿Qué distingue a una firma boutique de asesoría legal?</h2>
        <p class="mb-8 max-w-[46ch] text-lg text-(--c-muted)">Una firma boutique se caracteriza por especialización profunda, atención personalizada y análisis estratégico de cada caso.</p>
        <Accordion items={principios.map((p) => ({ q: p.title, a: p.text }))} />
        <div class="mt-10"><Button href={`${base}/nosotros`} variant="outline">Conocer a la firma</Button></div>
      </Split>
    </div>
  </Section>

  <Section id="contacto">
    <div class="wrap grid gap-14 lg:grid-cols-[1fr_1fr] lg:gap-24">
      <div data-reveal>
        <h2 class={`mb-5 ${h2}`}>Hablemos de su legado</h2>
        <p class="mb-10 max-w-[40ch] text-lg text-(--c-muted)">La tranquilidad patrimonial comienza con una conversación honesta. Agende una consulta inicial para evaluar su situación legal y financiera.</p>
        <ContactBlock site={site} showCta={false} />
      </div>
      <div data-reveal data-delay="120" class="rounded-(--c-radius) border border-(--c-line) bg-(--c-surface) p-6 sm:p-9">
        <Composer site={site} areas={areas.map((a) => a.title)} />
      </div>
    </div>
  </Section>

  <Footer slot="footer" site={site} variant="dark" blurb="Firma legal y consultoría patrimonial" />
</SiteLayout>
