---
import "@/sites/mfabogados/site.css";
import SiteLayout from "@/kit/SiteLayout.astro";
import PageHero from "@/kit/PageHero.astro";
import Section from "@/kit/Section.astro";
import CtaBand from "@/kit/CtaBand.astro";
import Nav from "@/sites/mfabogados/Nav.astro";
import Footer from "@/sites/mfabogados/Footer.astro";
import { site } from "@/sites/mfabogados/site";
import { areas } from "@/sites/mfabogados/data";
import cupula from "@/sites/mfabogados/assets/cupula.jpg";

const base = "/mfabogados";
const wa = `https://wa.me/${site.whatsapp.number}?text=${encodeURIComponent(site.whatsapp.intro)}.`;
const waArea = (t: string) => `https://wa.me/${site.whatsapp.number}?text=${encodeURIComponent(`${site.whatsapp.intro} sobre ${t.toLowerCase()}.`)}`;
const schema = areas.map((a) => ({
  "@context": "https://schema.org",
  "@type": "Service",
  name: a.title,
  description: a.items.join("; "),
  provider: { "@id": `https://demos.diabolicalservices.tech/${site.slug}#organizacion` },
  areaServed: { "@type": "City", name: "Ciudad de México" },
}));
---

<SiteLayout
  site={site}
  title="Áreas de práctica | Moreno & Fuertes Abogados, derecho mercantil, civil, familiar, penal y laboral"
  description="Recuperación de créditos, derecho societario, contratos, divorcios y sucesiones, defensa penal y juicios laborales. Despacho de abogados en el Centro de la Ciudad de México."
  nav={false}
  footer={false}
  breadcrumbs={[{ name: "Áreas de práctica", href: `${base}/areas-de-practica` }]}
  schema={schema}
>
  <Nav slot="nav" site={site} variant="pill" tone="dark" />
  <PageHero title="Áreas de práctica" lede="Derecho mercantil, civil, familiar, penal y laboral." image={cupula} imageAlt="Cúpula y balaustrada de piedra de un edificio histórico del centro de la Ciudad de México, en blanco y negro" />
  <Section size="sm" class="pt-16 sm:pt-24">
    <div class="wrap">
      {
        areas.map((a, i) => (
          <div id={a.key} class:list={["grid scroll-mt-24 gap-8 py-14 lg:grid-cols-[0.8fr_1.2fr] lg:gap-20 lg:py-20", i > 0 && "border-t border-(--c-line)"]}>
            <div class="lg:sticky lg:top-28 lg:self-start">
              <h2 data-reveal class="text-[clamp(2rem,4vw,3.6rem)] font-medium leading-[1.02] tracking-[-0.025em]">{a.title}</h2>
              <div data-reveal data-delay="100" class="mt-8"><a href={waArea(a.title)} target="_blank" rel="noopener" class="link-u text-lg font-medium">Escribir por WhatsApp</a></div>
            </div>
            <ul data-stagger data-gap="55" class="grid gap-x-12 gap-y-5 sm:grid-cols-2">
              {a.items.map((it) => <li class="text-lg leading-snug text-(--c-muted)">{it}</li>)}
            </ul>
          </div>
        ))
      }
    </div>
  </Section>
  <CtaBand title="Cuéntenos su caso" href={wa} label="Escribir por WhatsApp" tone="brand" external />
  <Footer slot="footer" site={site} variant="dark" blurb="Soluciones legales profesionales." />
</SiteLayout>
