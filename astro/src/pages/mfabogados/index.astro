---
import "@/sites/mfabogados/site.css";
import SiteLayout from "@/kit/SiteLayout.astro";
import Button from "@/kit/Button.astro";
import Section from "@/kit/Section.astro";
import Icon from "@/kit/Icon.astro";
import Pic from "@/kit/Pic.astro";
import ContactBlock from "@/kit/ContactBlock.astro";
import Composer from "@/kit/Composer.astro";
import Nav from "@/sites/mfabogados/Nav.astro";
import Footer from "@/sites/mfabogados/Footer.astro";
import Hero from "@/sites/mfabogados/Hero.astro";
import { site } from "@/sites/mfabogados/site";
import { areas, partners, firma } from "@/sites/mfabogados/data";
import escalera from "@/sites/mfabogados/assets/escalera.jpg";

const base = "/mfabogados";
const wa = `https://wa.me/${site.whatsapp.number}?text=${encodeURIComponent(site.whatsapp.intro)}.`;
const h2 = "text-[clamp(2.1rem,4.6vw,4.2rem)] font-medium leading-[1.02] tracking-[-0.025em]";
---

<SiteLayout site={site} title="Moreno & Fuertes Abogados | Soluciones legales profesionales en la Ciudad de México" nav={false} footer={false}>
  <Nav slot="nav" site={site} variant="pill" tone="dark" />
  <Hero title="Soluciones legales profesionales." lede="Firma de abogados fundada en 2013, con diligencia, honestidad y lealtad.">
    <Fragment slot="actions">
      <Button href={wa} size="lg" external>Escribir por WhatsApp</Button>
      <Button href={`${base}/areas-de-practica`} variant="outline" size="lg">Ver áreas de práctica</Button>
    </Fragment>
  </Hero>

  <Section>
    <div class="wrap"><p data-statement class="max-w-[26ch] font-(family-name:--f-display) text-[clamp(1.9rem,4.4vw,4rem)] font-medium leading-[1.1] tracking-[-0.02em] sm:max-w-[28ch]">{firma.frase}</p></div>
  </Section>

  <Section tone="surface" id="areas">
    <div class="wrap">
      <h2 data-reveal class={`mb-12 ${h2}`}>Áreas de práctica</h2>
      <ul data-stagger data-gap="70" class="border-y border-(--c-line)">
        {
          areas.map((a, i) => (
            <li class:list={[i > 0 && "border-t border-(--c-line)"]}>
              <a href={`${base}/areas-de-practica#${a.key}`} class="mf-row -mx-5 grid items-center gap-3 px-5 py-7 sm:-mx-8 sm:grid-cols-[1.1fr_1fr_auto] sm:gap-10 sm:px-8 sm:py-9">
                <h3 class="text-[clamp(1.7rem,3.4vw,3rem)] font-medium leading-[1.05] tracking-[-0.02em]">{a.title}</h3>
                <p class="mf-teaser max-w-[44ch] text-base text-(--c-muted) sm:text-lg">{a.teaser}</p>
                <span class="mf-arrow hidden size-12 place-items-center rounded-full border border-current/30 sm:grid"><Icon name="arrow-up-right" weight="bold" class="size-5" /></span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </Section>

  <div class="relative isolate flex h-[clamp(24rem,60vw,40rem)] items-end overflow-hidden bg-(--c-dark) text-white">
    <div class="absolute inset-0 -z-10" data-parallax="60"><Pic src={escalera} alt="Escalera monumental de piedra con barandales de hierro, en blanco y negro" position="50% 45%" class="size-full object-cover" /></div>
    <div class="mf-veil absolute inset-0 -z-10"></div>
    <div class="wrap pb-10 sm:pb-14"><p data-reveal class="max-w-[22ch] font-(family-name:--f-display) text-[clamp(1.8rem,4.2vw,3.8rem)] font-medium italic leading-[1.08] tracking-[-0.02em]">{firma.lema}</p></div>
  </div>

  <Section>
    <div class="wrap">
      <h2 data-reveal class={`mb-14 ${h2}`}>Socios fundadores</h2>
      <ul data-stagger data-gap="120" class="grid gap-14 md:grid-cols-2 md:gap-20">
        {
          partners.map((p) => (
            <li class="border-t border-(--c-line) pt-8">
              <h3 class="text-[clamp(1.6rem,2.6vw,2.3rem)] font-medium leading-tight tracking-[-0.015em]">{p.name}</h3>
              <p class="mt-2 text-[15px] text-(--c-muted)">{p.role}</p>
              <p class="mt-6 max-w-[42ch] text-lg leading-relaxed">{p.short}</p>
            </li>
          ))
        }
      </ul>
      <div data-reveal class="mt-12"><Button href={`${base}/nosotros`} variant="outline">Conocer a la firma</Button></div>
    </div>
  </Section>

  <Section tone="surface">
    <div class="wrap">
      <ul data-stagger data-gap="120" class="grid gap-2 sm:gap-0">
        {firma.valores.map((v) => <li class="border-b border-(--c-line) py-3 font-(family-name:--f-display) text-[clamp(2.8rem,10vw,9rem)] font-medium italic leading-[1] tracking-[-0.03em] first:border-t sm:py-5">{v}</li>)}
      </ul>
    </div>
  </Section>

  <Section id="contacto">
    <div class="wrap grid gap-14 lg:grid-cols-2 lg:gap-24">
      <div data-reveal>
        <h2 class={`mb-10 ${h2}`}>Contacto</h2>
        <ContactBlock site={site} showCta={false} />
      </div>
      <div data-reveal data-delay="120" class="border border-(--c-line) bg-(--c-surface) p-6 sm:p-9">
        <Composer site={site} areas={areas.map((a) => a.title)} />
      </div>
    </div>
  </Section>

  <Footer slot="footer" site={site} variant="dark" blurb="Soluciones legales profesionales." />
</SiteLayout>
