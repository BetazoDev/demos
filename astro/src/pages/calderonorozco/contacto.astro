---
import SiteLayout from "@/kit/SiteLayout.astro";
import PageHero from "@/kit/PageHero.astro";
import Section from "@/kit/Section.astro";
import ContactBlock from "@/kit/ContactBlock.astro";
import Composer from "@/kit/Composer.astro";
import { site } from "@/sites/calderonorozco/site";
import { areas } from "@/sites/calderonorozco/data";

const base = "/calderonorozco";
---

<SiteLayout site={site} title="Contacto | Calderón · Orozco Abogados" description="Sedes en Río Amazonas 22, Ciudad de México, y 5 de febrero de 1917 no. 104, Pachuca. WhatsApp 55 1302 4724." nav={{ variant: "pill", tone: "light" }} breadcrumbs={[{ name: "Contacto", href: `${base}/contacto` }]}>
  <PageHero title="Contacto" lede="Escríbanos por WhatsApp o visítenos en cualquiera de nuestras dos sedes." />
  <Section size="sm" class="pt-4">
    <div class="wrap grid gap-14 lg:grid-cols-2 lg:gap-24">
      <div data-reveal><ContactBlock site={site} /></div>
      <div data-reveal data-delay="120" class="rounded-[1.5rem] border border-(--c-line) bg-(--c-surface) p-6 sm:p-9">
        <Composer site={site} areas={areas.map((a) => a.title)} />
      </div>
    </div>
  </Section>
</SiteLayout>
