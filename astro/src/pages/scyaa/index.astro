---
import SiteLayout from "@/kit/SiteLayout.astro";
import Button from "@/kit/Button.astro";
import Section from "@/kit/Section.astro";
import Statement from "@/kit/Statement.astro";
import Stats from "@/kit/Stats.astro";
import AreasIndex from "@/kit/AreasIndex.astro";
import Pic from "@/kit/Pic.astro";
import ContactBlock from "@/kit/ContactBlock.astro";
import Composer from "@/kit/Composer.astro";
import CtaBand from "@/kit/CtaBand.astro";
import Hero from "@/sites/scyaa/Hero.astro";
import { site } from "@/sites/scyaa/site";
import { areas, waLink } from "@/sites/scyaa/data";
import { photos, team, testimonials } from "@/sites/scyaa/people";

const base = "/scyaa";
const rows = areas.map((a) => ({ key: a.key, title: a.title, text: a.short, href: `${base}/servicios/${a.key}` }));
const wa = waLink(site.whatsapp.intro + ".");
const partners = team.filter((p) => p.partner);
const associates = team.filter((p) => !p.partner);
---

<SiteLayout site={site} title="Salcedo Caballero y Abogados Asociados | Servicios legales para empresas en Ciudad de México" description="Asociación de abogados SCYAA, especializada en servicios legales para empresas y desarrollo de negocios. Corporativo, laboral, migratorio, contratos y litigio. Oficinas en la Ciudad de México e Irapuato." nav={{ variant: "pill", tone: "light", logoHeight: 30 }} footer={{ variant: "light", blurb: "Legal & Business Advisor" }}>
  <Hero title="Servicios legales para empresas y desarrollo de negocios" lede="Salcedo Caballero y Abogados Asociados, S.C. es una asociación de abogados con oficinas en la Ciudad de México e Irapuato." image={photos.equipo} imageAlt="El equipo del despacho en la escalera de la oficina, junto al letrero de Mediadores 271 y 288, Correduría Pública 29 y Abogados">
    <Fragment slot="actions">
      <Button href={wa} size="lg" external>Escribir por WhatsApp</Button>
      <Button href={`${base}/servicios`} variant="outline" size="lg">Ver servicios</Button>
    </Fragment>
  </Hero>

  <Section>
    <div class="wrap grid gap-14 lg:grid-cols-[1.35fr_1fr] lg:gap-20">
      <Statement text="No buscamos ser numerosos sino un grupo de profesionales altamente calificados." class="!max-w-[24ch] !text-[clamp(1.9rem,4vw,3.6rem)]" />
      <p data-reveal data-delay="120" class="self-end text-lg text-(--c-muted)">Hemos evolucionado a lo largo de más de 20 años con el principal objetivo de ser un socio de negocios de nuestros clientes, ayudándolos desde el punto de vista legal a realizar sus planes con servicios altamente especializados y a un precio razonable.</p>
    </div>
    <div class="wrap mt-16 sm:mt-24">
      <Stats stats={[{ value: "1996", label: "Año en que nace la firma Salcedo Caballero y Abogados Asociados" }, { value: "+20", label: "Profesionales" }, { value: "2", label: "Oficinas: Ciudad de México e Irapuato" }]} />
    </div>
  </Section>

  <Section tone="surface" id="servicios">
    <div class="wrap">
      <h2 data-reveal class="mb-12 text-[clamp(2rem,4.4vw,3.8rem)] font-medium leading-[1.02] tracking-[-0.02em]">Servicios</h2>
      <AreasIndex areas={rows} />
    </div>
  </Section>

  <Section>
    <div class="wrap">
      <div data-reveal="clip" class="aspect-[16/9] overflow-hidden rounded-[1.5rem] sm:aspect-[2.2/1]"><Pic src={photos.socios} alt="Tres integrantes del despacho junto al letrero de la oficina" position="50% 30%" class="size-full object-cover" /></div>
      <div class="mt-14 grid gap-12 lg:grid-cols-2 lg:gap-24">
        <div data-reveal>
          <h2 class="text-[clamp(1.7rem,3vw,2.6rem)] font-medium leading-tight tracking-[-0.015em]">Socios de negocios</h2>
          <p class="mt-5 max-w-[52ch] text-lg leading-relaxed text-(--c-muted)">Nuestro diferenciador con otros abogados es que el principal objetivo de nuestro personal es encontrar la manera en la que legalmente nuestros clientes puedan realizar las actividades y negocios que han planeado, con la mejor asesoría de negocios posible.</p>
        </div>
        <div data-reveal data-delay="120">
          <h2 class="text-[clamp(1.7rem,3vw,2.6rem)] font-medium leading-tight tracking-[-0.015em]">Gente profesional</h2>
          <p class="mt-5 max-w-[52ch] text-lg leading-relaxed text-(--c-muted)">Nuestro equipo está integrado por abogados titulados con especialidades, maestrías y muchas actualizaciones anuales, conocedores no solo del derecho sino también de áreas de negocios como automotriz, autotransporte, fabricación y eléctrica.</p>
        </div>
      </div>
    </div>
  </Section>

  <Section tone="surface">
    <div class="wrap">
      <h2 data-reveal class="mb-12 text-[clamp(2rem,4.4vw,3.8rem)] font-medium leading-[1.02] tracking-[-0.02em]">Socios y abogados</h2>
      <ul data-stagger data-gap="90" class="grid grid-cols-2 gap-x-5 gap-y-10 md:grid-cols-5">
        {team.map((p) => (
          <li class:list={[p.partner ? "col-span-1 md:col-span-1" : ""]}>
            <div class="img-zoom aspect-[4/5] overflow-hidden rounded-[1.25rem] bg-(--c-bg)"><Pic src={p.photo} alt={p.name} class="size-full object-cover" /></div>
            <h3 class="mt-4 text-lg font-semibold leading-snug tracking-[-0.01em]">{p.name}</h3>
            <p class="mt-1 text-[15px] text-(--c-muted)">{p.role}</p>
          </li>
        ))}
      </ul>
      <div data-reveal class="mt-12"><Button href={`${base}/nosotros`} variant="outline">Conocer a la firma</Button></div>
    </div>
  </Section>

  <Section>
    <div class="wrap">
      <h2 data-reveal class="mb-12 text-[clamp(2rem,4.4vw,3.8rem)] font-medium leading-[1.02] tracking-[-0.02em]">Testimonios</h2>
      <ul data-stagger data-gap="120" class="grid gap-14 lg:grid-cols-[0.8fr_1.2fr] lg:gap-24">
        {testimonials.map((t) => (
          <li>
            <blockquote lang={t.lang} class="font-(family-name:--f-display) text-[clamp(1.4rem,2.3vw,2rem)] leading-snug tracking-[-0.01em]">“{t.text}”</blockquote>
            <p class="mt-5 text-[15px] text-(--c-muted)">{t.author}</p>
          </li>
        ))}
      </ul>
    </div>
  </Section>

  <Section tone="surface" id="contacto">
    <div class="wrap grid gap-14 lg:grid-cols-2 lg:gap-24">
      <div data-reveal>
        <h2 class="mb-10 text-[clamp(2rem,4.4vw,3.8rem)] font-medium leading-[1.02] tracking-[-0.02em]">Contacto</h2>
        <ContactBlock site={site} showCta={false} />
      </div>
      <div data-reveal data-delay="120" class="rounded-[1.5rem] border border-(--c-line) bg-(--c-bg) p-6 sm:p-9">
        <Composer site={site} areas={areas.map((a) => a.title)} />
      </div>
    </div>
  </Section>

  <CtaBand title="Hablemos de su caso" href={wa} label="Escribir por WhatsApp" tone="dark" external />
</SiteLayout>
