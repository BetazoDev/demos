---
import SiteLayout from "@/kit/SiteLayout.astro";
import PageHero from "@/kit/PageHero.astro";
import Section from "@/kit/Section.astro";
import Icon from "@/kit/Icon.astro";
import Accordion from "@/kit/Accordion.astro";
import CtaBand from "@/kit/CtaBand.astro";
import { site } from "@/sites/scyaa/site";
import { areas, waLink } from "@/sites/scyaa/data";

export function getStaticPaths() {
  return areas.map((a) => ({ params: { area: a.key }, props: { area: a } }));
}
const { area } = Astro.props;
const base = "/scyaa";
const others = areas.filter((a) => a.key !== area.key);
const wa = waLink(`${site.whatsapp.intro} sobre ${area.title.toLowerCase()}.`);
const org = new URL(`/${site.slug}#organizacion`, Astro.site).href;
const schema: Record<string, unknown>[] = [
  { "@context": "https://schema.org", "@type": "Service", name: area.title, description: area.lead, provider: { "@id": org }, areaServed: { "@type": "Country", name: "México" } },
];
if (area.faq) schema.push({ "@context": "https://schema.org", "@type": "FAQPage", mainEntity: area.faq.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })) });
const hasSide = !!area.groups;
---

<SiteLayout site={site} title={`${area.title} | Salcedo Caballero y Abogados Asociados`} description={`${area.lead} Despacho de ${area.seo}.`.slice(0, 300)} nav={{ variant: "pill", tone: "light", logoHeight: 30 }} breadcrumbs={[{ name: "Servicios", href: `${base}/servicios` }, { name: area.title, href: `${base}/servicios/${area.key}` }]} schema={schema} footer={{ variant: "light", blurb: "Legal & Business Advisor" }}>
  <PageHero title={area.title} lede={area.lead} transitionName={`area-${area.key}`} />
  <Section size="sm" class="pt-4">
    <div class:list={["wrap grid gap-12 lg:gap-24", hasSide ? "lg:grid-cols-[1.1fr_0.9fr]" : ""]}>
      <div class="grid content-start gap-6">
        {area.paras?.map((p) => <p data-reveal class:list={["max-w-[60ch] leading-relaxed text-(--c-muted)", hasSide ? "text-lg" : "text-xl"]}>{p}</p>)}
      </div>
      {
        area.groups && (
          <div class="grid content-start gap-10">
            {area.groups.map((g) => (
              <section>
                <h2 data-reveal class="mb-5 text-[clamp(1.4rem,2.4vw,1.9rem)] font-medium leading-tight tracking-[-0.02em]">{g.title}</h2>
                <ul data-stagger data-gap="45" class="grid gap-3.5">
                  {g.items.map((i) => (
                    <li class="flex gap-3 text-[17px] leading-snug">
                      <Icon name="check" weight="bold" class="mt-1 size-4 shrink-0 text-(--c-accent)" />
                      <span>{i}</span>
                    </li>
                  ))}
                </ul>
              </section>
            ))}
          </div>
        )
      }
    </div>
  </Section>
  {
    area.faq && (
      <Section tone="surface" size="sm">
        <div class="wrap grid gap-10 lg:grid-cols-[0.5fr_1fr] lg:gap-24">
          <h2 data-reveal class="text-[clamp(1.6rem,3vw,2.4rem)] font-medium leading-tight tracking-[-0.015em]">Preguntas frecuentes</h2>
          <div data-reveal data-delay="100"><Accordion items={area.faq} /></div>
        </div>
      </Section>
    )
  }
  <Section tone={area.faq ? "paper" : "surface"} size="sm">
    <div class="wrap">
      <h2 data-reveal class="mb-8 text-[clamp(1.4rem,2.4vw,1.9rem)] font-medium leading-tight tracking-[-0.02em]">Otros servicios</h2>
      <ul data-stagger data-gap="45" class="flex flex-wrap gap-3">
        {others.map((o) => <li><a href={`${base}/servicios/${o.key}`} class="press inline-flex rounded-full border border-(--c-line) bg-(--c-bg) px-5 py-2.5 text-[15px] hover:border-(--c-accent)">{o.title}</a></li>)}
      </ul>
    </div>
  </Section>
  <CtaBand title="Hablemos de su caso" href={wa} label="Escribir por WhatsApp" tone="dark" external />
</SiteLayout>
