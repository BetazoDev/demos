---
import "@/sites/gtmabogados/site.css";
import SiteLayout from "@/kit/SiteLayout.astro";
import PageHero from "@/kit/PageHero.astro";
import Section from "@/kit/Section.astro";
import Icon from "@/kit/Icon.astro";
import CtaBand from "@/kit/CtaBand.astro";
import Footer from "@/sites/gtmabogados/Footer.astro";
import { site } from "@/sites/gtmabogados/site";
import { groups } from "@/sites/gtmabogados/data";
import columnas from "@/sites/gtmabogados/assets/columnas.jpg";

const base = "/gtmabogados";
const wa = `https://wa.me/${site.whatsapp.number}?text=${encodeURIComponent(site.whatsapp.intro)}.`;
const lede = "Auditorías administrativas y laborales, conflictos de trabajo y patrocinio legal en responsabilidades administrativas de servidores públicos.";
---

<SiteLayout
  site={site}
  title="Servicios | GTM SC Abogados, abogados laboralistas y administrativos en la Ciudad de México"
  description="Auditorías administrativas laborales, conflictos individuales y colectivos de trabajo, formación de sindicatos y responsabilidades administrativas de servidores públicos."
  nav={{ variant: "pill", tone: "light", logoHeight: 44 }}
  footer={false}
  breadcrumbs={[{ name: "Servicios", href: `${base}/servicios` }]}
>
  <PageHero title="Servicios" lede={lede} image={columnas} imageAlt="Columnas y cornisa tallada de un edificio neoclásico de la Ciudad de México al atardecer" />
  <Section size="sm" class="pt-16 sm:pt-24">
    <div class="wrap grid gap-20 lg:gap-28">
      {
        groups.map((g) => (
          <div class="grid gap-8 lg:grid-cols-[0.55fr_1.45fr] lg:gap-16">
            <h2 data-reveal class="text-[clamp(1.6rem,2.6vw,2.2rem)] font-medium leading-tight tracking-[-0.02em] text-(--c-accent)">{g.title}</h2>
            <ul data-stagger data-gap="70" class="divide-y divide-(--c-line) border-y border-(--c-line)">
              {g.items.map((s) => (
                <li>
                  <a href={`${base}/contacto?area=${encodeURIComponent(s.title)}`} class="gtm-row group flex items-start justify-between gap-6 py-7 text-[clamp(1.35rem,2.4vw,2.1rem)] font-medium leading-[1.15] tracking-[-0.02em] sm:py-9">
                    <span class="max-w-[32ch]">{s.title}</span>
                    <Icon name="arrow-up-right" weight="bold" class="gtm-row-arrow mt-1.5 size-6 shrink-0 text-(--c-accent)" />
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </Section>
  <CtaBand title="Cuéntenos su caso" href={wa} label="Escribir por WhatsApp" tone="brand" external />
  <Footer slot="footer" site={site} />
</SiteLayout>
