---
import "@/sites/palominoasociados/theme.css";
import SiteLayout from "@/kit/SiteLayout.astro";
import PageHero from "@/kit/PageHero.astro";
import Section from "@/kit/Section.astro";
import ContactBlock from "@/kit/ContactBlock.astro";
import Composer from "@/kit/Composer.astro";
import { site } from "@/sites/palominoasociados/site";
import { areas } from "@/sites/palominoasociados/data";

const base = "/palominoasociados";
---

<SiteLayout
  site={site}
  title="Contacto | Palomino & Asociados"
  description="Manuel María Contreras 13, colonia San Rafael, Ciudad de México. WhatsApp 55 3712 7954 y correo contacto@palominoasociados.com."
  nav={{ variant: "pill", tone: "dark", logoHeight: 44 }}
  breadcrumbs={[{ name: "Contacto", href: `${base}/contacto` }]}
>
  <PageHero title="Contacto" lede="Escríbanos por WhatsApp o visítenos en la colonia San Rafael." tone="brand" />
  <Section size="sm" class="pt-16 sm:pt-24">
    <div class="wrap grid gap-14 lg:grid-cols-2 lg:gap-24">
      <div data-reveal><ContactBlock site={site} /></div>
      <div data-reveal data-delay="120" class="border border-(--c-line) bg-(--c-surface) p-6 sm:p-9">
        <Composer site={site} areas={areas.map((a) => a.title)} />
      </div>
    </div>
  </Section>
</SiteLayout>
