---
import "@/sites/megoiabogados/site.css";
import SiteLayout from "@/kit/SiteLayout.astro";
import PageHero from "@/kit/PageHero.astro";
import Section from "@/kit/Section.astro";
import Button from "@/kit/Button.astro";
import Icon from "@/kit/Icon.astro";
import CtaBand from "@/kit/CtaBand.astro";
import Footer from "@/sites/megoiabogados/Footer.astro";
import { site } from "@/sites/megoiabogados/site";
import { areas, otros } from "@/sites/megoiabogados/data";
import fachada from "@/sites/megoiabogados/assets/fachada.jpg";

const base = "/megoiabogados";
const wa = `https://wa.me/${site.whatsapp.number}?text=${encodeURIComponent(site.whatsapp.intro)}.`;
const waArea = (t: string) => `https://wa.me/${site.whatsapp.number}?text=${encodeURIComponent(`${site.whatsapp.intro} sobre ${t.toLowerCase()}.`)}`;
const groups = [
  { title: "Áreas de experiencia", items: areas },
  { title: "Otros servicios", items: otros },
];
const schema = areas.map((a) => ({
  "@context": "https://schema.org",
  "@type": "Service",
  name: a.title,
  description: a.text,
  provider: { "@id": `https://demos.diabolicalservices.tech/${site.slug}#organizacion` },
  areaServed: { "@type": "City", name: "Ciudad de México" },
}));
---

<SiteLayout
  site={site}
  title="Servicios | Megoi Abogados Asociados, derecho administrativo, bancario, familiar, civil, mercantil, penal y laboral"
  description="Asesoría y representación jurídica en derecho administrativo, bancario, familiar, civil, mercantil, penal y laboral, en la Ciudad de México."
  nav={{ variant: "pill", tone: "light", logoHeight: 52 }}
  footer={false}
  breadcrumbs={[{ name: "Servicios", href: `${base}/servicios` }]}
  schema={schema}
>
  <PageHero title="Servicios" lede="Asesoría y representación jurídica en derecho administrativo, bancario, familiar, civil, mercantil, penal y laboral." image={fachada} imageAlt="Fachada de piedra de un edificio con ventanales en arco, con ramas de jacaranda en flor" />
  <Section size="sm" class="pt-16 sm:pt-24">
    <div class="wrap grid gap-20 lg:gap-28">
      {
        groups.map((g, gi) => (
          <div class="grid gap-8 lg:grid-cols-[0.5fr_1.5fr] lg:gap-16">
            <h2 data-reveal class="font-(family-name:--f-display) text-[clamp(1.4rem,2.2vw,1.9rem)] font-medium leading-tight tracking-[-0.03em]">{g.title}</h2>
            <div class="divide-y divide-(--c-line) border-y border-(--c-line)">
              {g.items.map((a, i) => (
                <details class="acc group" open={gi === 0 && i === 0} id={a.key}>
                  <summary class="flex items-center justify-between gap-6 py-6 sm:py-7">
                    <span class="flex items-center gap-5">
                      <Icon name={a.icon} class="size-8 shrink-0 text-(--c-brand)" />
                      <h3 class="mgo-body text-[clamp(1.25rem,2.3vw,1.9rem)] font-medium leading-tight tracking-[-0.02em]">{a.title}</h3>
                    </span>
                    <span class="acc-plus grid size-9 shrink-0 place-items-center rounded-full border border-current/25" aria-hidden="true">
                      <svg width="12" height="12" viewBox="0 0 12 12"><path d="M6 1v10M1 6h10" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" fill="none" /></svg>
                    </span>
                  </summary>
                  <div class="acc-body">
                    <div>
                      <div class="grid gap-7 pb-9 sm:pl-[3.25rem]">
                        <p class="max-w-[54ch] text-lg leading-relaxed text-(--c-muted)">{a.text}</p>
                        <div><Button href={waArea(a.title)} external>Escribir por WhatsApp</Button></div>
                      </div>
                    </div>
                  </div>
                </details>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </Section>
  <CtaBand title="Agenda tu cita hoy mismo." href={wa} label="Escribir por WhatsApp" tone="surface" external />
  <Footer slot="footer" site={site} variant="dark" blurb="Profesionalismo a tu alcance." />
</SiteLayout>
