---
import Layout from "@/sites/victorhugonunoaguillonconsul/Layout.astro";
import Composer from "@/sites/victorhugonunoaguillonconsul/Composer.astro";
import PageHero from "@/kit/PageHero.astro";
import Section from "@/kit/Section.astro";
import ContactBlock from "@/kit/ContactBlock.astro";
import { site } from "@/sites/victorhugonunoaguillonconsul/site";
import { areasComposer } from "@/sites/victorhugonunoaguillonconsul/data";

const base = "/victorhugonunoaguillonconsul";
const cb = { ...site, phones: [] };
---

<Layout site={site} title="Contacto | Victor Hugo Nuño Aguillon, abogado en Granada, Polanco" description="Escríbeme por WhatsApp al 55 1631 9839 o por correo. Atención presencial en Lago Alberto s/n, colonia Granada, Miguel Hidalgo, y en línea." breadcrumbs={[{ name: "Contacto", href: `${base}/contacto` }]}>
  <PageHero title="Contacto" lede="Escríbeme por WhatsApp. Atención presencial en Granada, Polanco y CDMX, y en línea." />
  <Section size="sm" class="pt-4">
    <div class="wrap grid gap-14 lg:grid-cols-2 lg:gap-24">
      <div data-reveal><ContactBlock site={cb} /></div>
      <div data-reveal data-delay="120" class="rounded-[1.25rem] border border-(--c-line) bg-(--c-surface) p-6 sm:p-9">
        <Composer site={site} areas={areasComposer} />
      </div>
    </div>
  </Section>
</Layout>
