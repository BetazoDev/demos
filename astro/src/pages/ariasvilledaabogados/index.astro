---
import "@/sites/ariasvilledaabogados/site.css";
import SiteLayout from "@/kit/SiteLayout.astro";
import Button from "@/kit/Button.astro";
import Section from "@/kit/Section.astro";
import AreasIndex from "@/kit/AreasIndex.astro";
import ImageBand from "@/kit/ImageBand.astro";
import ContactBlock from "@/kit/ContactBlock.astro";
import Composer from "@/kit/Composer.astro";
import Hero from "@/sites/ariasvilledaabogados/Hero.astro";
import { site } from "@/sites/ariasvilledaabogados/site";
import { areas, team, firma, cobertura } from "@/sites/ariasvilledaabogados/data";
import calle from "@/sites/ariasvilledaabogados/assets/calle.jpg";
import archivo from "@/sites/ariasvilledaabogados/assets/archivo.jpg";

const base = "/ariasvilledaabogados";
const wa = `https://wa.me/${site.whatsapp.number}?text=${encodeURIComponent(site.whatsapp.intro)}.`;
const rows = areas.map((a) => ({ key: a.key, title: a.title, text: a.teaser, href: `${base}/servicios/${a.key}` }));
const h2 = "text-[clamp(2.1rem,4.4vw,3.9rem)] leading-[1.02] tracking-[-0.03em]";
---

<SiteLayout site={site} title="Arias & Villeda Abogados | Despacho corporativo, notarial y litigio en la Roma Sur, Ciudad de México" nav={{ variant: "bar", tone: "light", logoHeight: 56 }}>
  <Hero title="Atención experta y personalizada" lede="Despacho de abogados en la Ciudad de México con servicios especializados en diversas áreas del Derecho." image={calle} imageAlt="Calle arbolada de la colonia Roma con una fachada de piedra y balcones de hierro forjado" position="68% 50%">
    <Fragment slot="actions">
      <Button href={wa} size="lg" external>Escribir por WhatsApp</Button>
      <Button href={`${base}/servicios`} variant="outline" size="lg">Ver servicios</Button>
    </Fragment>
  </Hero>

  <Section>
    <div class="wrap"><p data-statement class="max-w-[28ch] font-(family-name:--f-display) text-[clamp(1.9rem,4.3vw,3.8rem)] font-light leading-[1.12] tracking-[-0.025em]">{firma.frase}</p></div>
  </Section>

  <Section tone="surface" id="servicios">
    <div class="wrap">
      <h2 data-reveal class={`mb-12 ${h2}`}>Servicios</h2>
      <AreasIndex areas={rows} />
    </div>
  </Section>

  <ImageBand image={archivo} alt="Pasillo de un archivo con estantes metálicos y cajas grises bajo lámparas colgantes" position="50% 50%" />

  <Section id="cobertura">
    <div class="wrap">
      <div class="grid gap-8 lg:grid-cols-[0.6fr_1.4fr] lg:gap-24">
        <h2 data-reveal class={h2}>Cobertura</h2>
        <div data-reveal data-delay="80">
          <p class="max-w-[58ch] text-lg leading-relaxed text-(--c-muted) sm:text-xl">{cobertura.intro}</p>
          <div class="mt-8"><Button href={`${base}/cobertura`} variant="outline">Ver cobertura</Button></div>
        </div>
      </div>
      <ul data-stagger data-gap="90" class="av-zones mt-16 grid lg:grid-cols-5">
        {
          cobertura.zonas.map((z) => (
            <li class="py-7 lg:px-6 lg:first:pl-0 lg:last:pr-0">
              <h3 class="text-lg font-medium">{z.zona}</h3>
              <p class="mt-3 text-[15px] leading-relaxed text-(--c-muted)">{z.entidades.join(", ")}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </Section>

  <Section tone="surface">
    <div class="wrap grid gap-10 lg:grid-cols-[0.6fr_1.4fr] lg:gap-24">
      <div>
        <h2 data-reveal class={h2}>Nuestro equipo</h2>
        <div data-reveal data-delay="80" class="mt-8"><Button href={`${base}/nosotros`} variant="outline">Conocer a la firma</Button></div>
      </div>
      <ul data-stagger data-gap="70" class="grid gap-x-10 gap-y-9 sm:grid-cols-2">
        {team.map((p) => <li><h3 class="text-xl font-medium leading-snug tracking-[-0.01em]">{p.name}</h3><p class="mt-1 text-base text-(--c-muted)">{p.role}</p></li>)}
      </ul>
    </div>
  </Section>

  <Section id="contacto">
    <div class="wrap grid gap-14 lg:grid-cols-2 lg:gap-24">
      <div data-reveal>
        <h2 class={`mb-10 ${h2}`}>Contacto</h2>
        <ContactBlock site={site} showCta={false} />
      </div>
      <div data-reveal data-delay="120" class="border border-(--c-line) bg-(--c-surface) p-6 sm:p-9">
        <Composer site={site} areas={areas.map((a) => a.title)} />
      </div>
    </div>
  </Section>
</SiteLayout>
