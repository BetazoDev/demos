---
import SiteLayout from "@/kit/SiteLayout.astro";
import PageHero from "@/kit/PageHero.astro";
import Section from "@/kit/Section.astro";
import Button from "@/kit/Button.astro";
import Icon from "@/kit/Icon.astro";
import CtaBand from "@/kit/CtaBand.astro";
import Footer from "@/sites/revsaabogados/Footer.astro";
import Skin from "@/sites/revsaabogados/Skin.astro";
import { site } from "@/sites/revsaabogados/site";
import { areas, opiniones } from "@/sites/revsaabogados/data";

export function getStaticPaths() {
  return areas.map((a) => ({ params: { area: a.key }, props: { area: a } }));
}
const { area } = Astro.props;
const base = "/revsaabogados";
const others = areas.filter((a) => a.key !== area.key);
const quotes = area.opinions.map((k) => opiniones[k]);
const wa = `https://wa.me/${site.whatsapp.number}?text=${encodeURIComponent(`${site.whatsapp.intro} sobre ${area.title.toLowerCase()}.`)}`;
const schema = [{
  "@context": "https://schema.org",
  "@type": "Service",
  name: area.title,
  description: area.lead,
  provider: { "@id": `https://demos.diabolicalservices.tech/${site.slug}#organizacion` },
  areaServed: { "@type": "City", name: "Ciudad de México" },
}];
---

<SiteLayout
  site={site}
  title={`${area.title} | REVSA Abogados, Roma Sur, CDMX`}
  description={area.meta}
  nav={{ variant: "pill", tone: "light", logoHeight: 60 }}
  footer={false}
  schema={schema}
  breadcrumbs={[{ name: "Áreas jurídicas", href: `${base}/servicios` }, { name: area.title, href: `${base}/servicios/${area.key}` }]}
>
  <Skin />
  <PageHero title={area.title} lede={area.lead} transitionName={`area-${area.key}`} />

  <Section size="sm" class="pt-6">
    <div class="wrap grid gap-10 lg:grid-cols-[0.7fr_1.3fr] lg:gap-20">
      <h2 data-reveal class="text-[clamp(1.5rem,2.6vw,2.2rem)] leading-tight tracking-[-0.02em]">Asuntos que atendemos</h2>
      <div>
        <ul data-stagger data-gap="55" class="grid gap-x-8 sm:grid-cols-2">
          {
            area.items.map((i) => (
              <li class="flex items-start gap-4 border-t border-(--c-line) py-5 text-[clamp(1.15rem,1.7vw,1.4rem)] leading-snug">
                <Icon name="check" weight="bold" class="mt-[0.45em] size-4 shrink-0 text-(--c-accent)" />
                <span>{i}</span>
              </li>
            ))
          }
          {area.more && <li class="flex items-start gap-4 border-t border-(--c-line) py-5 text-[clamp(1.15rem,1.7vw,1.4rem)] leading-snug text-(--c-muted)"><Icon name="plus" weight="bold" class="mt-[0.45em] size-4 shrink-0 text-(--c-accent)" /><span>Y más asuntos de esta materia</span></li>}
        </ul>
        <div data-reveal class="mt-10"><Button href={wa} external>Escribir por WhatsApp</Button></div>
      </div>
    </div>
  </Section>

  {
    quotes.length > 0 && (
      <Section tone="surface" size="sm">
        <div class="wrap">
          <h2 data-reveal class="mb-10 text-[clamp(1.5rem,2.6vw,2.2rem)] leading-tight tracking-[-0.02em]">Lo que dicen nuestros clientes</h2>
          <ul data-stagger data-gap="90" class:list={["grid gap-5", quotes.length > 1 && "md:grid-cols-2"]}>
            {quotes.map((q) => (
              <li class="flex flex-col justify-between gap-8 rounded-(--c-radius-card,1.5rem) bg-(--c-bg) p-7 sm:p-9">
                <blockquote class="font-(family-name:--f-display) text-[clamp(1.25rem,1.9vw,1.65rem)] leading-[1.25] tracking-[-0.015em]">“{q.text}”</blockquote>
                <p class="text-[15px] text-(--c-muted)">{q.author}</p>
              </li>
            ))}
          </ul>
        </div>
      </Section>
    )
  }

  <Section size="sm">
    <div class="wrap">
      <h2 data-reveal class="mb-8 text-[clamp(1.5rem,2.6vw,2.2rem)] leading-tight tracking-[-0.02em]">Otras áreas</h2>
      <ul data-stagger data-gap="45" class="flex flex-wrap gap-3">
        {others.map((o) => <li><a href={`${base}/servicios/${o.key}`} class="press inline-flex rounded-full border border-(--c-line) px-5 py-2.5 text-[15px] hover:border-(--c-accent) hover:text-(--c-accent)">{o.title}</a></li>)}
      </ul>
    </div>
  </Section>

  <CtaBand title="¡Quiero una asesoría!" href={wa} label="Escribir por WhatsApp" tone="brand" external />
  <Footer slot="footer" site={site} variant="dark" blurb="Soluciones jurídicas al alcance de tu mano" />
</SiteLayout>
