---
import SiteLayout from "@/kit/SiteLayout.astro";
import Button from "@/kit/Button.astro";
import Section from "@/kit/Section.astro";
import Statement from "@/kit/Statement.astro";
import AreasIndex from "@/kit/AreasIndex.astro";
import Split from "@/kit/Split.astro";
import Pic from "@/kit/Pic.astro";
import ContactBlock from "@/kit/ContactBlock.astro";
import Composer from "@/kit/Composer.astro";
import Nav from "@/sites/bravoabogados/Nav.astro";
import Footer from "@/sites/bravoabogados/Footer.astro";
import Hero from "@/sites/bravoabogados/Hero.astro";
import Personas from "@/sites/bravoabogados/Personas.astro";
import { site } from "@/sites/bravoabogados/site";
import { areas, otras, photos, fundador, equipo } from "@/sites/bravoabogados/data";

const base = "/bravoabogados";
const rows = areas.map((a) => ({ key: a.key, title: a.title, text: a.summary, href: `${base}/servicios/${a.key}` }));
const wa = `https://wa.me/${site.whatsapp.number}?text=${encodeURIComponent(site.whatsapp.intro)}.`;
const h2 = "text-[clamp(2rem,4.2vw,3.6rem)] font-normal leading-[1.05] tracking-[-0.025em]";
---

<SiteLayout site={site} bodyClass="[--c-radius-img:0px] [--c-radius-card:0px] [--c-radius-field:0px]" title="Bravo Abogados | Servicios jurídicos para empresas concesionarias, CDMX" description={site.description} nav={false} footer={false}>
  <Nav slot="nav" site={site} variant="bar" tone="dark" />
  <Hero title="Servicios jurídicos para las empresas concesionarias de obras y servicios públicos" lede="Asesoría, juicios administrativos, mercantiles, civiles y penales." image={photos.librero} imageAlt="Librero con libros de derecho y un águila de bronce en la oficina del despacho" position="40% 50%">
    <Fragment slot="actions">
      <Button href={wa} variant="light" size="lg" external>Escribir por WhatsApp</Button>
      <Button href={`${base}/servicios`} variant="outline" size="lg">Ver servicios</Button>
    </Fragment>
  </Hero>

  <Section>
    <div class="wrap"><Statement text="Servicios legales que requieren no solo las grandes empresas, sino también las medianas y pequeñas." class="max-w-[26ch] font-(family-name:--f-display) font-light! tracking-[-0.025em] sm:max-w-[28ch]" /></div>
  </Section>

  <Section tone="surface" id="servicios">
    <div class="wrap">
      <h2 data-reveal class={`mb-12 ${h2}`}>Servicios</h2>
      <AreasIndex areas={rows} />
      <p data-reveal class="mt-8 text-[15px] text-(--c-muted)">También: {otras.join(", ").toLowerCase()}.</p>
    </div>
  </Section>

  <Section tone="brand">
    <div class="wrap grid items-end gap-10 lg:grid-cols-[auto_1fr] lg:gap-20">
      <p data-count="80%" class="font-(family-name:--f-display) text-[clamp(6rem,17vw,15rem)] font-light leading-[0.8] tracking-[-0.05em] tabular-nums">80%</p>
      <div data-reveal class="pb-2">
        <p class="max-w-[34ch] font-(family-name:--f-display) text-[clamp(1.5rem,2.6vw,2.2rem)] leading-[1.2] tracking-[-0.015em]">de los juicios mercantiles promovidos contra TRIBASA, ahora PINFRA, durante su concurso mercantil, con resultados favorables.</p>
        <div class="mt-8"><Button href={`${base}/servicios/civil-mercantil`} variant="light">Ver el asunto</Button></div>
      </div>
    </div>
  </Section>

  <Section>
    <div class="wrap">
      <Split image={fundador.photo} alt={`${fundador.name}, abogado fundador, en su biblioteca`} ratio="4/5" class="lg:grid-cols-[0.8fr_1.2fr]">
        <h2 class={h2}>{fundador.name}</h2>
        <p class="mt-3 text-lg text-(--c-muted)">{fundador.role}</p>
        <p class="mt-8 max-w-[56ch] text-lg leading-relaxed">{fundador.bio[0]}</p>
        <p class="mt-5 max-w-[56ch] text-lg leading-relaxed text-(--c-muted)">{fundador.bio[1]}</p>
        <div class="mt-9"><Button href={`${base}/nosotros`} variant="outline">Conocer al equipo</Button></div>
      </Split>
    </div>
  </Section>

  <Section tone="surface" size="sm">
    <div class="wrap">
      <h2 data-reveal class={`mb-10 ${h2}`}>Equipo en la Ciudad de México</h2>
      <Personas people={equipo} />
    </div>
  </Section>

  <div class="relative isolate overflow-hidden bg-(--c-dark) text-(--c-on-dark)" style="min-height:clamp(26rem,52vw,36rem)">
    <div class="absolute inset-0 -z-10" data-parallax="60"><Pic src={photos.nudo} alt="Nudo vial visto desde el aire al anochecer" class="size-full object-cover" /></div>
    <div class="absolute inset-0 -z-10 bg-[linear-gradient(to_top,color-mix(in_oklab,var(--c-dark)_88%,transparent),color-mix(in_oklab,var(--c-dark)_30%,transparent)_75%)]"></div>
    <div class="wrap flex min-h-[inherit] items-end pb-12 sm:pb-16">
      <p data-reveal class="max-w-[32ch] font-(family-name:--f-display) text-[clamp(1.6rem,3.2vw,2.8rem)] font-light leading-[1.15] tracking-[-0.02em]">Apoyamos a las empresas que llevan a cabo obras y servicios públicos, y a las personas afectadas por los actos de las autoridades federales, locales y municipales.</p>
    </div>
  </div>

  <Section id="contacto">
    <div class="wrap grid gap-14 lg:grid-cols-[1fr_1fr] lg:gap-24">
      <div data-reveal>
        <h2 class={`mb-10 ${h2}`}>Contacto</h2>
        <ContactBlock site={site} showCta={false} />
      </div>
      <div data-reveal data-delay="120" class="rounded-(--c-radius) border border-(--c-line) bg-(--c-surface) p-6 sm:p-9">
        <Composer site={site} areas={[...areas.map((a) => a.title), ...otras]} />
      </div>
    </div>
  </Section>
  <Footer slot="footer" site={site} variant="dark" blurb="Bufete Bravo Abogados. Soporte funcional, S.C." />
</SiteLayout>
