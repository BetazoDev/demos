---
import Layout from "@/sites/abogadosquintero/Layout.astro";
import Servicios from "@/sites/abogadosquintero/Servicios.astro";
import PageHero from "@/kit/PageHero.astro";
import Section from "@/kit/Section.astro";
import CtaBand from "@/kit/CtaBand.astro";
import { site } from "@/sites/abogadosquintero/site";
import { areas, tambien, texto } from "@/sites/abogadosquintero/data";

const base = "/abogadosquintero";
const wa = `https://wa.me/${site.whatsapp.number}?text=${encodeURIComponent(site.whatsapp.intro + ".")}`;
const org = new URL(`/${site.slug}#organizacion`, Astro.site).href;
const schema = areas.slice(0, 6).map((a) => ({
  "@context": "https://schema.org",
  "@type": "Service",
  name: a.title,
  description: a.text.join(" "),
  provider: { "@id": org },
  areaServed: { "@type": "City", name: "Ciudad de México" },
  serviceType: "Derecho familiar",
}));
---

<Layout footer={{ variant: "light", blurb: "Expertos en derecho familiar." }} title="Servicios de derecho familiar: pensión alimenticia, divorcio y sucesiones | Abogados Quintero" description="Pensión alimenticia, divorcio incausado, voluntario y administrativo, testamentarios y sucesiones, guarda y custodia, visitas y convivencias, y gestiones familiares en la Ciudad de México." schema={schema} breadcrumbs={[{ name: "Servicios", href: `${base}/servicios` }]}>
  <PageHero title="Servicios" lede={texto.amplia} />
  <Section size="sm" class="pt-4">
    <div class="wrap">
      <Servicios items={areas} />
      <p data-reveal class="mt-8 text-[15px] text-(--c-muted)">{tambien}</p>
    </div>
  </Section>
  <CtaBand title="Evite problemas futuros" text="Priorizamos la resolución amigable, pero estamos listos para representarlo con determinación en el tribunal cuando sea necesario." href={wa} label="Escribir por WhatsApp" tone="dark" external />
</Layout>
