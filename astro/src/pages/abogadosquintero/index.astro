---
import Layout from "@/sites/abogadosquintero/Layout.astro";
import Hero from "@/sites/abogadosquintero/Hero.astro";
import Promesa from "@/sites/abogadosquintero/Promesa.astro";
import Button from "@/kit/Button.astro";
import Section from "@/kit/Section.astro";
import AreasIndex from "@/sites/abogadosquintero/Indice.astro";
import Split from "@/kit/Split.astro";
import ContactBlock from "@/kit/ContactBlock.astro";
import Composer from "@/kit/Composer.astro";
import CtaBand from "@/kit/CtaBand.astro";
import { site } from "@/sites/abogadosquintero/site";
import { areas, tambien, photos, esperar, texto } from "@/sites/abogadosquintero/data";
import band from "@/sites/abogadosquintero/assets/madre-hija-hd.jpg";

const base = "/abogadosquintero";
const short = (t: string[]) => t.reduce((acc, p) => (acc && (acc + " " + p).length > 175 ? acc : acc ? acc + " " + p : p), "");
const main = areas.slice(0, 4).map((a) => ({ key: a.key, title: a.title, text: short(a.text), href: `${base}/servicios#${a.key}` }));
const wa = `https://wa.me/${site.whatsapp.number}?text=${encodeURIComponent(site.whatsapp.intro + ".")}`;
const h2 = "text-[clamp(2rem,4.4vw,3.8rem)] leading-[1.04]";
---

<Layout title="Abogados de derecho familiar en la Tabacalera, CDMX | Abogados Quintero" footer={{ variant: "light", blurb: "Expertos en derecho familiar." }}>
  <Hero title="Expertos en derecho familiar" lede="Solucionamos problemas legales en temas de pensión alimenticia, guarda y custodia, divorcios, testamentarios y más." image={photos.madre} imageAlt="Una joven y una mujer mayor se abrazan sonriendo, fotografía en blanco y negro" position="58% 40%">
    <Fragment slot="actions">
      <Button href={wa} size="lg" external>Escribir por WhatsApp</Button>
      <Button href={`${base}/servicios`} variant="outline" size="lg">Ver servicios</Button>
    </Fragment>
  </Hero>

  <Section>
    <div class="wrap"><Promesa /></div>
  </Section>

  <Section tone="surface" id="servicios">
    <div class="wrap">
      <h2 data-reveal class={`mb-12 ${h2}`}>Servicios</h2>
      <AreasIndex areas={main} />
      <p data-reveal class="mt-8 text-[15px] text-(--c-muted)">{tambien}</p>
      <div data-reveal class="mt-10"><Button href={`${base}/servicios`} variant="outline">Ver todos los servicios</Button></div>
    </div>
  </Section>

  <Section>
    <div class="wrap">
      <Split image={band} alt="Una madre besa a su hija pequeña en la frente" position="50% 40%" ratio="4/3">
        <h2 class="max-w-[18ch] text-[clamp(1.9rem,3.8vw,3.2rem)] leading-[1.08]">{texto.tranquilidad}</h2>
        <p class="mt-7 max-w-[46ch] text-lg text-(--c-muted)">{texto.gestion}</p>
        <div class="mt-9"><Button href={`${base}/servicios`} variant="outline">Ver servicios</Button></div>
      </Split>
    </div>
  </Section>

  <Section tone="surface">
    <div class="wrap">
      <h2 data-reveal class={`mb-12 ${h2}`}>¿Qué puedes esperar de nosotros?</h2>
      <ul data-stagger data-gap="90" class="grid gap-9 sm:gap-11">
        {
          esperar.map((e) => (
            <li class="grid items-baseline gap-2 md:grid-cols-[0.8fr_1.2fr] md:gap-16">
              <h3 class="text-[clamp(1.7rem,3.2vw,2.8rem)] leading-tight">{e.title}</h3>
              <p class="max-w-[44ch] text-lg text-(--c-muted)">{e.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </Section>

  <Section id="contacto">
    <div class="wrap grid gap-14 lg:grid-cols-2 lg:gap-24">
      <div data-reveal>
        <h2 class={`mb-10 ${h2}`}>Contacto</h2>
        <ContactBlock site={site} showCta={false} />
      </div>
      <div data-reveal data-delay="120" class="rounded-(--c-radius-card,16px) border border-(--c-line) bg-(--c-surface) p-6 sm:p-9">
        <Composer site={site} areas={areas.map((a) => a.title)} />
      </div>
    </div>
  </Section>

  <CtaBand title="Evite problemas futuros" text="Confíe en nosotros para proteger sus intereses familiares." href={wa} label="Escribir por WhatsApp" tone="dark" external />
</Layout>
