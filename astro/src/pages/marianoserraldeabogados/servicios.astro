---
import "@/sites/marianoserraldeabogados/theme.css";
import SiteLayout from "@/kit/SiteLayout.astro";
import PageHero from "@/kit/PageHero.astro";
import Section from "@/kit/Section.astro";
import CtaBand from "@/kit/CtaBand.astro";
import AreaList from "@/sites/marianoserraldeabogados/AreaList.astro";
import { site } from "@/sites/marianoserraldeabogados/site";
import { intro, main, others } from "@/sites/marianoserraldeabogados/data";

const base = "/marianoserraldeabogados";
const wa = `https://wa.me/${site.whatsapp.number}?text=${encodeURIComponent(site.whatsapp.intro)}.`;
---

<SiteLayout
  site={site}
  title="Servicios legales | Mariano Serralde & Asociados, Polanco CDMX"
  description="Asesoría y representación corporativa, civil, mercantil, laboral, propiedad industrial y derechos de autor, seguridad social, familiar, administrativo y amparo en Polanco, Ciudad de México."
  nav={{ variant: "pill", tone: "light", logoHeight: 46 }}
  breadcrumbs={[{ name: "Servicios", href: `${base}/servicios` }]}
>
  <PageHero title="Servicios" lede={intro.lede} />

  <Section size="sm" class="pt-4">
    <div class="wrap">
      <h2 data-reveal class="mb-8 text-[clamp(1.8rem,3.4vw,2.8rem)] leading-tight">Áreas de práctica</h2>
      <AreaList areas={main} />
    </div>
  </Section>

  <Section tone="surface" size="sm">
    <div class="wrap">
      <h2 data-reveal class="mb-8 text-[clamp(1.8rem,3.4vw,2.8rem)] leading-tight">También atendemos</h2>
      <AreaList areas={others} />
    </div>
  </Section>

  <CtaBand title="Servicios legales en defensa de tus intereses" href={wa} label="Escribir por WhatsApp" tone="brand" external />
</SiteLayout>
