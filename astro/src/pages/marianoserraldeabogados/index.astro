---
import "@/sites/marianoserraldeabogados/theme.css";
import SiteLayout from "@/kit/SiteLayout.astro";
import Button from "@/kit/Button.astro";
import Section from "@/kit/Section.astro";
import Statement from "@/kit/Statement.astro";
import AreasIndex from "@/kit/AreasIndex.astro";
import Split from "@/kit/Split.astro";
import ContactBlock from "@/kit/ContactBlock.astro";
import Composer from "@/kit/Composer.astro";
import Hero from "@/sites/marianoserraldeabogados/Hero.astro";
import { site } from "@/sites/marianoserraldeabogados/site";
import { intro, main, reviews, photos, serviceNames } from "@/sites/marianoserraldeabogados/data";

const base = "/marianoserraldeabogados";
const wa = `https://wa.me/${site.whatsapp.number}?text=${encodeURIComponent(site.whatsapp.intro)}.`;
const rows = main.map((a) => ({ key: a.key, title: a.title, text: a.text, href: `${base}/servicios#${a.key}` }));
const addr = site.addresses[0];
---

<SiteLayout
  site={site}
  title="Mariano Serralde & Asociados | Servicios legales corporativos en Polanco, CDMX"
  description="Firma legal especializada en el rubro corporativo: asesoría y representación laboral, civil, mercantil, propiedad industrial y derechos de autor. Torre Polanco, Ciudad de México."
  nav={{ variant: "pill", tone: "dark", logoHeight: 46 }}
  footer={{ variant: "dark", blurb: "Servicios legales en defensa de tus intereses" }}
>
  <Hero title={intro.title} lede={intro.lede} image={photos.capitel} imageAlt="Capitel de columna de piedra clara sobre un fondo gris oscuro">
    <Fragment slot="actions">
      <Button href={wa} variant="solid" size="lg" external>Escribir por WhatsApp</Button>
      <Button href={`${base}/servicios`} variant="outline" size="lg">Ver servicios</Button>
    </Fragment>
  </Hero>

  <Section>
    <div class="wrap"><Statement text={intro.statement} /></div>
  </Section>

  <Section id="servicios" size="sm" class="pt-0">
    <div class="wrap">
      <h2 data-reveal class="mb-12 text-[clamp(2.2rem,4.8vw,4rem)] leading-[1.02]">Áreas de práctica</h2>
      <AreasIndex areas={rows} />
      <div data-reveal class="mt-10"><Button href={`${base}/servicios`} variant="outline">Ver todos los servicios</Button></div>
    </div>
  </Section>

  <Section tone="surface">
    <div class="wrap">
      <Split image={photos.torre} alt="Fachada de Torre Polanco: muro verde y torre de cristal" ratio="1/1">
        <h2 class="text-[clamp(2.2rem,4.8vw,4rem)] leading-[1.02]">Torre Polanco</h2>
        <address class="mt-8 max-w-[38ch] text-lg not-italic text-(--c-muted)">{addr.text}</address>
        {site.hours && <p class="mt-5 text-lg">{site.hours}</p>}
        <div class="mt-10 flex flex-wrap gap-3">
          <Button href={site.mapsUrl!} variant="outline" external>Ver en el mapa</Button>
        </div>
      </Split>
    </div>
  </Section>

  <Section>
    <div class="wrap grid gap-12 lg:grid-cols-[0.6fr_1.4fr] lg:gap-24">
      <p data-reveal class="flex flex-col gap-3">
        <span data-count={reviews.rating.toFixed(1)} class="font-(family-name:--f-display) text-[clamp(4.5rem,10vw,8rem)] leading-none tabular-nums">{reviews.rating.toFixed(1)}</span>
        <span class="text-lg text-(--c-muted)">en Google, {reviews.count} reseñas</span>
      </p>
      <ul data-stagger data-gap="100" class="grid gap-x-12 gap-y-10 sm:grid-cols-2">
        {reviews.quotes.map((q, i) => (
          <li class:list={[i === 0 && "sm:col-span-2"]}>
            <blockquote class:list={["font-(family-name:--f-display) leading-[1.15]", i === 0 ? "text-[clamp(2rem,4vw,3.4rem)]" : "text-[clamp(1.5rem,2.4vw,2rem)]"]}>“{q.text}”</blockquote>
            <p class="mt-3 text-(--c-muted)">{q.author}</p>
          </li>
        ))}
      </ul>
    </div>
  </Section>

  <Section tone="surface" id="contacto">
    <div class="wrap grid gap-14 lg:grid-cols-[1fr_1fr] lg:gap-24">
      <div data-reveal>
        <h2 class="mb-10 text-[clamp(2.2rem,4.8vw,4rem)] leading-[1.02]">Contacto</h2>
        <ContactBlock site={site} showCta={false} />
      </div>
      <div data-reveal data-delay="120" class="border border-(--c-line) bg-(--c-bg) p-6 sm:p-9">
        <Composer site={site} areas={serviceNames} />
      </div>
    </div>
  </Section>
</SiteLayout>
