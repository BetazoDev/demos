---
import SiteLayout from "@/kit/SiteLayout.astro";
import PageHero from "@/kit/PageHero.astro";
import Section from "@/kit/Section.astro";
import Statement from "@/kit/Statement.astro";
import Stats from "@/kit/Stats.astro";
import Pic from "@/kit/Pic.astro";
import Icon from "@/kit/Icon.astro";
import CtaBand from "@/kit/CtaBand.astro";
import Nav from "@/sites/abogadoscej/Nav.astro";
import Footer from "@/sites/abogadoscej/Footer.astro";
import { site, waLink } from "@/sites/abogadoscej/site";
import lockup from "@/sites/abogadoscej/assets/logo-lockup.png";
import atardecer from "@/sites/abogadoscej/assets/sala-atardecer.jpg";

const base = "/abogadoscej";
---

<SiteLayout
  site={site}
  title="Nosotros | Consultores & Estrategas Jurídicos"
  description="Consultores y estrategas jurídicos especializados en cumplimiento normativo y asesoría corporativa, con oficinas en Ciudad de México y San Luis Potosí."
  breadcrumbs={[{ name: "Nosotros", href: `${base}/nosotros` }]}
  nav={false}
  footer={false}
>
  <Nav slot="nav" site={site} />
  <PageHero title="Soluciones jurídicas para un entorno complejo" lede="Consultores y estrategas jurídicos especializados en cumplimiento normativo y asesoría corporativa." />

  <Section size="sm" class="pt-8">
    <div class="wrap grid items-center gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:gap-24">
      <div data-reveal="clip" class="mx-auto w-full max-w-[26rem] overflow-hidden rounded-(--c-radius)">
        <Pic src={lockup} alt="Logotipo de Consultores & Estrategas Jurídicos: balanza, el lema Dura lex sed lex y un búho con las alas abiertas" fill={false} class="h-auto w-full" />
      </div>
      <div data-reveal data-delay="100">
        <p class="max-w-[34ch] font-(family-name:--f-display) text-[clamp(1.7rem,3.2vw,2.8rem)] leading-[1.14] tracking-[-0.01em]">Acompañamos a empresas e instituciones a operar con seguridad legal, mitigando riesgos y convirtiendo la regulación en una ventaja competitiva.</p>
        <p class="mt-8 max-w-[50ch] text-lg text-(--c-muted)">Litigio estratégico y blindaje legal en toda la República Mexicana. Sede central en la Ciudad de México y oficina en San Luis Potosí.</p>
      </div>
    </div>
  </Section>

  <div class="relative isolate overflow-hidden bg-(--c-dark)" style="height:clamp(18rem,44vw,32rem)">
    <div class="absolute inset-0 -z-10" data-parallax="50">
      <Pic src={atardecer} alt="Sala de juntas con sillones de piel y vista al Monumento a la Revolución al atardecer" position="50% 45%" class="size-full object-cover" />
    </div>
  </div>

  <Section>
    <div class="wrap">
      <h2 class="sr-only">En Google</h2>
      <Stats stats={[{ value: "4.9", label: "calificación en Google" }, { value: "77", label: "reseñas en Google" }, { value: "2", label: "oficinas: Ciudad de México y San Luis Potosí" }]} />
    </div>
  </Section>

  <Section tone="surface" size="sm">
    <div class="wrap">
      <h2 data-reveal class="mb-10 text-[clamp(1.7rem,3vw,2.5rem)] leading-tight tracking-[-0.01em]">Oficinas</h2>
      <ul data-stagger data-gap="90" class="grid gap-10 md:grid-cols-2">
        {site.addresses.map((a) => (
          <li>
            <address class="not-italic">
              <h3 class="text-xl">{a.label}</h3>
              <p class="mt-3 flex gap-3 text-(--c-muted)"><Icon name="map-pin" class="mt-1 size-5 shrink-0" />{a.text}</p>
            </address>
          </li>
        ))}
      </ul>
    </div>
  </Section>

  <CtaBand title="Hablemos de su caso" href={waLink()} label="Escribir por WhatsApp" tone="brand" external />
  <Footer slot="footer" site={site} variant="dark" blurb="Dura lex, sed lex. Cumplimiento que protege. Estrategia que impulsa." />
</SiteLayout>
