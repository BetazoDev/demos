---
import Layout from "@/sites/zepco/Layout.astro";
import Hero from "@/sites/zepco/Hero.astro";
import Button from "@/kit/Button.astro";
import Section from "@/kit/Section.astro";
import AreasIndex from "@/sites/zepco/Indice.astro";
import Accordion from "@/kit/Accordion.astro";
import Pic from "@/kit/Pic.astro";
import ContactBlock from "@/kit/ContactBlock.astro";
import Composer from "@/kit/Composer.astro";
import { site } from "@/sites/zepco/site";
import { areas, tambien, equipo, photos, texto, valores, stats } from "@/sites/zepco/data";

const base = "/zepco";
const rows = areas.map((a) => ({ key: a.key, title: a.title, text: a.text, href: `${base}/servicios#${a.key}` }));
const wa = `https://wa.me/${site.whatsapp.number}?text=${encodeURIComponent(site.whatsapp.intro + ".")}`;
const h2 = "text-[clamp(2rem,4.3vw,3.7rem)] leading-[1.05]";
---

<Layout title="Zepeda & Torres Abogados | Despacho en Verónica Anzures, Ciudad de México">
  <Hero title="Brindando servicios profesionales de abogacía en México" lede={texto.lede} people={equipo}>
    <Fragment slot="actions">
      <Button href={wa} size="lg" external>Escribir por WhatsApp</Button>
      <Button href={`${base}/servicios`} variant="outline" size="lg">Ver servicios</Button>
    </Fragment>
  </Hero>

  <Section tone="dark" class="relative z-10">
    <div class="wrap grid gap-16 lg:grid-cols-[0.85fr_1.15fr] lg:gap-24">
      <dl data-stagger data-gap="120" class="grid content-start gap-12">
        {
          stats.map((s) => (
            <div>
              <dt class="sr-only">{s.label}</dt>
              <dd>
                <span data-count={s.value} class="block text-[clamp(5.5rem,13vw,11rem)] leading-[0.86] tracking-[-0.03em] text-(--c-accent) tabular-nums" style="font-family:var(--f-display)">{s.value}</span>
                <span class="mt-4 block text-lg opacity-80">{s.label}</span>
              </dd>
            </div>
          ))
        }
      </dl>
      <div data-reveal>
        <h2 class={`max-w-[16ch] ${h2}`}>Bienvenido a Zepeda &amp; Torres Abogados</h2>
        <div class="mt-9 grid max-w-[56ch] gap-5 text-lg leading-relaxed opacity-85">
          {texto.bienvenida.map((p) => <p>{p}</p>)}
        </div>
        <div class="mt-10"><Button href={`${base}/nosotros`} variant="light">Conocer a la firma</Button></div>
      </div>
    </div>
  </Section>

  <Section tone="surface" id="servicios">
    <div class="wrap">
      <h2 data-reveal class={`mb-12 ${h2}`}>Servicios jurídicos</h2>
      <AreasIndex areas={rows} />
      <p data-reveal class="mt-8 text-[15px] text-(--c-muted)">{tambien}</p>
    </div>
  </Section>

  <div class="relative isolate overflow-hidden bg-(--c-dark) text-(--c-on-dark)" style="height:clamp(22rem,48vw,34rem)">
    <div class="absolute inset-0 -z-10" data-parallax="70"><Pic src={photos.angel} alt="El Ángel de la Independencia contra un cielo azul" position="50% 70%" class="size-full object-cover" /></div>
    <div class="absolute inset-0 -z-10 bg-[linear-gradient(to_top,color-mix(in_oklab,var(--c-dark)_88%,transparent)_0%,color-mix(in_oklab,var(--c-dark)_45%,transparent)_55%,color-mix(in_oklab,var(--c-dark)_10%,transparent)_100%)]"></div>
    <div class="wrap flex h-full items-end pb-10 sm:pb-14">
      <p data-reveal class="max-w-[24ch] text-[clamp(1.8rem,3.9vw,3.4rem)] leading-[1.1]" style="font-family:var(--f-display)">Representamos a empresas, inversionistas y personas físicas en la toma de decisiones clave.</p>
    </div>
  </div>

  <Section>
    <div class="wrap grid gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:gap-24">
      <div data-reveal>
        <h2 class={`max-w-[12ch] ${h2}`}>Brindándote Excelencia Jurídica</h2>
        <p class="mt-8 max-w-[44ch] text-lg leading-relaxed text-(--c-muted)">{texto.excelencia}</p>
      </div>
      <div data-reveal data-delay="100"><Accordion items={valores} /></div>
    </div>
  </Section>

  <Section tone="surface" id="contacto">
    <div class="wrap grid gap-14 lg:grid-cols-2 lg:gap-24">
      <div data-reveal>
        <h2 class={`mb-6 ${h2}`}>Ponte en contacto</h2>
        <p class="mb-10 max-w-[44ch] text-lg text-(--c-muted)">{texto.contacto}</p>
        <ContactBlock site={site} showCta={false} />
      </div>
      <div data-reveal data-delay="120" class="rounded-(--c-radius-card,4px) border border-(--c-line) bg-(--c-bg) p-6 sm:p-9">
        <Composer site={site} areas={[...areas.map((a) => a.title), "Otros"]} />
      </div>
    </div>
  </Section>
</Layout>
