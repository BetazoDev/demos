---
import Layout from "@/sites/rinconabogados/Layout.astro";
import PageHero from "@/kit/PageHero.astro";
import Section from "@/kit/Section.astro";
import Pic from "@/kit/Pic.astro";
import CtaBand from "@/kit/CtaBand.astro";
import { site } from "@/sites/rinconabogados/site";
import { team, photos } from "@/sites/rinconabogados/data";

const base = "/rinconabogados";
const wa = `https://wa.me/${site.whatsapp.number}?text=${encodeURIComponent(site.whatsapp.intro)}`;
const h2 = "text-[clamp(1.8rem,3.4vw,2.9rem)] font-light leading-[1.05] tracking-[-0.025em]";
const lead = team.slice(0, 2);
const rest = team.slice(2);
---

<Layout
  site={site}
  title="Nosotros | Rincón Mayorga Abogados, firma de litigio en CDMX y Guadalajara"
  description="Firma legal con más de tres décadas de experiencia, con oficinas en Ciudad de México, Guadalajara y La Jolla, California. Conozca a su equipo de abogados."
  nav={{ variant: "bar", tone: "light", logoHeight: 38 }}
  breadcrumbs={[{ name: "Nosotros", href: `${base}/nosotros` }]}
>
  <PageHero title="Nosotros" lede="Somos una firma legal con más de tres décadas de experiencia, dedicada a transformar los desafíos legales en estrategias efectivas, sostenibles y orientadas al éxito de nuestros clientes." image={photos.pasillo} imageAlt="Pasillo de oficinas con paredes de vidrio en la sede de Ciudad de México" />

  <Section>
    <div class="wrap grid gap-14 md:grid-cols-2 md:gap-20">
      <div data-reveal>
        <h2 class={h2}>Nuestra misión</h2>
        <p class="mt-6 text-xl leading-snug text-(--c-muted)">Brindar servicios legales confiables con propuestas innovadoras, creativas y funcionales, que generen valor y resultados para nuestros clientes.</p>
      </div>
      <div data-reveal data-delay="120">
        <h2 class={h2}>Nuestra visión</h2>
        <p class="mt-6 text-xl leading-snug text-(--c-muted)">Ser la firma jurídica de mayor trascendencia en México, impulsando la excelencia, la ética profesional y la confianza en cada representación.</p>
      </div>
    </div>
  </Section>

  <Section tone="surface" size="sm">
    <div class="wrap grid gap-8 lg:grid-cols-[0.8fr_1.2fr] lg:gap-24">
      <h2 data-reveal class={h2}>Oficinas</h2>
      <div data-reveal data-delay="100" class="grid gap-6 text-lg leading-relaxed">
        <p class="text-(--c-muted)">Contamos con oficinas en Ciudad de México, Guadalajara y La Jolla, California, además de consultoría internacional en Europa (Estonia).</p>
        <ul class="grid gap-5 sm:grid-cols-2">
          {site.addresses.map((a) => (
            <li>
              <p class="text-sm font-medium text-(--c-muted)">{a.label}</p>
              <address class="mt-1 not-italic">{a.text}</address>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </Section>

  <Section id="equipo">
    <div class="wrap">
      <h2 data-reveal class:list={["mb-6", h2]}>Equipo</h2>
      <p data-reveal class="mb-14 max-w-[52ch] text-lg text-(--c-muted)">Conoce a los especialistas que combinan experiencia, rigor jurídico y visión estratégica.</p>
      <ul class="grid gap-16 sm:gap-24">
        {lead.map((p, i) => (
          <li class:list={["grid items-start gap-8 md:gap-16", i % 2 === 0 ? "md:grid-cols-[0.8fr_1.2fr]" : "md:grid-cols-[1.2fr_0.8fr]"]}>
            <div data-reveal="clip" class:list={["aspect-[4/5] overflow-hidden rounded-[1.5rem] bg-(--c-surface)", i % 2 === 1 && "md:order-2"]}><Pic src={p.photo} alt={p.name} class="size-full object-cover" /></div>
            <div data-reveal class="md:py-8">
              <h3 class="text-[clamp(1.7rem,3vw,2.6rem)] font-light leading-tight tracking-[-0.02em]">{p.name}</h3>
              <p class="mt-2 text-(--c-muted)">{p.role}</p>
              <p class="mt-6 max-w-[56ch] text-lg leading-relaxed text-(--c-muted)">{p.bio}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </Section>

  <Section tone="surface">
    <div class="wrap">
      <ul data-stagger data-gap="70" class="grid gap-x-16 gap-y-12 md:grid-cols-2">
        {rest.map((p) => (
          <li class="grid grid-cols-[7.5rem_1fr] items-start gap-6 sm:grid-cols-[9rem_1fr]">
            <div class="aspect-[4/5] overflow-hidden rounded-[1rem] bg-(--c-bg)"><Pic src={p.photo} alt={p.name} class="size-full object-cover" /></div>
            <div>
              <h3 class="text-xl leading-tight">{p.name}</h3>
              <p class="mt-1 text-base text-(--c-muted)">{p.role}</p>
              <p class="mt-3 text-base leading-relaxed text-(--c-muted)">{p.bio}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </Section>

  <CtaBand title="Hablemos de su caso" href={wa} label="Escribir por WhatsApp" tone="brand" external />
</Layout>
