---
import Layout from "@/sites/rinconabogados/Layout.astro";
import PageHero from "@/kit/PageHero.astro";
import Section from "@/kit/Section.astro";
import Icon from "@/kit/Icon.astro";
import CtaBand from "@/kit/CtaBand.astro";
import Statement from "@/kit/Statement.astro";
import { site } from "@/sites/rinconabogados/site";
import { areas, publicaciones } from "@/sites/rinconabogados/data";

export function getStaticPaths() {
  return areas.map((a) => ({ params: { area: a.key }, props: { area: a } }));
}
const { area } = Astro.props;
const base = "/rinconabogados";
const others = areas.filter((a) => a.key !== area.key);
const wa = `https://wa.me/${site.whatsapp.number}?text=${encodeURIComponent(`${site.whatsapp.intro} sobre ${area.title.toLowerCase()}.`)}`;
const h2 = "text-[clamp(1.6rem,3vw,2.4rem)] font-light leading-tight tracking-[-0.02em]";
const schema = [{
  "@context": "https://schema.org",
  "@type": "Service",
  name: area.title,
  description: area.lead,
  provider: { "@id": new URL(`/${site.slug}#organizacion`, Astro.site).href },
  areaServed: [{ "@type": "City", name: "Ciudad de México" }, { "@type": "City", name: "Guadalajara" }],
}];
---

<Layout
  site={site}
  title={`${area.title} en CDMX y Guadalajara | Rincón Mayorga Abogados`}
  description={area.lead}
  nav={{ variant: "bar", tone: "light", logoHeight: 38 }}
  breadcrumbs={[{ name: "Servicios", href: `${base}/servicios` }, { name: area.title, href: `${base}/servicios/${area.key}` }]}
  schema={schema}
>
  <PageHero title={area.title} lede={area.lead} transitionName={`area-${area.key}`} image={area.image} imageAlt={area.alt} />

  <Section>
    <div class="wrap grid gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:gap-24">
      <h2 data-reveal class:list={["lg:sticky lg:top-28 lg:self-start", h2]}>Nuestro enfoque</h2>
      <div data-reveal data-delay="100" class="grid gap-7 text-lg leading-relaxed text-(--c-muted)">
        <p class="text-[clamp(1.25rem,2vw,1.6rem)] leading-snug text-(--c-ink)">{area.intro}</p>
        <p>{area.enfoque}</p>
      </div>
    </div>
  </Section>

  <Section tone="surface">
    <div class="wrap grid gap-14">
      <div class="grid gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:gap-24">
        <h2 data-reveal class={h2}>El reto</h2>
        <p data-reveal data-delay="100" class="text-lg leading-relaxed text-(--c-muted)">{area.reto}</p>
      </div>
      <div class="grid gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:gap-24">
        <h2 data-reveal class={h2}>{area.itemsTitle}</h2>
        <ul data-stagger data-gap="45" class="grid gap-x-10 gap-y-4 sm:grid-cols-2">
          {area.items.map((i) => (
            <li class="flex gap-3 border-b border-(--c-line) pb-4 text-lg">
              <Icon name="check" weight="bold" class="mt-1.5 size-4 shrink-0 text-(--c-ink)" />
              <span>{i}</span>
            </li>
          ))}
        </ul>
      </div>
      {
        area.key === "amparo" && (
          <div class="grid gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:gap-24">
            <h2 data-reveal class={h2}>Análisis de la firma</h2>
            <ul data-stagger data-gap="45" class="grid gap-4">
              {publicaciones.map((p) => (
                <li>
                  <a href={p.href} target="_blank" rel="noopener" class="press group flex items-start justify-between gap-6 rounded-[1.5rem] border border-(--c-line) bg-(--c-bg) p-6">
                    <span>
                      <span class="block text-xl leading-snug">{p.title}</span>
                      <span class="mt-2 block text-[15px] text-(--c-muted)">{p.by}</span>
                    </span>
                    <Icon name="arrow-up-right" weight="bold" class="mt-1 size-5 shrink-0" />
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </div>
  </Section>

  <Section>
    <div class="wrap"><Statement text={area.quote} class="!max-w-[26ch] !font-light font-(family-name:--f-display)" /></div>
  </Section>

  <Section tone="surface" size="sm">
    <div class="wrap">
      <h2 data-reveal class:list={["mb-8", h2]}>Otros servicios</h2>
      <ul data-stagger data-gap="45" class="flex flex-wrap gap-3">
        {others.map((o) => <li><a href={`${base}/servicios/${o.key}`} class="press inline-flex rounded-full border border-(--c-line) bg-(--c-bg) px-5 py-3 text-[15px] hover:border-(--c-ink)">{o.title}</a></li>)}
      </ul>
    </div>
  </Section>

  <CtaBand title="Hablemos de su caso" href={wa} label="Escribir por WhatsApp" tone="brand" external />
</Layout>
