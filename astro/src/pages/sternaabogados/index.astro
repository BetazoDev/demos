---
import "@/sites/sternaabogados/theme.css";
import SiteLayout from "@/kit/SiteLayout.astro";
import Button from "@/kit/Button.astro";
import Section from "@/kit/Section.astro";
import Statement from "@/kit/Statement.astro";
import Pic from "@/kit/Pic.astro";
import Icon from "@/kit/Icon.astro";
import ContactBlock from "@/kit/ContactBlock.astro";
import Hero from "@/sites/sternaabogados/Hero.astro";
import BandQuote from "@/sites/sternaabogados/BandQuote.astro";
import Composer from "@/sites/sternaabogados/Composer.astro";
import { site } from "@/sites/sternaabogados/site";
import { services, intro, offices, team, reviews, photos, serviceNames } from "@/sites/sternaabogados/data";

const base = "/sternaabogados";
const wa = `https://wa.me/${site.whatsapp.number}?text=${encodeURIComponent(site.whatsapp.intro)}.`;
const [featured, ...rest] = services;
const ainhoa = team[0];
const [lead, ...others] = reviews.quotes;
---

<SiteLayout
  site={site}
  title="Sterna Abogados | Abogados de inmigración a España desde México"
  description="¿Quieres vivir en España? Te ayudamos a gestionar tu visado desde México: nacionalidad española, nómada digital, visado de estudiante y residencia no lucrativa. Despacho México en la CDMX."
  nav={{ variant: "pill", tone: "light" }}
  footer={{ variant: "dark", blurb: "Abogados de Inmigración a España desde México" }}
>
  <Hero title="Abogados de Inmigración a España desde México" lede={intro.hero} image={photos.arco} imageAlt="Calle de Madrid al anochecer, con fachadas de piedra, balcones de hierro y ventanas iluminadas">
    <Fragment slot="actions">
      <Button href={wa} variant="solid" size="lg" external>Escribir por WhatsApp</Button>
      <Button href={`${base}/servicios`} variant="outline" size="lg">Ver servicios</Button>
    </Fragment>
  </Hero>

  <Section>
    <div class="wrap"><Statement text={intro.statement} /></div>
  </Section>

  <Section id="servicios" size="sm" class="pt-0">
    <div class="wrap">
      <a href={`${base}/servicios/${featured.key}`} data-reveal class="group relative grid gap-8 rounded-(--c-radius-card) bg-(--c-surface) p-8 sm:p-12 lg:grid-cols-[1.1fr_0.9fr] lg:gap-16 lg:p-14">
        <h2 transition:name={`area-${featured.key}`} class="max-w-[10ch] text-[clamp(2.4rem,6vw,5.4rem)] font-medium leading-[0.98]">{featured.title}</h2>
        <div class="flex flex-col justify-between gap-8">
          <p class="max-w-[46ch] text-lg text-(--c-muted)">{featured.text}</p>
          <span class="inline-flex items-center gap-3 font-medium">
            Ver servicio
            <span class="arr nudge grid size-11 place-items-center rounded-full border border-current/30 transition-transform group-hover:translate-x-1"><Icon name="arrow-right" weight="bold" class="size-4" /></span>
          </span>
        </div>
      </a>
      <ul data-stagger data-gap="60" class="mt-14 grid gap-x-16 gap-y-10 md:grid-cols-2">
        {rest.map((s) => (
          <li>
            <h3 class="text-[clamp(1.4rem,2.2vw,1.9rem)] font-medium leading-tight">{s.title}</h3>
            <p class="mt-3 max-w-[48ch] text-(--c-muted)">{s.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </Section>

  <BandQuote image={photos.madrid} alt="Vista aérea de Madrid al atardecer" position="50% 40%">
    <p data-reveal class="max-w-[26ch] text-[clamp(1.7rem,3.6vw,3.1rem)] font-medium leading-[1.1]">{intro.mission}</p>
  </BandQuote>

  <Section>
    <div class="wrap grid gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:gap-24">
      <h2 data-reveal class="max-w-[12ch] text-[clamp(2rem,4.4vw,3.8rem)] font-medium leading-[1.02]">¿Por qué elegirnos?</h2>
      <ul data-stagger data-gap="90" class="grid gap-6">
        {intro.why.map((w) => (
          <li class="flex items-center gap-5 text-[clamp(1.4rem,2.6vw,2.2rem)] font-medium leading-tight">
            <span class="grid size-11 shrink-0 place-items-center rounded-full bg-(--c-brand) text-(--c-on-brand)"><Icon name="check" weight="bold" class="size-5" /></span>
            {w}
          </li>
        ))}
      </ul>
    </div>
  </Section>

  <Section tone="surface" size="sm">
    <div class="wrap">
      <h2 data-reveal class="mb-10 text-[clamp(2rem,4.4vw,3.8rem)] font-medium leading-[1.02]">Oficinas</h2>
      <ul data-stagger data-gap="80" class="divide-y divide-(--c-line) border-y border-(--c-line)">
        {offices.map((o) => (
          <li class="grid gap-3 py-8 lg:grid-cols-[1fr_1fr_0.6fr] lg:items-center lg:gap-10">
            <div>
              <h3 class="text-[clamp(1.8rem,3.4vw,2.8rem)] font-medium leading-none">{o.city}</h3>
              <p class="mt-2 text-(--c-muted)">{o.label}</p>
            </div>
            <address class="not-italic text-lg">{o.address}</address>
            <div>{o.phone && <a href={`tel:${o.tel}`} class="link-u text-lg">{o.phone}</a>}</div>
          </li>
        ))}
      </ul>
    </div>
  </Section>

  <Section>
    <div class="wrap grid items-center gap-12 lg:grid-cols-[1.1fr_0.9fr] lg:gap-20">
      <div data-reveal="clip" class="aspect-[4/3] overflow-hidden rounded-(--c-radius-img) bg-(--c-surface)">
        <Pic src={photos.equipo} alt="El equipo de Sterna Abogados sentado en una mesa de juntas" class="size-full object-cover" />
      </div>
      <div>
        <h2 data-reveal class="text-[clamp(2rem,4vw,3.4rem)] font-medium leading-[1.02]">{ainhoa.name}</h2>
        <p data-reveal data-delay="60" class="mt-3 text-(--c-muted)">{ainhoa.role}</p>
        <p data-reveal data-delay="120" class="mt-6 max-w-[48ch] text-lg leading-relaxed">{ainhoa.bio.split(" Formación:")[0]}</p>
        <div data-reveal class="mt-8"><Button href={`${base}/nosotros`} variant="outline">Conocer al equipo</Button></div>
      </div>
    </div>
  </Section>

  <Section tone="surface">
    <div class="wrap grid gap-12 lg:grid-cols-[0.6fr_1.4fr] lg:gap-24">
      <p data-reveal class="flex flex-col gap-3">
        <span data-count={reviews.rating.toFixed(1)} class="font-(family-name:--f-display) text-[clamp(4.5rem,10vw,8rem)] font-medium leading-none tabular-nums">{reviews.rating.toFixed(1)}</span>
        <span class="text-lg text-(--c-muted)">en Google, {reviews.count} reseñas</span>
      </p>
      <div>
        <figure data-reveal>
          <blockquote class="max-w-[40ch] text-[clamp(1.35rem,2.4vw,2rem)] leading-[1.28]">“{lead.text}”</blockquote>
          <figcaption class="mt-5 text-(--c-muted)">{lead.author}</figcaption>
        </figure>
        <ul data-stagger data-gap="90" class="mt-12 grid gap-10 border-t border-(--c-line) pt-10 sm:grid-cols-3">
          {others.map((q) => (
            <li>
              <blockquote class="leading-snug">“{q.text}”</blockquote>
              <p class="mt-4 text-sm text-(--c-muted)">{q.author}</p>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </Section>

  <Section id="contacto">
    <div class="wrap grid gap-14 lg:grid-cols-[1fr_1fr] lg:gap-24">
      <div data-reveal>
        <h2 class="mb-10 text-[clamp(2rem,4.4vw,3.8rem)] font-medium leading-[1.02]">Contacto</h2>
        <ContactBlock site={site} showCta={false} />
      </div>
      <div data-reveal data-delay="120" class="rounded-(--c-radius-card) border border-(--c-line) bg-(--c-surface) p-6 sm:p-9">
        <Composer site={site} areas={serviceNames} />
      </div>
    </div>
  </Section>
</SiteLayout>
