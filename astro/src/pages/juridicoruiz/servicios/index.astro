---
import SiteLayout from "@/kit/SiteLayout.astro";
import PageHero from "@/kit/PageHero.astro";
import Section from "@/kit/Section.astro";
import CtaBand from "@/kit/CtaBand.astro";
import { site } from "@/sites/juridicoruiz/site";
import { areas } from "@/sites/juridicoruiz/data";
import Nav from "@/sites/juridicoruiz/Nav.astro";
import Footer from "@/sites/juridicoruiz/Footer.astro";

const base = "/juridicoruiz";
const wa = `https://wa.me/${site.whatsapp.number}?text=${encodeURIComponent(site.whatsapp.intro)}`;
const schema = areas.map((a) => ({
  "@context": "https://schema.org",
  "@type": "Service",
  name: a.title,
  description: a.text,
  provider: { "@id": new URL(`${base}#organizacion`, Astro.site).href },
  areaServed: { "@type": "AdministrativeArea", name: "Guadalajara" },
}));
---

<SiteLayout
  site={site}
  title="Servicios | Jurídico Ruiz, abogados en Guadalajara"
  description="Justicia alternativa en materia civil, administrativa y penal, y asuntos familiares como divorcios y custodia. Despacho de abogados en Guadalajara."
  breadcrumbs={[{ name: "Servicios", href: `${base}/servicios` }]}
  schema={schema}
  nav={false}
  footer={false}
>
  <Nav slot="nav" site={site} tone="light" />

  <PageHero title="Servicios" lede="Justicia alternativa y asuntos familiares, con atención en Guadalajara." />

  {
    areas.map((a, i) => (
      <Section tone={i % 2 === 0 ? "surface" : "paper"} id={a.key}>
        <div class="wrap grid gap-12 lg:grid-cols-[1.1fr_0.9fr] lg:gap-24">
          <div>
            <h2 transition:name={`area-${a.key}`} class="max-w-[14ch] text-[clamp(2.2rem,5vw,4.4rem)] font-light leading-[1.02] tracking-[-0.03em]">{a.title}</h2>
            <p data-reveal class="mt-8 max-w-[46ch] text-lg text-(--c-muted) sm:text-xl">{a.text}</p>
          </div>
          <figure data-reveal data-delay="120" class="flex flex-col justify-end gap-6 border-t border-(--c-line) pt-8 lg:border-l lg:border-t-0 lg:pl-12 lg:pt-0">
            <blockquote class="font-(family-name:--f-display) text-[clamp(1.4rem,2.3vw,1.9rem)] font-light leading-snug tracking-[-0.015em]">“{a.quote.text}”</blockquote>
            <figcaption class="text-[15px] text-(--c-muted)">{a.quote.author}, {a.quote.when}, en Google</figcaption>
          </figure>
        </div>
      </Section>
    ))
  }

  <CtaBand title="Hablemos de su caso" text="Cuéntenos su situación por WhatsApp." href={wa} label="Escribir por WhatsApp" tone="brand" external />

  <Footer slot="footer" site={site} />
</SiteLayout>
