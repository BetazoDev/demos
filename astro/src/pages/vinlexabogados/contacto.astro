---
import VxLayout from "@/sites/vinlexabogados/VxLayout.astro";
import VxPageHero from "@/sites/vinlexabogados/VxPageHero.astro";
import VxButton from "@/sites/vinlexabogados/VxButton.astro";
import Section from "@/kit/Section.astro";
import ContactBlock from "@/kit/ContactBlock.astro";
import Composer from "@/kit/Composer.astro";
import { site, WA } from "@/sites/vinlexabogados/site";
import { areas, text } from "@/sites/vinlexabogados/data";

const base = "/vinlexabogados";
const wa = `https://wa.me/${WA}?text=${encodeURIComponent(site.whatsapp.intro)}`;
---

<VxLayout title="Contacto | VINLEX Abogados, José María Roa Bárcenas 7, colonia Obrera" description="VINLEX Abogados: José María Roa Bárcenas 7, colonia Obrera, Ciudad de México. WhatsApp 55 5215 9894 y correo vinlexab@gmail.com." breadcrumbs={[{ name: "Contacto", href: `${base}/contacto` }]}>
  <VxPageHero title="Contacto" lede={text.contact} />
  <Section size="sm" class="pt-4">
    <div class="wrap grid gap-14 lg:grid-cols-2 lg:gap-24">
      <div data-reveal>
        <ContactBlock site={site} showCta={false} />
        <div class="mt-10 flex flex-wrap gap-3">
          <VxButton href={wa} external>Escribir por WhatsApp</VxButton>
          {site.mapsUrl && <VxButton href={site.mapsUrl} variant="outline" external>Ver en el mapa</VxButton>}
        </div>
      </div>
      <div data-reveal data-delay="120" class="border border-(--c-line) bg-(--c-surface) p-6 sm:p-9">
        <Composer site={site} areas={areas.map((a) => a.title)} />
      </div>
    </div>
  </Section>
</VxLayout>
