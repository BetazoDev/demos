---
import VxLayout from "@/sites/vinlexabogados/VxLayout.astro";
import VxPageHero from "@/sites/vinlexabogados/VxPageHero.astro";
import VxCta from "@/sites/vinlexabogados/VxCta.astro";
import Section from "@/kit/Section.astro";
import Icon from "@/kit/Icon.astro";
import { site, WA } from "@/sites/vinlexabogados/site";
import { areas } from "@/sites/vinlexabogados/data";

export function getStaticPaths() {
  return areas.filter((a) => a.page).map((a) => ({ params: { area: a.key }, props: { area: a } }));
}
const { area } = Astro.props;
const base = "/vinlexabogados";
const others = areas.filter((a) => a.key !== area.key);
const wa = `https://wa.me/${WA}?text=${encodeURIComponent(`${site.whatsapp.intro} sobre ${area.title.toLowerCase()}.`)}`;
const schema = [{ "@context": "https://schema.org", "@type": "Service", name: area.title, description: area.seo, provider: { "@id": new URL(`/${site.slug}#organizacion`, Astro.site).href }, areaServed: { "@type": "City", name: "Ciudad de México" } }];
---

<VxLayout title={`${area.title} en la Ciudad de México | VINLEX Abogados`} description={area.seo} breadcrumbs={[{ name: "Servicios", href: `${base}/servicios` }, { name: area.title, href: `${base}/servicios/${area.key}` }]} schema={schema}>
  <VxPageHero title={area.title} lede={area.lead} transitionName={`area-${area.key}`} />
  <Section size="sm" class="pt-4">
    <div class="wrap grid gap-10 lg:grid-cols-[0.7fr_1.3fr] lg:gap-20">
      <h2 data-reveal class="text-[clamp(1.9rem,3.2vw,2.8rem)] leading-tight">Incluye</h2>
      <ul data-stagger data-gap="45" class="grid gap-x-10 gap-y-5 sm:grid-cols-2">
        {area.items.map((i) => (
          <li class="flex gap-3.5 text-[18px] leading-snug">
            <Icon name="check" weight="bold" class="mt-1 size-[18px] shrink-0 text-(--vx-teal-ink)" />
            <span>{i}</span>
          </li>
        ))}
      </ul>
    </div>
  </Section>
  <Section tone="surface" size="sm">
    <div class="wrap">
      <h2 data-reveal class="mb-8 text-[clamp(1.6rem,3vw,2.4rem)] leading-tight">Otros servicios</h2>
      <ul data-stagger data-gap="45" class="flex flex-wrap gap-3">
        {others.map((o) => <li><a href={o.page ? `${base}/servicios/${o.key}` : `${base}/servicios#${o.key}`} class="press inline-flex border border-(--c-ink)/25 bg-(--c-bg) px-5 py-2.5 text-[15px] hover:border-(--c-accent) hover:text-(--vx-teal-ink)">{o.title}</a></li>)}
      </ul>
    </div>
  </Section>
  <VxCta title="Le ayudaremos con mucho gusto" href={wa} label="Escribir por WhatsApp" />
</VxLayout>
