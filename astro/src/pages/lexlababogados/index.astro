---
import "@/sites/lexlababogados/theme.css";
import SiteLayout from "@/kit/SiteLayout.astro";
import Nav from "@/kit/Nav.astro";
import Footer from "@/sites/lexlababogados/Footer.astro";
import Button from "@/kit/Button.astro";
import Section from "@/kit/Section.astro";
import Statement from "@/kit/Statement.astro";
import Pic from "@/kit/Pic.astro";
import ContactBlock from "@/kit/ContactBlock.astro";
import Hero from "@/sites/lexlababogados/Hero.astro";
import StackCards from "@/sites/lexlababogados/StackCards.astro";
import BandQuote from "@/sites/lexlababogados/BandQuote.astro";
import Composer from "@/sites/lexlababogados/Composer.astro";
import { site, navSite } from "@/sites/lexlababogados/site";
import { services, about, lead, reviews, coverage, photos, serviceNames } from "@/sites/lexlababogados/data";

const base = "/lexlababogados";
const wa = `https://wa.me/${site.whatsapp.number}?text=${encodeURIComponent(site.whatsapp.intro)}.`;
const cards = services.map((s) => ({ key: s.key, title: s.title, icon: s.icon, text: s.text, href: s.lead ? `${base}/servicios/${s.key}` : undefined }));
const [first, ...others] = reviews.quotes;
---

<SiteLayout
  site={site}
  title="LexLab Abogados | Abogados laboralistas para empresas en la Ciudad de México"
  description="Firma legal especializada en materia laboral que protege a las empresas de forma integral: auditoría legal, consultoría, defensa ante demandas e inspecciones de la STPS. Verónica Anzúres, CDMX."
  nav={false}
>
  <Footer slot="footer" site={site} variant="dark" blurb="Blindaje Legal Laboral." />
  <Nav slot="nav" site={navSite} variant="pill" tone="dark" logoHeight={40} />

  <Hero title="Blindaje Legal Laboral." lede="¿Cómo proteger tu empresa de demandas, sindicatos, multas de la Secretaría del Trabajo y empleados con bajo desempeño?" image={photos.hero} imageAlt="Sala de juntas vacía al anochecer, con una lámpara encendida sobre la mesa" position="50% 55%">
    <Fragment slot="actions">
      <Button href={wa} variant="solid" size="lg" external>Escribir por WhatsApp</Button>
      <Button href={`${base}/servicios`} variant="outline" size="lg">Ver servicios</Button>
    </Fragment>
  </Hero>

  <Section>
    <div class="wrap"><Statement text={about[0]} /></div>
  </Section>

  <Section id="servicios" size="sm" class="pt-0">
    <div class="wrap">
      <h2 data-reveal class="mb-10 text-[clamp(2rem,4.4vw,3.8rem)] font-bold leading-[1]">Servicios</h2>
      <StackCards items={cards} />
    </div>
  </Section>

  <BandQuote image={photos.expedientes} alt="Carpetas de expedientes y una libreta con pluma sobre un escritorio, bajo una lámpara cálida" position="50% 60%">
    <p data-reveal class="max-w-[20ch] text-[clamp(1.9rem,4.2vw,3.6rem)] font-bold leading-[1.02]">Prevenimos multas, demandas e inspecciones.</p>
  </BandQuote>

  <Section>
    <div class="wrap grid items-start gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:gap-24">
      <div data-reveal="clip" class="aspect-[3/4] overflow-hidden rounded-(--c-radius-img) bg-(--c-surface)">
        <Pic src={photos.pedro} alt={`${lead.name}, ${lead.role.toLowerCase()} de LexLab Abogados`} position="50% 20%" class="size-full object-cover" />
      </div>
      <div>
        <h2 data-reveal class="text-[clamp(2rem,4.4vw,3.8rem)] font-bold leading-[1]">{lead.name}</h2>
        <p data-reveal data-delay="60" class="mt-3 text-lg text-(--c-muted)">{lead.role}. {lead.bio}</p>
        <div data-stagger data-gap="80" class="mt-10 grid max-w-[58ch] gap-5 text-lg">
          {about.slice(1).map((p) => <p>{p}</p>)}
        </div>
        <div data-reveal class="mt-10"><Button href={`${base}/nosotros`} variant="outline">Conocer a la firma</Button></div>
      </div>
    </div>
  </Section>

  <Section tone="surface">
    <div class="wrap grid gap-12 lg:grid-cols-[0.6fr_1.4fr] lg:gap-24">
      <p data-reveal class="flex flex-col gap-3">
        <span data-count={reviews.rating.toFixed(1)} class="font-(family-name:--f-display) text-[clamp(4.5rem,10vw,8rem)] font-bold leading-none tabular-nums">{reviews.rating.toFixed(1)}</span>
        <span class="text-lg text-(--c-muted)">en Google, {reviews.count} reseñas</span>
      </p>
      <div>
        <figure data-reveal>
          <blockquote class="max-w-[38ch] text-[clamp(1.4rem,2.5vw,2.1rem)] leading-[1.25]">“{first.text}”</blockquote>
          <figcaption class="mt-5 text-(--c-muted)">{first.author}</figcaption>
        </figure>
        <ul data-stagger data-gap="90" class="mt-12 grid gap-10 border-t border-(--c-line) pt-10 sm:grid-cols-3">
          {others.map((q) => (
            <li>
              <blockquote class="leading-snug">“{q.text}”</blockquote>
              <p class="mt-4 text-sm text-(--c-muted)">{q.author}</p>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </Section>

  <Section tone="brand">
    <div class="wrap grid items-end gap-10 lg:grid-cols-[1.1fr_0.9fr] lg:gap-20">
      <h2 data-reveal class="max-w-[12ch] text-[clamp(2.6rem,7vw,6.4rem)] font-bold leading-[0.94]">{coverage.title}</h2>
      <p data-reveal data-delay="100" class="max-w-[52ch] text-lg">{coverage.text}</p>
    </div>
  </Section>

  <Section id="contacto">
    <div class="wrap grid gap-14 lg:grid-cols-[1fr_1fr] lg:gap-24">
      <div data-reveal>
        <h2 class="mb-10 text-[clamp(2rem,4.4vw,3.8rem)] font-bold leading-[1]">Contacto</h2>
        <ContactBlock site={site} showCta={false} />
      </div>
      <div data-reveal data-delay="120" class="rounded-(--c-radius-card) border border-(--c-line) bg-(--c-surface) p-6 sm:p-9">
        <Composer site={site} areas={serviceNames} />
      </div>
    </div>
  </Section>
</SiteLayout>
