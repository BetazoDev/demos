---
import "@/sites/lexlababogados/theme.css";
import SiteLayout from "@/kit/SiteLayout.astro";
import Nav from "@/kit/Nav.astro";
import Footer from "@/sites/lexlababogados/Footer.astro";
import PageHero from "@/kit/PageHero.astro";
import Section from "@/kit/Section.astro";
import Icon from "@/kit/Icon.astro";
import CtaBand from "@/kit/CtaBand.astro";
import { site, navSite } from "@/sites/lexlababogados/site";
import { pagedServices, reviews } from "@/sites/lexlababogados/data";

export function getStaticPaths() {
  return pagedServices.map((s, i) => ({ params: { area: s.key }, props: { area: s, quote: [1, 3, 0, 2, 1][i] ?? 0 } }));
}
const { area, quote } = Astro.props;
const q = reviews.quotes[quote];
const base = "/lexlababogados";
const others = pagedServices.filter((s) => s.key !== area.key);
const org = new URL(`/${site.slug}#organizacion`, Astro.site).href;
const wa = `https://wa.me/${site.whatsapp.number}?text=${encodeURIComponent(`${site.whatsapp.intro} sobre ${area.title.toLowerCase()}.`)}`;
const schema = [{ "@context": "https://schema.org", "@type": "Service", name: area.title, description: area.lead, provider: { "@id": org }, areaServed: { "@type": "Country", name: "México" } }];
---

<SiteLayout
  site={site}
  title={`${area.title} para empresas | LexLab Abogados`}
  description={area.meta ?? area.lead}
  nav={false}
  breadcrumbs={[{ name: "Servicios", href: `${base}/servicios` }, { name: area.title, href: `${base}/servicios/${area.key}` }]}
  schema={schema}
>
  <Footer slot="footer" site={site} variant="dark" blurb="Blindaje Legal Laboral." />
  <Nav slot="nav" site={navSite} variant="pill" tone="light" logoHeight={40} />
  <PageHero title={area.title} lede={area.lead} transitionName={`area-${area.key}`} />

  <Section size="sm" class="pt-4">
    <div class="wrap grid gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:gap-20">
      <h2 data-reveal class="max-w-[16ch] text-[clamp(1.7rem,3.2vw,2.6rem)] font-bold leading-[1.05]">{area.listTitle}</h2>
      {
        area.ordered ? (
          <ol data-stagger data-gap="80" class="relative grid gap-8 border-l border-(--c-line) pl-8 sm:pl-10">
            {area.items!.map((i) => (
              <li class="relative">
                <span aria-hidden="true" class="absolute -left-[2.45rem] top-2 size-3 bg-(--c-accent) sm:-left-[3.05rem]" style="border-radius:0 6px 0 6px"></span>
                <h3 class="text-[clamp(1.3rem,2.4vw,1.9rem)] font-medium leading-snug">{i}</h3>
              </li>
            ))}
          </ol>
        ) : (
          <ul data-stagger data-gap="50" class="grid gap-x-10 gap-y-5 sm:grid-cols-2">
            {area.items!.map((i) => (
              <li class="flex gap-4 border-b border-(--c-line) pb-5 text-lg">
                <span class="mt-1 grid size-6 shrink-0 place-items-center bg-(--c-accent) text-(--c-on-accent)" style="border-radius:0 8px 0 8px"><Icon name="check" weight="bold" class="size-3.5" /></span>
                <span>{i}</span>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </Section>

  {
    area.note && (
      <Section tone="brand" size="sm">
        <div class="wrap"><p data-reveal class="max-w-[22ch] text-[clamp(1.9rem,4.4vw,3.8rem)] font-bold leading-[1]">{area.note}</p></div>
      </Section>
    )
  }

  <Section size="sm">
    <div class="wrap grid gap-8 lg:grid-cols-[0.8fr_1.2fr] lg:gap-20">
      <p data-reveal class="text-(--c-muted)">Reseña en Google</p>
      <figure data-reveal data-delay="100">
        <blockquote class="max-w-[40ch] text-[clamp(1.3rem,2.3vw,1.9rem)] leading-[1.25]">“{q.text}”</blockquote>
        <figcaption class="mt-5 text-(--c-muted)">{q.author}</figcaption>
      </figure>
    </div>
  </Section>

  <Section tone="surface" size="sm">
    <div class="wrap">
      <h2 data-reveal class="mb-8 text-[clamp(1.6rem,3vw,2.4rem)] font-bold leading-tight">Otros servicios</h2>
      <ul data-stagger data-gap="45" class="flex flex-wrap gap-3">
        {others.map((o) => <li><a href={`${base}/servicios/${o.key}`} class="press inline-flex border border-(--c-line) px-5 py-2.5 text-[15px] hover:border-(--c-accent)" style="border-radius:0 14px 0 14px">{o.title}</a></li>)}
      </ul>
    </div>
  </Section>

  <CtaBand title="Blindaje Legal Laboral." href={wa} label="Escribir por WhatsApp" tone="brand" external />
</SiteLayout>
