---
import DuLayout from "@/sites/dupratlira/DuLayout.astro";
import DuPageHero from "@/sites/dupratlira/DuPageHero.astro";
import DuCta from "@/sites/dupratlira/DuCta.astro";
import Section from "@/kit/Section.astro";
import Icon from "@/kit/Icon.astro";
import Pic from "@/kit/Pic.astro";
import { site, WA } from "@/sites/dupratlira/site";
import { areas, team } from "@/sites/dupratlira/data";

export function getStaticPaths() {
  return areas.map((a) => ({ params: { area: a.key }, props: { area: a } }));
}
const { area } = Astro.props;
const base = "/dupratlira";
const others = areas.filter((a) => a.key !== area.key);
const lawyer = team.find((p) => p.id === area.lawyer);
const wa = `https://wa.me/${WA}?text=${encodeURIComponent(`${site.whatsapp.intro} sobre ${area.title.toLowerCase()}.`)}`;
const schema = [{ "@context": "https://schema.org", "@type": "Service", name: area.title, description: area.seo, provider: { "@id": new URL(`/${site.slug}#organizacion`, Astro.site).href }, areaServed: { "@type": "City", name: "Ciudad de México" } }];
---

<DuLayout title={`${area.title} en la Ciudad de México | Duprat Lira Abogados`} description={area.seo} breadcrumbs={[{ name: "Servicios", href: `${base}/servicios` }, { name: area.title, href: `${base}/servicios/${area.key}` }]} schema={schema}>
  <DuPageHero title={area.title} lede={area.lead} transitionName={`area-${area.key}`} />
  <Section>
    <div class="wrap grid gap-12 lg:grid-cols-[0.7fr_1.3fr] lg:gap-20">
      <div data-reveal class="grid content-start gap-10">
        <h2 class="text-[clamp(1.9rem,3.2vw,2.8rem)] leading-tight">Incluye</h2>
        {
          lawyer && (
            <a href={`${base}/nosotros`} class="group flex max-w-[22rem] items-center gap-5">
              <span class="img-zoom block size-24 shrink-0 overflow-hidden outline outline-1 outline-offset-4 outline-(--du-gold)/70"><Pic src={lawyer.photo} alt={`Retrato de ${lawyer.name}`} position="50% 30%" class="size-full object-cover" /></span>
              <span>
                <span class="block text-[15px] text-(--c-muted)">Abogado especialista</span>
                <span class="link-u mt-1 block text-lg font-medium leading-snug">{lawyer.name}</span>
                <span class="mt-1 block text-[15px] leading-snug text-(--c-muted)">{lawyer.role}</span>
              </span>
            </a>
          )
        }
      </div>
      <div class="grid gap-10">
        {area.groups.map((g) => (
          <div data-reveal>
            {g.title && <h3 class="mb-5 text-[1.5rem] leading-tight">{g.title}</h3>}
            <ul data-stagger data-gap="45" class="grid gap-x-10 gap-y-4 sm:grid-cols-2">
              {g.items.map((i) => (
                <li class="flex gap-3.5 text-[18px] leading-snug">
                  <Icon name="check" weight="bold" class="mt-1 size-[18px] shrink-0 text-(--du-gold)" />
                  <span>{i}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </Section>
  <Section tone="surface" size="sm">
    <div class="wrap">
      <h2 data-reveal class="mb-8 text-[clamp(1.6rem,3vw,2.4rem)] leading-tight">Otros servicios</h2>
      <ul data-stagger data-gap="45" class="flex flex-wrap gap-3">
        {others.map((o) => <li><a href={`${base}/servicios/${o.key}`} class="press inline-flex border border-(--c-ink)/25 bg-(--c-bg) px-5 py-2.5 text-[15px] hover:border-(--du-gold) hover:text-(--du-gold-ink)">{o.title}</a></li>)}
      </ul>
    </div>
  </Section>
  <DuCta title="Primera consulta sin costo" href={wa} label="Escribir por WhatsApp" />
</DuLayout>
