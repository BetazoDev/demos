---
import DuLayout from "@/sites/dupratlira/DuLayout.astro";
import DuPageHero from "@/sites/dupratlira/DuPageHero.astro";
import DuContact from "@/sites/dupratlira/DuContact.astro";
import Section from "@/kit/Section.astro";
import Composer from "@/kit/Composer.astro";
import { site } from "@/sites/dupratlira/site";
import { areas } from "@/sites/dupratlira/data";

const base = "/dupratlira";
---

<DuLayout title="Contacto | Duprat Lira Abogados, Insurgentes Sur 300, Roma Norte" description="Duprat Lira Abogados: Av. Insurgentes Sur 300, 6.º piso, desp. 615, colonia Roma Norte, Ciudad de México. WhatsApp 55 3228 3556 y 55 1475 0441." breadcrumbs={[{ name: "Contacto", href: `${base}/contacto` }]}>
  <DuPageHero title="Contacto" lede="Escríbanos por WhatsApp, llámenos o visítenos en la colonia Roma Norte. Primera consulta sin costo." />
  <Section size="sm" class="pt-14">
    <div class="wrap grid gap-14 lg:grid-cols-2 lg:gap-24">
      <div data-reveal><DuContact site={site} /></div>
      <div data-reveal data-delay="120" class="border border-(--c-line) bg-(--c-surface) p-6 sm:p-9">
        <Composer site={site} areas={areas.map((a) => a.title)} />
      </div>
    </div>
  </Section>
</DuLayout>
