---
import Layout from "@/sites/mendozaalvarez/Layout.astro";
import PageHero from "@/kit/PageHero.astro";
import Section from "@/kit/Section.astro";
import ContactBlock from "@/kit/ContactBlock.astro";
import Composer from "@/kit/Composer.astro";
import { site } from "@/sites/mendozaalvarez/site";
import { areas, texto } from "@/sites/mendozaalvarez/data";

const base = "/mendozaalvarez";
---

<Layout site={site} title="Contacto | Mendoza Álvarez Abogados, López 11, Centro, CDMX" description="Comunícate con Mendoza Álvarez Abogados para una asesoría y agendar una cita. López 11, Centro, Ciudad de México. Lunes a viernes de 8:00 a 20:00." breadcrumbs={[{ name: "Contacto", href: `${base}/contacto` }]}>
  <PageHero title="Contáctanos" lede={texto.contactoLede} />
  <Section size="sm" class="pt-4">
    <div class="wrap grid gap-14 lg:grid-cols-2 lg:gap-24">
      <div data-reveal><ContactBlock site={site} /></div>
      <div data-reveal data-delay="120" class="border border-(--c-line) bg-(--c-surface) p-6 sm:p-9">
        <Composer site={site} areas={areas.map((a) => a.title)} />
      </div>
    </div>
  </Section>
</Layout>
