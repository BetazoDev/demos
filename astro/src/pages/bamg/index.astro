---
import "@/sites/bamg/theme.css";
import SiteLayout from "@/kit/SiteLayout.astro";
import Button from "@/kit/Button.astro";
import Section from "@/kit/Section.astro";
import Statement from "@/kit/Statement.astro";
import AreasIndex from "@/kit/AreasIndex.astro";
import Band from "@/sites/bamg/Band.astro";
import Urgent from "@/sites/bamg/Urgent.astro";
import Stats from "@/kit/Stats.astro";
import Pic from "@/kit/Pic.astro";
import Icon from "@/kit/Icon.astro";
import ContactBlock from "@/kit/ContactBlock.astro";
import Hero from "@/sites/bamg/Hero.astro";
import Journey from "@/sites/bamg/Journey.astro";
import Composer from "@/sites/bamg/Composer.astro";
import { site } from "@/sites/bamg/site";
import { groups, leaving, intro, process, benefits, seals, stats, team, reviews, photos, serviceNames } from "@/sites/bamg/data";

const base = "/bamg";
const wa = `https://wa.me/${site.whatsapp.number}?text=${encodeURIComponent(site.whatsapp.intro)}.`;
const rows = [
  ...groups.map((g) => ({ key: g.key, title: g.title, text: g.summary, href: `${base}/servicios/${g.key}` })),
  { key: leaving.key, title: leaving.title, text: leaving.d.split(". ")[0] + ".", href: `${base}/servicios#${leaving.key}` },
];
const [lead, ...rest] = reviews.quotes;
---

<SiteLayout
  site={site}
  title="BAM-G Abogados Migratorios | Abogados de migración en Ciudad de México"
  description="Abogados de migración en Ciudad de México: visas mexicanas, residencia temporal o permanente, naturalización, regularización y amparos migratorios. Frente al Monumento a la Revolución."
  nav={{ variant: "pill", tone: "dark", logoHeight: 40 }}
  footer={{ variant: "dark", blurb: "Todas Tus Opciones Migratorias" }}
>
  <Hero title="Abogados de Migración en Ciudad de México" lede={intro.hero} image={photos.reforma} imageAlt="Paseo de la Reforma al amanecer, con el Ángel de la Independencia al fondo" position="55% 50%">
    <Fragment slot="actions">
      <Button href={wa} variant="light" size="lg" external>Escribir por WhatsApp</Button>
      <Button href={`${base}/servicios`} variant="outline" size="lg">Ver servicios</Button>
    </Fragment>
  </Hero>

  <Section>
    <div class="wrap"><Statement text={intro.statement} /></div>
  </Section>

  <Section id="servicios" size="sm" class="pt-0">
    <div class="wrap">
      <h2 data-reveal class="mb-12 text-[clamp(2rem,4.4vw,3.8rem)] font-medium leading-[1.02]">Servicios</h2>
      <AreasIndex areas={rows} />
    </div>
  </Section>

  <Band image={photos.terminal} alt="Sala de salidas de un aeropuerto, vacía y con luz de la mañana" position="50% 55%" />

  <Urgent />

  <Section tone="surface">
    <div class="wrap">
      <h2 data-reveal class="mb-14 text-[clamp(2rem,4.4vw,3.8rem)] font-medium leading-[1.02]">{process.title}</h2>
      <Journey />
    </div>
  </Section>

  <Section>
    <div class="wrap grid items-start gap-14 lg:grid-cols-[1.1fr_0.9fr] lg:gap-20">
      {team.map((p, i) => (
        <article class:list={[i === 1 && "lg:pt-28"]}>
          <div data-reveal="clip" class:list={["overflow-hidden rounded-(--c-radius-img) bg-(--c-surface)", i === 0 ? "aspect-square" : "aspect-[4/5] max-w-[20rem]"]}>
            <Pic src={p.photo} alt={`${p.name}, ${p.role.toLowerCase()}`} position={i === 0 ? "50% 40%" : "50% 30%"} class="size-full object-cover" />
          </div>
          <h3 data-reveal class="mt-6 text-[clamp(1.6rem,2.6vw,2.2rem)] font-medium leading-tight">{p.name}</h3>
          <p data-reveal data-delay="60" class="mt-1 text-(--c-muted)">{p.role}</p>
          <p data-reveal data-delay="100" class="mt-5 max-w-[52ch] text-[17px] leading-relaxed">{p.bio}</p>
        </article>
      ))}
    </div>
    <div class="wrap mt-16"><Stats stats={stats} /></div>
  </Section>

  <Section tone="surface">
    <div class="wrap grid gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:gap-24">
      <div data-reveal>
        <h2 class="max-w-[12ch] text-[clamp(2rem,4.4vw,3.8rem)] font-medium leading-[1.02]">¿Por qué elegirnos?</h2>
        <p class="mt-6 max-w-[40ch] text-lg text-(--c-muted)">Somos un bufete especializado en derecho migratorio que trabaja con ética, transparencia y resultados.</p>
      </div>
      <div>
        <ul data-stagger data-gap="60" class="grid gap-x-10 gap-y-6 sm:grid-cols-2">
          {benefits.map((b) => (
            <li class="flex gap-4 text-lg">
              <span class="mt-1 grid size-6 shrink-0 place-items-center rounded-[4px] bg-(--c-brand) text-(--c-on-brand)"><Icon name="check" weight="bold" class="size-3.5" /></span>
              <span>{b}</span>
            </li>
          ))}
        </ul>
        <ul data-stagger data-gap="60" class="mt-10 flex flex-wrap gap-3">
          {seals.map((s) => <li class="rounded-[6px] border border-(--c-line) bg-(--c-bg) px-5 py-2.5">{s}</li>)}
        </ul>
      </div>
    </div>
  </Section>

  <Section tone="brand">
    <div class="wrap grid gap-12 lg:grid-cols-[0.6fr_1.4fr] lg:gap-24">
      <p data-reveal class="flex flex-col gap-3">
        <span data-count={reviews.rating.toFixed(1)} class="font-(family-name:--f-display) text-[clamp(4.5rem,10vw,8rem)] font-medium leading-none tabular-nums">{reviews.rating.toFixed(1)}</span>
        <span class="text-lg opacity-90">en Google, {reviews.count} reseñas</span>
      </p>
      <div>
        <figure data-reveal>
          <blockquote class="max-w-[40ch] text-[clamp(1.35rem,2.4vw,2rem)] leading-[1.28]">“{lead.text}”</blockquote>
          <figcaption class="mt-5 opacity-90">{lead.author}</figcaption>
        </figure>
        <ul data-stagger data-gap="90" class="mt-12 grid gap-10 border-t border-current/25 pt-10 sm:grid-cols-3">
          {rest.map((q) => (
            <li>
              <blockquote class="leading-snug">“{q.text}”</blockquote>
              <p class="mt-4 text-sm opacity-90">{q.author}</p>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </Section>

  <Section id="contacto">
    <div class="wrap grid gap-14 lg:grid-cols-[1fr_1fr] lg:gap-24">
      <div data-reveal>
        <h2 class="mb-10 text-[clamp(2rem,4.4vw,3.8rem)] font-medium leading-[1.02]">Contacto</h2>
        <ContactBlock site={site} showCta={false} />
      </div>
      <div data-reveal data-delay="120" class="rounded-(--c-radius-card) border border-(--c-line) bg-(--c-surface) p-6 sm:p-9">
        <Composer site={site} areas={serviceNames} />
      </div>
    </div>
  </Section>
</SiteLayout>
