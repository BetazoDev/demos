---
import "@/sites/bamg/theme.css";
import SiteLayout from "@/kit/SiteLayout.astro";
import PageHero from "@/kit/PageHero.astro";
import Section from "@/kit/Section.astro";
import Statement from "@/kit/Statement.astro";
import Stats from "@/kit/Stats.astro";
import Pic from "@/kit/Pic.astro";
import Icon from "@/kit/Icon.astro";
import CtaBand from "@/kit/CtaBand.astro";
import { site } from "@/sites/bamg/site";
import { intro, team, stats, benefits, photos } from "@/sites/bamg/data";

const base = "/bamg";
const wa = `https://wa.me/${site.whatsapp.number}?text=${encodeURIComponent(site.whatsapp.intro)}.`;
---

<SiteLayout
  site={site}
  title="Nosotros | BAM-G Abogados Migratorios, Ciudad de México"
  description="Conoce a Germán Martínez Saldaña, socio fundador de BAM-G, y a Eliud Jahzeel Ocampo López, coordinador de gestión jurídica en casos migratorios. Abogados de migración en Ciudad de México."
  nav={{ variant: "pill", tone: "light", logoHeight: 40 }}
  breadcrumbs={[{ name: "Nosotros", href: `${base}/nosotros` }]}
>
  <PageHero title="Nosotros" lede={intro.about} />

  <Section>
    <div class="wrap">
      <Statement text={intro.about2} />
    </div>
  </Section>

  <Section tone="surface">
    <div class="wrap">
      <ul class="grid gap-20 sm:gap-28">
        {team.map((p, i) => (
          <li class:list={["grid items-start gap-8 md:gap-16", i % 2 === 0 ? "md:grid-cols-[0.8fr_1.2fr]" : "md:grid-cols-[1.2fr_0.8fr]"]}>
            <div data-reveal="clip" class:list={["aspect-square overflow-hidden rounded-(--c-radius-img) bg-(--c-bg)", i % 2 === 1 && "md:order-2"]}>
              <Pic src={p.photo} alt={`${p.name}, ${p.role.toLowerCase()}`} position="50% 35%" class="size-full object-cover" />
            </div>
            <div data-reveal class="md:py-6">
              <h2 class="text-[clamp(1.8rem,3.2vw,2.8rem)] font-medium leading-tight">{p.name}</h2>
              <p class="mt-2 text-(--c-muted)">{p.role}</p>
              <p class="mt-6 max-w-[56ch] text-lg leading-relaxed">{p.bio}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </Section>

  <Section>
    <div class="wrap grid items-start gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:gap-24">
      <div>
        <div data-reveal="clip" class="aspect-[4/5] overflow-hidden rounded-(--c-radius-img) bg-(--c-surface)">
          <Pic src={photos.germanReforma} alt="Germán Martínez Saldaña con los brazos cruzados sobre Paseo de la Reforma, con el Ángel de la Independencia al fondo" position="50% 40%" class="size-full object-cover" />
        </div>
      </div>
      <div>
        <div data-reveal class="mb-14">
          <h2 class="text-[clamp(2rem,4.4vw,3.8rem)] font-medium leading-[1.02]">Visión</h2>
          <p class="mt-6 max-w-[44ch] text-lg text-(--c-muted)">{intro.vision}</p>
        </div>
        <Stats stats={stats} />
        <ul data-stagger data-gap="60" class="mt-14 grid gap-x-10 gap-y-6 sm:grid-cols-2">
          {benefits.map((b) => (
            <li class="flex gap-4 text-lg">
              <span class="mt-1 grid size-6 shrink-0 place-items-center rounded-[4px] bg-(--c-brand) text-(--c-on-brand)"><Icon name="check" weight="bold" class="size-3.5" /></span>
              <span>{b}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </Section>

  <CtaBand title="Todas tus opciones migratorias" href={wa} label="Escribir por WhatsApp" tone="brand" external />
</SiteLayout>
