---
import SiteLayout from "@/sites/rcaabogados/Page.astro";
import PageHero from "@/kit/PageHero.astro";
import Section from "@/kit/Section.astro";
import ContactBlock from "@/kit/ContactBlock.astro";
import Composer from "@/kit/Composer.astro";
import { site } from "@/sites/rcaabogados/site";
import { areas } from "@/sites/rcaabogados/data";

const base = "/rcaabogados";
---

<SiteLayout site={site} title="Contacto | RCA Abogados, Calzada General Mariano Escobedo, Polanco" description="Calz. Gral. Mariano Escobedo 353A, interior 902, Polanco, Ciudad de México. WhatsApp 55 4008 1831, oficina 55 5525 8052, lunes a viernes de 10:00 a 17:00." nav={{ variant: "bar", tone: "light", logoHeight: 52 }} breadcrumbs={[{ name: "Contacto", href: `${base}/contacto` }]}>
  <PageHero title="Contacto" lede="Escríbanos por WhatsApp o visítenos en Polanco, de lunes a viernes." />
  <Section size="sm" class="pt-4">
    <div class="wrap grid gap-14 lg:grid-cols-2 lg:gap-24">
      <div data-reveal><ContactBlock site={site} /></div>
      <div data-reveal data-delay="120" class="rounded-(--c-radius-card) border border-(--c-line) bg-(--c-surface) p-6 sm:p-9">
        <Composer site={site} areas={areas.map((a) => a.title)} />
      </div>
    </div>
  </Section>
</SiteLayout>
