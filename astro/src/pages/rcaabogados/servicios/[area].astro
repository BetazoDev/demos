---
import SiteLayout from "@/sites/rcaabogados/Page.astro";
import PageHero from "@/kit/PageHero.astro";
import Section from "@/kit/Section.astro";
import Icon from "@/kit/Icon.astro";
import CtaBand from "@/kit/CtaBand.astro";
import { site } from "@/sites/rcaabogados/site";
import { areas } from "@/sites/rcaabogados/data";

export function getStaticPaths() {
  return areas.map((a) => ({ params: { area: a.key }, props: { area: a } }));
}
const { area } = Astro.props;
const base = "/rcaabogados";
const others = areas.filter((a) => a.key !== area.key);
const wa = `https://wa.me/${site.whatsapp.number}?text=${encodeURIComponent(`${site.whatsapp.intro} sobre ${area.title.toLowerCase()}.`)}`;
const origin = Astro.site!.origin;
const schema = [{ "@context": "https://schema.org", "@type": "Service", name: area.title, description: area.lead, provider: { "@id": `${origin}${base}#organizacion` }, areaServed: { "@type": "City", name: "Ciudad de México" } }];
---

<SiteLayout site={site} title={`${area.title} | RCA Abogados, Polanco, Ciudad de México`} description={area.lead} nav={{ variant: "bar", tone: "light", logoHeight: 52 }} breadcrumbs={[{ name: "Áreas de práctica", href: `${base}/servicios` }, { name: area.title, href: `${base}/servicios/${area.key}` }]} schema={schema}>
  <PageHero title={area.title} lede={area.lead} transitionName={`area-${area.key}`} />
  <Section size="sm" class="pt-10 sm:pt-16">
    <div class="wrap grid gap-10 lg:grid-cols-[0.55fr_1.45fr] lg:gap-20">
      <h2 data-reveal class="text-[clamp(1.6rem,3vw,2.4rem)] font-semibold leading-tight tracking-[-0.02em]">Servicios</h2>
      <ul data-stagger data-gap="35" class="grid gap-x-10 gap-y-5 text-[17px] leading-snug sm:grid-cols-2">
        {area.services.map((s) => (
          <li class="flex gap-3">
            <Icon name="check" weight="bold" class="mt-1 size-4 shrink-0 text-(--c-brand)" />
            <span>{s}</span>
          </li>
        ))}
      </ul>
    </div>
  </Section>
  <Section tone="surface" size="sm">
    <div class="wrap">
      <h2 data-reveal class="mb-8 text-[clamp(1.6rem,3vw,2.4rem)] font-semibold leading-tight tracking-[-0.02em]">Otras áreas</h2>
      <ul data-stagger data-gap="35" class="flex flex-wrap gap-3">
        {others.map((o) => <li><a href={`${base}/servicios/${o.key}`} class="press inline-flex rounded-full border border-(--c-line) bg-(--c-bg) px-5 py-2.5 text-[15px] hover:border-(--c-brand) hover:bg-(--c-brand) hover:text-(--c-on-brand)">{o.title}</a></li>)}
      </ul>
    </div>
  </Section>
  <CtaBand title="Cuéntenos su asunto" href={wa} label="Escribir por WhatsApp" tone="brand" external />
</SiteLayout>
