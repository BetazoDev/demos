---
import SiteLayout from "@/sites/rcaabogados/Page.astro";
import PageHero from "@/kit/PageHero.astro";
import Section from "@/kit/Section.astro";
import Icon from "@/kit/Icon.astro";
import CtaBand from "@/kit/CtaBand.astro";
import { site } from "@/sites/rcaabogados/site";
import { areas, sectores } from "@/sites/rcaabogados/data";

const base = "/rcaabogados";
const wa = `https://wa.me/${site.whatsapp.number}?text=${encodeURIComponent(site.whatsapp.intro)}`;
---

<SiteLayout site={site} title="Áreas de práctica | RCA Abogados, Polanco, Ciudad de México" description="Litigio, fiscal, financiero, fintech, inmobiliario, laboral, penal, competencia económica, migración, consultoría, corporativo y comercio exterior. Doce áreas de especialidad." nav={{ variant: "bar", tone: "light", logoHeight: 52 }} breadcrumbs={[{ name: "Áreas de práctica", href: `${base}/servicios` }]}>
  <PageHero title="Áreas de práctica" lede={sectores} />
  <Section size="sm" class="pt-10 sm:pt-16">
    <div class="wrap">
      <ul data-stagger data-gap="50" class="grid gap-x-16 gap-y-14 md:grid-cols-2">
        {areas.map((a) => (
          <li>
            <a href={`${base}/servicios/${a.key}`} class="group block">
              <h2 transition:name={`area-${a.key}`} class="inline-flex items-center gap-3 text-[clamp(1.7rem,3vw,2.6rem)] font-medium leading-[1.05] tracking-[-0.025em]">
                {a.title}
                <Icon name="arrow-up-right" weight="bold" class="size-6 shrink-0 opacity-30 transition-[opacity,transform] duration-300 ease-(--ease-out) group-hover:translate-x-1 group-hover:-translate-y-1 group-hover:opacity-100" />
              </h2>
              <p class="mt-3 max-w-[46ch] text-[17px] leading-relaxed text-(--c-muted)">{a.lead}</p>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </Section>
  <CtaBand title="Cuéntenos su asunto" href={wa} label="Escribir por WhatsApp" tone="brand" external />
</SiteLayout>
