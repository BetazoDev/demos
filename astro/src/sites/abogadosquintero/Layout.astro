---
// Envoltorio de SiteLayout: nav y pie propios (logotipo recompuesto con el medallón y Marcellus) y un solo sistema de radios (16px).
import SiteLayout from "@/kit/SiteLayout.astro";
import Nav from "./Nav.astro";
import Footer from "./Footer.astro";
import { site } from "./site";
interface Props {
  title: string;
  description?: string;
  breadcrumbs?: { name: string; href: string }[];
  schema?: Record<string, unknown>[];
  nav?: { variant?: "pill" | "bar"; tone?: "light" | "dark"; logoHeight?: number };
  footer?: { variant?: "dark" | "light" | "brand"; blurb?: string };
}
const { nav, footer, ...rest } = Astro.props;
---

<SiteLayout site={site} nav={false} footer={false} {...rest}>
  <Nav slot="nav" site={site} variant="bar" tone="light" logoHeight={46} {...nav} />
  <slot />
  <Footer slot="footer" site={site} variant="dark" blurb="Expertos en derecho familiar." {...footer} />
</SiteLayout>

<style is:global>
  html[data-site="abogadosquintero"] {
    --c-radius-nav: 16px;
    --c-radius-img: 16px;
    --c-radius-card: 16px;
    --c-radius-field: 12px;
  }
  [data-site="abogadosquintero"] :is(h1, h2, h3) { font-weight: 400; letter-spacing: -0.01em; }
  [data-site="abogadosquintero"] [data-statement] { font-family: var(--f-display); font-weight: 400; letter-spacing: -0.015em; }
  [data-site="abogadosquintero"] main :is(.opacity-60, .opacity-65, .opacity-70) { opacity: 0.8; }
</style>
