---
// Héroe tipográfico sobre campo marino: titular en una pieza (palabras que suben), retrato a la derecha fundido con el fondo.
import Pic from "@/kit/Pic.astro";
import type { Img } from "@/kit/types";
interface Props { title: string; lede: string; image: Img; imageAlt?: string }
const { title, lede, image, imageAlt = "" } = Astro.props;
const words = title.split(" ");
---

<section class="ss-hero">
  <div class="ss-photo" data-hero-media style="--d:0ms"><Pic src={image} alt={imageAlt} priority /></div>
  <div class="wrap flex min-h-[100svh] flex-col justify-end pb-14 pt-40 sm:pb-20">
    <h1 aria-label={title} class="max-w-[13ch] text-[clamp(2.9rem,7.4vw,7.4rem)] font-light leading-[0.98] tracking-[-0.04em]">
      {words.map((w, i) => <Fragment><span class="ss-w" aria-hidden="true"><span style={`--i:${i}`}>{w}</span></span>{" "}</Fragment>)}
    </h1>
    <p data-hero style="--i:5" class="mt-7 max-w-[40ch] text-lg opacity-85 sm:text-xl">{lede}</p>
    <div data-hero style="--i:6" class="mt-9 flex flex-wrap items-center gap-3"><slot name="actions" /></div>
  </div>
</section>
