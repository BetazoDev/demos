---
// Cierre de página: campo claro de marca con el botón invertido (el del kit usa el color claro de marca sobre el mismo color).
import Button from "@/kit/Button.astro";
interface Props { title: string; text?: string; href: string; label: string; external?: boolean }
const { title, text, href, label, external = false } = Astro.props;
---

<section class="section-y overflow-hidden bg-(--c-brand) text-(--c-on-brand)">
  <div class="wrap grid items-end gap-10 lg:grid-cols-[1fr_auto]">
    <div data-reveal>
      <h2 class="max-w-[20ch] text-[clamp(2.2rem,5.2vw,4.6rem)] font-light leading-[1.02] tracking-[-0.04em]">{title}</h2>
      {text && <p class="mt-5 max-w-[48ch] text-lg opacity-80">{text}</p>}
    </div>
    <div data-reveal data-delay="120">
      <Button href={href} size="lg" external={external} class="!bg-(--c-on-brand) !text-(--c-brand)"><Fragment>{label}</Fragment></Button>
    </div>
  </div>
</section>
