---
// Escalera de precios: cada opción es una fila con su nombre, lo que incluye y su precio (sin tarjetas).
import Icon from "@/kit/Icon.astro";
import type { Tier } from "./data";
interface Props { tiers: Tier[] }
const { tiers } = Astro.props;
---

<ul data-stagger data-gap="80" class="divide-y divide-(--c-line) border-y border-(--c-line)">
  {tiers.map((t) => {
    const hasFeatures = !!t.features?.length;
    const textOnly = !hasFeatures && !t.price;
    return (
      <li class:list={["grid gap-6 py-9 md:gap-12 md:py-11", textOnly ? "md:grid-cols-[0.8fr_1.2fr]" : hasFeatures ? "md:grid-cols-[1fr_1fr_13rem]" : "md:grid-cols-[1fr_13rem]"]}>
        <div>
          <h3 class="text-[clamp(1.6rem,2.8vw,2.4rem)] font-medium leading-tight tracking-[-0.025em]">{t.name}</h3>
          {t.text && !textOnly && <p class="mt-3 max-w-[44ch] text-lg text-(--c-muted)">{t.text}</p>}
        </div>
        {textOnly && t.text && <p class="max-w-[54ch] text-lg text-(--c-muted) md:pt-1.5">{t.text}</p>}
        {hasFeatures && (
          <ul class="grid content-start gap-3 text-[17px]">
            {t.features!.map((f) => (
              <li class="flex gap-3">
                <Icon name="check" weight="bold" class="mt-1.5 size-4 shrink-0 text-(--c-accent)" />
                <span>{f}</span>
              </li>
            ))}
          </ul>
        )}
        {t.price && (
          <div class="md:text-right">
            {t.price.startsWith("Desde ") && <p class="mb-1 text-(--c-muted)">Desde</p>}
            <p class="font-(family-name:--f-display) text-[clamp(2rem,3.6vw,3.2rem)] font-semibold leading-none tracking-[-0.03em] tabular-nums">{t.price.replace(/^Desde /, "")}</p>
            {t.unit && <p class="mt-2 text-(--c-muted)">{t.unit}</p>}
          </div>
        )}
      </li>
    );
  })}
</ul>
