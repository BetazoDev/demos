---
// Héroe propio de Herrera: foto a sangre (fachada de cristal con una línea dorada), titular ligero que sube línea por línea.
import type { Img } from "@/kit/types";
import Pic from "@/kit/Pic.astro";
interface Props { lines: string[]; lede: string; image: Img; imageAlt: string; position?: string }
const { lines, lede, image, imageAlt, position } = Astro.props;
---

<section class="relative isolate flex min-h-[100svh] flex-col justify-end overflow-hidden bg-(--c-dark) text-(--c-on-dark)">
  <div class="absolute inset-0 -z-10" data-hero-media style="--d:0ms">
    <div class="size-full" data-parallax="70">
      <Pic src={image} alt={imageAlt} priority position={position} class="size-full object-cover" />
    </div>
    <div class="absolute inset-0 bg-[linear-gradient(to_right,color-mix(in_oklab,var(--c-dark)_72%,transparent)_0%,color-mix(in_oklab,var(--c-dark)_25%,transparent)_60%,transparent_100%)]"></div>
    <div class="absolute inset-x-0 bottom-0 h-1/3 bg-[linear-gradient(to_top,color-mix(in_oklab,var(--c-dark)_80%,transparent),transparent)]"></div>
  </div>
  <div class="wrap pb-14 pt-40 sm:pb-20">
    <h1 class="hh-light max-w-[15ch] text-[clamp(2.7rem,7.6vw,7.6rem)] leading-[0.98] tracking-[-0.035em]">
      {lines.map((l, i) => <span class="hh-line" style={`--l:${i}`}><span>{l}</span></span>)}
    </h1>
    <p data-hero style="--i:3" class="mt-8 max-w-[44ch] text-lg text-white/85 sm:text-xl">{lede}</p>
    <div data-hero style="--i:4" class="mt-9 flex flex-wrap items-center gap-3">
      <slot name="actions" />
    </div>
  </div>
</section>
