---
// Héroe propio de GTM: titular a la izquierda, foto a sangre en un panel derecho (clip de abajo hacia arriba).
import type { Img } from "@/kit/types";
import Pic from "@/kit/Pic.astro";
interface Props { title: string; lede: string; image: Img; imageAlt: string; position?: string }
const { title, lede, image, imageAlt, position } = Astro.props;
---

<section class="relative isolate overflow-hidden bg-(--c-bg) text-(--c-ink) lg:min-h-[100svh]">
  <div class="wrap flex min-h-[72svh] flex-col justify-end pb-12 pt-36 lg:min-h-[100svh] lg:justify-center lg:pb-20 lg:pt-32">
    <div class="gtm-hero-copy">
      <h1 data-hero="blur" class="text-[clamp(2.6rem,5.6vw,5.4rem)] font-medium leading-[0.98] tracking-[-0.04em]">{title}</h1>
      <p data-hero style="--i:1" class="mt-6 max-w-[40ch] text-lg text-(--c-muted) sm:text-xl">{lede}</p>
      <div data-hero style="--i:2" class="mt-9 flex flex-wrap items-center gap-3">
        <slot name="actions" />
      </div>
    </div>
  </div>
  <div data-hero-media style="--d:150ms" class="relative aspect-[5/4] w-full overflow-hidden bg-(--c-surface) lg:absolute lg:inset-y-0 lg:right-0 lg:aspect-auto lg:w-[40vw]">
    <Pic src={image} alt={imageAlt} priority position={position} class="size-full object-cover" />
  </div>
</section>
