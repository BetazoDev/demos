---
// Envoltorio de SiteLayout: nav de barra con el sello (anillos) y el nombre compuesto, pie con el logo completo,
// un solo sistema de radios (6px) y ajustes de la serif display.
import SiteLayout from "@/kit/SiteLayout.astro";
import Nav from "./Nav.astro";
import Footer from "./Footer.astro";
import { site } from "./site";
interface Props {
  title: string;
  description?: string;
  breadcrumbs?: { name: string; href: string }[];
  schema?: Record<string, unknown>[];
  nav?: { variant?: "pill" | "bar"; tone?: "light" | "dark"; logoHeight?: number };
  footer?: { variant?: "dark" | "light" | "brand"; blurb?: string };
}
const { nav, footer, ...rest } = Astro.props;
---

<SiteLayout site={site} nav={false} footer={false} {...rest}>
  <Nav slot="nav" site={site} variant="bar" tone="light" logoHeight={44} {...nav} />
  <slot />
  <Footer slot="footer" site={site} variant="light" {...footer} />
</SiteLayout>

<style is:global>
  [data-site="divorcioexpres"] {
    --c-radius-img: 6px;
    --c-radius-card: 6px;
    --c-radius-field: 6px;
  }
  [data-site="divorcioexpres"] :is(h1, h2, h3) { font-weight: 400; letter-spacing: -0.012em; }
  [data-site="divorcioexpres"] [data-statement] { font-weight: 400; letter-spacing: -0.015em; }
  [data-site="divorcioexpres"] main :is(.opacity-60, .opacity-65) { opacity: 0.78; }
  [data-site="divorcioexpres"] main a.break-all { word-break: normal; overflow-wrap: anywhere; font-size: clamp(0.85rem, 3.7vw, 1.0625rem); }
  [data-site="divorcioexpres"] footer { border-top: 1px solid var(--c-line); }
</style>
