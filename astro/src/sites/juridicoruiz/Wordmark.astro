---
// Marca tipográfica: el despacho no tiene logo publicado, el nombre se compone en la fuente display del sitio.
interface Props { size?: number; class?: string }
const { size = 24, class: cls = "" } = Astro.props;
---

<span class:list={["inline-flex items-baseline gap-[0.28em] whitespace-nowrap font-(family-name:--f-display) leading-none tracking-[-0.02em]", cls]} style={`font-size:${size}px`}>
  <span class="font-light">Jurídico</span><span class="font-bold">Ruiz</span>
</span>
