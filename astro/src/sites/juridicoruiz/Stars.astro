---
// Cinco estrellas de la calificación real (4.9). Firma de movimiento: se encienden una a una al entrar (solo opacity y transform, una vez).
import Icon from "@/kit/Icon.astro";
interface Props { class?: string; delay?: number }
const { class: cls = "", delay = 700 } = Astro.props;
---

<span class:list={["stars inline-flex gap-1", cls]} style={`--sd:${delay}ms`} role="img" aria-label="Calificación 4.9 de 5">
  {[0, 1, 2, 3, 4].map((i) => <span class="star inline-flex" style={`--i:${i}`}><Icon name="star" weight="fill" class="size-5" /></span>)}
</span>

<style is:global>
  @keyframes star-on {
    from { opacity: 0.18; transform: scale(0.7); }
    to { opacity: 1; transform: scale(1); }
  }
  .stars .star { animation: star-on 480ms cubic-bezier(0.23, 1, 0.32, 1) both; animation-delay: calc(var(--sd, 700ms) + var(--i) * 110ms); }
  @media (prefers-reduced-motion: reduce) { .stars .star { animation: none; } }
</style>
