---
// Héroe de Lexon: foto a sangre que ocupa la mitad izquierda y titular a la derecha. La foto se abre desde el centro
// como las puertas dobles de una clínica (recorte horizontal que se ensancha). En móvil la foto va debajo, a ancho completo.
import type { Img } from "@/kit/types";
import Pic from "@/kit/Pic.astro";
interface Props { title: string; lede?: string; image: Img; imageAlt?: string; position?: string }
const { title, lede, image, imageAlt = "", position = "50% 50%" } = Astro.props;
---

<section class="relative overflow-hidden bg-(--c-bg) text-(--c-ink)">
  <div class="grid min-h-[100svh] lg:grid-cols-[0.96fr_1.04fr]">
    <div class="flex flex-col justify-center pb-14 pl-5 pr-5 pt-36 md:pl-10 lg:order-2 lg:pb-16 lg:pl-16 lg:pr-[max(2.5rem,calc((100vw-76rem)/2))] lg:pt-32">
      <h1 data-hero="blur" class="max-w-[15ch] text-[clamp(2.3rem,4.7vw,4.7rem)] font-medium leading-[1.04] tracking-[-0.02em]">{title}</h1>
      {lede && <p data-hero style="--i:1" class="mt-7 max-w-[46ch] text-lg text-(--c-muted) sm:text-xl">{lede}</p>}
      <div data-hero style="--i:2" class="mt-10 flex flex-wrap items-center gap-3">
        <slot name="actions" />
      </div>
    </div>
    <div class="lx-photo relative min-h-[26rem] sm:min-h-[34rem] lg:order-1 lg:min-h-0">
      <div class="lx-open absolute inset-0">
        <Pic src={image} alt={imageAlt} priority position={position} class="size-full object-cover" />
      </div>
    </div>
  </div>
</section>

<style>
  .lx-open { animation: lx-doors 1.5s var(--ease-in-out) 0.15s both; }
  @keyframes lx-doors {
    from { clip-path: inset(0 50% 0 50%); }
    to { clip-path: inset(0 0 0 0); }
  }
  @media (prefers-reduced-motion: reduce) { .lx-open { animation: none; } }
</style>
