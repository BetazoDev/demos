---
// Las tres condiciones de estancia como un recorrido: una línea que se dibuja al entrar en pantalla y marca cada parada.
// Firma de movimiento propia del sitio (solo transform/opacity; sin animación con movimiento reducido).
interface Props { steps: { title: string; meta: string; text?: string; href?: string }[] }
const { steps } = Astro.props;
---

<div class="journey relative" data-reveal>
  <ol class="grid gap-12 md:grid-cols-3 md:gap-10">
    {
      steps.map((s, k) => (
        <li class="journey-step relative pl-9 md:pl-0 md:pt-14" style={`--k:${k}`}>
          <span class="journey-dot absolute left-0 top-[0.5rem] size-[14px] rounded-full bg-(--c-brand) ring-[6px] ring-(--c-surface) md:top-[1.05rem]"></span>
          <h3 class="text-[clamp(1.5rem,2.3vw,2.05rem)] font-medium leading-tight tracking-[-0.03em]">{s.title}</h3>
          <p class="mt-2 text-lg font-medium text-(--c-brand)">{s.meta}</p>
          {s.text && <p class="mt-3 max-w-[34ch] text-(--c-muted)">{s.text}</p>}
        </li>
      ))
    }
  </ol>
  <span class="journey-rail pointer-events-none absolute bottom-0 left-[6px] top-2 w-px md:inset-x-0 md:bottom-auto md:left-0 md:top-[1.5rem] md:h-px md:w-auto" aria-hidden="true"><span class="journey-fill block size-full bg-(--c-brand)/70"></span></span>
</div>

<style is:global>
  .journey .journey-fill { clip-path: inset(0 0 100% 0); }
  @media (min-width: 768px) { .journey .journey-fill { clip-path: inset(0 100% 0 0); } }
  .journey .journey-rail { background: color-mix(in oklab, var(--c-ink) 14%, transparent); }
  .journey .journey-dot { opacity: 0; transform: scale(0.4); }
  .journey.is-in .journey-fill { clip-path: inset(0 0 0 0); transition: clip-path 2s cubic-bezier(0.77, 0, 0.175, 1) 150ms; }
  .journey.is-in .journey-dot { opacity: 1; transform: scale(1); transition: transform 500ms cubic-bezier(0.23, 1, 0.32, 1), opacity 300ms ease; transition-delay: calc(150ms + var(--k) * 900ms); }
  @media (prefers-reduced-motion: reduce) {
    .journey .journey-fill { clip-path: none !important; transition: none !important; }
    .journey .journey-dot { transition: none !important; transform: none !important; opacity: 1 !important; }
  }
</style>
