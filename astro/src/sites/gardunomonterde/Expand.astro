---
// Firma de movimiento: la foto entra como un panel inset y se amplía hasta casi llenar la pantalla con el scroll.
// Solo transform. Sin movimiento si se pide reducir movimiento.
import type { Img } from "@/kit/types";
import Pic from "@/kit/Pic.astro";
interface Props { image: Img; alt?: string; position?: string; height?: string }
const { image, alt = "", position, height = "clamp(20rem,54vw,40rem)" } = Astro.props;
---

<div class="overflow-hidden px-3 sm:px-5">
  <div data-expand class="expand relative isolate mx-auto overflow-hidden rounded-[1.5rem] bg-(--c-dark)" style={`height:${height}`}>
    <Pic src={image} alt={alt} position={position} class="size-full object-cover" />
    <div class="absolute inset-0 bg-[color-mix(in_oklab,var(--c-dark)_18%,transparent)]"></div>
  </div>
</div>

<style>
  .expand { transform: scale(var(--s, 1)); transform-origin: 50% 50%; will-change: transform; }
</style>

<script>
  let off: Array<() => void> = [];
  function init() {
    const els = document.querySelectorAll<HTMLElement>("[data-expand]");
    if (!els.length || matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    let raf = 0;
    const run = () => {
      raf = 0;
      const vh = window.innerHeight;
      els.forEach((el) => {
        const r = el.getBoundingClientRect();
        const p = Math.min(1, Math.max(0, (vh - r.top) / (vh * 0.62)));
        const e = 1 - Math.pow(1 - p, 3);
        el.style.setProperty("--s", (0.84 + 0.16 * e).toFixed(4));
      });
    };
    const on = () => { if (!raf) raf = requestAnimationFrame(run); };
    window.addEventListener("scroll", on, { passive: true });
    window.addEventListener("resize", on);
    run();
    off.push(() => { window.removeEventListener("scroll", on); window.removeEventListener("resize", on); if (raf) cancelAnimationFrame(raf); });
  }
  document.addEventListener("astro:page-load", init);
  document.addEventListener("astro:before-swap", () => { off.forEach((f) => f()); off = []; });
</script>
