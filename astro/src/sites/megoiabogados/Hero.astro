---
// Héroe propio de Megoi: panel azul de marca dentro del marco de la página, titular a la izquierda y ventana de foto a la derecha.
import type { Img } from "@/kit/types";
import Pic from "@/kit/Pic.astro";
interface Props { title: string; lede: string; image: Img; imageAlt: string; position?: string }
const { title, lede, image, imageAlt, position } = Astro.props;
---

<section class="bg-(--c-bg) p-2 sm:p-3">
  <div class="relative isolate grid min-h-[calc(100svh-1rem)] overflow-hidden rounded-(--c-radius) bg-(--c-brand) text-(--c-on-brand) sm:min-h-[calc(100svh-1.5rem)] lg:grid-cols-[1.08fr_0.92fr]">
    <div class="flex flex-col justify-end px-6 pb-12 pt-36 sm:px-10 lg:justify-center lg:pb-16 lg:pl-[max(3rem,6.5vw)] lg:pr-8 lg:pt-32">
      <h1 data-hero="blur" class="max-w-[12ch] text-[clamp(2.1rem,3.8vw,3.9rem)] font-medium leading-[1.1] tracking-[-0.035em]">{title}</h1>
      <p data-hero style="--i:1" class="mt-7 max-w-[38ch] text-lg text-white/85 sm:text-xl">{lede}</p>
      <div data-hero style="--i:2" class="mt-10 flex flex-wrap items-center gap-3">
        <slot name="actions" />
      </div>
    </div>
    <div class="p-2 pt-0 lg:p-3">
      <div data-hero-media style="--d:150ms" class="relative h-[22rem] overflow-hidden rounded-(--c-radius) bg-(--c-dark) sm:h-[30rem] lg:h-full">
        <Pic src={image} alt={imageAlt} priority position={position} class="size-full object-cover" />
      </div>
    </div>
  </div>
</section>
