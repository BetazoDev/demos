---
// Héroe propio: campo verde petróleo, titular grande y una cápsula con vidrio esmeralda (imagen de ambiente, no es su oficina).
import Pic from "@/kit/Pic.astro";
import type { Img } from "@/kit/types";
interface Props { title: string; lede: string; image: Img; imageAlt?: string }
const { title, lede, image, imageAlt = "" } = Astro.props;
---

<section class="relative isolate overflow-hidden bg-(--c-dark) text-(--c-on-dark)">
  <div class="wrap grid min-h-[100svh] items-center gap-12 pb-14 pt-32 lg:grid-cols-[1.4fr_0.6fr] lg:gap-16 lg:pb-16 lg:pt-28">
    <div class="lg:self-end">
      <h1 data-hero="blur" class="max-w-[25ch] text-[clamp(2.5rem,4.5vw,4.3rem)] font-medium leading-[1] tracking-[-0.04em]">{title}</h1>
      <p data-hero style="--i:1" class="mt-7 max-w-[42ch] text-lg opacity-85 sm:text-xl">{lede}</p>
      <div data-hero style="--i:2" class="mt-10 flex flex-wrap items-center gap-3">
        <slot name="actions" />
      </div>
    </div>
    <div data-hero-media style="--d:250ms" class="relative aspect-[4/3] w-full overflow-hidden rounded-[2rem] lg:aspect-auto lg:h-[min(74svh,48rem)] lg:rounded-full">
      <Pic src={image} alt={imageAlt} priority position="30% 15%" class="size-full object-cover" />
    </div>
  </div>
</section>
