---
// Proceso en tres pasos (texto real del sitio). En escritorio un avión recorre la línea con el scroll y enciende cada paso.
import Icon from "@/kit/Icon.astro";
import { process } from "./data";
---

<div data-journey>
  <div class="relative mb-10 hidden h-12 lg:block" aria-hidden="true">
    <span class="absolute inset-x-0 top-1/2 h-px bg-current/20"></span>
    <span data-journey-line class="absolute inset-x-0 top-1/2 h-px bg-(--c-brand)"></span>
    <span data-journey-plane class="absolute left-0 top-1/2 -mt-[18px] grid size-9 place-items-center text-(--c-brand)"><Icon name="airplane-tilt" weight="fill" class="size-9 rotate-45" /></span>
  </div>
  <ol class="grid gap-10 lg:grid-cols-3 lg:gap-12">
    {
      process.steps.map((s) => (
        <li data-journey-step class="relative border-t border-(--c-line) pt-6 lg:border-t-0 lg:pt-0">
          <div class="step-body">
            <h3 class="text-[clamp(1.5rem,2.6vw,2.2rem)] font-medium leading-tight">{s.t}</h3>
            {s.d && <p class="mt-3 max-w-[32ch] text-lg text-(--c-muted)">{s.d}</p>}
          </div>
        </li>
      ))
    }
  </ol>
</div>

<script>
  let cleanup: (() => void) | null = null;
  const reduce = () => window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  function init() {
    const root = document.querySelector<HTMLElement>("[data-journey]");
    if (!root) return;
    const line = root.querySelector<HTMLElement>("[data-journey-line]")!;
    const plane = root.querySelector<HTMLElement>("[data-journey-plane]")!;
    const steps = Array.from(root.querySelectorAll<HTMLElement>("[data-journey-step]"));
    if (reduce() || !window.matchMedia("(min-width: 1024px)").matches) return steps.forEach((s) => s.classList.add("is-on"));
    let raf = 0;
    const update = () => {
      raf = 0;
      const vh = window.innerHeight;
      const r = root.getBoundingClientRect();
      const p = Math.min(1, Math.max(0, (vh * 0.8 - r.top) / (vh * 0.45)));
      const w = r.width - plane.offsetWidth;
      const x = p * w;
      plane.style.transform = `translate3d(${x.toFixed(1)}px,0,0)`;
      line.style.transform = `scaleX(${Math.min(1, (x + plane.offsetWidth / 2) / r.width).toFixed(4)})`;
      steps.forEach((s) => s.classList.toggle("is-on", s.offsetLeft - 8 <= x + plane.offsetWidth / 2));
    };
    const onScroll = () => {
      if (!raf) raf = requestAnimationFrame(update);
    };
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll);
    update();
    cleanup = () => {
      window.removeEventListener("scroll", onScroll);
      window.removeEventListener("resize", onScroll);
      if (raf) cancelAnimationFrame(raf);
    };
  }
  document.addEventListener("astro:page-load", init);
  document.addEventListener("astro:before-swap", () => {
    cleanup?.();
    cleanup = null;
  });
</script>
