---
// Héroe propio: campo azul de marca a la izquierda con el titular, y a la derecha la foto a sangre
// (Paseo de la Reforma al amanecer, imagen de ambiente generada; no es su oficina).
import Pic from "@/kit/Pic.astro";
import type { Img } from "@/kit/types";
interface Props { title: string; lede: string; image: Img; imageAlt?: string; position?: string }
const { title, lede, image, imageAlt = "", position = "50% 50%" } = Astro.props;
---

<section class="relative isolate grid min-h-[100svh] overflow-hidden bg-(--c-brand) text-(--c-on-brand) lg:grid-cols-[1.05fr_0.95fr]">
  <div class="flex flex-col justify-center gap-0 px-5 pb-14 pt-36 sm:px-10 lg:pb-16 lg:pl-[max(2.5rem,calc((100vw-76rem)/2))] lg:pr-14">
    <h1 data-hero="blur" class="max-w-[14ch] text-[clamp(2.7rem,5.8vw,5.6rem)] font-medium leading-[1.02]">{title}</h1>
    <p data-hero style="--i:1" class="mt-7 max-w-[44ch] text-lg opacity-90 sm:text-xl">{lede}</p>
    <div data-hero style="--i:2" class="mt-10 flex flex-wrap items-center gap-3"><slot name="actions" /></div>
  </div>
  <div data-hero-media style="--d:150ms" class="relative min-h-[55svh] overflow-hidden lg:min-h-0">
    <Pic src={image} alt={imageAlt} priority position={position} class="absolute inset-0 size-full object-cover" />
  </div>
</section>
