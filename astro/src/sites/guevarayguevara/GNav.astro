---
// Copia de kit/Nav.astro con el nombre del despacho recompuesto junto al monograma y esquinas rectas.
import type { SiteConfig } from "@/kit/types";
import Icon from "@/kit/Icon.astro";
import GButton from "./GButton.astro";
import Wordmark from "./Wordmark.astro";

interface Props { site: SiteConfig }
const { site } = Astro.props;
const base = `/${site.slug}`;
const { links, cta } = site.nav;
---

<header data-nav data-root={base} data-tone="light" data-variant="pill" class="nav-shell group/nav fixed inset-x-0 top-0 z-50 px-3 pt-3 sm:px-5 sm:pt-4">
  <div class="nav-inner relative mx-auto flex max-w-[68rem] items-center justify-between gap-6 rounded-(--c-radius-nav,0px) py-2 pl-4 pr-2 backdrop-blur-xl sm:pl-5">
    <a href={base} class="shrink-0" aria-label={`${site.name}, inicio`} transition:name="logo">
      <Wordmark mark={site.logo.src} height={30} alt="" />
    </a>

    <nav aria-label="Principal" class="hidden items-center gap-1 lg:flex">
      {
        links.map((l) => (
          <a data-nav-link href={l.href} class="nav-link px-4 py-2 text-[15px] font-medium opacity-80 transition-[opacity,background-color] duration-200 hover:opacity-100 aria-[current=page]:opacity-100 aria-[current=page]:bg-current/8">
            {l.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      {cta && <div class="hidden sm:block"><GButton href={cta.href} class="nav-cta !h-11" external>{cta.label}</GButton></div>}
      <button data-nav-toggle type="button" aria-expanded="false" aria-controls="nav-panel" aria-label="Abrir menú" class="press grid size-11 place-items-center lg:hidden hover:bg-current/8">
        <Icon name="list" weight="bold" class="size-5 group-[.menu-open]/nav:hidden" />
        <Icon name="x" weight="bold" class="hidden size-5 group-[.menu-open]/nav:block" />
      </button>
    </div>

    <div id="nav-panel" data-nav-panel class="nav-panel absolute inset-x-0 top-[calc(100%+0.5rem)] overflow-hidden border border-(--c-line) bg-(--c-bg) p-3 text-(--c-ink) shadow-2xl lg:hidden">
      <ul class="grid">
        {
          links.map((l, i) => (
            <li>
              <a data-nav-link href={l.href} style={`--i:${i}`} class="flex items-center justify-between px-4 py-4 text-lg font-medium aria-[current=page]:bg-(--c-surface)">
                {l.label}
                <Icon name="arrow-right" weight="bold" class="size-4 opacity-40" />
              </a>
            </li>
          ))
        }
      </ul>
      {cta && <GButton href={cta.href} class="mt-3 w-full justify-between" external>{cta.label}</GButton>}
    </div>
  </div>
</header>

<style is:global>
  /* Radios del sitio: todo recto */
  html[data-site="guevarayguevara"] { --c-radius-nav: 0px; --c-radius-field: 0px; --c-radius-img: 0px; --c-radius-card: 0px; }
  html[data-site="guevarayguevara"] ::placeholder { color: var(--c-muted); opacity: 1; }
  [data-nav] .nav-inner { transition: background-color 300ms ease, color 300ms ease, box-shadow 300ms ease, border-color 300ms ease, padding 300ms ease; border: 1px solid transparent; }
  [data-nav][data-tone="light"] { color: var(--c-ink); }
  [data-nav][data-variant="pill"][data-tone="light"] .nav-inner { background: color-mix(in oklab, var(--c-bg) 74%, transparent); border-color: color-mix(in oklab, var(--c-ink) 10%, transparent); box-shadow: 0 8px 30px -12px rgb(7 21 40 / 0.2); }
  @supports not (backdrop-filter: blur(1px)) { [data-nav][data-variant="pill"] .nav-inner { background: var(--c-bg); } }
  @media (prefers-reduced-transparency: reduce) { [data-nav][data-variant="pill"] .nav-inner { background: var(--c-bg); color: var(--c-ink); backdrop-filter: none; } }
</style>
