---
// Cabecera de páginas interiores: título a la izquierda y la colonnata (foto cortada en tres columnas) apoyada en el zócalo.
import type { Img } from "@/kit/types";
import Colonnade from "./Colonnade.astro";
interface Props { title: string; lede?: string; image: Img; imageAlt: string; position?: string }
const { title, lede, image, imageAlt, position } = Astro.props;
---

<section class="relative isolate overflow-hidden border-b border-(--c-line) bg-(--c-bg) pt-36 text-(--c-ink) sm:pt-44">
  <div class="wrap grid items-end gap-10 lg:grid-cols-[1.1fr_0.9fr] lg:gap-14">
    <div class="lg:pb-16">
      <h1 data-hero="blur" class="max-w-[16ch] text-[clamp(2.6rem,6vw,5.4rem)] font-medium leading-[1.02] tracking-[-0.03em]">{title}</h1>
      {lede && <p data-hero style="--i:1" class="mt-6 max-w-[48ch] text-lg text-(--c-muted) sm:text-xl">{lede}</p>}
    </div>
    <Colonnade compact image={image} alt={imageAlt} position={position} />
  </div>
</section>
