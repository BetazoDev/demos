---
// Marca horizontal: el escudo con balanza y laureles original + el nombre en versalitas serif, como en su logo.
// El logo completo es casi cuadrado y de texto blanco: aquí se compone para la barra de navegación.
import { Image } from "astro:assets";
import mark from "./assets/mark.png";
import markOnLight from "./assets/mark-onlight.png";
interface Props { height?: number; tone?: "light" | "dark"; class?: string }
const { height = 40, tone = "light", class: cls = "" } = Astro.props;
const m = tone === "dark" ? mark : markOnLight;
const w = Math.round(height * (mark.width / mark.height));
---

<span class:list={["inline-flex items-center gap-3", cls]}>
  <Image src={m} alt="" width={w * 2} height={height * 2} layout="fixed" class="shrink-0" style={`height:${height}px;width:auto`} />
  <span class="grid leading-none" aria-hidden="true">
    <span class:list={["font-(family-name:--f-display) text-[14px] font-bold uppercase tracking-[0.1em]", tone === "dark" ? "text-(--c-on-dark)" : "text-(--c-brand)"]}>Lozano Guzmán</span>
    <span class:list={["mt-[5px] font-(family-name:--f-display) text-[10.5px] font-bold uppercase tracking-[0.34em]", tone === "dark" ? "text-[#FBB601]" : "text-(--c-accent)"]}>Abogados</span>
  </span>
  <span class="sr-only">Lozano Guzmán Abogados</span>
</span>
