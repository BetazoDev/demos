---
// Héroe de García & Escamilla: titular a la izquierda y foto a la derecha con un bloque azul desplazado detrás
// (el bloque se mueve con el scroll). Nav con tone="light".
import type { Img } from "@/kit/types";
import Pic from "@/kit/Pic.astro";
interface Props { title: string; lede?: string; image: Img; imageAlt?: string; position?: string }
const { title, lede, image, imageAlt = "", position = "50% 55%" } = Astro.props;
---

<section class="relative overflow-hidden bg-(--c-bg) text-(--c-ink)">
  <div class="wrap grid min-h-[100svh] items-center gap-14 pb-20 pt-36 lg:grid-cols-[1.1fr_0.9fr] lg:gap-20 lg:pb-12 lg:pt-32">
    <div>
      <h1 data-hero="blur" class="max-w-[19ch] text-[clamp(2.5rem,4.7vw,4.7rem)] font-medium leading-[1.04] tracking-[-0.025em]">{title}</h1>
      {lede && <p data-hero style="--i:1" class="mt-6 max-w-[40ch] text-lg text-(--c-muted) sm:text-xl">{lede}</p>}
      <div data-hero style="--i:2" class="mt-9 flex flex-wrap items-center gap-3">
        <slot name="actions" />
      </div>
    </div>
    <div class="relative mx-auto w-full max-w-[28rem] lg:ml-auto lg:mr-6">
      <div aria-hidden="true" data-drift class="absolute -bottom-5 -right-5 left-8 top-8 bg-(--c-brand) sm:-bottom-6 sm:-right-6"></div>
      <div data-hero-media style="--d:200ms" class="relative aspect-[4/5] max-h-[72svh] w-full overflow-hidden">
        <Pic src={image} alt={imageAlt} priority position={position} class="size-full object-cover" />
      </div>
    </div>
  </div>
</section>
