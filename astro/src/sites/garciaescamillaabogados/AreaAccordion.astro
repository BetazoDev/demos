---
// Servicios como acordeón nativo (<details>): cada área abre su lista real. El título lleva transition:name para viajar desde la home.
import Icon from "@/kit/Icon.astro";
import type { Area } from "./data";
interface Props { areas: Area[]; openFirst?: boolean }
const { areas, openFirst = true } = Astro.props;
---

<div class="divide-y divide-(--c-line) border-y border-(--c-line)">
  {
    areas.map((a, i) => (
      <details class="acc group scroll-mt-28" id={a.key} open={openFirst && i === 0}>
        <summary class="flex items-center justify-between gap-6 py-7 text-left">
          <h2 transition:name={`area-${a.key}`} class="text-[clamp(1.7rem,3.4vw,2.8rem)] font-medium leading-[1.05] tracking-[-0.02em]">{a.title}</h2>
          <span class="acc-plus grid size-11 shrink-0 place-items-center border border-current/25" aria-hidden="true">
            <svg width="12" height="12" viewBox="0 0 12 12"><path d="M6 1v10M1 6h10" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" fill="none" /></svg>
          </span>
        </summary>
        <div class="acc-body">
          <div>
            <div class="pb-10">
              {a.lead && <p class="max-w-[52ch] text-lg text-(--c-muted)">{a.lead}</p>}
              {a.items && (
                <ul class="grid max-w-4xl gap-x-12 gap-y-3 text-[17px] text-(--c-muted) sm:grid-cols-2">
                  {a.items.map((it) => (
                    <li class="flex gap-3">
                      <Icon name="check" weight="bold" class="mt-1.5 size-4 shrink-0 text-(--c-brand)" />
                      <span>{it}</span>
                    </li>
                  ))}
                </ul>
              )}
            </div>
          </div>
        </div>
      </details>
    ))
  }
</div>
