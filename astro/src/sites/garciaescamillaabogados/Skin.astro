---
// Piel de García & Escamilla: esquinas rectas, bloque azul que se desplaza detrás de la foto del héroe
// y apertura del acordeón de servicios según el ancla de la URL.
---

<style is:global>
  [data-site="garciaescamillaabogados"] {
    --c-radius-nav: 0px;
    --c-radius-img: 0px;
    --c-radius-card: 0px;
    --c-radius-field: 0px;
  }
  [data-site="garciaescamillaabogados"] :is(.arr, .nav-link, [data-nav-toggle], .acc-plus) {
    border-radius: 0;
  }
  /* El signo + del acordeón gira dentro de su caja cuadrada (la caja no rota) */
  [data-site="garciaescamillaabogados"] details.acc[open] .acc-plus {
    rotate: 0deg;
  }
  [data-site="garciaescamillaabogados"] details.acc .acc-plus svg {
    transition: rotate 260ms var(--ease-out);
  }
  [data-site="garciaescamillaabogados"] details.acc[open] .acc-plus svg {
    rotate: 45deg;
  }
  [data-site="garciaescamillaabogados"] [data-drift] {
    transform: translate3d(0, calc(var(--dy, 0) * 1px), 0);
    will-change: transform;
  }
</style>

<script>
  let cleanup: (() => void) | null = null;
  function init() {
    cleanup?.();
    cleanup = null;
    const hash = decodeURIComponent(location.hash.slice(1));
    if (hash) {
      const d = document.getElementById(hash);
      if (d instanceof HTMLDetailsElement) d.open = true;
    }
    const els = document.querySelectorAll<HTMLElement>("[data-drift]");
    if (!els.length || window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    let raf = 0;
    const update = () => {
      raf = 0;
      const vh = window.innerHeight;
      els.forEach((el) => {
        const host = el.parentElement ?? el;
        const r = host.getBoundingClientRect();
        if (r.bottom < -200 || r.top > vh + 200) return;
        const p = (r.top + r.height / 2 - vh / 2) / vh;
        el.style.setProperty("--dy", (p * -48).toFixed(1));
      });
    };
    const on = () => {
      if (!raf) raf = requestAnimationFrame(update);
    };
    window.addEventListener("scroll", on, { passive: true });
    window.addEventListener("resize", on);
    update();
    cleanup = () => {
      window.removeEventListener("scroll", on);
      window.removeEventListener("resize", on);
      if (raf) cancelAnimationFrame(raf);
    };
  }
  document.addEventListener("astro:page-load", init);
  document.addEventListener("astro:before-swap", () => {
    cleanup?.();
    cleanup = null;
  });
</script>
