---
// Servicios como pestañas de solo CSS (radios + :has): cada área muestra su consultoría preventiva y su litigio estratégico.
import Icon from "@/kit/Icon.astro";
import type { Area } from "./data";
interface Props { areas: Area[]; base: string }
const { areas, base } = Astro.props;
---

<fieldset class="svc-tabs grid gap-5 border-0 p-0 lg:grid-cols-[0.42fr_1fr] lg:gap-6">
  <legend class="sr-only">Áreas de servicio</legend>
  {areas.map((a, i) => <input type="radio" name="svc" id={`svc-${i}`} value={a.key} checked={i === 0} class="sr-only" />)}
  <div class="svc-list -mx-5 flex gap-2 overflow-x-auto px-5 pb-1 lg:mx-0 lg:grid lg:content-start lg:overflow-visible lg:px-0">
    {
      areas.map((a, i) => (
        <label for={`svc-${i}`} class="svc-label press flex shrink-0 cursor-pointer items-center gap-3 rounded-(--c-radius-card) border border-(--c-line) bg-(--c-bg) px-5 py-4 text-[17px] font-medium lg:gap-4 lg:py-5">
          <Icon name={a.icon} class="size-6 shrink-0" />
          <span class="whitespace-nowrap lg:whitespace-normal">{a.title}</span>
        </label>
      ))
    }
  </div>
  <div>
    {
      areas.map((a, i) => (
        <section data-panel={i} class="svc-panel rounded-(--c-radius-card) border border-(--c-line) bg-(--c-bg) p-7 sm:p-10">
          <h3 class="max-w-[24ch] text-[clamp(1.4rem,2.4vw,2rem)] font-semibold leading-tight tracking-[-0.03em]">{a.lead}</h3>
          <div class="mt-9 grid gap-9 md:grid-cols-2">
            <div>
              <h4 class="text-sm font-semibold text-(--c-muted)">Consultoría preventiva</h4>
              <ul class="mt-4 grid gap-2.5 text-[15.5px]">
                {a.consult.slice(0, 5).map((t) => <li class="flex gap-3"><Icon name="check" weight="bold" class="mt-1 size-4 shrink-0 text-(--c-brand)" /><span>{t}</span></li>)}
              </ul>
            </div>
            <div>
              <h4 class="text-sm font-semibold text-(--c-muted)">Litigio estratégico</h4>
              <ul class="mt-4 grid gap-2.5 text-[15.5px]">
                {a.litigate.slice(0, 5).map((t) => <li class="flex gap-3"><Icon name="gavel" class="mt-1 size-4 shrink-0 text-(--c-brand)" /><span>{t}</span></li>)}
              </ul>
            </div>
          </div>
          <a href={`${base}/servicios/${a.key}`} class="mt-9 inline-flex items-center gap-2 font-medium text-(--c-brand)"><span class="link-u">Ver {a.title}</span> <Icon name="arrow-up-right" weight="bold" class="size-4" /></a>
        </section>
      ))
    }
  </div>
</fieldset>

<style is:global>
  .svc-panel { display: none; }
  .svc-label { transition: background-color 220ms ease, color 220ms ease, border-color 220ms ease, transform 160ms var(--ease-out); }
  @media (hover: hover) { .svc-label:hover { border-color: var(--c-brand); } }
  .svc-tabs input:focus-visible ~ .svc-list .svc-label { outline: none; }
  @keyframes svc-in { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }
  .svc-tabs:has(#svc-0:checked) [data-panel="0"] { display: block; animation: svc-in 420ms var(--ease-out) both; }
  .svc-tabs:has(#svc-0:checked) label[for="svc-0"] { background: var(--c-brand); color: var(--c-on-brand); border-color: var(--c-brand); }
  .svc-tabs:has(#svc-0:focus-visible) label[for="svc-0"] { outline: 2px solid var(--c-accent); outline-offset: 3px; }
  .svc-tabs:has(#svc-1:checked) [data-panel="1"] { display: block; animation: svc-in 420ms var(--ease-out) both; }
  .svc-tabs:has(#svc-1:checked) label[for="svc-1"] { background: var(--c-brand); color: var(--c-on-brand); border-color: var(--c-brand); }
  .svc-tabs:has(#svc-1:focus-visible) label[for="svc-1"] { outline: 2px solid var(--c-accent); outline-offset: 3px; }
  .svc-tabs:has(#svc-2:checked) [data-panel="2"] { display: block; animation: svc-in 420ms var(--ease-out) both; }
  .svc-tabs:has(#svc-2:checked) label[for="svc-2"] { background: var(--c-brand); color: var(--c-on-brand); border-color: var(--c-brand); }
  .svc-tabs:has(#svc-2:focus-visible) label[for="svc-2"] { outline: 2px solid var(--c-accent); outline-offset: 3px; }
  .svc-tabs:has(#svc-3:checked) [data-panel="3"] { display: block; animation: svc-in 420ms var(--ease-out) both; }
  .svc-tabs:has(#svc-3:checked) label[for="svc-3"] { background: var(--c-brand); color: var(--c-on-brand); border-color: var(--c-brand); }
  .svc-tabs:has(#svc-3:focus-visible) label[for="svc-3"] { outline: 2px solid var(--c-accent); outline-offset: 3px; }
  @media (prefers-reduced-motion: reduce) { .svc-panel { animation: none !important; } }
</style>
