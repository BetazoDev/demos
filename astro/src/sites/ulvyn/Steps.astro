---
// Proceso en tres pasos sobre una línea que se traza con el scroll (transform: scaleX en escritorio, scaleY en móvil).
import Icon from "@/kit/Icon.astro";
interface Props { steps: { title: string; text: string }[] }
const { steps } = Astro.props;
const icons = ["calendar-check", "magnifying-glass", "scales"];
---

<ol data-steps class="steps relative grid gap-12 md:grid-cols-3 md:gap-10" style="--p:0">
  <span class="steps-track absolute bg-(--c-line)" aria-hidden="true"></span>
  <span class="steps-fill absolute bg-(--c-brand)" aria-hidden="true"></span>
  {
    steps.map((s, i) => (
      <li data-reveal data-delay={i * 120} class="relative pl-20 md:pl-0 md:pt-24">
        <span class="step-node absolute left-0 top-0 grid size-14 place-items-center rounded-(--c-radius) border border-(--c-line) bg-(--c-bg) text-(--c-brand) md:size-[3.75rem]">
          <Icon name={icons[i]} class="size-6" />
        </span>
        <h3 class="text-[clamp(1.3rem,2vw,1.6rem)] font-semibold tracking-[-0.025em]">{s.title}</h3>
        <p class="mt-3 max-w-[30ch] text-[17px] text-(--c-muted)">{s.text}</p>
      </li>
    ))
  }
</ol>

<style>
  .steps-track, .steps-fill { left: 1.75rem; top: 1.75rem; bottom: 1.75rem; width: 2px; }
  .steps-fill { transform-origin: top; transform: scaleY(var(--p)); }
  @media (min-width: 768px) {
    .steps-track, .steps-fill { left: 1.875rem; right: calc(33.333% + 0rem); top: 1.875rem; bottom: auto; width: auto; height: 2px; }
    .steps-track { right: 1.875rem; }
    .steps-fill { right: 1.875rem; transform-origin: left; transform: scaleX(var(--p)); }
  }
  @media (prefers-reduced-motion: reduce) { .steps-fill { transform: none; } }
</style>

<script>
  let off: (() => void) | null = null;
  const init = () => {
    off?.();
    const el = document.querySelector<HTMLElement>("[data-steps]");
    if (!el || matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    let raf = 0;
    const update = () => {
      raf = 0;
      const r = el.getBoundingClientRect();
      const vh = innerHeight;
      const p = Math.min(1, Math.max(0, (vh * 0.8 - r.top) / (Math.min(r.height, vh * 0.55) + 40)));
      el.style.setProperty("--p", p.toFixed(3));
    };
    const onScroll = () => { if (!raf) raf = requestAnimationFrame(update); };
    addEventListener("scroll", onScroll, { passive: true });
    addEventListener("resize", onScroll);
    update();
    off = () => { removeEventListener("scroll", onScroll); removeEventListener("resize", onScroll); if (raf) cancelAnimationFrame(raf); off = null; };
  };
  document.addEventListener("astro:page-load", init);
  document.addEventListener("astro:before-swap", () => off?.());
</script>
