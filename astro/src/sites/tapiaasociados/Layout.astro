---
// Envoltorio de SiteLayout con los valores propios de este sitio: nav y pie con el nombre junto a la insignia,
// radios de un solo sistema (6px) y ajustes de la tipografía display.
import SiteLayout from "@/kit/SiteLayout.astro";
import Nav from "./Nav.astro";
import Footer from "./Footer.astro";
import { site } from "./site";
interface Props {
  title: string;
  description?: string;
  breadcrumbs?: { name: string; href: string }[];
  schema?: Record<string, unknown>[];
  nav?: { variant?: "pill" | "bar"; tone?: "light" | "dark"; logoHeight?: number };
  footer?: { variant?: "dark" | "light" | "brand"; blurb?: string };
}
const { nav, footer, ...rest } = Astro.props;
---

<SiteLayout site={site} nav={false} footer={false} {...rest}>
  <Nav slot="nav" site={site} variant="pill" tone="light" logoHeight={46} {...nav} />
  <slot />
  <Footer slot="footer" site={site} variant="dark" {...footer} />
</SiteLayout>

<style is:global>
  [data-site="tapiaasociados"] {
    --c-radius-nav: 12px;
    --c-radius-img: 6px;
    --c-radius-card: 6px;
    --c-radius-field: 6px;
  }
  [data-site="tapiaasociados"] :is(h1, h2, h3) { font-weight: 400; letter-spacing: -0.01em; }
  [data-site="tapiaasociados"] [data-statement] { font-weight: 400; letter-spacing: -0.012em; }
  [data-site="tapiaasociados"] main :is(.opacity-60, .opacity-65) { opacity: 0.78; }
  [data-site="tapiaasociados"] main a.break-all { word-break: normal; overflow-wrap: anywhere; font-size: clamp(0.85rem, 3.7vw, 1.0625rem); }
</style>
