---
// Áreas como títulos grandes sin líneas divisorias. El título morfa a su página (area-<key>).
import Icon from "@/kit/Icon.astro";
interface Row { key: string; title: string; text?: string; href: string }
interface Props { areas: Row[]; class?: string }
const { areas, class: cls = "" } = Astro.props;
---

<ul data-stagger data-gap="70" class:list={["grid gap-2", cls]}>
  {areas.map((a) => (
    <li>
      <a href={a.href} data-area={a.title} class="group grid grid-cols-[1fr_auto] items-center gap-6 rounded-(--c-radius) py-5 sm:py-6">
        <div>
          <h3 transition:name={`area-${a.key}`} class="text-[clamp(1.7rem,3.2vw,2.8rem)] leading-[1.06] tracking-[-0.02em] transition-transform duration-500 ease-(--ease-out) group-hover:translate-x-2">{a.title}</h3>
          {a.text && <p class="mt-3 line-clamp-2 max-w-[52ch] text-[15px] leading-relaxed text-(--c-muted) sm:text-base">{a.text}</p>}
        </div>
        <span class="arr grid size-12 shrink-0 place-items-center rounded-full border border-current/25 transition-[background-color,color,border-color] duration-300 group-hover:border-transparent group-hover:bg-(--c-accent) group-hover:text-(--c-on-accent)">
          <Icon name="arrow-up-right" weight="bold" class="size-5" />
        </span>
      </a>
    </li>
  ))}
</ul>
