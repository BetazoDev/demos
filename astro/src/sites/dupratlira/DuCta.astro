---
// Cierre de página: frase y un solo botón sobre mármol azul marino.
import Pic from "@/kit/Pic.astro";
import DuButton from "./DuButton.astro";
import marble from "./assets/marmol.jpg";
interface Props { title: string; href: string; label: string }
const { title, href, label } = Astro.props;
---

<section class="relative isolate overflow-hidden bg-(--c-dark) text-(--c-on-dark) section-y">
  <div aria-hidden="true" class="absolute inset-0 -z-10 opacity-90"><Pic src={marble} alt="" class="size-full object-cover" /></div>
  <div class="wrap grid items-end gap-10 lg:grid-cols-[1fr_auto]">
    <div data-reveal>
      <span class="rule mb-8 !bg-(--du-gold-hi)"></span>
      <h2 class="max-w-[18ch] text-[clamp(2.3rem,5.2vw,4.6rem)] leading-[1.04]">{title}</h2>
    </div>
    <div data-reveal data-delay="120"><DuButton href={href} variant="gold" size="lg" external>{label}</DuButton></div>
  </div>
</section>
