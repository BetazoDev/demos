---
// Héroe propio de Duprat Lira: titular en serif sobre papel, y los dos retratos de sus abogados sobre un panel de mármol azul marino
// con un filete dorado vertical (eco del filete de su logo). Los retratos se mueven en sentidos opuestos con el scroll.
import Pic from "@/kit/Pic.astro";
import type { ImageMetadata } from "astro";
interface Props { title: string; lede: string; marble: ImageMetadata; left: ImageMetadata; leftAlt: string; right: ImageMetadata; rightAlt: string }
const { title, lede, marble, left, leftAlt, right, rightAlt } = Astro.props;
---

<section class="relative isolate overflow-hidden bg-(--c-bg) text-(--c-ink)">
  <div aria-hidden="true" class="absolute inset-y-0 right-0 -z-10 hidden w-[52%] bg-(--c-dark) lg:block">
    <Pic src={marble} alt="" priority class="size-full object-cover" />
    <span class="absolute inset-y-0 left-0 w-px bg-(--du-gold) origin-top" data-hero-line></span>
  </div>
  <div class="wrap grid min-h-[100svh] items-center gap-14 pb-16 pt-36 lg:grid-cols-[1fr_1.05fr] lg:gap-14 lg:pb-14 lg:pt-32">
    <div>
      <h1 data-hero="blur" class="text-[clamp(2.6rem,4.05vw,4.4rem)] font-medium leading-[1.04]">{title}</h1>
      <p data-hero style="--i:1" class="mt-7 max-w-[40ch] text-lg text-(--c-muted) sm:text-xl">{lede}</p>
      <div data-hero style="--i:2" class="mt-9 flex flex-wrap items-center gap-3">
        <slot name="actions" />
      </div>
    </div>
    <div class="relative -mx-5 bg-(--c-dark) px-5 py-12 sm:-mx-10 sm:px-10 lg:mx-0 lg:-mr-[max(2.5rem,calc((100vw-76rem)/2))] lg:bg-transparent lg:py-0 lg:pl-0 lg:pr-[max(2.5rem,calc((100vw-76rem)/2))]">
      <Pic src={marble} alt="" class="absolute inset-0 -z-10 size-full object-cover lg:hidden" />
      <div class="mx-auto grid max-w-[34rem] grid-cols-2 gap-5 sm:gap-7 lg:max-w-none">
        <div class="relative aspect-[3/4] outline outline-1 outline-offset-[10px] outline-(--du-gold)/70">
          <div data-hero-media style="--d:150ms" class="size-full overflow-hidden"><div class="size-full" data-parallax="46"><Pic src={left} alt={leftAlt} priority position="50% 30%" class="size-full object-cover" /></div></div>
        </div>
        <div class="relative mt-10 aspect-[3/4] outline outline-1 outline-offset-[10px] outline-(--du-gold)/70 sm:mt-16">
          <div data-hero-media style="--d:380ms" class="size-full overflow-hidden"><div class="size-full" data-parallax="-40"><Pic src={right} alt={rightAlt} priority position="50% 28%" class="size-full object-cover" /></div></div>
        </div>
      </div>
    </div>
  </div>
</section>

<style is:global>
  @keyframes du-line { from { transform: scaleY(0); } to { transform: scaleY(1); } }
  [data-hero-line] { animation: du-line 1.4s var(--ease-in-out) 0.2s both; }
  @media (prefers-reduced-motion: reduce) { [data-hero-line] { animation: none; } }
</style>
