---
// Reseñas de Google: una cita principal grande y dos más pequeñas con filete dorado. Autor tal como aparece en Google.
interface Props { rating: number; count: number; quotes: { text: string; author: string }[] }
const { rating, count, quotes } = Astro.props;
const [main, ...rest] = quotes;
---

<div>
  <p class="flex flex-wrap items-baseline gap-x-5 gap-y-1">
    <span data-count={rating.toFixed(1)} class="text-[clamp(4rem,9vw,7.5rem)] leading-none tabular-nums" style="font-family: var(--f-display)">{rating.toFixed(1)}</span>
    <span class="text-lg text-(--c-muted)">en Google, {count} reseñas</span>
  </p>
  <div class="mt-12 grid gap-12 lg:grid-cols-[1.25fr_0.75fr] lg:gap-20">
    <figure data-reveal class="m-0">
      <span class="rule mb-8"></span>
      <blockquote class="text-[clamp(1.5rem,2.6vw,2.2rem)] leading-[1.3]" style="font-family: var(--f-display)">“{main.text}”</blockquote>
      <figcaption class="mt-6 text-[15px] text-(--c-muted)">{main.author}</figcaption>
    </figure>
    <ul data-stagger data-gap="120" class="grid content-start gap-10">
      {
        rest.map((q) => (
          <li class="border-t border-(--du-gold) pt-6">
            <blockquote class="text-[17px] leading-relaxed">“{q.text}”</blockquote>
            <p class="mt-4 text-[15px] text-(--c-muted)">{q.author}</p>
          </li>
        ))
      }
    </ul>
  </div>
</div>
