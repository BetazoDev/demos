---
// Héroe propio: titular enorme sobre la estatua (foto del sitio, espejada para dejar el texto en el lado vacío).
import type { Img } from "@/kit/types";
import Pic from "@/kit/Pic.astro";
interface Props { title: string; lede?: string; image: Img; imageAlt?: string; position?: string }
const { title, lede, image, imageAlt = "", position = "50% 40%" } = Astro.props;
---

<section class="relative isolate flex min-h-[100svh] flex-col justify-end overflow-hidden bg-(--c-dark) text-(--c-on-dark)">
  <div class="absolute inset-0 -z-10" data-hero-media style="--d:0ms">
    <div class="size-full" data-parallax="60">
      <div class="size-full" style="transform:scaleX(-1)">
        <Pic src={image} alt={imageAlt} priority position={position} class="size-full object-cover" />
      </div>
    </div>
    <div class="absolute inset-0 bg-[linear-gradient(to_right,var(--c-dark)_0%,color-mix(in_oklab,var(--c-dark)_88%,transparent)_34%,color-mix(in_oklab,var(--c-dark)_20%,transparent)_70%,transparent_100%)] max-lg:bg-[linear-gradient(to_top,var(--c-dark)_10%,color-mix(in_oklab,var(--c-dark)_60%,transparent)_70%,color-mix(in_oklab,var(--c-dark)_30%,transparent)_100%)]"></div>
    <div class="absolute inset-x-0 bottom-0 h-1/3 bg-[linear-gradient(to_top,var(--c-dark),transparent)]"></div>
  </div>
  <div class="wrap pb-14 pt-40 sm:pb-20">
    <h1 data-hero="blur" class="max-w-[9ch] text-[clamp(3.6rem,10.5vw,10rem)] font-semibold leading-[0.9] tracking-[-0.05em]">{title}</h1>
    {lede && <p data-hero style="--i:1" class="mt-8 max-w-[42ch] text-lg opacity-90 sm:text-xl">{lede}</p>}
    <div data-hero style="--i:2" class="mt-9 flex flex-wrap items-center gap-3">
      <slot name="actions" />
    </div>
  </div>
</section>
