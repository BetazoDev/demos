---
// Héroe split propio: texto a la izquierda, foto generada a sangre a la derecha fundida con el fondo.
import Pic from "@/kit/Pic.astro";
import type { Img } from "@/kit/types";
interface Props { title: string; lede: string; image: Img; imageAlt?: string; position?: string }
const { title, lede, image, imageAlt = "", position } = Astro.props;
---

<section class="tt-hero">
  <div class="tt-hero-grid">
    <div class="tt-hero-copy">
      <h1 data-hero="blur" class="max-w-[18ch] text-[clamp(2.5rem,4.7vw,5rem)] font-normal leading-[1.04] tracking-[-0.03em]">{title}</h1>
      <p data-hero style="--i:1" class="mt-7 max-w-[44ch] text-lg text-(--c-muted) sm:text-xl">{lede}</p>
      <div data-hero style="--i:2" class="mt-9 flex flex-wrap items-center gap-3"><slot name="actions" /></div>
    </div>
    <div class="tt-hero-media" data-hero-media style="--d:200ms">
      <div class="absolute inset-0" data-parallax="40"><Pic src={image} alt={imageAlt} priority position={position} class="size-full object-cover" /></div>
    </div>
  </div>
</section>
