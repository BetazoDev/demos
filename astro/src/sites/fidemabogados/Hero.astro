---
// Héroe propio: foto generada de ambiente (cuenco reparado con kintsugi) a sangre, volteada para que el cuenco quede a la derecha
// y el titular sobre el muro oscuro. Variante de kit/Hero.astro (layout "photo").
import type { Img } from "@/kit/types";
import Pic from "@/kit/Pic.astro";
interface Props { title: string; lede?: string; image: Img; imageAlt?: string }
const { title, lede, image, imageAlt = "" } = Astro.props;
---

<section class="relative isolate flex min-h-[100svh] flex-col justify-end overflow-hidden bg-(--c-dark) text-(--c-on-dark)">
  <div class="absolute inset-x-0 top-0 -z-10 h-[60%] lg:inset-0 lg:h-auto" data-hero-media style="--d:0ms">
    <div class="size-full -scale-x-100 [&_img]:!object-[22%_60%] lg:[&_img]:!object-[70%_60%]" data-parallax="50">
      <Pic src={image} alt={imageAlt} priority position="70% 60%" class="size-full object-cover" />
    </div>
    <div class="absolute inset-0 bg-[linear-gradient(to_top,rgba(12,15,17,1)_0%,rgba(12,15,17,0.2)_55%,rgba(12,15,17,0)_100%)] lg:bg-[linear-gradient(to_right,rgba(12,15,17,0.9)_0%,rgba(12,15,17,0.55)_42%,rgba(12,15,17,0)_72%),linear-gradient(to_top,rgba(12,15,17,0.7)_0%,rgba(12,15,17,0)_45%)]"></div>
  </div>
  <div class="wrap pb-14 pt-40 sm:pb-20">
    <h1 data-hero="blur" class="max-w-[14ch] text-[clamp(2.8rem,7vw,6.8rem)] font-medium leading-[0.98] tracking-[-0.03em]">{title}</h1>
    {lede && <p data-hero style="--i:1" class="mt-7 max-w-[42ch] text-lg text-(--c-on-dark)/85 sm:text-xl">{lede}</p>}
    <div data-hero style="--i:2" class="mt-9 flex flex-wrap items-center gap-3">
      <slot name="actions" />
    </div>
  </div>
</section>
