---
// Héroe propio: foto generada a la izquierda en marco alto de 8px, titular (su lema) a la derecha.
import Pic from "@/kit/Pic.astro";
import type { Img } from "@/kit/types";
interface Props { title: string; lede: string; image: Img; imageAlt?: string; position?: string }
const { title, lede, image, imageAlt = "", position } = Astro.props;
---

<section class="cd-hero">
  <div class="wrap grid min-h-[100svh] items-center gap-10 pb-14 pt-32 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] lg:gap-20 lg:pt-28">
    <div class="cd-photo order-2 lg:order-1" data-hero-media style="--d:150ms"><Pic src={image} alt={imageAlt} priority position={position} class="size-full object-cover" /></div>
    <div class="order-1 lg:order-2">
      <h1 data-hero="blur" class="max-w-[13ch] text-[clamp(2.8rem,6.4vw,6.4rem)] font-semibold leading-[1] tracking-[-0.03em]">{title}</h1>
      <p data-hero style="--i:1" class="mt-7 max-w-[40ch] text-lg text-(--c-muted) sm:text-xl">{lede}</p>
      <div data-hero style="--i:2" class="mt-9 flex flex-wrap items-center gap-3"><slot name="actions" /></div>
    </div>
  </div>
</section>
