---
// Áreas en una retícula irregular de 12 columnas: cuatro tarjetas con foto (7|5, 5|7) y una banda de color para la última.
import Pic from "@/kit/Pic.astro";
import Icon from "@/kit/Icon.astro";
import type { Area } from "./data";
interface Props { areas: Area[]; base: string }
const { areas, base } = Astro.props;
const photoAreas = areas.filter((a) => a.image).slice(0, 4);
const last = areas.find((a) => !a.image)!;
const spans = ["lg:col-span-7", "lg:col-span-5", "lg:col-span-5", "lg:col-span-7"];
---

<ul data-stagger data-gap="80" class="grid gap-4 lg:grid-cols-12">
  {photoAreas.map((a, i) => (
    <li class:list={["min-w-0", spans[i]]}>
      <a href={`${base}/servicios/${a.key}`} class="img-zoom group relative isolate flex min-h-[24rem] flex-col justify-end overflow-hidden rounded-(--c-radius-img) bg-(--c-dark) p-7 text-white sm:min-h-[28rem] sm:p-9">
        <div class="absolute inset-0 -z-10"><Pic src={a.image!} alt="" position={a.position} class="size-full object-cover" /></div>
        <div class="absolute inset-0 -z-10 bg-[linear-gradient(to_top,rgb(20_16_14/0.86),rgb(20_16_14/0.1)_70%)]"></div>
        <div class="flex items-end justify-between gap-6">
          <div>
            <h3 transition:name={`area-${a.key}`} class="text-[clamp(1.7rem,3vw,2.6rem)] font-medium leading-[1.05] tracking-[-0.025em]">{a.title}</h3>
            <p class="mt-3 line-clamp-2 max-w-[38ch] text-[15px] opacity-85">{a.short}</p>
          </div>
          <span class="arr hidden size-12 shrink-0 place-items-center rounded-full bg-(--c-brand) text-(--c-on-brand) sm:grid"><Icon name="arrow-up-right" weight="bold" class="size-5" /></span>
        </div>
      </a>
    </li>
  ))}
  <li class="lg:col-span-12">
    <a href={`${base}/servicios/${last.key}`} class="group flex flex-col justify-between gap-8 rounded-(--c-radius-img) bg-(--c-brand) p-7 text-(--c-on-brand) sm:p-10 md:flex-row md:items-end">
      <div>
        <h3 transition:name={`area-${last.key}`} class="text-[clamp(1.9rem,3.6vw,3.2rem)] font-medium leading-[1.04] tracking-[-0.03em]">{last.title}</h3>
        <p class="mt-3 max-w-[52ch] text-lg opacity-85">{last.short}</p>
      </div>
      <span class="arr grid size-14 shrink-0 place-items-center rounded-full bg-(--c-on-brand) text-(--c-brand) transition-transform duration-300 ease-(--ease-out) group-hover:translate-x-1"><Icon name="arrow-right" weight="bold" class="size-5" /></span>
    </a>
  </li>
</ul>
