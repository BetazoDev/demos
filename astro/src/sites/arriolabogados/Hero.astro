---
// Héroe propio de Arriola Abogados: titular a la izquierda y la foto panorámica de la firma debajo, que se amplía al hacer scroll.
import Pic from "@/kit/Pic.astro";
import type { Img } from "@/kit/types";
interface Props { title: string; lede?: string; image: Img; imageAlt?: string; position?: string }
const { title, lede, image, imageAlt = "", position } = Astro.props;
---

<section class="relative overflow-hidden bg-(--c-bg) text-(--c-ink)">
  <div class="wrap pt-36 sm:pt-44">
    <h1 data-hero="blur" class="max-w-[20ch] text-[clamp(2.4rem,5.5vw,5.3rem)] font-medium leading-[1] tracking-[-0.035em]">{title}</h1>
    <div class="mt-9 grid items-end gap-8 lg:grid-cols-[1fr_auto] lg:gap-16">
      {lede && <p data-hero style="--i:1" class="max-w-[48ch] text-lg text-(--c-muted) sm:text-xl">{lede}</p>}
      <div data-hero style="--i:2" class="flex flex-wrap items-center gap-3">
        <slot name="actions" />
      </div>
    </div>
  </div>
  <div class="wrap pb-14 pt-12 sm:pb-24 sm:pt-16">
    <div data-pano class="pano">
      <div data-hero-media style="--d:350ms" class="aspect-[16/9] overflow-hidden rounded-(--c-radius-img,1.5rem) sm:aspect-[1600/750]">
        <Pic src={image} alt={imageAlt} priority position={position} class="size-full object-cover" />
      </div>
    </div>
  </div>
</section>

<style>
  .pano { transform: scale(var(--s, 0.92)); transform-origin: 50% 0; will-change: transform; }
  @media (prefers-reduced-motion: reduce) { .pano { transform: none; } }
</style>

<script>
  let off: (() => void) | null = null;
  function init() {
    off?.();
    off = null;
    const el = document.querySelector<HTMLElement>("[data-pano]");
    if (!el || matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    let queued = false;
    const update = () => {
      queued = false;
      const top = el.getBoundingClientRect().top;
      const vh = window.innerHeight;
      const p = Math.min(1, Math.max(0, (vh * 0.95 - top) / (vh * 0.6)));
      el.style.setProperty("--s", (0.9 + 0.1 * p).toFixed(4));
    };
    const onScroll = () => {
      if (!queued) { queued = true; requestAnimationFrame(update); }
    };
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll, { passive: true });
    update();
    off = () => { window.removeEventListener("scroll", onScroll); window.removeEventListener("resize", onScroll); };
  }
  document.addEventListener("astro:page-load", init);
  document.addEventListener("astro:before-swap", () => { off?.(); off = null; });
</script>
