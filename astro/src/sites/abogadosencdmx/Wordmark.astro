---
// Logo compuesto: el sitio actual no tiene archivo de logo. Isotipo (columnas en recuadro, cobre) + nombre en Prata + «Despacho jurídico».
import mark from "./assets/mark.svg";
interface Props { size?: number; class?: string }
const { size = 44, class: cls = "" } = Astro.props;
---

<span class:list={["inline-flex items-center gap-3", cls]}>
  <img src={mark.src} alt="" width={size} height={size} style={`width:${size}px;height:${size}px;max-width:none`} />
  <span class="grid leading-none">
    <span class="font-(family-name:--f-display) text-[1.3rem] tracking-[0.005em]" style={`font-size:${size * 0.5}px`}>Abogados en CDMX</span>
    <span class="mt-[0.4em] text-[10px] font-semibold uppercase tracking-[2px] text-(--c-accent)">Despacho jurídico</span>
  </span>
</span>
