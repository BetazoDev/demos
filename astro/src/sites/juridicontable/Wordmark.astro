---
// Marca solo tipográfica: el logo del despacho no se recuperó (Wayback no conserva GRUPO-2.png). Se compone el nombre
// con la tipografía display del sitio, sobre dos líneas. Nada de símbolo ni ornamento inventado.
interface Props { size?: "sm" | "md" | "lg"; class?: string }
const { size = "md", class: cls = "" } = Astro.props;
const sizes = { sm: "text-[0.95rem]", md: "text-[1.05rem]", lg: "text-[1.35rem]" };
---

<span class:list={["inline-block font-(family-name:--f-display) leading-[1.12] tracking-[0.005em]", sizes[size], cls]}>
  <span class="block">Grupo de Abogados,</span>
  <span class="block">Contadores &amp; Consultores</span>
</span>
