---
// Banda de foto B/N de su sitio, teñida con el azul de la marca (igual que el héroe), con parallax suave y una frase real encima.
import Pic from "@/kit/Pic.astro";
import type { Img } from "@/kit/types";
interface Props { image: Img; alt?: string; position?: string; height?: string; class?: string }
const { image, alt = "", position, height = "clamp(20rem,50vw,34rem)", class: cls = "" } = Astro.props;
---

<div class:list={["relative isolate overflow-hidden bg-(--c-dark) text-(--c-on-dark)", cls]} style={`height:${height}`}>
  <div class="absolute inset-0 -z-10">
    <div class="size-full" data-parallax="60"><Pic src={image} alt={alt} position={position} class="size-full object-cover" /></div>
    <div class="absolute inset-0" style="background:#0e4d8f;mix-blend-mode:multiply"></div>
    <div class="absolute inset-0 bg-[linear-gradient(to_top,color-mix(in_oklab,var(--c-dark)_70%,transparent),transparent_75%)]"></div>
  </div>
  <div class="wrap flex h-full items-end pb-10"><slot /></div>
</div>
