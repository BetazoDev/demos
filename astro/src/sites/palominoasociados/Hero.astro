---
// Héroe propio sobre papel: titular enorme y la pluma con rúbrica (el vector original del logo) que se «escribe» al cargar.
import Pic from "@/kit/Pic.astro";
import mark from "./assets/mark.svg";
interface Props { title: string; lede?: string }
const { title, lede } = Astro.props;
---

<section class="relative isolate overflow-hidden bg-(--c-bg) text-(--c-ink)">
  <div class="pointer-events-none absolute right-[5%] top-[6.5rem] -z-10 w-[60vw] max-w-[28rem] sm:right-[1%] sm:top-[7.5rem] sm:w-[33vw] sm:max-w-[34rem]" aria-hidden="true">
    <div class="write">
      <img src={mark.src} alt="" width="760" height="645" class="h-auto w-full" />
    </div>
  </div>
  <div class="wrap flex min-h-[100svh] flex-col justify-end gap-10 pb-14 pt-40 sm:pb-20">
    <h1 data-hero="blur" class="max-w-[19ch] text-[clamp(2.6rem,6vw,6.2rem)] font-medium leading-[1] tracking-[-0.03em]">{title}</h1>
    <div class="grid items-end gap-8 lg:grid-cols-[1fr_auto]">
      {lede && <p data-hero style="--i:1" class="max-w-[40ch] text-lg text-(--c-muted) sm:text-xl">{lede}</p>}
      <div data-hero style="--i:2" class="flex flex-wrap items-center gap-3">
        <slot name="actions" />
      </div>
    </div>
  </div>
</section>

<style>
  .write { animation: write 2s var(--ease-in-out) 350ms both; }
  @keyframes write { from { clip-path: inset(0 100% 0 0); } to { clip-path: inset(0 0 0 0); } }
  @media (prefers-reduced-motion: reduce) { .write { animation: none; } }
</style>
