---
// Héroe propio: titular enorme sobre papel y, debajo, la foto del equipo del despacho que se amplía al hacer scroll
// (solo transform; sin movimiento si se pide reducirlo). Variante de kit/Hero.astro (layout "type", sin campo de color).
import type { Img } from "@/kit/types";
import Pic from "@/kit/Pic.astro";
interface Props { title: string; lede?: string; image: Img; imageAlt?: string }
const { title, lede, image, imageAlt = "" } = Astro.props;
---

<section class="relative bg-(--c-bg) text-(--c-ink)">
  <div class="wrap pt-36 sm:pt-44">
    <h1 data-hero="blur" class="max-w-[17ch] text-[clamp(2.9rem,7.6vw,7.8rem)] font-medium leading-[0.98] tracking-[-0.02em]">{title}</h1>
    <div class="mt-10 grid items-end gap-8 lg:grid-cols-[1fr_auto] lg:gap-16">
      {lede && <p data-hero style="--i:1" class="max-w-[46ch] text-lg text-(--c-muted) sm:text-xl">{lede}</p>}
      <div data-hero style="--i:2" class="flex flex-wrap items-center gap-3">
        <slot name="actions" />
      </div>
    </div>
  </div>
  <div class="wrap pb-14 pt-14 sm:pb-20 sm:pt-16">
    <div data-expand data-hero-media style="--d:350ms" class="expand-frame aspect-[4/3] overflow-hidden rounded-[1.5rem] bg-(--c-surface) sm:aspect-[16/9]">
      <Pic src={image} alt={imageAlt} priority position="40% 40%" class="size-full object-cover" />
    </div>
  </div>
</section>

<style is:global>
  .expand-frame { transform: scale(calc(0.9 + 0.1 * var(--p, 1))); transform-origin: 50% 0; will-change: transform; }
  @media (prefers-reduced-motion: reduce) { .expand-frame { transform: none; } }
</style>

<script>
  let off: (() => void) | undefined;
  const init = () => {
    off?.();
    off = undefined;
    const el = document.querySelector<HTMLElement>("[data-expand]");
    if (!el || matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    let raf = 0;
    const upd = () => {
      raf = 0;
      const r = el.getBoundingClientRect();
      const p = Math.min(1, Math.max(0, (innerHeight - r.top) / (innerHeight * 0.95)));
      el.style.setProperty("--p", p.toFixed(3));
    };
    const on = () => { if (!raf) raf = requestAnimationFrame(upd); };
    addEventListener("scroll", on, { passive: true });
    addEventListener("resize", on);
    upd();
    off = () => {
      removeEventListener("scroll", on);
      removeEventListener("resize", on);
      if (raf) cancelAnimationFrame(raf);
    };
  };
  document.addEventListener("astro:page-load", init);
  document.addEventListener("astro:before-swap", () => { off?.(); off = undefined; });
</script>
