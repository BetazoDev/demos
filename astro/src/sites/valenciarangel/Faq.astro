---
// Preguntas frecuentes con <details> nativo (apertura animada del kit). Respuestas de uno o varios párrafos y lista opcional.
interface Item { q: string; p?: string[]; ul?: string[] }
interface Props { items: Item[]; class?: string }
const { items, class: cls = "" } = Astro.props;
---

<div class:list={["divide-y divide-current/15 border-y border-current/15", cls]}>
  {
    items.map((it) => (
      <details class="acc group">
        <summary class="flex items-center justify-between gap-6 py-6 text-left text-[clamp(1.15rem,2vw,1.5rem)] leading-snug" style="font-family:var(--f-display)">
          {it.q}
          <span class="acc-plus grid size-9 shrink-0 place-items-center rounded-full border border-current/25" aria-hidden="true">
            <svg width="12" height="12" viewBox="0 0 12 12"><path d="M6 1v10M1 6h10" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" fill="none" /></svg>
          </span>
        </summary>
        <div class="acc-body">
          <div class="max-w-[66ch] pb-7 text-[17px] leading-relaxed text-(--c-muted)">
            {it.p?.map((t) => <p class="mb-4 last:mb-0">{t}</p>)}
            {it.ul && <ul class="mt-4 grid gap-2">{it.ul.map((t) => <li class="flex gap-3"><span aria-hidden="true" class="mt-[0.7em] h-px w-4 shrink-0 bg-(--c-accent)"></span><span>{t}</span></li>)}</ul>}
          </div>
        </div>
      </details>
    ))
  }
</div>
