---
// Héroe propio: titular a la izquierda y dos cápsulas de foto a la derecha (sistema de radio total del sitio).
// Firma de movimiento: las cápsulas se desfasan al hacer scroll (la grande sube despacio, la pequeña más rápido).
import type { Img } from "@/kit/types";
import Pic from "@/kit/Pic.astro";
interface Props { title: string; lede?: string; big: Img; bigAlt?: string; bigPosition?: string; small: Img; smallAlt?: string; smallPosition?: string }
const { title, lede, big, bigAlt = "", bigPosition = "50% 50%", small, smallAlt = "", smallPosition = "50% 50%" } = Astro.props;
---

<section class="relative isolate overflow-hidden bg-(--c-bg) text-(--c-ink)">
  <div class="wrap grid min-h-[100svh] items-center gap-12 pb-16 pt-32 lg:grid-cols-[1.08fr_0.92fr] lg:gap-10 lg:pb-14">
    <div class="relative z-10">
      <h1 data-hero="blur" class="max-w-[21ch] text-[clamp(2.5rem,4.6vw,4.7rem)] leading-[1.04]">{title}</h1>
      {lede && <p data-hero style="--i:1" class="mt-7 max-w-[40ch] text-lg text-(--c-muted) sm:text-xl">{lede}</p>}
      <div data-hero style="--i:2" class="mt-9 flex flex-wrap items-center gap-3">
        <slot name="actions" />
      </div>
    </div>
    <div class="relative mx-auto h-[31rem] w-full max-w-[26rem] sm:h-[38rem] sm:max-w-[32rem] lg:h-[41rem] lg:max-w-none">
      <div data-cap="0.045" class="absolute right-[2%] top-0 h-[88%] w-[62%] will-change-transform">
        <div data-hero-media style="--d:150ms" class="size-full overflow-hidden rounded-[999px]">
          <Pic src={big} alt={bigAlt} priority position={bigPosition} class="size-full object-cover" />
        </div>
      </div>
      <div data-cap="-0.11" class="absolute bottom-0 left-[0%] h-[50%] w-[40%] rounded-[999px] bg-(--c-bg) p-2.5 will-change-transform sm:p-3">
        <div data-hero-media style="--d:420ms" class="size-full overflow-hidden rounded-[999px]">
          <Pic src={small} alt={smallAlt} position={smallPosition} class="size-full object-cover" />
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  let off: (() => void) | undefined;
  function init() {
    off?.();
    const caps = Array.from(document.querySelectorAll<HTMLElement>("[data-cap]"));
    if (!caps.length || window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    let raf = 0;
    const update = () => {
      raf = 0;
      const y = Math.min(window.scrollY, 1100);
      caps.forEach((c) => (c.style.transform = `translate3d(0, ${(-y * parseFloat(c.dataset.cap || "0")).toFixed(1)}px, 0)`));
    };
    const onScroll = () => { if (!raf) raf = requestAnimationFrame(update); };
    window.addEventListener("scroll", onScroll, { passive: true });
    update();
    off = () => { window.removeEventListener("scroll", onScroll); if (raf) cancelAnimationFrame(raf); };
  }
  document.addEventListener("astro:page-load", init);
  document.addEventListener("astro:before-swap", () => { off?.(); off = undefined; });
</script>
