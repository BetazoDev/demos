---
// Héroe propio: tarjeta de foto con esquinas redondeadas inscrita en la ventana. Firma de movimiento: con el scroll la tarjeta
// se contrae un poco (scale) y la foto se desliza dentro de ella (translate). Solo transform.
import type { Img } from "@/kit/types";
import Pic from "@/kit/Pic.astro";
interface Props { title: string; lede?: string; image: Img; imageAlt?: string; position?: string }
const { title, lede, image, imageAlt = "", position = "70% 50%" } = Astro.props;
---

<section class="relative bg-(--c-bg) p-2.5 sm:p-3">
  <div data-card class="relative isolate flex min-h-[calc(100svh-1.25rem)] flex-col justify-end overflow-hidden rounded-(--c-radius-img,24px) bg-(--c-dark) text-(--c-on-dark) will-change-transform sm:min-h-[calc(100svh-1.5rem)]" style="transform-origin:50% 0">
    <div class="absolute inset-0 -z-10" data-hero-media style="--d:0ms">
      <div data-card-img class="size-full will-change-transform" style="transform:scale(1.08)">
        <Pic src={image} alt={imageAlt} priority position={position} class="size-full object-cover" />
      </div>
      <div class="absolute inset-0 bg-[linear-gradient(to_right,color-mix(in_oklab,var(--c-dark)_92%,transparent)_0%,color-mix(in_oklab,var(--c-dark)_70%,transparent)_38%,transparent_75%)] max-lg:bg-[linear-gradient(to_top,color-mix(in_oklab,var(--c-dark)_92%,transparent)_20%,color-mix(in_oklab,var(--c-dark)_35%,transparent)_75%,transparent_100%)]"></div>
      <div class="absolute inset-x-0 bottom-0 h-1/3 bg-[linear-gradient(to_top,color-mix(in_oklab,var(--c-dark)_80%,transparent),transparent)]"></div>
    </div>
    <div class="px-[clamp(1.25rem,5vw,4.5rem)] pb-12 pt-44 sm:pb-16">
      <h1 data-hero="blur" class="max-w-[15ch] text-[clamp(2.8rem,6.8vw,6.6rem)] leading-[0.98]">{title}</h1>
      {lede && <p data-hero style="--i:1" class="mt-7 max-w-[34ch] text-lg opacity-90 sm:text-xl">{lede}</p>}
      <div data-hero style="--i:2" class="mt-9 flex flex-wrap items-center gap-3">
        <slot name="actions" />
      </div>
    </div>
  </div>
</section>

<script>
  let off: (() => void) | undefined;
  function init() {
    off?.();
    const card = document.querySelector<HTMLElement>("[data-card]");
    const img = document.querySelector<HTMLElement>("[data-card-img]");
    if (!card || !img || window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    let raf = 0;
    const update = () => {
      raf = 0;
      const h = card.offsetHeight || window.innerHeight;
      const p = Math.min(1, Math.max(0, window.scrollY / (h * 0.8)));
      card.style.transform = `scale(${(1 - 0.05 * p).toFixed(4)})`;
      img.style.transform = `translate3d(0, ${(p * h * 0.08).toFixed(1)}px, 0) scale(1.08)`;
    };
    const onScroll = () => { if (!raf) raf = requestAnimationFrame(update); };
    window.addEventListener("scroll", onScroll, { passive: true });
    update();
    off = () => { window.removeEventListener("scroll", onScroll); if (raf) cancelAnimationFrame(raf); };
  }
  document.addEventListener("astro:page-load", init);
  document.addEventListener("astro:before-swap", () => { off?.(); off = undefined; });
</script>
