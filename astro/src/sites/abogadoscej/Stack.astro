---
// Pila de tarjetas: cada materia con foto se asienta sobre la anterior al hacer scroll (position: sticky, sin JS).
import Pic from "@/kit/Pic.astro";
import Icon from "@/kit/Icon.astro";
import type { Area } from "./data";
interface Props { areas: Area[]; base: string }
const { areas, base } = Astro.props;
---

<ol class="stack grid gap-6 sm:gap-8">
  {
    areas.map((a, i) => (
      <li class="stack-card" style={`--n:${i}`}>
        <a href={`${base}/servicios/${a.key}`} class="img-zoom group grid overflow-hidden rounded-(--c-radius) border border-(--c-line) bg-(--c-surface) md:grid-cols-[1.05fr_0.95fr]">
          <div class="flex flex-col justify-between gap-10 p-7 sm:p-10 lg:p-14">
            <h3 transition:name={`area-${a.key}`} class="max-w-[16ch] text-[clamp(2rem,4vw,3.6rem)] leading-[1.04] tracking-[-0.015em]">{a.title}</h3>
            <div>
              <ul class="grid gap-x-8 gap-y-2 text-[15px] text-(--c-muted) sm:grid-cols-2">
                {a.items.slice(0, 6).map((t) => <li class="flex gap-2.5"><Icon name="check" weight="bold" class="mt-1.5 size-3.5 shrink-0 text-(--c-accent)" /><span>{t.split(":")[0]}</span></li>)}
              </ul>
              <span class="mt-8 inline-flex items-center gap-2 font-medium text-(--c-accent)">
                Ver el servicio <Icon name="arrow-up-right" weight="bold" class="size-4 transition-transform duration-300 ease-(--ease-out) group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
              </span>
            </div>
          </div>
          <div class="relative min-h-[16rem] md:min-h-[28rem]">
            <Pic src={a.photo!} alt={a.alt ?? ""} class="absolute inset-0 size-full object-cover" />
          </div>
        </a>
      </li>
    ))
  }
</ol>

<style>
  /* Solo en pantallas donde la tarjeta cabe entera: en móvil las tarjetas son más altas que la ventana. */
  @media (min-width: 768px) and (min-height: 640px) { .stack-card { position: sticky; top: calc(5.5rem + var(--n) * 1.1rem); } }
</style>
