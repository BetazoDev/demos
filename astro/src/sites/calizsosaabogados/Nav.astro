---
// Navegación. variant="pill": cápsula flotante de vidrio (canon Framer). variant="bar": barra de ancho completo.
// tone: color del texto antes de hacer scroll cuando la nav va sobre una foto/campo oscuro ("dark" = texto claro).
import type { SiteConfig } from "@/kit/types";
import Brand from "./Brand.astro";
import Button from "@/kit/Button.astro";
import Icon from "@/kit/Icon.astro";

interface Props {
  site: SiteConfig;
  variant?: "pill" | "bar";
  tone?: "light" | "dark";
  /** Altura del logo en px */
  logoHeight?: number;
}
const { site, variant = "pill", tone = "light", logoHeight = 40 } = Astro.props;
const base = `/${site.slug}`;
const { links, cta } = site.nav;
const logoSrc = tone === "dark" && site.logo.onDark ? site.logo.onDark : site.logo.src;
---

<header
  data-nav
  data-root={base}
  data-tone={tone}
  data-variant={variant}
  class:list={["nav-shell group/nav fixed inset-x-0 top-0 z-50", variant === "pill" ? "px-3 pt-3 sm:px-5 sm:pt-4" : ""]}
>
  <div
    class:list={[
      "nav-inner relative mx-auto flex items-center justify-between gap-6",
      variant === "pill"
        ? "max-w-[68rem] rounded-(--c-radius-nav,999px) py-2 pl-5 pr-2 backdrop-blur-xl"
        : "wrap py-3",
    ]}
  >
    <a href={base} class="shrink-0" aria-label={`${site.name}, inicio`} transition:name="logo">
      <Brand tone={tone} height={logoHeight} />
    </a>

    <nav aria-label="Principal" class="hidden items-center gap-1 lg:flex">
      {
        links.map((l) => (
          <a data-nav-link href={l.href} class="nav-link rounded-full px-4 py-2 text-[15px] font-medium opacity-80 transition-[opacity,background-color] duration-200 hover:opacity-100 aria-[current=page]:opacity-100 aria-[current=page]:bg-current/8">
            {l.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      {cta && <div class="hidden sm:block"><Button href={cta.href} variant="solid" class="nav-cta !h-11" {...(cta.href.startsWith("http") ? { external: true } : {})}>{cta.label}</Button></div>}
      <button data-nav-toggle type="button" aria-expanded="false" aria-controls="nav-panel" aria-label="Abrir menú" class="press grid size-11 place-items-center rounded-full lg:hidden hover:bg-current/8">
        <Icon name="list" weight="bold" class="size-5 group-[.menu-open]/nav:hidden" />
        <Icon name="x" weight="bold" class="hidden size-5 group-[.menu-open]/nav:block" />
      </button>
    </div>

    <div id="nav-panel" data-nav-panel class="nav-panel absolute inset-x-0 top-[calc(100%+0.5rem)] overflow-hidden rounded-[1.5rem] border border-(--c-line) bg-(--c-bg) p-3 text-(--c-ink) shadow-2xl lg:hidden">
      <ul class="grid">
        {
          links.map((l, i) => (
            <li>
              <a data-nav-link href={l.href} style={`--i:${i}`} class="flex items-center justify-between rounded-2xl px-4 py-4 text-lg font-medium aria-[current=page]:bg-(--c-surface)">
                {l.label}
                <Icon name="arrow-right" weight="bold" class="size-4 opacity-40" />
              </a>
            </li>
          ))
        }
      </ul>
      {cta && <Button href={cta.href} variant="solid" class="mt-3 w-full justify-between" {...(cta.href.startsWith("http") ? { external: true } : {})}>{cta.label}</Button>}
    </div>
  </div>
</header>

<style is:global>
  /* Color antes de scroll (sobre foto) y después (superficie propia) */
  [data-nav] .nav-inner { transition: background-color 300ms ease, color 300ms ease, box-shadow 300ms ease, border-color 300ms ease, padding 300ms ease; border: 1px solid transparent; }
  [data-nav][data-tone="light"] { color: var(--c-ink); }
  [data-nav][data-tone="dark"] { color: var(--c-on-dark); }
  /* Pill: vidrio claro u oscuro */
  [data-nav][data-variant="pill"][data-tone="light"] .nav-inner { background: color-mix(in oklab, var(--c-bg) 72%, transparent); border-color: color-mix(in oklab, var(--c-ink) 10%, transparent); box-shadow: 0 8px 30px -12px rgb(0 0 0 / 0.18); }
  [data-nav][data-variant="pill"][data-tone="dark"] .nav-inner { background: color-mix(in oklab, var(--c-dark) 38%, transparent); border-color: color-mix(in oklab, var(--c-on-dark) 22%, transparent); box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.14), 0 8px 30px -12px rgb(0 0 0 / 0.4); }
  [data-nav][data-variant="pill"][data-tone="dark"].is-scrolled .nav-inner { background: color-mix(in oklab, var(--c-dark) 82%, transparent); }
  /* Barra: transparente arriba, sólida al hacer scroll */
  [data-nav][data-variant="bar"] .nav-inner { max-width: none; }
  [data-nav][data-variant="bar"]::before { content: ""; position: absolute; inset: 0; background: var(--c-bg); border-bottom: 1px solid var(--c-line); opacity: 0; transition: opacity 300ms ease; pointer-events: none; }
  [data-nav][data-variant="bar"].is-scrolled::before, [data-nav][data-variant="bar"].menu-open::before { opacity: 1; }
  [data-nav][data-variant="bar"][data-tone="dark"].is-scrolled, [data-nav][data-variant="bar"][data-tone="dark"].menu-open { color: var(--c-ink); }
  [data-nav][data-variant="bar"] .nav-inner { position: relative; }
  /* El botón de la nav se invierte sobre vidrio oscuro */
  [data-nav][data-tone="dark"]:not(.is-scrolled) .nav-cta { background: var(--c-on-dark); color: var(--c-dark); }
  [data-nav][data-tone="dark"]:not(.is-scrolled) .nav-cta .arr { background: var(--c-dark); color: var(--c-on-dark); }
  @supports not (backdrop-filter: blur(1px)) { [data-nav][data-variant="pill"] .nav-inner { background: var(--c-bg); } }
  @media (prefers-reduced-transparency: reduce) { [data-nav][data-variant="pill"] .nav-inner { background: var(--c-bg); color: var(--c-ink); backdrop-filter: none; } }
</style>
